	rewardLocked = "아직 잠겨 있어요",
	boostShort = "2배 {n}분",
	limited = "기간 한정",
	endsIn = "{t} 후 종료",
	["offer.full"] = "가방이 꽉 찼나요? 어디서든 자동 판매!",
	["offer.blackout"] = "더 빨리 헤엄쳐 올라와요!",
	["offer.unlock"] = "다음 월드를 지금 바로 열어요!",
	["offer.starter"] = "새 다이버를 위한 최고 혜택!",
	["offer.double"] = "모든 판매 금액 2배!",
	["offer.boost"] = "이번 판을 폭주 모드로!",
	["offer.eggs"] = "알 뽑기 운 UP!",
	["offer.rank"] = "주간 랭킹을 올려보세요!",
	["offer.godShark"] = "한정판: 게임 최강의 펫!",
	["prompt.buy"] = "구매",
	groupButton = "그룹",
	inviteButton = "초대",
	groupReward = "그룹 가입 완료! +{n} 코인",
	notInGroup = "그룹에 먼저 가입한 뒤 다시 눌러 보상을 받으세요",
	groupThanks = "그룹에 함께해 줘서 고마워요!",
	["offer.coins"] = "코인이 부족한가요?",
	["grantedUnlock"] = "월드 {n} 해금!",
	["grantedCoins"] = "코인 +{n}!",
	["grantedBoost"] = "{n}분 동안 코인 2배!",
	["grantedReroll"] = "{name}(으)로 리롤!",
	["grantedMutation"] = "{mutation} 변이 추가!",
	["grantedFill"] = "가방이 가득 찼어요 (+{n})!",
}

local TABLES = { en = EN, ko = KO }

Strings.language = "en"
Strings.languages = { "en", "ko" }

function Strings.setLanguage(lang: string)
	if TABLES[lang] then
		Strings.language = lang
	end
end

function Strings.get(key: string, args: { [string]: any }?): string
	local text = TABLES[Strings.language][key] or EN[key] or key
	return Format.fill(text, args)
end

-- Long durations: "3d 4h" above a day, "5h 12m" below.
function Strings.duration(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	local days, hours, minutes = total // 86400, (total % 86400) // 3600, (total % 3600) // 60
	if days > 0 then
		return Strings.get("durDH", { d = days, h = hours })
	end
	return Strings.get("durHM", { h = hours, m = minutes })
end

function Strings.name(named: { en: string, ko: string }): string
	return (named :: any)[Strings.language] or named.en
end

function Strings.hasKey(key: string): boolean
	return EN[key] ~= nil
end

-- Keys that exist in English but are missing in Korean (for tests).
function Strings.missingKorean(): { string }
	local missing = {}
	for key in EN do
		if KO[key] == nil then
			table.insert(missing, key)
		end
	end
	table.sort(missing)
	return missing
end

return Strings
]]></string>
