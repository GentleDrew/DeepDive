          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--!strict
-- Per-world look (sky, lighting, water, terrain palette) and the underwater transition: tint,
-- haze, depth darkening, blur, reverb, drifting plankton, god rays and a headlamp in the deep.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Layout = require(Shared.Layout)
local Worlds = require(Shared.Data.Worlds)

local Ambience = {}

local player = Players.LocalPlayer
local terrain = Workspace.Terrain

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function Ambience.init(app: any)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Parent = Lighting
	local colorFx = Lighting:FindFirstChild("DiveColor") :: ColorCorrectionEffect? or Instance.new("ColorCorrectionEffect")
	colorFx.Name = "DiveColor"
	colorFx.Parent = Lighting
	local blur = Lighting:FindFirstChild("DiveBlur") :: BlurEffect? or Instance.new("BlurEffect")
	blur.Name = "DiveBlur"
	blur.Parent = Lighting
	local bloom = Lighting:FindFirstChild("DiveBloom") :: BloomEffect? or Instance.new("BloomEffect")
	bloom.Name = "DiveBloom"
	bloom.Parent = Lighting
	local sunRays = Lighting:FindFirstChild("DiveSunRays") :: SunRaysEffect? or Instance.new("SunRaysEffect")
	sunRays.Name = "DiveSunRays"
	sunRays.Parent = Lighting
	local clouds = terrain:FindFirstChildOfClass("Clouds")

	local folder = Workspace:FindFirstChild("DeepDiveClient") or Instance.new("Folder")
	folder.Name = "DeepDiveClient"
	folder.Parent = Workspace

	-- Plankton volume that follows the camera underwater.
	local plankton = Instance.new("Part")
	plankton.Name = "Plankton"
	plankton.Anchored = true
	plankton.CanCollide = false
	plankton.CanQuery = false
	plankton.CanTouch = false
	plankton.Transparency = 1
	plankton.Size = Vector3.new(70, 40, 70)
	plankton.Parent = folder
	local motes = Instance.new("ParticleEmitter")
	motes.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	motes.Shape = Enum.ParticleEmitterShape.Box
	motes.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	motes.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.12), NumberSequenceKeypoint.new(1, 0) })
	motes.Transparency = NumberSequence.new(0.35)
	motes.LightEmission = 0.8
	motes.LightInfluence = 0.2
	motes.Lifetime = NumberRange.new(4, 7)
	motes.Rate = 0
	motes.Speed = NumberRange.new(0.2, 0.8)
	motes.SpreadAngle = Vector2.new(180, 180)
	motes.Parent = plankton

	-- God rays: faint beams slanting down from the surface of the current lagoon.
	local rays = Instance.new("Folder")
	rays.Name = "GodRays"
	rays.Parent = folder
	local rayBeams: { Beam } = {}
	local function buildRays(world: number)
		rays:ClearAllChildren()
		table.clear(rayBeams)
		local info = Layout.info(world)
		local data = Worlds.get(world)
		if data.sky.time > 19 or data.sky.time < 6 then
			return
		end
		local rng = Random.new(world * 31)
		for i = 1, 9 do
			local a = i / 9 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
			local r = rng:NextNumber(0.1, 0.8) * info.radius
			local top = Instance.new("Part")
			top.Anchored = true
			top.CanCollide = false
			top.CanQuery = false
			top.CanTouch = false
			top.Transparency = 1
			top.Size = Vector3.new(1, 1, 1)
			top.Position = info.origin + Vector3.new(math.cos(a) * r, -0.5, math.sin(a) * r)
			top.Parent = rays
			local a0 = Instance.new("Attachment")
			a0.Parent = top
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(rng:NextNumber(-12, 12), -math.min(info.depth * 0.7, 70), rng:NextNumber(-12, 12))
			a1.Parent = top
			local beam = Instance.new("Beam")
			beam.Attachment0 = a0
			beam.Attachment1 = a1
			beam.Width0 = rng:NextNumber(5, 9)
			beam.Width1 = rng:NextNumber(10, 16)
			beam.FaceCamera = true
			beam.LightEmission = 0.8
			beam.LightInfluence = 0
			beam.Color = ColorSequence.new(Color.lighten(Color.hex(data.water), 0.7))
			beam.Transparency =
				NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(0.5, 0.9), NumberSequenceKeypoint.new(1, 1) })
			beam.Segments = 2
			beam.Parent = top
			table.insert(rayBeams, beam)
		end
	end

	-- Headlamp for dark water.
	local lamp: SpotLight? = nil
	local glow: PointLight? = nil
	local function attachLamp(character: Model)
		local head = character:WaitForChild("Head", 10)
		if not head then
			return
		end
		local spot = Instance.new("SpotLight")
		spot.Name = "Headlamp"
		spot.Face = Enum.NormalId.Front
		spot.Angle = 70
		spot.Range = 48
		spot.Brightness = 0
		spot.Shadows = true
		spot.Color = Color3.fromRGB(230, 245, 255)
		spot.Parent = head
		lamp = spot
		local point = Instance.new("PointLight")
		point.Name = "DiverGlow"
		point.Range = 16
		point.Brightness = 0
		point.Shadows = false
		point.Color = Color3.fromRGB(200, 230, 255)
		point.Parent = head
		glow = point
	end
	player.CharacterAdded:Connect(attachLamp)
	if player.Character then
		task.spawn(attachLamp, player.Character)
	end

	local surfaceLook: any = {}
	local function applyWorld(world: number)
		local data = Worlds.get(world)
		local sky = data.sky
		surfaceLook = {
			clock = sky.time,
			brightness = sky.bright,
			ambient = Color.hex(sky.ambient),
			outdoor = Color.hex(sky.outdoor),
			density = sky.density,
			haze = sky.haze,
			atmo = Color.hex(sky.atmo),
			decay = Color.hex(sky.decay),
			glare = sky.glare,
			water = Color.hex(data.water),
			tint = Color.hex(data.under.tint),
			dark = data.under.dark,
		}
		Lighting.ClockTime = sky.time
		terrain.WaterColor = surfaceLook.water
		local t = data.terrain
		for _, pair in
			{ { t.land, t.landColor }, { t.beach, t.beachColor }, { t.rock, t.rockColor }, { t.floor, t.floorColor }, { t.deep, t.deepColor } }
		do
			terrain:SetMaterialColor(Color.material(pair[1], Enum.Material.Sand), Color.hex(pair[2]))
		end
		if clouds then
			clouds.Cover = sky.clouds
			clouds.Color = Color.hex(sky.cloudColor)
		end
		local skyObject = Lighting:FindFirstChildOfClass("Sky")
		if skyObject then
			skyObject.StarCount = if data.sky.stars then 3000 else 0
			skyObject.CelestialBodiesShown = true
		end
		buildRays(world)
	end
	applyWorld(app.State.world)
	app.State.worldChanged:Connect(applyWorld)

	local blend = 0
	local wasUnder = false
	RunService.RenderStepped:Connect(function(dt: number)
		local camera = Workspace.CurrentCamera
		if not camera or not surfaceLook.water then
			return
		end
		local world = app.State.world
		local lowFx = app.State.settings().lowFx
		local position = camera.CFrame.Position
		local over = Layout.overLagoon(world, position)
		local camDepth = Config.SurfaceY - position.Y
		local under = over and camDepth > 0.25
		if under ~= wasUnder then
			wasUnder = under
			SoundService.AmbientReverb = if under then Enum.ReverbType.UnderWater else Enum.ReverbType.NoReverb
		end
		blend += ((if under then 1 else 0) - blend) * math.clamp(dt * 7, 0, 1)
		local depthRatio = if under then math.clamp(camDepth / Economy.depthStuds(world), 0, 1) else 0
		local look = surfaceLook
		local darkness = look.dark * depthRatio

		Lighting.Brightness = lerp(look.brightness, look.brightness * (1 - darkness * 0.8), blend)
		Lighting.Ambient = look.ambient:Lerp(look.water:Lerp(Color3.new(0, 0, 0), 0.35 + darkness * 0.5), blend * 0.85)
		Lighting.OutdoorAmbient = look.outdoor:Lerp(look.water:Lerp(Color3.new(0, 0, 0), 0.25 + darkness * 0.6), blend)
		Lighting.ExposureCompensation = lerp(0.1, -0.15 - darkness * 1.4, blend)
		atmosphere.Density = lerp(look.density, math.min(0.8, 0.46 + depthRatio * 0.3), blend)
		atmosphere.Haze = lerp(look.haze, 2.2 + darkness * 2, blend)
		atmosphere.Color = look.atmo:Lerp(look.water, blend)
		atmosphere.Decay = look.decay:Lerp(look.water:Lerp(Color3.new(0, 0, 0), 0.55 + darkness * 0.4), blend)
		atmosphere.Glare = lerp(look.glare, 0, blend)
		atmosphere.Offset = lerp(0.12, 0, blend)
		colorFx.TintColor = Color3.new(1, 1, 1):Lerp(look.tint, blend * 0.55)
		colorFx.Saturation = lerp(0.12, 0.22, blend)
		colorFx.Contrast = lerp(0.08, 0.14, blend)
		blur.Size = if lowFx then 0 else blend * (2 + depthRatio * 3)
		bloom.Intensity = lerp(0.6, 1.1, blend)
		sunRays.Intensity = lerp(0.06, 0, blend)

		plankton.CFrame = CFrame.new(position)
		motes.Rate = if under and not lowFx then 24 else 0
		motes.Color = ColorSequence.new(look.tint:Lerp(Color3.new(1, 1, 1), 0.5))
		for _, beam in rayBeams do
			beam.Enabled = not lowFx
		end

		local lampPower = math.clamp((look.dark * depthRatio - 0.12) / 0.4, 0, 1) * blend
		if lamp then
			lamp.Brightness = lampPower * 3.2
			lamp.Enabled = lampPower > 0.02
		end
		if glow then
			glow.Brightness = lampPower * 0.9
			glow.Enabled = lampPower > 0.02
		end
	end)
end

return Ambience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Board</string>
              <string name="Source"><![CDATA[--!strict
-- Draws the ranking board at the current world's dock from the JSON the server publishes in
-- ReplicatedStorage. Arrows on the board switch between weekly (the default), monthly and all-time;
-- the podium statues beside it follow the same choice. The Director has their own row on top.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Rankings = require(Shared.Rankings)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)
local Strings = require(Shared.Strings)

local TierStyle = require(script.Parent.Parent.UI.TierStyle)

local Board = {}

local MEDALS = { utf8.char(0x1F947), utf8.char(0x1F948), utf8.char(0x1F949) }
local ROW = 36
local PIXELS_PER_STUD = 40
local ARROW_BAND = 72 -- px from the top of the board: the title row with the arrows
local ARROW_REACH = 120 -- px in from each side edge
local data: any = { boards = {}, directors = {} }

-- The board this player picked with the arrows (the statues follow it too). Every player starts
-- on the weekly board when they join.
Board.selected = "weekly"
Board.selectionChanged = Signal.new()

-- Which arrow (-1 left, 1 right, nil none) a point on the board's front face hits. `localPoint`
-- is in the board part's space; the front face looks down -Z, so the viewer's left is +X.
function Board.arrowAt(localPoint: Vector3, size: Vector3): number?
	local x = (size.X / 2 - localPoint.X) * PIXELS_PER_STUD
	local y = (size.Y / 2 - localPoint.Y) * PIXELS_PER_STUD
	if y < 0 or y > ARROW_BAND then
		return nil
	elseif x >= 0 and x <= ARROW_REACH then
		return -1
	elseif x <= size.X * PIXELS_PER_STUD and x >= size.X * PIXELS_PER_STUD - ARROW_REACH then
		return 1
	end
	return nil
end

-- Steps to the previous (-1) or next (1) board.
function Board.pick(side: number)
	local index = table.find(Rankings.Boards, Board.selected) or 1
	Board.selected = Rankings.Boards[(index - 1 + side) % #Rankings.Boards + 1]
	Board.selectionChanged:Fire(Board.selected)
end

-- Weekly rank of a UserId (1..10) on the published board, for the player list's "#N" tags.
function Board.weeklyRank(userId: number): number?
	local weekly = data.boards.weekly
	if type(weekly) == "table" and type(weekly.entries) == "table" then
		for rank, entry in weekly.entries do
			if entry.u == userId then
				return rank
			end
		end
	end
	return nil
end

function Board.init(app: any)
	local Kit = app.Kit
	local current: SurfaceGui? = nil
	local localPlayer = Players.LocalPlayer

	local function decode()
		local value = ReplicatedStorage:FindFirstChild(Remotes.Board)
		if not value or not value:IsA("StringValue") then
			return
		end
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, value.Value)
		if ok and type(decoded) == "table" and type(decoded.boards) == "table" then
			data = decoded
		end
	end

	local function nameText(entry: any): string
		return string.format('%s <font size="17" color="#a9c3df">@%s</font>', tostring(entry.d), tostring(entry.n))
	end

	local function avatar(parent: Instance, userId: number, x: number)
		local image = Kit.new("ImageLabel", {
			BackgroundColor3 = Color3.fromRGB(40, 64, 104),
			Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", math.max(1, userId)),
			Size = UDim2.fromOffset(ROW - 6, ROW - 6),
			Position = UDim2.new(0, x, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Parent = parent,
		})
		Kit.round(image)
		Kit.stroke(image, Color3.new(1, 1, 1), 1.5)
	end

	local function row(root: Frame, order: number, entry: any, rankText: string, director: boolean, tint: Color3, transparency: number)
		local frame = Kit.new("Frame", {
			BackgroundColor3 = tint,
			BackgroundTransparency = transparency,
			Size = UDim2.new(1, 0, 0, ROW),
			LayoutOrder = order,
			Parent = root,
		})
		Kit.corner(frame, 10)
		local rank = Kit.text({
			Text = rankText,
			TextSize = if director then 17 else 24,
			Stroke = if director then 2 else (if string.sub(rankText, 1, 1) == "#" then 2 else 0),
			Size = UDim2.fromOffset(if director then 96 else 54, ROW),
			Position = UDim2.fromOffset(4, 0),
			Parent = frame,
		})
		if director then
			local stroke = Kit.stroke(frame, Color3.new(1, 1, 1), 2.5)
			TierStyle.director(stroke)
			TierStyle.director(rank)
		end
		local x = if director then 104 else 62
		avatar(frame, tonumber(entry.u) or 1, x)
		local name = Kit.text({
			Text = nameText(entry),
			Rich = true,
			TextSize = 23,
			Stroke = 2.2,
			Size = UDim2.new(1, -(x + 200), 1, 0),
			Position = UDim2.fromOffset(x + ROW + 2, 0),
			XAlign = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		name.TextTruncate = Enum.TextTruncate.AtEnd
		if director then
			TierStyle.director(name)
		else
			TierStyle.apply(name, tonumber(entry.t) or 0, Color3.new(1, 1, 1))
		end
		Kit.text({
			Text = Format.short(tonumber(entry.v) or 0),
			TextSize = 24,
			Color = Color3.fromRGB(255, 222, 92),
			Stroke = 2.4,
			Size = UDim2.fromOffset(150, ROW),
			Position = UDim2.new(1, -158, 0, 0),
			XAlign = Enum.TextXAlignment.Right,
			Parent = frame,
		})
	end

	local function render()
		if current then
			current:Destroy()
			current = nil
		end
		local worlds = Workspace:FindFirstChild("Worlds")
		local folder = worlds and worlds:FindFirstChild("World" .. app.State.world)
		local screen = folder and folder:FindFirstChild("BoardScreen", true)
		if not screen or not screen:IsA("BasePart") then
			return
		end
		local board = Board.selected
		local section = data.boards[board] or {}
		local entries = if type(section.entries) == "table" then section.entries else {}
		local gui = Instance.new("SurfaceGui")
		gui.Name = "LeaderboardGui"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = PIXELS_PER_STUD
		gui.LightInfluence = 0
		-- Drawn on the board but parented to PlayerGui, the only place a SurfaceGui takes clicks.
		gui.Adornee = screen
		gui.ResetOnSpawn = false
		gui.Parent = app.Gui.promptParent
		current = gui
		local root = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
		Kit.padding(root, 10, 20, 10, 20)
		Kit.list(root, Enum.FillDirection.Vertical, 3, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
		local titleRow = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 1, Parent = root })
		Kit.text({
			Text = utf8.char(0x1F3C6) .. "  " .. Strings.get("board." .. board),
			TextSize = 38,
			Color = Color3.fromRGB(255, 222, 92),
			Stroke = 4,
			Size = UDim2.new(1, -130, 1, 0),
			Position = UDim2.fromScale(0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0),
			Parent = titleRow,
		})
		-- Arrow "buttons" are drawn here but clicked through the 3D board (see the click handler).
		for _, side in { -1, 1 } do
			local arrow = Kit.new("Frame", {
				Name = if side < 0 then "BoardPrev" else "BoardNext",
				BackgroundColor3 = Color3.new(1, 1, 1),
				Size = UDim2.fromOffset(60, 48),
				Position = if side < 0 then UDim2.fromOffset(0, 1) else UDim2.new(1, 0, 0, 1),
				AnchorPoint = Vector2.new(if side < 0 then 0 else 1, 0),
				Parent = titleRow,
			})
			Kit.corner(arrow, 14)
			Kit.gradient(arrow, app.Theme.Buttons.Gold[1], app.Theme.Buttons.Gold[2])
			Kit.stroke(arrow, app.Theme.Buttons.Gold[3], 3)
			Kit.text({
				Text = if side < 0 then "<" else ">",
				TextSize = 32,
				Size = UDim2.fromScale(1, 1),
				StrokeColor = app.Theme.Buttons.Gold[3],
				Parent = arrow,
			})
		end
		local subtitle = if section.reset
			then Strings.get("boardResets", { t = Strings.duration(section.reset - (os.time() - (data.at or os.time()))) })
			else Strings.get("boardForever")
		if data.global ~= true then
			subtitle ..= "  " .. Strings.get("boardLocalTag")
		end
		-- Which of the three boards is showing (dots).
		local dots = {}
		for _, name in Rankings.Boards do
			table.insert(dots, if name == board then utf8.char(0x25CF) else utf8.char(0x25CB))
		end
		Kit.text({
			Text = subtitle .. "   " .. table.concat(dots, " "),
			TextSize = 19,
			Color = Color3.fromRGB(170, 200, 235),
			Stroke = 2,
			Size = UDim2.new(1, 0, 0, 24),
			LayoutOrder = 2,
			Parent = root,
		})
		local director = data.directors[board]
		if director then
			row(root, 3, director, Strings.get("director"), true, Color3.fromRGB(8, 8, 12), 0.15)
		end
		if #entries == 0 then
			Kit.text({ Text = Strings.get("boardEmpty"), TextSize = 26, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 4, Parent = root })
			return
		end
		for rank, entry in entries do
			if rank > 10 then
				break
			end
			local mine = entry.u == localPlayer.UserId
			row(
				root,
				10 + rank,
				entry,
				MEDALS[rank] or ("#" .. rank),
				false,
				if mine then Color3.fromRGB(255, 214, 90) else Color3.fromRGB(255, 255, 255),
				if mine then 0.55 elseif rank % 2 == 0 then 0.92 else 0.84
			)
		end
	end

	local function hook()
		local value = ReplicatedStorage:WaitForChild(Remotes.Board, 30)
		if value and value:IsA("StringValue") then
			value.Changed:Connect(function()
				decode()
				render()
			end)
		end
		decode()
		render()
	end
	task.spawn(hook)
	app.State.worldChanged:Connect(function()
		task.delay(0.5, render)
	end)
	app.State.languageChanged:Connect(render)
	Board.selectionChanged:Connect(render)

	-- Left click / tap on the board's arrows. Raycasting against the board itself works everywhere
	-- (SurfaceGui buttons only take input in some setups).
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local gui = current
		local screen = gui and gui.Adornee
		local camera = Workspace.CurrentCamera
		if not screen or not screen:IsA("BasePart") or not camera then
			return
		end
		local ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { screen }
		local hit = Workspace:Raycast(ray.Origin, ray.Direction * 300, params)
		if not hit then
			return
		end
		local side = Board.arrowAt(screen.CFrame:PointToObjectSpace(hit.Position), screen.Size)
		if side then
			app.Sfx.play("Click")
			Board.pick(side)
		end
	end)
	-- The world folder may still be building when we first look; the reset countdown ticks too.
	task.spawn(function()
		local age = 0
		while true do
			task.wait(1)
			age += 1
			if not current or not current.Adornee or not current.Adornee.Parent or age >= 30 then
				age = 0
				render()
			end
		end
	end)
end

return Board
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Dive</string>
              <string name="Source"><![CDATA[--!strict
-- Client side of the dive loop: reacts to server pushes (dive start, oxygen, pickups, sales,
-- blackouts, clears, travel) with feedback, and predicts oxygen smoothly between syncs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Dive = {}

function Dive.init(app: any)
	local State = app.State
	local Net = app.Net
	local dive = State.dive

	Net.on("profile", function(view: any)
		State.applyView(view)
	end)

	Net.on("layout", function(layout: any)
		if type(layout) ~= "table" then
			return
		end
		local relics = {}
		for _, pair in layout.relics or {} do
			relics[pair[1]] = pair[2]
		end
		State.layout = { id = layout.id, world = layout.world, relics = relics, chest = layout.chest == true }
		State.layoutChanged:Fire(State.layout)
	end)

	Net.on("dive", function(payload: any)
		if payload.state == "start" then
			dive.active = true
			dive.blackout = false
			dive.oxygen = payload.oxygen
			dive.max = payload.max
			dive.chestCarried = false
			State.diveChanged:Fire()
		elseif payload.state == "blackout" then
			dive.blackout = true
			app.Sfx.play("Blackout")
			app.Screens.blackout()
			State.diveChanged:Fire()
			task.delay(4, function()
				app.Offers.trigger("blackout")
			end)
		end
	end)

	Net.on("oxygen", function(payload: any)
		if not dive.active then
			return
		end
		dive.max = payload.max
		if payload.hit then
			dive.oxygen = payload.value
			app.Sfx.play("Hurt")
			app.Effects.flash(Color3.fromRGB(255, 60, 80), 0.45, 0.5)
			app.Toasts.show(Strings.get("hazardHit", { n = math.floor(Config.Dive.HazardPenalty * 100 + 0.5) }), "bad", utf8.char(0x1F4A5))
		elseif math.abs(payload.value - dive.oxygen) > 1.5 then
			dive.oxygen = payload.value
		else
			dive.oxygen += (payload.value - dive.oxygen) * 0.5
		end
	end)

	Net.on("collected", function(payload: any)
		if payload.chest then
			dive.chestCarried = true
			app.Sfx.play("Chest")
			app.Effects.flash(Color3.fromRGB(255, 220, 120), 0.5, 0.6)
			app.Toasts.show(Strings.get("chestGot"), "gold", utf8.char(0x1F451))
			return
		end
		dive.cargo = payload.cargo
		app.Relics.confirm(payload.point)
		app.Hud.bumpCargo()
		local relic = Worlds.relics[payload.key]
		if payload.discovered and relic then
			app.Sfx.play("Discover")
			app.Toasts.show(Strings.get("newRelic") .. "  " .. Strings.name(relic.name), "rare", utf8.char(0x2728))
		end
		if payload.capacity and payload.cargo >= payload.capacity then
			app.Toasts.show(Strings.get("backpackFull"), "blue", utf8.char(0x1F392))
			app.Offers.trigger("full")
		end
	end)

	-- A point you emptied earlier in this dive just refilled with a new relic.
	Net.on("relicSpawn", function(payload: any)
		app.Relics.spawn(payload.point, payload.key)
	end)

	Net.on("reject", function(payload: any)
		app.Relics.restore(payload.point)
		if payload.reason == "full" then
			app.Hud.flashFull()
		end
	end)

	-- Dive over: treasure stays in the backpack until it is sold at the sell stand.
	Net.on("surfaced", function(payload: any)
		dive.active = false
		dive.chestCarried = false
		dive.cargo = payload.cargo or dive.cargo
		dive.blackout = false
		State.diveChanged:Fire()
		if payload.rescued then
			local text = Strings.get("rescued")
			if (payload.lost or 0) > 0 then
				text ..= "  (" .. Strings.get("lostTreasure", { n = payload.lost }) .. ")"
			end
			app.Screens.rescued(text)
		elseif (payload.cargo or 0) > 0 and not payload.chest then
			app.Toasts.show(Strings.get("carrying", { n = payload.cargo }), "gold", utf8.char(0x1F392))
		end
		if payload.record then
			app.Toasts.show(Strings.get("depthRecord", { n = payload.record }), "blue", utf8.char(0x1F3C6))
		end
		if payload.chestLost then
			app.Toasts.show(Strings.get("chestLost"), "bad")
		end
	end)

	Net.on("sold", function(payload: any)
		dive.cargo = 0
		app.Hud.bumpCargo()
		local world = State.world
		local spot = Layout.origin(world) + Layout.dock(world).sell
		app.WorldFx.coinFountain(spot + Vector3.new(0, 0.5, 0), math.clamp(payload.count + 6, 8, 22))
		app.Sfx.play(if payload.count >= 10 then "SellBig" else "Sell")
		app.Effects.flash(Color3.fromRGB(255, 226, 120), 0.35, 0.35)
		app.Effects.floatText("+" .. Format.commas(payload.payout), Color3.fromRGB(255, 226, 90), UDim2.fromScale(0.5, 0.58), 48)
		local coins = math.clamp(math.floor(payload.count * 1.5) + 6, 8, 26)
		app.Effects.coinBurst(coins, Vector2.new(0.5, 0.62), app.Hud.coinTarget, function()
			app.Sfx.play("Coin", 0.9 + math.random() * 0.3)
		end)
		app.Toasts.show(Strings.get("sold", { n = payload.count }), "gold", utf8.char(0x1F4B0))
		if payload.chestReady then
			task.delay(1.2, function()
				app.Sfx.play("Unlock")
				app.Toasts.show(Strings.get("chestReady"), "gold", utf8.char(0x1F451))
			end)
		end
	end)

	Net.on("cleared", function(payload: any)
		task.delay(0.8, function()
			app.Clear.show(payload, app.unlockWorld, app.Sfx.play)
		end)
	end)

	Net.on("travel", function(payload: any)
		if payload.state == "start" then
			State.traveling = true
			app.closePanels()
			app.Sfx.play("Travel")
			app.Screens.travelStart(payload.world)
		else
			State.traveling = false
			app.Screens.travelEnd()
		end
	end)

	Net.on("toast", function(payload: any)
		local args = payload.args
		if payload.key == "grantedReroll" and args and args.key then
			local pet = Worlds.pets[args.key]
			args = { name = if pet then Strings.name(pet.name) else args.key }
		end
		app.Toasts.show(Strings.get(payload.key, args), payload.kind or "info")
	end)

	Net.on("saved", function()
		app.Hud.showSaved()
	end)

	Net.on("purchase", function(payload: any)
		if (payload.coins or 0) <= 0 then
			app.Sfx.play("Legendary")
			app.Toasts.show(Strings.get("luckyGot", { n = payload.enchants or 0 }), "gold", utf8.char(0x2728))
			return
		end
		app.Effects.coinBurst(24, Vector2.new(0.5, 0.5), app.Hud.coinTarget, function()
			app.Sfx.play("Coin", 1.1)
		end)
		app.Effects.floatText("+" .. Format.commas(payload.coins), Color3.fromRGB(255, 226, 90), UDim2.fromScale(0.5, 0.5), 50)
	end)

	-- Oxygen prediction and warnings.
	local warned = false
	local lastBeat = 0
	RunService.RenderStepped:Connect(function(dt: number)
		if dive.active and not dive.blackout then
			dive.oxygen = math.max(0, dive.oxygen - Economy.oxygenDrain(State.world, math.max(0, dive.depth)) * dt)
		elseif not dive.active then
			dive.max = State.upgrade("tank")
			dive.oxygen = dive.max
		end
		local ratio = if dive.max > 0 then dive.oxygen / dive.max else 1
		local now = os.clock()
		if dive.active and not dive.blackout then
			if ratio <= Config.Dive.OxygenWarn and not warned then
				warned = true
				app.Sfx.play("Warning")
			end
			if ratio <= Config.Dive.OxygenDanger and now - lastBeat > 1.1 then
				lastBeat = now
				app.Sfx.play("Warning", 1.2)
			end
			local strength = 0
			if ratio <= Config.Dive.OxygenDanger then
				strength = 0.45 + math.sin(now * 7) * 0.2
			elseif ratio <= Config.Dive.OxygenWarn then
				strength = 0.18
			end
			app.Effects.setVignette(strength)
		else
			warned = false
			app.Effects.setVignette(0)
		end
	end)
end

return Dive
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Fish</string>
              <string name="Source"><![CDATA[--!strict
-- Ambient fish schools that circle the lagoon and scatter from the diver.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Layout = require(Shared.Layout)
local Worlds = require(Shared.Data.Worlds)

local Fish = {}

local player = Players.LocalPlayer

type FishEntry = { body: BasePart, tail: BasePart, offset: Vector3, phase: number, position: Vector3 }
type School = { fish: { FishEntry }, radius: number, depth: number, speed: number, phase: number, tilt: number }

function Fish.init(app: any)
	local folder = Instance.new("Folder")
	folder.Name = "Fish"
	folder.Parent = Workspace:WaitForChild("DeepDiveClient")
	local schools: { School } = {}
	local parts: { BasePart } = {}
	local cframes: { CFrame } = {}
	local loadedWorld = 0
	local loadedLow = false

	local function newPart(size: Vector3, color: Color3, wedge: boolean, glow: boolean): BasePart
		local part: BasePart = if wedge then Instance.new("WedgePart") else Instance.new("Part")
		part.Size = size
		part.Color = color
		part.Material = if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Parent = folder
		if not wedge then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		return part
	end

	local function build(world: number)
		folder:ClearAllChildren()
		table.clear(schools)
		table.clear(parts)
		loadedWorld = world
		local data = Worlds.get(world)
		local info = Layout.info(world)
		local low = app.State.settings().lowFx
		loadedLow = low
		local rng = Random.new(world * 977)
		local schoolCount = if low then 2 else 4
		for s = 1, schoolCount do
			local color = Color.hex(data.fish[((s - 1) % #data.fish) + 1])
			local school: School = {
				fish = {},
				radius = rng:NextNumber(0.35, 0.75) * info.midRadius,
				depth = rng:NextNumber(0.2, 0.75) * info.depth,
				speed = rng:NextNumber(0.12, 0.22) * (if rng:NextNumber() < 0.5 then 1 else -1),
				phase = rng:NextNumber(0, math.pi * 2),
				tilt = rng:NextNumber(-0.3, 0.3),
			}
			local count = rng:NextInteger(6, 9)
			for _ = 1, count do
				local scale = rng:NextNumber(0.8, 1.2)
				local body = newPart(Vector3.new(0.55, 0.75, 1.3) * scale, color, false, data.fishGlow)
				local tail = newPart(Vector3.new(0.1, 0.6, 0.5) * scale, Color.darken(color, 0.2), true, data.fishGlow)
				table.insert(school.fish, {
					body = body,
					tail = tail,
					offset = Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(-2, 2), rng:NextNumber(-4, 4)),
					phase = rng:NextNumber(0, 6),
					position = info.origin,
				})
				table.insert(parts, body)
				table.insert(parts, tail)
			end
			table.insert(schools, school)
		end
	end

	RunService.RenderStepped:Connect(function(dt: number)
		local world = app.State.world
		local low = app.State.settings().lowFx
		if world ~= loadedWorld or low ~= loadedLow then
			build(world)
		end
		local info = Layout.info(world)
		local t = os.clock()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local diver = root and root.Position
		local index = 0
		table.clear(cframes)
		for _, school in schools do
			local angle = t * school.speed + school.phase
			local center = info.origin
				+ Vector3.new(math.cos(angle) * school.radius, -school.depth + math.sin(t * 0.3 + school.phase) * 3, math.sin(angle) * school.radius)
			local heading = Vector3.new(-math.sin(angle), 0, math.cos(angle)) * math.sign(school.speed)
			for _, fish in school.fish do
				local wobble = Vector3.new(math.sin(t * 1.3 + fish.phase), math.sin(t * 0.9 + fish.phase) * 0.5, math.cos(t * 1.1 + fish.phase))
				local target = center + fish.offset + wobble
				if diver then
					local away = target - diver
					local distance = away.Magnitude
					if distance < 9 and distance > 0.01 then
						target += away.Unit * (9 - distance) * 1.4
					end
				end
				local previous = fish.position
				fish.position = previous:Lerp(target, math.clamp(dt * 3, 0, 1))
				local velocity = fish.position - previous
				-- Fish swim mostly level: damp the climb so the look direction never goes vertical.
				local level = Vector3.new(velocity.X, velocity.Y * 0.35, velocity.Z)
				local direction = if Vector3.new(level.X, 0, level.Z).Magnitude > 0.004 then level.Unit else heading
				local cf = CFrame.lookAt(fish.position, fish.position + direction)
				local swish = math.sin(t * 10 + fish.phase) * 0.5
				index += 1
				cframes[index] = cf
				index += 1
				-- WedgePart is tallest at +Z, which is the back of the fish here.
				cframes[index] = cf * CFrame.new(0, 0, fish.body.Size.Z * 0.62) * CFrame.Angles(0, swish, 0)
			end
		end
		if #parts > 0 then
			Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end)
end

return Fish
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Hazards</string>
              <string name="Source"><![CDATA[--!strict
-- Hazards (jellyfish, urchins, puffers, eels, ice shards, lava bubbles, void orbs). Motion is
-- a pure function of server time, so every client sees them in the same place.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Build = require(Shared.Models.Build)
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local PetModels = require(Shared.Models.PetModels)
local RelicModels = require(Shared.Models.RelicModels)
local Worlds = require(Shared.Data.Worlds)

local Hazards = {}

local player = Players.LocalPlayer

type Hazard = { kind: string, x: number, y: number, z: number, radius: number, range: number, speed: number, phase: number }
type Entry = { def: Hazard, model: Model, base: Vector3, lastHit: number }

local function buildModel(kind: string, world: number): Model
	local data = Worlds.get(world)
	local accent = Color.hex(data.accent[1])
	local model = Build.model("Hazard_" .. kind)
	if kind == "jelly" then
		PetModels.Shapes.jelly(model, Color3.fromRGB(255, 120, 200), Color3.fromRGB(255, 190, 240))
		Build.style(model, "neon", Color3.fromRGB(255, 120, 220))
		Build.fit(model, 3.4)
	elseif kind == "urchin" then
		RelicModels.Shapes.urchin(model, Color3.fromRGB(70, 30, 90), Color3.fromRGB(150, 70, 190))
		Build.fit(model, 3)
	elseif kind == "puffer" then
		PetModels.Shapes.puffer(model, Color3.fromRGB(255, 160, 90), Color3.fromRGB(200, 60, 60))
		Build.fit(model, 3.2)
	elseif kind == "eel" then
		PetModels.Shapes.eel(model, Color3.fromRGB(70, 80, 50), Color3.fromRGB(255, 220, 90))
		Build.fit(model, 5)
	elseif kind == "shard" then
		RelicModels.Shapes.crystal(model, if data.kit == "ice" then Color3.fromRGB(170, 225, 255) else accent, Color3.fromRGB(255, 255, 255))
		Build.style(model, "neon", accent)
		Build.fit(model, 3.4)
	elseif kind == "lava" then
		local ball = Build.ball(model, 2.4, CFrame.identity, Color3.fromRGB(255, 120, 30))
		ball.Material = Enum.Material.Neon
		Build.light(ball, Color3.fromRGB(255, 130, 40), 12, 2)
		local fire = Instance.new("ParticleEmitter")
		fire.Texture = "rbxasset://textures/particles/fire_main.dds"
		fire.Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 60, 30))
		fire.LightEmission = 1
		fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0.2) })
		fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		fire.Lifetime = NumberRange.new(0.3, 0.6)
		fire.Rate = 22
		fire.Speed = NumberRange.new(1, 3)
		fire.Parent = ball
	else
		local core = Build.ball(model, 2, CFrame.identity, Color3.fromRGB(40, 10, 60))
		core.Material = Enum.Material.Neon
		local shell = Build.ball(model, 3.2, CFrame.identity, Color3.fromRGB(170, 90, 255))
		shell.Material = Enum.Material.ForceField
		Build.light(core, Color3.fromRGB(170, 90, 255), 14, 2)
		Build.sparkles(core, Color3.fromRGB(200, 140, 255), 8)
	end
	return model
end

local function positionAt(def: Hazard, base: Vector3, t: number): (Vector3, number)
	local w = t * def.speed + def.phase
	if def.kind == "jelly" then
		return base + Vector3.new(math.sin(w * 0.5) * 1.2, math.sin(w) * def.range, math.cos(w * 0.4) * 1.2), 0
	elseif def.kind == "urchin" then
		return base, w * 0.2
	elseif def.kind == "puffer" then
		return base + Vector3.new(math.cos(w * 0.6) * def.range, math.sin(w * 1.3) * 1.2, math.sin(w * 0.6) * def.range), -w * 0.6
	elseif def.kind == "eel" then
		return base + Vector3.new(math.cos(w * 0.5) * def.range, math.sin(w * 2) * 0.6, math.sin(w * 0.5) * def.range), -w * 0.5 - math.pi / 2
	elseif def.kind == "shard" then
		return base + Vector3.new(0, math.sin(w) * 1.5, 0), w * 0.7
	elseif def.kind == "lava" then
		local cycle = (w * 0.35) % 1
		return base + Vector3.new(0, cycle * def.range, 0), 0
	end
	return base + Vector3.new(math.sin(w * 0.5) * def.range, math.sin(w) * def.range * 0.3, math.sin(w) * def.range * 0.5), w
end

function Hazards.init(app: any)
	local folder = Instance.new("Folder")
	folder.Name = "Hazards"
	folder.Parent = Workspace:WaitForChild("DeepDiveClient")
	local entries: { Entry } = {}
	local loadedWorld = 0

	local function load(world: number)
		folder:ClearAllChildren()
		table.clear(entries)
		loadedWorld = world
		local worlds = Workspace:FindFirstChild("Worlds")
		local wf = worlds and worlds:FindFirstChild("World" .. world)
		local raw = wf and wf:GetAttribute("Hazards")
		if type(raw) ~= "string" then
			loadedWorld = 0
			return
		end
		local ok, list = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok or type(list) ~= "table" then
			return
		end
		for _, def in list do
			local model = buildModel(def.kind, world)
			model.Parent = folder
			table.insert(entries, { def = def, model = model, base = Vector3.new(def.x, def.y, def.z), lastHit = 0 })
		end
	end

	RunService.RenderStepped:Connect(function()
		local world = app.State.world
		if loadedWorld ~= world then
			load(world)
		end
		local t = Workspace:GetServerTimeNow()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local dive = app.State.dive
		local now = os.clock()
		for index, entry in entries do
			local position, spin = positionAt(entry.def, entry.base, t)
			entry.model:PivotTo(CFrame.new(position) * CFrame.Angles(0, spin, 0))
			if root and dive.active and not dive.blackout and now - entry.lastHit > Config.Dive.HazardImmunity then
				if (root.Position - position).Magnitude < entry.def.radius + 1.6 then
					entry.lastHit = now
					app.Net.hazard(index)
				end
			end
		end
	end)
end

return Hazards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">Nameplates</string>
              <string name="Source"><![CDATA[--!strict
-- Floating nameplates above every diver (including you): display name and coins. Coins come
-- from the "Coins" attribute the server keeps on each player.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)

local TierStyle = require(script.Parent.Parent.UI.TierStyle)

local Nameplates = {}

type Plate = {
	gui: BillboardGui,
	name: TextLabel,
	aura: ParticleEmitter?,
	auraKind: string?, -- "operator" | "vip", so switching between them swaps the aura's color
	glow: UIStroke?, -- pulsing neon stroke, Operator only
	connections: { RBXScriptConnection },
}

local VIP_CROWN = utf8.char(0x1F451) .. " "
local OPERATOR_BADGE = utf8.char(0x1F6E1) .. utf8.char(0xFE0F) .. " " -- shield
local OPERATOR_RED = Color3.fromRGB(255, 70, 70)
local OPERATOR_RED_DARK = Color3.fromRGB(120, 10, 10)
local INK = Color3.fromRGB(21, 38, 58) -- Theme.C.Ink, the stroke's normal default

-- Sparkle worn around the root part: gold for VIPAura owners, red for the game's Operator.
local function auraEmitter(root: BasePart, colorA: Color3, colorB: Color3): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(colorA, colorB)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.7, 1.2)
	emitter.Rate = 6
	emitter.Speed = NumberRange.new(0.5, 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = root
	return emitter
end

function Nameplates.init(app: any)
	local Kit = app.Kit
	local localPlayer = Players.LocalPlayer
	local plates: { [Player]: Plate } = {}

	local function remove(player: Player)
		local plate = plates[player]
		if plate then
			for _, connection in plate.connections do
				connection:Disconnect()
			end
			plate.gui:Destroy()
			plates[player] = nil
		end
	end

	local function build(player: Player, character: Model)
		remove(player)
		local head = character:WaitForChild("Head", 10)
		if not head or player.Character ~= character then
			return
		end
		local isMe = player == localPlayer
		local gui = Instance.new("BillboardGui")
		gui.Name = "DeepDiveNameplate"
		gui.Size = UDim2.fromOffset(240, 62)
		gui.StudsOffset = Vector3.new(0, 2.7, 0)
		gui.Adornee = head :: Instance
		gui.LightInfluence = 0
		gui.MaxDistance = 110
		gui.ResetOnSpawn = false
		gui.Parent = app.Gui.promptParent
		local column = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
		Kit.list(column, Enum.FillDirection.Vertical, 0)
		local name = Kit.text({
			Text = player.DisplayName,
			TextSize = 22,
			Color = if isMe then Color3.fromRGB(255, 236, 150) else Color3.new(1, 1, 1),
			Stroke = 3,
			Size = UDim2.new(1, 0, 0, 28),
			LayoutOrder = 1,
			Parent = column,
		})
		local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 2, Parent = column })
		Kit.list(row, Enum.FillDirection.Horizontal, 4)
		local coin = Kit.Icons.coin(20, row)
		coin.LayoutOrder = 1
		local amount = Kit.text({
			Text = "0",
			TextSize = 20,
			Color = Color3.fromRGB(255, 222, 92),
			Stroke = 3,
			StrokeColor = Color3.fromRGB(90, 56, 8),
			Size = UDim2.new(0, 0, 1, 0),
			AutoX = true,
			LayoutOrder = 2,
			Parent = row,
		})
		local function refresh()
			local coins = player:GetAttribute("Coins")
			amount.Text = Format.short(if type(coins) == "number" then coins else 0)
		end
		refresh()
		local nameStroke = name:FindFirstChildOfClass("UIStroke")
		local plate: Plate = {
			gui = gui,
			name = name,
			aura = nil,
			auraKind = nil,
			glow = nil,
			connections = { player:GetAttributeChangedSignal("Coins"):Connect(refresh) },
		}
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local function refreshVip()
			-- Operator (the game's creator, see Config.AdminUserIds) outranks VIP and borders.
			local operator = player:GetAttribute("Operator") == true
			local vip = player:GetAttribute("VIP") == true
			name.Text = (if operator then OPERATOR_BADGE elseif vip then VIP_CROWN else "") .. player.DisplayName
			if operator then
				TierStyle.apply(name, 0, OPERATOR_RED)
			else
				TierStyle.apply(name, tonumber(player:GetAttribute("Tier")) or 0, if isMe then Color3.fromRGB(255, 236, 150) else Color3.new(1, 1, 1))
			end
			local wantKind = if operator then "operator" elseif vip then "vip" else nil
			if wantKind ~= plate.auraKind then
				if plate.aura then
					plate.aura:Destroy()
					plate.aura = nil
				end
				if wantKind and root then
					plate.aura = if wantKind == "operator"
						then auraEmitter(root, Color3.fromRGB(255, 120, 120), OPERATOR_RED)
						else auraEmitter(root, Color3.fromRGB(255, 226, 130), Color3.fromRGB(255, 190, 40))
				end
				plate.auraKind = wantKind
			end
			if operator and not plate.glow then
				plate.glow = Kit.neon(name, OPERATOR_RED)
			elseif not operator and plate.glow then
				plate.glow:Destroy()
				plate.glow = nil
			end
			if nameStroke then
				local border = player:GetAttribute("Border")
				nameStroke.Color = if operator
					then OPERATOR_RED_DARK
					elseif border == "Gold" then Color3.fromRGB(255, 214, 90)
					elseif border == "Silver" then Color3.fromRGB(210, 220, 232)
					else INK
			end
		end
		refreshVip()
		table.insert(plate.connections, player:GetAttributeChangedSignal("Operator"):Connect(refreshVip))
		table.insert(plate.connections, player:GetAttributeChangedSignal("Tier"):Connect(refreshVip))
		table.insert(plate.connections, player:GetAttributeChangedSignal("VIP"):Connect(refreshVip))
		table.insert(plate.connections, player:GetAttributeChangedSignal("Border"):Connect(refreshVip))
		plates[player] = plate
	end

	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character)
			build(player, character)
		end)
		if player.Character then
			task.spawn(build, player, player.Character)
		end
	end

	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(remove)
end

return Nameplates
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Pets</string>
              <string name="Source"><![CDATA[--!strict
-- Renders equipped pets following every nearby player (from the replicated "Pets" attribute).

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Mutations = require(Shared.Models.Mutations)
local PetModels = require(Shared.Models.PetModels)

local Pets = {}

local localPlayer = Players.LocalPlayer

type PetView = { key: string, model: Model, cf: CFrame, phase: number }
type Owner = { player: Player, pets: { PetView }, raw: string }

local RENDER_DISTANCE = 260

function Pets.init(app: any)
	local folder = Instance.new("Folder")
	folder.Name = "Pets"
	folder.Parent = Workspace:WaitForChild("DeepDiveClient")
	local owners: { [Player]: Owner } = {}
	local templates: { [string]: Model } = {}

	-- `entry` is "species" or "species|Gold,Lava" (see Sessions.publishPets).
	local function template(entry: string): Model
		local model = templates[entry]
		if not model then
			local key, mutations = Mutations.parse(entry)
			local built = PetModels.build(key)
			Mutations.apply(built, mutations)
			templates[entry] = built
			return built:Clone()
		end
		return model:Clone()
	end

	local function clear(owner: Owner)
		for _, pet in owner.pets do
			pet.model:Destroy()
		end
		table.clear(owner.pets)
	end

	local function sync(player: Player)
		local raw = player:GetAttribute("Pets")
		local text = if type(raw) == "string" then raw else "[]"
		local owner = owners[player]
		if not owner then
			owner = { player = player, pets = {}, raw = "" }
			owners[player] = owner
		end
		if owner.raw == text then
			return
		end
		owner.raw = text
		clear(owner)
		local ok, keys = pcall(HttpService.JSONDecode, HttpService, text)
		if not ok or type(keys) ~= "table" then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local start = if root then root.CFrame else CFrame.new()
		for _, key in keys do
			if type(key) == "string" then
				local model = template(key)
				model.Parent = folder
				table.insert(owner.pets, { key = key, model = model, cf = start, phase = math.random() * 6.28 })
			end
		end
	end

	local function track(player: Player)
		sync(player)
		player:GetAttributeChangedSignal("Pets"):Connect(function()
			sync(player)
		end)
	end
	for _, player in Players:GetPlayers() do
		track(player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(function(player)
		local owner = owners[player]
		if owner then
			clear(owner)
			owners[player] = nil
		end
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		local camera = Workspace.CurrentCamera
		local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
		local hideOthers = app.State.settings().hidePets
		local t = os.clock()
		for player, owner in owners do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local visible = root ~= nil and (player == localPlayer or not hideOthers) and (root.Position - cameraPosition).Magnitude < RENDER_DISTANCE
			local count = #owner.pets
			for i, pet in owner.pets do
				if not visible or not root then
					if pet.model.Parent then
						pet.model.Parent = nil
					end
					continue
				end
				if not pet.model.Parent then
					pet.model.Parent = folder
					pet.cf = root.CFrame
				end
				-- Arc behind the owner; pets bob and face where the owner is heading.
				local look = root.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				flat = if flat.Magnitude > 0.05 then flat.Unit else Vector3.new(0, 0, -1)
				local basis = CFrame.lookAt(root.Position, root.Position + flat)
				local spread = (i - (count + 1) / 2) * 1.0
				local offset = Vector3.new(math.sin(spread) * 5, 1.6 + math.sin(t * 2.4 + pet.phase) * 0.45, math.cos(spread) * 4.5 + 1.5)
				local targetPosition = basis:PointToWorldSpace(offset)
				local position = pet.cf.Position:Lerp(targetPosition, 1 - math.exp(-7 * dt))
				local velocity = targetPosition - pet.cf.Position
				local flatVelocity = Vector3.new(velocity.X, 0, velocity.Z)
				local faceDirection = if flatVelocity.Magnitude > 1.5 then flatVelocity.Unit else flat
				local target = CFrame.lookAt(position, position + faceDirection)
					* CFrame.Angles(math.sin(t * 3 + pet.phase) * 0.08, 0, math.sin(t * 2 + pet.phase) * 0.1)
				pet.cf = pet.cf:Lerp(target, 1 - math.exp(-10 * dt))
				pet.cf = CFrame.new(position) * pet.cf.Rotation
				pet.model:PivotTo(pet.cf)
			end
		end
	end)
end

return Pets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Prompts</string>
              <string name="Source"><![CDATA[--!strict
-- Custom ProximityPrompt UI in the game's rounded style, with touch support, routing each
-- prompt kind to its panel.

local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Prompts = {}

local KIND_TEXT =
	{ Egg = "prompt.egg", Kiosk = "prompt.upgrades", Portal = "prompt.portal", Sell = "sellAction", Enchant = "enchant", GodShark = "prompt.buy" }
local KIND_PALETTE = { Egg = "Purple", Kiosk = "Orange", Portal = "Blue", Sell = "Gold", Enchant = "Purple", GodShark = "Cyan" }

function Prompts.init(app: any)
	local Kit = app.Kit
	local Theme = app.Theme
	local shown: { [ProximityPrompt]: BillboardGui } = {}

	local function objectText(prompt: ProximityPrompt): string
		local kind = prompt:GetAttribute("Kind")
		local world = prompt:GetAttribute("World")
		if kind == "Egg" and type(world) == "number" then
			return Strings.name(Worlds.get(world).egg.name)
		elseif kind == "Kiosk" then
			return Strings.get("menu.upgrades")
		elseif kind == "Portal" then
			return Strings.get("menu.worlds")
		elseif kind == "Sell" then
			return Strings.get("sellShop")
		elseif kind == "Enchant" then
			return Strings.get("enchantAltar")
		elseif kind == "GodShark" then
			return Strings.get("product.GodShark")
		end
		return prompt.ObjectText
	end

	ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom or shown[prompt] then
			return
		end
		local kind = prompt:GetAttribute("Kind")
		local palette = Theme.Buttons[KIND_PALETTE[kind] or "Blue"]
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "DeepDivePrompt"
		billboard.AlwaysOnTop = true
		billboard.Size = UDim2.fromOffset(300, 78)
		billboard.StudsOffset = Vector3.new(0, 1, 0)
		billboard.LightInfluence = 0
		billboard.Active = true
		billboard.Adornee = prompt.Parent :: Instance
		billboard.Parent = app.Gui.promptParent

		local pill = Kit.new(
			"TextButton",
			{ Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), Parent = billboard }
		)
		Kit.round(pill)
		Kit.gradient(pill, palette[1], palette[2])
		Kit.stroke(pill, palette[3], 4)
		local key = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.fromOffset(58, 58),
			Position = UDim2.new(0, 10, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Parent = pill,
		})
		Kit.round(key)
		Kit.stroke(key, palette[3], 3)
		local keyText = if inputType == Enum.ProximityPromptInputType.Touch
			then utf8.char(0x1F446)
			elseif inputType == Enum.ProximityPromptInputType.Gamepad then "X"
			else UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
		Kit.text({ Text = keyText, TextSize = 32, Color = palette[3], Stroke = 0, Size = UDim2.fromScale(1, 1), Parent = key })
		Kit.text({
			Text = Strings.get(KIND_TEXT[kind] or "prompt.egg"),
			TextSize = 30,
			Size = UDim2.new(1, -86, 0, 34),
			Position = UDim2.fromOffset(78, 6),
			XAlign = Enum.TextXAlignment.Left,
			StrokeColor = palette[3],
			Parent = pill,
		})
		Kit.text({
			Text = objectText(prompt),
			TextSize = 20,
			Color = Color3.fromRGB(235, 245, 255),
			Size = UDim2.new(1, -86, 0, 26),
			Position = UDim2.fromOffset(78, 42),
			XAlign = Enum.TextXAlignment.Left,
			StrokeColor = palette[3],
			Parent = pill,
		})
		app.Anim.appear(pill, 0.3)
		pill.Activated:Connect(function()
			prompt:InputHoldBegin()
			task.wait()
			prompt:InputHoldEnd()
		end)
		shown[prompt] = billboard
	end)

	ProximityPromptService.PromptHidden:Connect(function(prompt: ProximityPrompt)
		local billboard = shown[prompt]
		if billboard then
			shown[prompt] = nil
			billboard:Destroy()
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
		local kind = prompt:GetAttribute("Kind")
		local world = prompt:GetAttribute("World")
		app.Sfx.play("Click")
		if kind == "Egg" and type(world) == "number" then
			app.openEgg(world)
		elseif kind == "Kiosk" then
			app.openUpgrades()
		elseif kind == "Portal" then
			app.openWorlds()
		elseif kind == "Sell" then
			app.sell()
		elseif kind == "Enchant" then
			app.openPets()
		elseif kind == "GodShark" then
			app.buyGodShark()
		end
	end)
end

return Prompts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Relics</string>
              <string name="Source"><![CDATA[--!strict
-- Renders this player's relic layout (per-player treasure), the Ancient Chest with its light
-- beam, and handles magnet pickups (optimistic, rolled back if the server rejects).

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local RelicModels = require(Shared.Models.RelicModels)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Relics = {}

local player = Players.LocalPlayer

type Entry = {
	point: number,
	key: string,
	model: Model,
	aura: BasePart,
	auraSize: number,
	base: Vector3,
	phase: number,
	collecting: boolean,
	started: number,
}

local RARITY_LIGHT = { 7, 9, 11, 14, 18 }
local RARITY_AURA = { 2.0, 2.4, 2.9, 3.5, 4.3 } -- glow bubble diameter in studs, by rarity

function Relics.init(app: any)
	local folder = Instance.new("Folder")
	folder.Name = "Relics"
	folder.Parent = Workspace:WaitForChild("DeepDiveClient")

	local entries: { [number]: Entry } = {}
	local pending: { [number]: Entry } = {}
	local points: { Vector3 } = {}
	local chestPosition: Vector3? = nil
	local chest: Model? = nil
	local layoutId = 0
	local lastFullToast = 0
	local templates: { [string]: Model } = {}

	local function worldFolder(world: number): Instance?
		local worlds = Workspace:FindFirstChild("Worlds")
		return worlds and worlds:FindFirstChild("World" .. world)
	end

	local function loadPoints(world: number): boolean
		local wf = worldFolder(world)
		if not wf then
			return false
		end
		local raw = wf:GetAttribute("Points")
		local rawChest = wf:GetAttribute("Chest")
		if type(raw) ~= "string" then
			return false
		end
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if not ok or type(decoded) ~= "table" then
			return false
		end
		points = {}
		for i, p in decoded do
			points[i] = Vector3.new(p[1], p[2], p[3])
		end
		chestPosition = nil
		if type(rawChest) == "string" then
			local okChest, c = pcall(HttpService.JSONDecode, HttpService, rawChest)
			if okChest and type(c) == "table" then
				chestPosition = Vector3.new(c[1], c[2], c[3])
			end
		end
		return true
	end

	local function template(key: string): Model
		local existing = templates[key]
		if existing then
			return existing:Clone()
		end
		do
			local model = RelicModels.build(key)
			local relic = Worlds.relics[key]
			local root = model.PrimaryPart :: BasePart
			local color = Color.hex(relic.accent):Lerp(app.Theme.rarityColor(relic.rarity), 0.5)
			local light = Instance.new("PointLight")
			light.Color = color
			light.Range = RARITY_LIGHT[relic.rarity] or 8
			light.Brightness = 0.9 + relic.rarity * 0.35
			light.Shadows = false
			light.Parent = root
			if relic.rarity >= 3 then
				local sparkle = Instance.new("ParticleEmitter")
				sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
				sparkle.Color = ColorSequence.new(app.Theme.rarityColor(relic.rarity))
				sparkle.LightEmission = 1
				sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
				sparkle.Lifetime = NumberRange.new(0.6, 1.2)
				sparkle.Rate = relic.rarity * 2
				sparkle.Speed = NumberRange.new(0.5, 1.5)
				sparkle.SpreadAngle = Vector2.new(180, 180)
				sparkle.Parent = root
			end
			-- Bold black cartoon outline on every relic (legendaries also glow gold).
			local highlight = Instance.new("Highlight")
			highlight.OutlineColor = Color3.new(0, 0, 0)
			highlight.OutlineTransparency = 0
			highlight.FillColor = app.Theme.rarityColor(5)
			highlight.FillTransparency = if relic.rarity >= 5 then 0.75 else 1
			highlight.DepthMode = Enum.HighlightDepthMode.Occluded
			highlight.Parent = model
			-- Soft glowing aura bubble so relics read from a distance, not just up close.
			local auraColor = app.Theme.rarityColor(relic.rarity)
			local aura = Instance.new("Part")
			aura.Name = "Aura"
			aura.Shape = Enum.PartType.Ball
			aura.Material = Enum.Material.Neon
			aura.Color = auraColor
			aura.Transparency = 0.6
			aura.Anchored = true
			aura.CanCollide = false
			aura.CanQuery = false
			aura.CanTouch = false
			aura.CastShadow = false
			local size = RARITY_AURA[relic.rarity] or 2
			aura.Size = Vector3.new(size, size, size)
			aura.CFrame = root.CFrame
			aura.Parent = model
			templates[key] = model
			return model:Clone()
		end
	end

	local function clearAll()
		for _, entry in entries do
			entry.model:Destroy()
		end
		table.clear(entries)
		for _, entry in pending do
			entry.model:Destroy()
		end
		table.clear(pending)
		if chest then
			chest:Destroy()
			chest = nil
		end
	end

	local function spawnRelic(point: number, key: string)
		local base = points[point]
		if not base then
			return
		end
		local model = template(key)
		model:PivotTo(CFrame.new(base))
		model.Parent = folder
		local relic = Worlds.relics[key]
		local aura = model:FindFirstChild("Aura") :: BasePart
		entries[point] = {
			point = point,
			key = key,
			model = model,
			aura = aura,
			auraSize = RARITY_AURA[relic.rarity] or 2,
			base = base,
			phase = math.random() * 6.28,
			collecting = false,
			started = 0,
		}
	end

	-- A collected point refilled with a fresh relic (DiveService's respawn timer).
	function Relics.spawn(point: number, key: string)
		if not entries[point] and not pending[point] then
			spawnRelic(point, key)
		end
	end

	local function spawnChest(world: number)
		if not chestPosition then
			return
		end
		local model = RelicModels.buildChest(world, 4.2)
		model:PivotTo(CFrame.new(chestPosition + Vector3.new(0, 1, 0)))
		local outline = Instance.new("Highlight")
		outline.OutlineColor = Color3.new(0, 0, 0)
		outline.FillColor = Color3.fromRGB(255, 214, 90)
		outline.FillTransparency = 0.85
		outline.DepthMode = Enum.HighlightDepthMode.Occluded
		outline.Parent = model
		model.Parent = folder
		local root = model.PrimaryPart :: BasePart
		local top = Instance.new("Attachment")
		top.Position = Vector3.new(0, Config.SurfaceY - chestPosition.Y + 6, 0)
		top.Parent = root
		local bottom = Instance.new("Attachment")
		bottom.Parent = root
		local beam = Instance.new("Beam")
		beam.Attachment0 = bottom
		beam.Attachment1 = top
		beam.Width0 = 5
		beam.Width1 = 3
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120))
		beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.85) })
		beam.Parent = root
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromOffset(240, 60)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
		billboard.AlwaysOnTop = true
		billboard.LightInfluence = 0
		billboard.MaxDistance = 400
		billboard.Parent = root
		app.Kit.text({
			Text = Strings.get("chest"),
			TextSize = 30,
			Color = Color3.fromRGB(255, 230, 120),
			Stroke = 3,
			Size = UDim2.fromScale(1, 1),
			Parent = billboard,
		})
		chest = model
	end

	local function rebuild()
		clearAll()
		local layout = app.State.layout
		layoutId = layout.id
		if not loadPoints(layout.world) then
			-- The world may still be streaming its attributes in; retry shortly.
			task.delay(1, function()
				if app.State.layout.id == layoutId then
					rebuild()
				end
			end)
			return
		end
		for point, key in layout.relics do
			spawnRelic(point, key)
		end
		if layout.chest and not app.State.dive.chestCarried then
			spawnChest(layout.world)
		end
	end
	app.State.layoutChanged:Connect(rebuild)

	function Relics.restore(point: number)
		local entry = pending[point]
		if entry then
			pending[point] = nil
			entry.collecting = false
			entry.model.Parent = folder
			entry.model:PivotTo(CFrame.new(entry.base))
			entries[point] = entry
		elseif point == 0 and not chest and app.State.layout.chest then
			spawnChest(app.State.layout.world)
		end
	end

	function Relics.confirm(point: number)
		local entry = pending[point]
		if entry then
			pending[point] = nil
			entry.model:Destroy()
		end
	end

	function Relics.nearest(): Vector3?
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return nil
		end
		local best, bestDistance = nil, math.huge
		for _, entry in entries do
			local d = (entry.base - root.Position).Magnitude
			if d < bestDistance then
				best, bestDistance = entry.base, d
			end
		end
		return best
	end

	local function collect(entry: Entry)
		entry.collecting = true
		entry.started = os.clock()
		entries[entry.point] = nil
		pending[entry.point] = entry
		local relic = Worlds.relics[entry.key]
		app.Sfx.play(if relic.rarity >= 3 then "CollectRare" else "Collect")
		local color = app.Theme.rarityColor(relic.rarity)
		app.WorldFx.burst(entry.base, color, 14 + relic.rarity * 6, 0.7 + relic.rarity * 0.12)
		app.WorldFx.ring(entry.base, color, 4 + relic.rarity, 0.45)
		app.Effects.floatText("+1 " .. Strings.name(relic.name), app.Theme.rarityColor(relic.rarity), UDim2.fromScale(0.5, 0.42), 28)
		app.Net.collect(layoutId, entry.point)
	end

	RunService.RenderStepped:Connect(function(dt: number)
		local t = os.clock()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local rootPosition = root and root.Position
		local dive = app.State.dive
		local magnet = app.State.upgrade("magnet")
		local capacity = app.State.capacity()
		local canCollect = rootPosition ~= nil and dive.inWater and not dive.blackout and not app.State.traveling
		local pendingCount = 0
		for _ in pending do
			pendingCount += 1
		end
		for _, entry in entries do
			local bob = math.sin(t * 2 + entry.phase) * 0.35
			entry.model:PivotTo(
				CFrame.new(entry.base + Vector3.new(0, bob, 0)) * CFrame.Angles(0.25 * math.sin(t + entry.phase), t * 0.9 + entry.phase, 0)
			)
			if entry.aura then
				local pulse = 0.5 + 0.5 * math.sin(t * 2.4 + entry.phase)
				entry.aura.Transparency = 0.55 + 0.25 * pulse
				local scale = entry.auraSize * (0.88 + 0.16 * pulse)
				entry.aura.Size = Vector3.new(scale, scale, scale)
			end
			if canCollect and rootPosition and (rootPosition - entry.base).Magnitude <= magnet then
				if dive.cargo + pendingCount >= capacity then
					if t - lastFullToast > 3 then
						lastFullToast = t
						app.Toasts.show(Strings.get("backpackFull"), "bad", utf8.char(0x1F392))
						app.Hud.flashFull()
						app.Sfx.play("Error")
					end
				else
					pendingCount += 1
					collect(entry)
				end
			end
		end
		-- Pull collected relics into the diver while the server confirms.
		for point, entry in pending do
			if rootPosition then
				local age = t - entry.started
				local alpha = math.clamp(age / 0.25, 0, 1)
				local position = entry.base:Lerp(rootPosition, alpha * alpha)
				entry.model:PivotTo(CFrame.new(position) * CFrame.Angles(0, t * 8, 0))
				if age > 0.25 then
					entry.model.Parent = nil
				end
				if age > 4 then
					-- No answer from the server: give up on the optimistic pickup.
					pending[point] = nil
					entry.model:Destroy()
				end
			end
		end
		if chest and canCollect and rootPosition and chestPosition and (rootPosition - chestPosition).Magnitude <= magnet + 3 then
			chest:Destroy()
			chest = nil
			app.Net.collect(layoutId, 0)
		end
		local _ = dt
	end)
end

return Relics
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">Statues</string>
              <string name="Source"><![CDATA[--!strict
-- Podium statues at the docks (built by StatueService): shows the statues of the board picked on
-- the dock board (each podium carries one per board), with rank and names on the podium front and
-- each diver's progress to their next ranking tier above them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Strings = require(Shared.Strings)

local TierStyle = require(script.Parent.Parent.UI.TierStyle)
local Board = require(script.Parent.Board)

local Statues = {}

local MEDALS = { utf8.char(0x1F947), utf8.char(0x1F948), utf8.char(0x1F949) }

function Statues.init(app: any)
	local Kit = app.Kit
	local signatures: { [BasePart]: string } = {}

	-- Board podiums keep one set of labels per board ("weekly_Display"); the Director's are plain.
	local function prefix(part: BasePart): string
		return if part:GetAttribute("Rank") == 0 then "" else Board.selected .. "_"
	end

	-- Only the picked board's statue on each podium is drawn (locally; the server keeps all three).
	local function showPicked(part: BasePart)
		for _, child in part:GetChildren() do
			local key = child:GetAttribute("Board")
			if child:IsA("Model") and type(key) == "string" and key ~= "director" then
				local hidden = if key == Board.selected then 0 else 1
				for _, d in child:GetDescendants() do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = hidden
					elseif d:IsA("Decal") then
						d.LocalTransparencyModifier = hidden
					end
				end
			end
		end
	end

	local function signature(part: BasePart): string
		return table.concat({
			prefix(part),
			tostring(part:GetAttribute(prefix(part) .. "UserId")),
			tostring(part:GetAttribute(prefix(part) .. "Display")),
			tostring(part:GetAttribute(prefix(part) .. "Username")),
			tostring(part:GetAttribute(prefix(part) .. "NextTier")),
			tostring(part:GetAttribute(prefix(part) .. "NextSeconds")),
			Strings.get("director"),
			Strings.get("tierMax"),
		}, "|")
	end

	local function render(part: BasePart)
		for _, old in part:GetChildren() do
			if old.Name == "StatueFront" or old.Name == "StatueTitle" then
				old:Destroy()
			end
		end
		local rank = part:GetAttribute("Rank")
		local director = rank == 0
		local key = prefix(part)
		local userId = part:GetAttribute(key .. "UserId")
		if not userId then
			return
		end
		local display = tostring(part:GetAttribute(key .. "Display") or "")
		local username = tostring(part:GetAttribute(key .. "Username") or "")

		local front = Instance.new("SurfaceGui")
		front.Name = "StatueFront"
		front.Face = Enum.NormalId.Front
		front.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		front.PixelsPerStud = 40
		front.LightInfluence = 0
		front.Parent = part
		local column = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = front })
		Kit.list(column, Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		local head = Kit.text({
			Text = if director then Strings.get("director") else (MEDALS[rank :: number] or ""),
			TextSize = if director then 30 else 34,
			Stroke = if director then 3 else 0,
			Size = UDim2.new(1, 0, 0, 38),
			LayoutOrder = 1,
			Parent = column,
		})
		if director then
			TierStyle.director(head)
		end
		local name = Kit.text({
			Text = display,
			TextSize = 26,
			Stroke = 3,
			Size = UDim2.new(1, -8, 0, 30),
			LayoutOrder = 2,
			Parent = column,
		})
		name.TextTruncate = Enum.TextTruncate.AtEnd
		local user = Kit.text({
			Text = "@" .. username,
			TextSize = 18,
			Color = Color3.fromRGB(225, 236, 248),
			Stroke = 2,
			Size = UDim2.new(1, -8, 0, 22),
			LayoutOrder = 3,
			Parent = column,
		})
		user.TextTruncate = Enum.TextTruncate.AtEnd

		-- Tier countdowns matter on the weekly and monthly boards only (they are what earn tiers).
		if not director and Board.selected == "alltime" then
			return
		end
		local title = Instance.new("BillboardGui")
		title.Name = "StatueTitle"
		title.Size = UDim2.fromOffset(260, 40)
		title.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 + (if director then 16 else 11), 0)
		title.LightInfluence = 0
		title.MaxDistance = 120
		title.Parent = part
		local nextTier = part:GetAttribute(key .. "NextTier")
		local seconds = part:GetAttribute(key .. "NextSeconds")
		local text = if director
			then Strings.get("director")
			elseif type(nextTier) == "number" and type(seconds) == "number" then Strings.get(
				"tierNext",
				{ n = nextTier, t = Strings.duration(seconds) }
			)
			else Strings.get("tierMax")
		local line = Kit.text({
			Text = text,
			TextSize = 22,
			Color = Color3.fromRGB(255, 236, 140),
			Stroke = 2.5,
			Size = UDim2.fromScale(1, 1),
			Parent = title,
		})
		if director then
			TierStyle.director(line)
		elseif type(nextTier) == "number" then
			local color = TierStyle.color(nextTier)
			if color then
				line.TextColor3 = color
			end
		end
	end

	-- Every world's podiums (not just the current one): labels drawn while visiting another world
	-- must follow language changes too.
	local function refresh()
		local worlds = Workspace:FindFirstChild("Worlds")
		if not worlds then
			return
		end
		for _, folder in worlds:GetChildren() do
			local statues = folder:FindFirstChild("Statues")
			if statues then
				for _, part in statues:GetChildren() do
					if part:IsA("BasePart") and part:GetAttribute("Rank") ~= nil then
						showPicked(part)
						local sig = signature(part)
						if signatures[part] ~= sig or not part:FindFirstChild("StatueFront") then
							signatures[part] = sig
							render(part)
						end
					end
				end
			end
		end
	end

	task.spawn(function()
		while true do
			refresh()
			task.wait(1)
		end
	end)
	app.State.languageChanged:Connect(refresh)
	Board.selectionChanged:Connect(refresh)
end

return Statues
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Swim</string>
              <string name="Source"><![CDATA[--!strict
-- Custom swimming. The client owns its character, so velocity is driven locally for instant
-- response while the server only reads the position. Push forward to swim where the camera
-- looks (small pitch still swims level), Space rises, C/Ctrl/Q sinks, Shift dashes. Hold Space
-- at the surface to leap out; swim onto the beach to walk out.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)

local Swim = {}

local player = Players.LocalPlayer

-- Roblox's default R15 swim animations.
local SWIM_ANIMATION = "rbxassetid://507784897"
local SWIM_IDLE_ANIMATION = "rbxassetid://507785072"

local DISABLED_WHILE_SWIMMING = {
	Enum.HumanoidStateType.Jumping,
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.GettingUp,
	Enum.HumanoidStateType.Climbing,
	Enum.HumanoidStateType.Freefall,
	Enum.HumanoidStateType.Running,
}

Swim.active = false
local inputs = { up = false, down = false, dash = false }
local dashQueued = false

function Swim.setInput(key: string, pressed: boolean)
	if key == "dash" then
		if pressed and not inputs.dash then
			dashQueued = true
		end
		inputs.dash = pressed
	elseif key == "up" or key == "down" then
		(inputs :: any)[key] = pressed
	end
end

local function lerpAngle(a: number, b: number, t: number): number
	local diff = (b - a + math.pi) % (math.pi * 2) - math.pi
	return a + diff * t
end

function Swim.init(app: any)
	local character: Model? = nil
	local humanoid: Humanoid? = nil
	local root: BasePart? = nil
	local head: BasePart? = nil
	local attachment: Attachment? = nil
	local linear: LinearVelocity? = nil
	local align: AlignOrientation? = nil
	local bubbles: ParticleEmitter? = nil
	local tracks: { [string]: AnimationTrack } = {}
	local controls: any = nil
	local velocity = Vector3.zero
	local yaw, pitch = 0, 0
	local dashUntil, dashReadyAt = 0, 0
	local reenterAt = 0
	local surfaceHold = 0
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater = true

	-- Resolved once off the render loop so Heartbeat never yields waiting for the PlayerModule.
	task.spawn(function()
		local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 30)
		if module and module:IsA("ModuleScript") then
			local ok, result = pcall(function()
				return (require :: any)(module):GetControls()
			end)
			if ok then
				controls = result
			end
		end
	end)

	local function floorDistance(position: Vector3, maxDistance: number): number?
		local exclude: { Instance } = {}
		if character then
			table.insert(exclude, character)
		end
		local clientFolder = Workspace:FindFirstChild("DeepDiveClient")
		if clientFolder then
			table.insert(exclude, clientFolder)
		end
		rayParams.FilterDescendantsInstances = exclude
		local hit = Workspace:Raycast(position, Vector3.new(0, -maxDistance, 0), rayParams)
		return if hit then position.Y - hit.Position.Y else nil
	end

	local function bind()
		local function handler(name: string)
			return function(_, state: Enum.UserInputState)
				local pressed = state == Enum.UserInputState.Begin
				if state == Enum.UserInputState.Begin or state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
					Swim.setInput(name, pressed)
				end
				return Enum.ContextActionResult.Sink
			end
		end
		ContextActionService:BindActionAtPriority(
			"DeepDiveDown",
			handler("down"),
			false,
			Enum.ContextActionPriority.High.Value,
			Enum.KeyCode.C,
			Enum.KeyCode.LeftControl,
			Enum.KeyCode.Q,
			Enum.KeyCode.ButtonL2
		)
		ContextActionService:BindActionAtPriority(
			"DeepDiveDash",
			handler("dash"),
			false,
			Enum.ContextActionPriority.High.Value,
			Enum.KeyCode.LeftShift,
			Enum.KeyCode.ButtonR2
		)
	end

	local function unbind()
		ContextActionService:UnbindAction("DeepDiveDown")
		ContextActionService:UnbindAction("DeepDiveDash")
		inputs.down, inputs.dash, inputs.up = false, false, false
	end

	local function playTrack(name: string, speed: number)
		for key, track in tracks do
			if key == name then
				if not track.IsPlaying then
					track:Play(0.25)
				end
				track:AdjustSpeed(speed)
			elseif track.IsPlaying then
				track:Stop(0.25)
			end
		end
	end

	local function splash(position: Vector3, big: boolean)
		app.Sfx.play(if big then "Splash" else "SplashSmall")
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.new(1, 1, 1)
		part.Position = Vector3.new(position.X, Config.SurfaceY + 0.3, position.Z)
		part.Parent = Workspace
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(230, 250, 255))
		emitter.LightEmission = 0.5
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0.1) })
		emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		emitter.Lifetime = NumberRange.new(0.5, 0.9)
		emitter.Speed = NumberRange.new(10, 18)
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Acceleration = Vector3.new(0, -60, 0)
		emitter.EmissionDirection = Enum.NormalId.Top
		emitter.Rate = 0
		emitter.Parent = part
		emitter:Emit(if big then 40 else 18)
		app.WorldFx.ring(Vector3.new(position.X, Config.SurfaceY + 0.15, position.Z), Color3.fromRGB(230, 250, 255), if big then 8 else 4.5, 0.7)
		task.delay(1.5, function()
			part:Destroy()
		end)
	end

	local function disable(standUp: boolean?)
		if not Swim.active then
			return
		end
		Swim.active = false
		unbind()
		for _, instance in { linear, align, attachment } :: { Instance? } do
			if instance then
				instance:Destroy()
			end
		end
		linear, align, attachment = nil, nil, nil
		for _, track in tracks do
			track:Stop(0.2)
		end
		if bubbles then
			bubbles.Enabled = false
		end
		app.Sfx.setSwimming(false)
		local h = humanoid
		if h then
			h.PlatformStand = false
			for _, stateType in DISABLED_WHILE_SWIMMING do
				h:SetStateEnabled(stateType, true)
			end
			if standUp then
				h:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end
		app.State.dive.swimming = false
	end

	local function enable()
		local h, r = humanoid, root
		if Swim.active or not h or not r or h.Health <= 0 or h.SeatPart then
			return
		end
		Swim.active = true
		for _, stateType in DISABLED_WHILE_SWIMMING do
			h:SetStateEnabled(stateType, false)
		end
		h.PlatformStand = true
		local a = Instance.new("Attachment")
		a.Name = "SwimAttachment"
		a.Parent = r
		local lv = Instance.new("LinearVelocity")
		lv.Name = "SwimVelocity"
		lv.Attachment0 = a
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.ForceLimitMode = Enum.ForceLimitMode.Magnitude
		lv.MaxForce = 80000
		lv.VectorVelocity = Vector3.zero
		lv.Parent = r
		local ao = Instance.new("AlignOrientation")
		ao.Name = "SwimOrientation"
		ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
		ao.Attachment0 = a
		ao.MaxTorque = 1e6
		ao.Responsiveness = 16
		ao.Parent = r
		attachment, linear, align = a, lv, ao
		velocity = r.AssemblyLinearVelocity * Vector3.new(0.5, 0.35, 0.5)
		local _, currentYaw = r.CFrame:ToEulerAnglesYXZ()
		yaw = currentYaw
		pitch = 0
		ao.CFrame = CFrame.Angles(0, yaw, 0)
		if r.AssemblyLinearVelocity.Y < -10 then
			splash(r.Position, r.AssemblyLinearVelocity.Y < -30)
		end
		if bubbles then
			bubbles.Enabled = true
		end
		bind()
		app.State.dive.swimming = true
	end

	local function onCharacter(newCharacter: Model)
		disable()
		character = newCharacter
		humanoid = newCharacter:WaitForChild("Humanoid", 10) :: Humanoid?
		root = newCharacter:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		head = newCharacter:WaitForChild("Head", 10) :: BasePart?
		table.clear(tracks)
		local h = humanoid
		if not h then
			return
		end
		-- Native swimming never runs: this controller owns all water movement.
		h:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
		local animator = h:FindFirstChildOfClass("Animator") or h:WaitForChild("Animator", 5)
		if animator and animator:IsA("Animator") and h.RigType == Enum.HumanoidRigType.R15 then
			local animations: { [string]: string } = { swim = SWIM_ANIMATION, idle = SWIM_IDLE_ANIMATION }
			for key, id in animations do
				local animation = Instance.new("Animation")
				animation.AnimationId = id
				local ok, track = pcall(function()
					return animator:LoadAnimation(animation)
				end)
				if ok and track then
					track.Priority = Enum.AnimationPriority.Action
					track.Looped = true
					tracks[key] = track
				end
			end
		end
		if head then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "DiveBubbles"
			emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			emitter.Color = ColorSequence.new(Color3.fromRGB(210, 245, 255))
			emitter.LightEmission = 0.4
			emitter.LightInfluence = 0.3
			emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0.42) })
			emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
			emitter.Lifetime = NumberRange.new(1.2, 2)
			emitter.Rate = 5
			emitter.Speed = NumberRange.new(3, 6)
			emitter.SpreadAngle = Vector2.new(15, 15)
			emitter.Acceleration = Vector3.new(0, 8, 0)
			emitter.EmissionDirection = Enum.NormalId.Top
			emitter.Enabled = false
			emitter.Parent = head
			bubbles = emitter
		end
		h.Died:Connect(function()
			disable()
		end)
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end

	RunService.Heartbeat:Connect(function(dt: number)
		local r, h = root, humanoid
		local dive = app.State.dive
		if not r or not h or not r.Parent or h.Health <= 0 then
			dive.inWater = false
			dive.depth = 0
			return
		end
		local world = app.State.world
		local position = r.Position
		local depth = Config.SurfaceY - position.Y
		local over = Layout.overLagoon(world, position)
		dive.depth = if over then math.max(0, depth) else 0
		dive.inWater = over and depth > 0.4
		local now = os.clock()

		if not Swim.active then
			if over and now >= reenterAt then
				local falling = r.AssemblyLinearVelocity.Y < -12
				if depth >= Config.Swim.EnterDepth or (depth > 0.8 and falling) then
					enable()
				end
			end
			return
		end

		-- Exit: out of the lagoon, above the water, or floating over ground shallow enough to stand.
		if not over or depth < 0.3 then
			disable(false)
			return
		end
		if depth < Config.Swim.ExitDepth and not dive.blackout then
			local floor = floorDistance(position, 5)
			if floor and floor < 3.1 then
				disable(true)
				return
			end
		end

		local move = Vector3.zero
		local blocked = app.isUiBlocking() or dive.blackout or app.State.traveling
		if controls and not blocked then
			move = controls:GetMoveVector()
		end
		local camera = Workspace.CurrentCamera
		local look = camera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		flat = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.new(0, 0, -1)
		local rightVector = camera.CFrame.RightVector
		local right = Vector3.new(rightVector.X, 0, rightVector.Z)
		right = if right.Magnitude > 1e-3 then right.Unit else Vector3.new(1, 0, 0)
		-- Camera pitch inside the deadzone swims level; beyond it the swim direction tilts.
		local camPitch = math.asin(math.clamp(look.Y, -1, 1))
		local deadzone = math.rad(Config.Swim.PitchDeadzone)
		local effective = 0
		if math.abs(camPitch) > deadzone then
			effective = math.sign(camPitch) * (math.abs(camPitch) - deadzone) / (math.pi / 2 - deadzone) * (math.pi / 2)
		end
		local forward = flat * math.cos(effective) + Vector3.yAxis * math.sin(effective)
		local dir = forward * -move.Z + right * move.X
		local vertical = 0
		local wantsUp = not blocked and (h.Jump or inputs.up)
		if wantsUp then
			vertical += 1
		end
		if inputs.down and not blocked then
			vertical -= 1
		end
		dir += Vector3.yAxis * vertical * Config.Swim.VerticalFactor
		if dir.Magnitude > 1 then
			dir = dir.Unit
		end

		local speed = app.State.swimSpeed()
		if dashQueued then
			dashQueued = false
			if now >= dashReadyAt and not blocked then
				dashUntil = now + Config.Swim.DashSeconds
				dashReadyAt = now + Config.Swim.DashCooldown
				app.Sfx.play("Dash")
				if bubbles then
					bubbles:Emit(14)
				end
			end
		end
		local dashing = now < dashUntil
		local target = dir * speed * (if dashing then Config.Swim.DashMultiplier else 1)
		if dashing and dir.Magnitude < 0.1 then
			target = r.CFrame.LookVector * speed * Config.Swim.DashMultiplier
		end
		if dive.blackout then
			target = Vector3.new(0, 1.5, 0)
		end

		-- Surface: float with the head above water; hold jump there to leap out.
		local floatY = Config.SurfaceY - Config.Swim.FloatOffset
		local atSurface = position.Y >= floatY - 0.35
		if atSurface and target.Y > 0 then
			target = Vector3.new(target.X, 0, target.Z)
		end
		if position.Y > floatY then
			target = Vector3.new(target.X, math.min(target.Y, (floatY - position.Y) * 6), target.Z)
		elseif vertical == 0 and move.Magnitude < 0.1 and depth < 4.5 then
			target += Vector3.new(0, 3, 0)
		end
		if atSurface and wantsUp then
			surfaceHold += dt
			if surfaceHold > 0.22 then
				surfaceHold = 0
				reenterAt = now + 0.7
				local carry = velocity * Vector3.new(0.7, 0, 0.7)
				disable(false)
				r.AssemblyLinearVelocity = carry + Vector3.new(0, Config.Swim.SurfaceJumpPower, 0)
				h:ChangeState(Enum.HumanoidStateType.Freefall)
				splash(position, false)
				return
			end
		else
			surfaceHold = 0
		end

		-- Keep inside the terraced lagoon walls (the beach inlet is open).
		local origin = Layout.origin(world)
		local offset = Vector3.new(position.X - origin.X, 0, position.Z - origin.Z)
		local info = Layout.info(world)
		local inInlet = math.abs(offset.X) <= 21 and offset.Z >= info.radius - 4
		local maxRadius = Layout.radiusAtDepth(world, depth)
		if not inInlet and offset.Magnitude > maxRadius then
			local outward = offset.Unit
			local outSpeed = target:Dot(outward)
			if outSpeed > 0 then
				target -= outward * outSpeed
			end
			target -= outward * math.min(12, (offset.Magnitude - maxRadius) * 4)
		end
		-- Do not grind into the floor.
		if target.Y < 0 then
			local floor = floorDistance(position, 3.5)
			if floor and floor < 3 then
				target = Vector3.new(target.X, math.max(0, (3 - floor) * 4), target.Z)
			end
		end

		local rate = if dashing then Config.Swim.DashAccel else Config.Swim.Accel
		velocity = velocity:Lerp(target, 1 - math.exp(-rate * dt))
		if linear then
			linear.VectorVelocity = velocity
		end

		-- Body: face the swim direction and lie flat while moving.
		local total = velocity.Magnitude
		local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		if horizontal > 1.5 then
			yaw = lerpAngle(yaw, math.atan2(-velocity.X, -velocity.Z), math.clamp(dt * 7, 0, 1))
		elseif move.Magnitude > 0.1 then
			yaw = lerpAngle(yaw, math.atan2(-flat.X, -flat.Z), math.clamp(dt * 5, 0, 1))
		end
		local blend = math.clamp((total - 2) / 8, 0, 1)
		local elevation = if total > 0.5 then math.asin(math.clamp(velocity.Y / total, -1, 1)) else 0
		local pitchTarget = math.clamp((-math.pi / 2 + elevation) * blend, -math.rad(160), 0)
		if atSurface and horizontal < 6 then
			pitchTarget *= 0.35
		end
		pitch += (pitchTarget - pitch) * math.clamp(dt * 6, 0, 1)
		if align then
			align.CFrame = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		end
		if total > 3 then
			playTrack("swim", math.clamp(total / 14, 0.6, 2.2))
		else
			playTrack("idle", 1)
		end
		app.Sfx.setSwimming(total > 3 and depth > 2.5, total / math.max(1, speed))
		if bubbles then
			bubbles.Rate = if dashing then 30 else 4 + total * 0.3
		end
	end)
end

return Swim
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Trails</string>
              <string name="Source"><![CDATA[--!strict
-- SwimTrail pass cosmetic: a sparkling trail behind any diver (including you) who owns it, shown
-- only while they're actually underwater. No server-replicated "swimming" state is needed - depth
-- is just read off the character's own position, which always replicates.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Trails = {}

local DEPTH_THRESHOLD = 2 -- studs below the surface before the trail shows

local function buildEmitter(root: BasePart): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(150, 235, 255), Color3.fromRGB(90, 170, 255))
	emitter.LightEmission = 0.9
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(0.2, 0.8)
	emitter.SpreadAngle = Vector2.new(40, 40)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Parent = root
	return emitter
end

function Trails.init()
	local emitters: { [Player]: ParticleEmitter } = {}

	local function clear(player: Player)
		local emitter = emitters[player]
		if emitter then
			emitter:Destroy()
			emitters[player] = nil
		end
	end

	local function refresh(player: Player)
		local owns = player:GetAttribute("Trail") == true
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if owns and root and not emitters[player] then
			emitters[player] = buildEmitter(root)
		elseif (not owns or not root) and emitters[player] then
			clear(player)
		end
	end

	local function watch(player: Player)
		player:GetAttributeChangedSignal("Trail"):Connect(function()
			refresh(player)
		end)
		player.CharacterAdded:Connect(function()
			clear(player)
			task.defer(refresh, player)
		end)
		refresh(player)
	end

	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(clear)

	RunService.Heartbeat:Connect(function()
		for player, emitter in emitters do
			local root = emitter.Parent :: BasePart?
			local depth = if root then Config.SurfaceY - root.Position.Y else -1
			emitter.Rate = if depth > DEPTH_THRESHOLD then 10 else 0
		end
	end)
end

return Trails
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">WorldProps</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side life for the current world's props: spinning egg + portal, swaying plants,
-- localised signs and the floating egg label.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local WorldProps = {}

type Spinner = { instance: Instance, base: CFrame, speed: number, isModel: boolean }
type Swayer = { model: Model, base: CFrame, strength: number, phase: number }

function WorldProps.init(app: any)
	local spinners: { Spinner } = {}
	local swayers: { Swayer } = {}
	local guis: { Instance } = {}
	local loadedWorld = 0

	local function worldFolder(world: number): Instance?
		local worlds = Workspace:FindFirstChild("Worlds")
		return worlds and worlds:FindFirstChild("World" .. world)
	end

	local function signGui(part: BasePart, lines: { { text: string, size: number, color: Color3? } })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 50
		gui.LightInfluence = 0
		gui.Parent = part
		local holder = app.Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
		app.Kit.list(holder, Enum.FillDirection.Vertical, 0)
		for i, line in lines do
			app.Kit.text({
				Text = line.text,
				TextSize = line.size,
				Color = line.color,
				Stroke = 4,
				Size = UDim2.new(1, -20, 0, line.size + 10),
				LayoutOrder = i,
				Parent = holder,
			})
		end
		table.insert(guis, gui)
	end

	local function load(world: number)
		for _, gui in guis do
			gui:Destroy()
		end
		table.clear(guis)
		table.clear(spinners)
		table.clear(swayers)
		loadedWorld = world
		local wf = worldFolder(world)
		if not wf then
			loadedWorld = 0
			return
		end
		local data = Worlds.get(world)
		for _, descendant in wf:GetDescendants() do
			local spin = descendant:GetAttribute("Spin")
			if type(spin) == "number" then
				if descendant:IsA("Model") then
					table.insert(spinners, { instance = descendant :: Instance, base = descendant:GetPivot(), speed = spin, isModel = true })
				elseif descendant:IsA("BasePart") then
					table.insert(spinners, { instance = descendant :: Instance, base = descendant.CFrame, speed = spin, isModel = false })
				end
			end
			local sway = descendant:GetAttribute("Sway")
			if type(sway) == "number" and descendant:IsA("Model") then
				table.insert(swayers, { model = descendant, base = descendant:GetPivot(), strength = sway, phase = math.random() * 6.28 })
			end
			if descendant.Name == "WorldSign" and descendant:IsA("BasePart") then
				signGui(descendant, {
					{ text = Strings.get("world", { n = world }), size = 58, color = Color.hex(data.accent[1]) },
					{ text = Strings.name(data.name), size = 44 },
				})
			elseif descendant.Name == "KioskSign" and descendant:IsA("BasePart") then
				signGui(
					descendant,
					{ { text = utf8.char(0x1F93F) .. " " .. Strings.get("menu.upgrades"), size = 52, color = Color3.fromRGB(255, 226, 120) } }
				)
			elseif descendant.Name == "GodSharkSign" and descendant:IsA("BasePart") then
				signGui(descendant, {
					{ text = utf8.char(0x1F988) .. " GOD SHARK", size = 50, color = Color3.fromRGB(255, 236, 120) },
					{ text = Strings.get("limited") .. "  ·  R$ 399", size = 34, color = Color3.fromRGB(255, 120, 140) },
				})
			elseif descendant.Name == "EnchantSign" and descendant:IsA("BasePart") then
				signGui(
					descendant,
					{ { text = utf8.char(0x2728) .. " " .. Strings.get("enchantAltar"), size = 46, color = Color3.fromRGB(226, 180, 255) } }
				)
			elseif descendant.Name == "SellSign" and descendant:IsA("BasePart") then
				signGui(
					descendant,
					{ { text = utf8.char(0x1F4B0) .. " " .. Strings.get("sellShop"), size = 50, color = Color3.fromRGB(255, 222, 92) } }
				)
			elseif descendant.Name == "EggAnchor" and descendant:IsA("BasePart") then
				local billboard = Instance.new("BillboardGui")
				billboard.Size = UDim2.fromOffset(300, 96)
				billboard.StudsOffsetWorldSpace = Vector3.new(0, 5.5, 0)
				billboard.LightInfluence = 0
				billboard.MaxDistance = 90
				billboard.Parent = descendant
				local frame = app.Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = billboard })
				app.Kit.list(frame, Enum.FillDirection.Vertical, 2)
				app.Kit.text({
					Text = Strings.name(data.egg.name),
					TextSize = 34,
					Color = Color.hex(data.egg.accent),
					Stroke = 4,
					Size = UDim2.new(1, 0, 0, 40),
					LayoutOrder = 1,
					Parent = frame,
				})
				local costRow = app.Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 2, Parent = frame })
				app.Kit.list(costRow, Enum.FillDirection.Horizontal, 6)
				local coin = app.Kit.Icons.coin(32, costRow)
				coin.LayoutOrder = 1
				app.Kit.text({
					Text = Format.short(Economy.eggCost(world)),
					TextSize = 32,
					Stroke = 4,
					Size = UDim2.new(0, 0, 1, 0),
					AutoX = true,
					LayoutOrder = 2,
					Parent = costRow,
				})
				table.insert(guis, billboard)
			end
		end
	end

	app.State.languageChanged:Connect(function()
		loadedWorld = 0
	end)

	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt: number)
		local world = app.State.world
		if loadedWorld ~= world then
			load(world)
		end
		local t = os.clock()
		for _, spinner in spinners do
			local cf = spinner.base
				* CFrame.new(0, if spinner.isModel then math.sin(t * 1.6) * 0.5 else 0, 0)
				* CFrame.Angles(0, t * spinner.speed, 0)
			if spinner.isModel then
				(spinner.instance :: Model):PivotTo(cf)
			else
				local part = spinner.instance :: BasePart
				part.CFrame = spinner.base * CFrame.Angles(t * spinner.speed, 0, 0)
			end
		end
		accumulator += dt
		if accumulator < 1 / 30 or app.State.settings().lowFx then
			return
		end
		accumulator = 0
		local camera = Workspace.CurrentCamera
		local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero
		for _, swayer in swayers do
			if (swayer.base.Position - cameraPosition).Magnitude < 140 then
				local s = swayer.strength
				swayer.model:PivotTo(swayer.base * CFrame.Angles(math.sin(t * 1.1 + swayer.phase) * s, 0, math.cos(t * 0.8 + swayer.phase) * s))
			end
		end
	end)
end

return WorldProps
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="74">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Client entry point: loading screen, server handshake, then HUD, panels and controllers.

local LocalizationService = game:GetService("LocalizationService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Remotes = require(Shared.Remotes)
local Strings = require(Shared.Strings)

local UI = script.Parent:WaitForChild("UI")
local Controllers = script.Parent:WaitForChild("Controllers")

local Gui = require(UI.Gui)
local Screens = require(UI.Screens)
Screens.showLoading()

local Anim = require(UI.Anim)
local Clear = require(UI.Clear)
local Effects = require(UI.Effects)
local Hatch = require(UI.Hatch)
local Hud = require(UI.Hud)
local Kit = require(UI.Kit)
local Panel = require(UI.Panel)
local Theme = require(UI.Theme)
local Toasts = require(UI.Toasts)
local Tutorial = require(UI.Tutorial)
local EggPanel = require(UI.Panels.Egg)
local ProfilePanel = require(UI.Panels.Profile)
local PlayerList = require(UI.PlayerList)
local Trade = require(UI.Trade)
local PetsPanel = require(UI.Panels.Pets)
local RewardsPanel = require(UI.Panels.Rewards)
local Offers = require(UI.Offers)
local RightRail = require(UI.RightRail)
local Purchase = require(UI.Purchase)
local SettingsPanel = require(UI.Panels.Settings)
local ShopPanel = require(UI.Panels.Shop)
local GearPanel = require(UI.Panels.Gear)
local WorldsPanel = require(UI.Panels.Worlds)

local ClientNet = require(script.Parent.ClientNet)
local Music = require(script.Parent.Music)
local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.State)
local WorldFx = require(script.Parent.WorldFx)

local Ambience = require(Controllers.Ambience)
local Board = require(Controllers.Board)
local Dive = require(Controllers.Dive)
local Fish = require(Controllers.Fish)
local Hazards = require(Controllers.Hazards)
local Nameplates = require(Controllers.Nameplates)
local Pets = require(Controllers.Pets)
local Prompts = require(Controllers.Prompts)
local Relics = require(Controllers.Relics)
local Statues = require(Controllers.Statues)
local Swim = require(Controllers.Swim)
local Trails = require(Controllers.Trails)
local WorldProps = require(Controllers.WorldProps)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- Language and sound follow the saved settings; these run before any UI refresh.
-- "auto" picks Korean for Korean Roblox clients and English for everyone else.
local function resolveLanguage(lang: string): string
	if lang ~= "auto" then
		return lang
	end
	local ok, locale = pcall(function()
		return LocalizationService.RobloxLocaleId
	end)
	return if ok and type(locale) == "string" and string.sub(string.lower(locale), 1, 2) == "ko" then "ko" else "en"
end
Strings.setLanguage(resolveLanguage(Config.DefaultLanguage))
State.languageChanged:Connect(function(lang)
	Strings.setLanguage(resolveLanguage(lang))
end)
State.settingsChanged:Connect(function(settings)
	Sfx.setEnabled(settings.sfx)
	Music.setEnabled(settings.music)
end)
Music.follow(function()
	return State.dive.inWater
end)

Kit.clickSound = function()
	Sfx.play("Click")
end
Kit.hoverSound = function()
	Sfx.play("Hover")
end
Hatch.sfx = Sfx.play

local app: any = {
	Gui = Gui,
	Kit = Kit,
	Theme = Theme,
	Anim = Anim,
	State = State,
	Net = ClientNet,
	Sfx = Sfx,
	Toasts = Toasts,
	Effects = Effects,
	Screens = Screens,
	Hud = Hud,
	Clear = Clear,
	Hatch = Hatch,
	Relics = Relics,
	WorldFx = WorldFx,
}

local panels: { [string]: any } = {}

function app.isUiBlocking(): boolean
	return Panel.current() ~= nil or Hatch.playing
end

function app.closePanels()
	Panel.closeAll()
end

function app.travel(world: number)
	if State.traveling then
		return
	end
	if State.dive.active then
		Toasts.show(Strings.get("err.diving"), "bad")
		Sfx.play("Error")
		return
	end
	local result = ClientNet.invoke("Teleport", { world = world })
	if not result.ok then
		State.traveling = false
		Screens.travelEnd()
		Sfx.play("Error")
		Toasts.show(Strings.get(result.err or "err.generic"), "bad")
	end
end

function app.setSetting(key: string, value: any)
	local profile = State.profile
	if profile then
		(profile.settings :: any)[key] = value
		if key == "lang" then
			State.languageChanged:Fire(value)
		elseif key == "sfx" then
			Sfx.setEnabled(value)
		elseif key == "music" then
			Music.setEnabled(value)
		end
	end
	ClientNet.invoke("Setting", { key = key, value = value })
end

function app.openWorlds()
	panels.worlds.open()
end
function app.openUpgrades()
	panels.upgrades.open()
end
function app.openPets()
	panels.pets.open()
end
function app.openShop()
	panels.shop.open()
end
function app.openSettings()
	panels.settings.open()
end
function app.openProfile()
	panels.profile.open()
end
function app.openRewards()
	panels.rewards.open()
end
function app.buyGodShark()
	if not Purchase.prompt("GodShark", State.passes) then
		Toasts.show(Strings.get("comingSoon"), "info")
	end
end
function app.sell()
	local result = ClientNet.invoke("Sell")
	if not result.ok and result.err and result.err ~= "err.busy" then
		Sfx.play("Error")
		Toasts.show(Strings.get(result.err), "bad", utf8.char(0x1F392))
	end
end
-- Pays the unlock fee for a world; travels there on success when `go` is set.
function app.unlockWorld(world: number, go: boolean?): boolean
	local result = ClientNet.invoke("UnlockWorld", { world = world })
	if not result.ok then
		Sfx.play("Error")
		if result.err then
			Toasts.show(Strings.get(result.err), "bad", utf8.char(0x1F512))
		end
		if result.err == "notEnough" then
			Offers.trigger("unlock")
		end
		return false
	end
	Sfx.play("Unlock")
	Effects.confetti(60)
	Toasts.show(Strings.get("unlockedNext", { n = world }), "gold", utf8.char(0x1F513))
	if go then
		app.travel(world)
	end
	return true
end
function app.openEgg(world: number)
	if world ~= State.world then
		return
	end
	panels.egg.openWorld(world)
end

Hud.init({
	openWorlds = app.openWorlds,
	openUpgrades = app.openUpgrades,
	openPets = app.openPets,
	openShop = app.openShop,
	openSettings = app.openSettings,
	openProfile = app.openProfile,
	swimInput = Swim.setInput,
})

panels.worlds = WorldsPanel.new(app)
panels.upgrades = GearPanel.new(app)
panels.pets = PetsPanel.new(app)
panels.shop = ShopPanel.new(app)
panels.settings = SettingsPanel.new(app)
panels.egg = EggPanel.new(app)
panels.profile = ProfilePanel.new(app)
panels.rewards = RewardsPanel.new(app)
RewardsPanel.track(app)
for _, panel in panels do
	local previous = panel.onClose
	panel.onClose = function()
		Sfx.play("Close")
		if previous then
			previous()
		end
	end
end

app.Offers = Offers
Offers.init(app, function()
	return RightRail.starterLeft(app)
end, function(userId: number)
	return Board.weeklyRank(userId)
end)
RightRail.init(app, app.openRewards)
Dive.init(app)
Ambience.init(app)
Swim.init(app)
Relics.init(app)
Hazards.init(app)
Fish.init(app)
Pets.init(app)
WorldProps.init(app)
Prompts.init(app)
Tutorial.init(app)
Nameplates.init(app)
Trails.init()
Board.init(app)
Statues.init(app)
app.Trade = Trade.init(app)
app.PlayerList = PlayerList.init(function(player)
	app.requestTrade(player.UserId)
end, function(userId: number)
	return Board.weeklyRank(userId)
end)
task.spawn(function()
	local boardData = ReplicatedStorage:WaitForChild(Remotes.Board, 30)
	if boardData then
		boardData.Changed:Connect(function()
			task.delay(0.1, app.PlayerList.refresh)
		end)
	end
end)
State.languageChanged:Connect(function()
	task.defer(app.PlayerList.refresh)
end)

-- Handshake: wait until the server has loaded our profile and world.
local view = nil
local started = os.clock()
while not view do
	local result = ClientNet.invoke("Ready")
	if result.ok then
		view = result.data
	else
		if os.clock() - started > 12 then
			Screens.setLoadingStatus(Strings.get("err.notReady"))
		end
		task.wait(0.5)
	end
end
State.applyView(view)
Hud.refresh()
task.wait(0.4)
Screens.hideLoading()

local profile = State.profile
if profile then
	Music.setEnabled(profile.settings.music)
end
if profile and profile.stats.dives > 0 then
	task.delay(1.2, function()
		Toasts.show(Strings.get("welcomeBack"), "blue", utf8.char(0x1F30A))
	end)
end
-- Returning divers (past the tutorial) see today's login reward straight away.
if profile and profile.tutorial >= 7 and RewardsPanel.anyReady(app) then
	task.delay(2.5, function()
		if not app.isUiBlocking() then
			app.openRewards()
		end
	end)
end

-- Menu badges: something affordable in upgrades, or an egg you can hatch.
task.spawn(function()
	while true do
		local p = State.profile
		if p then
			Hud.setBadge("upgrades", GearPanel.anyAffordable(p))
			local nextWorld = p.unlocked + 1
			local previous = p.worlds[tostring(p.unlocked)]
			Hud.setBadge(
				"worlds",
				nextWorld <= Config.WorldCount and previous ~= nil and previous.cleared and p.coins >= Economy.unlockCost(nextWorld)
			)
			Hud.setBadge("pets", p.coins >= Economy.eggCost(State.world) and next(p.pets) == nil)
		end
		task.wait(0.5)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Music</string>
            <string name="Source"><![CDATA[--!strict
-- Background music: Config.MusicTracks shuffled and played back to back, forever. A new shuffle
-- never starts with the track that just ended. Quieter underwater; silent when Music is off.

local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Music = {}

local LOAD_TIMEOUT = 10

local group = Instance.new("SoundGroup")
group.Name = "DeepDiveMusic"
group.Volume = Config.MusicVolume
group.Parent = SoundService

local sound = Instance.new("Sound")
sound.Name = "Track"
sound.Looped = false
sound.SoundGroup = group
sound.Parent = SoundService

local enabled = true
local started = false
local queue: { string } = {}
local last: string? = nil
local token = 0

local function reshuffle()
	queue = table.clone(Config.MusicTracks)
	for i = #queue, 2, -1 do
		local j = math.random(1, i)
		queue[i], queue[j] = queue[j], queue[i]
	end
	if #queue > 1 and queue[1] == last then
		queue[1], queue[#queue] = queue[#queue], queue[1]
	end
end

local function playNext()
	if not enabled or #Config.MusicTracks == 0 then
		return
	end
	if #queue == 0 then
		reshuffle()
	end
	local id = table.remove(queue, 1) :: string
	last = id
	token += 1
	local mine = token
	sound.SoundId = id
	sound.TimePosition = 0
	sound:Play()
	-- A track that never loads (deleted, not approved yet) is skipped instead of stalling.
	task.delay(LOAD_TIMEOUT, function()
		if mine == token and enabled and not sound.IsLoaded then
			playNext()
		end
	end)
end

sound.Ended:Connect(function()
	playNext()
end)

-- Watchdog: Ended is not guaranteed (e.g. a track that stops early), so a loaded track that has
-- sat silent for a couple of seconds also moves the playlist on.
task.spawn(function()
	local silentFor = 0
	while true do
		task.wait(1)
		if enabled and started and sound.IsLoaded and not sound.IsPlaying then
			silentFor += 1
			if silentFor >= 2 then
				silentFor = 0
				playNext()
			end
		else
			silentFor = 0
		end
	end
end)

function Music.setEnabled(on: boolean)
	if on == enabled and started then
		return
	end
	enabled = on
	started = true
	if on then
		if sound.SoundId ~= "" and sound.TimePosition > 0 then
			sound:Resume()
		else
			playNext()
		end
	else
		sound:Pause()
	end
end

-- Underwater the music sits back so the dive ambience comes through.
function Music.follow(underwater: () -> boolean)
	RunService.Heartbeat:Connect(function(dt: number)
		local target = if underwater() then Config.MusicUnderwaterVolume else Config.MusicVolume
		group.Volume += (target - group.Volume) * math.clamp(dt * 2, 0, 1)
	end)
end

return Music
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--!strict
-- Sound design built from the engine's bundled sounds (no uploaded audio needed). Each cue is a
-- layered sequence of { sound, pitch, delay, volume } steps with a little random pitch so repeats
-- never sound identical. Any cue can be swapped for a recording via Config.SoundIds.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Sfx = {}

local S = Config.Sounds

-- Rising arpeggio of pings (a major chord: 1, 1.26, 1.5, 2).
local function chord(base: number, spacing: number, volume: number, steps: { number }): { { any } }
	local out = {}
	for i, ratio in steps do
		table.insert(out, { S.Ping :: any, base * ratio, (i - 1) * spacing, volume })
	end
	return out
end

local function concat(...: { { any } }): { { any } }
	local out = {}
	for _, list in { ... } do
		for _, step in list do
			table.insert(out, step)
		end
	end
	return out
end

local CUES: { [string]: { { any } } } = {
	Click = { { S.Button, 1.15, 0, 0.35 }, { S.Click, 1.6, 0, 0.18 } },
	Hover = { { S.Click, 2.1, 0, 0.1 } },
	Open = { { S.Swoosh, 1.5, 0, 0.22 }, { S.Ping, 2.2, 0.04, 0.12 } },
	Close = { { S.Swoosh, 1.15, 0, 0.18 } },
	Error = { { S.Button, 0.62, 0, 0.4 }, { S.Button, 0.55, 0.09, 0.35 } },
	Collect = { { S.Ping, 1.5, 0, 0.42 }, { S.Ping, 2.0, 0.05, 0.3 }, { S.Splash, 2.4, 0, 0.12 } },
	CollectRare = concat(chord(1.2, 0.06, 0.42, { 1, 1.26, 1.5, 2 }), { { S.Swoosh, 1.8, 0, 0.18 } }),
	Discover = concat(chord(1.0, 0.07, 0.45, { 1, 1.26, 1.5, 2, 2.52 }), { { S.Swoosh, 1.4, 0, 0.2 } }),
	Coin = { { S.Click, 2.3, 0, 0.2 }, { S.Ping, 3.0, 0, 0.08 } },
	Sell = concat({
		{ S.Button, 1.4, 0, 0.35 },
		{ S.Click, 2.0, 0.05, 0.3 },
		{ S.Click, 2.2, 0.1, 0.3 },
		{ S.Click, 2.4, 0.15, 0.3 },
	}, chord(1.3, 0.07, 0.42, { 1, 1.26, 1.5, 2 })),
	SellBig = concat(
		{ { S.Button, 1.2, 0, 0.4 }, { S.Swoosh, 1.2, 0, 0.25 } },
		chord(1.0, 0.07, 0.45, { 1, 1.26, 1.5, 2, 2.52, 3 }),
		chord(2.0, 0.05, 0.25, { 1, 1.5 })
	),
	Upgrade = concat(chord(0.9, 0.07, 0.45, { 1, 1.26, 1.5, 2 }), { { S.Swoosh, 1.7, 0.02, 0.22 }, { S.Button, 1.3, 0, 0.3 } }),
	Unlock = concat(chord(0.8, 0.1, 0.5, { 1, 1.26, 1.5, 2 }), { { S.Swoosh, 1.1, 0, 0.25 } }),
	Warning = { { S.Ping, 0.62, 0, 0.42 }, { S.Ping, 0.55, 0.2, 0.42 } },
	Splash = { { S.Splash, 1.0, 0, 0.65 }, { S.Splash, 1.45, 0.06, 0.3 }, { S.Swoosh, 0.7, 0, 0.18 } },
	SplashSmall = { { S.Splash, 1.35, 0, 0.35 }, { S.Splash, 1.8, 0.04, 0.15 } },
	Dash = { { S.Swoosh, 1.35, 0, 0.35 }, { S.Splash, 1.9, 0.02, 0.2 } },
	Hurt = { { S.Snap, 0.6, 0, 0.6 }, { S.Land, 0.8, 0, 0.4 }, { S.Ping, 0.45, 0.05, 0.3 } },
	EggShake = { { S.Snap, 1.3, 0, 0.3 }, { S.Land, 1.6, 0, 0.2 } },
	EggCrack = { { S.Snap, 0.85, 0, 0.55 }, { S.Swoosh, 1.6, 0.02, 0.3 }, { S.Ping, 1.4, 0.06, 0.35 } },
	Hatch = { { S.Snap, 0.85, 0, 0.55 }, { S.Swoosh, 1.6, 0.02, 0.3 } },
	Reveal = concat(chord(1.0, 0.08, 0.45, { 1, 1.26, 1.5, 2 }), { { S.Swoosh, 1.3, 0, 0.25 } }),
	Legendary = concat(chord(0.8, 0.1, 0.55, { 1, 1.26, 1.5, 2, 2.52 }), chord(1.6, 0.1, 0.35, { 1, 1.26, 1.5, 2 }), { { S.Swoosh, 0.9, 0, 0.3 } }),
	Clear = concat(
		chord(1.0, 0.12, 0.55, { 1, 1.26, 1.5, 2 }),
		chord(1.5, 0.1, 0.5, { 1, 1.33 }),
		chord(2.0, 0.1, 0.55, { 1, 1.26, 1.5 }),
		{ { S.Swoosh, 1.0, 0, 0.3 } }
	),
	Blackout = { { S.Ping, 0.45, 0, 0.5 }, { S.Ping, 0.4, 0.3, 0.45 }, { S.Swoosh, 0.5, 0, 0.3 } },
	Travel = { { S.Swoosh, 0.8, 0, 0.4 }, { S.Splash, 0.7, 0.05, 0.4 }, { S.Ping, 1.4, 0.25, 0.3 } },
	Chest = concat(chord(0.9, 0.1, 0.55, { 1, 1.26, 1.5, 2 }), { { S.Swoosh, 1.0, 0, 0.3 } }),
}

local enabled = true
local group = Instance.new("SoundGroup")
group.Name = "DeepDiveSfx"
group.Volume = 0.8
group.Parent = SoundService
-- A touch of room reverb makes the layered cues blend.
local reverb = Instance.new("ReverbSoundEffect")
reverb.DecayTime = 0.6
reverb.Density = 0.8
reverb.WetLevel = -14
reverb.DryLevel = 0
reverb.Parent = group

local pools: { [string]: { Sound } } = {}

local function acquire(id: string): Sound
	local pool = pools[id]
	if not pool then
		pool = {}
		pools[id] = pool
	end
	for _, sound in pool do
		if not sound.IsPlaying then
			return sound
		end
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.SoundGroup = group
	sound.Parent = SoundService
	table.insert(pool, sound)
	return sound
end

function Sfx.setEnabled(value: boolean)
	enabled = value
end

function Sfx.play(name: string, pitchScale: number?)
	if not enabled then
		return
	end
	local override = (Config.SoundIds :: any)[name]
	if type(override) == "string" and override ~= "" then
		local sound = acquire(override)
		sound.PlaybackSpeed = (pitchScale or 1) * (0.97 + math.random() * 0.06)
		sound.Volume = 0.6
		sound.TimePosition = 0
		sound:Play()
		return
	end
	local cue = CUES[name]
	if not cue then
		return
	end
	-- One random detune per cue keeps the chord intact but varies repeats.
	local detune = (pitchScale or 1) * (0.96 + math.random() * 0.08)
	for _, step in cue do
		local function fire()
			local sound = acquire(step[1])
			sound.PlaybackSpeed = step[2] * detune
			sound.Volume = step[4] or 0.5
			sound.TimePosition = 0
			sound:Play()
		end
		if step[3] > 0 then
			task.delay(step[3], fire)
		else
			fire()
		end
	end
end

-- Looping swim-stroke bed while moving underwater.
local swimLoop: Sound? = nil
function Sfx.setSwimming(active: boolean, speedRatio: number?)
	if not swimLoop then
		local sound = Instance.new("Sound")
		sound.SoundId = S.Swim
		sound.Looped = true
		sound.Volume = 0
		sound.SoundGroup = group
		sound.Parent = SoundService
		swimLoop = sound
	end
	local loop = swimLoop :: Sound
	if active and enabled then
		if not loop.IsPlaying then
			loop:Play()
		end
		loop.Volume = 0.12 + 0.12 * math.clamp(speedRatio or 0, 0, 1)
		loop.PlaybackSpeed = 0.8 + 0.4 * math.clamp(speedRatio or 0, 0, 1)
	elseif loop.IsPlaying then
		loop:Stop()
	end
end

return Sfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--!strict
-- Client-side store: latest profile snapshot, current world, relic layout and dive state.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Profile = require(Shared.Profile)
local Signal = require(Shared.Signal)

local State = {}

export type Layout = { id: number, world: number, relics: { [number]: string }, chest: boolean }
export type Dive = {
	active: boolean,
	blackout: boolean,
	oxygen: number,
	max: number,
	cargo: number,
	chestCarried: boolean,
	depth: number,
	inWater: boolean,
	swimming: boolean,
}

State.profile = nil :: Profile.Data?
State.passes = {} :: { [string]: boolean }
State.world = 1
State.memory = false
State.layout = { id = 0, world = 1, relics = {}, chest = false } :: Layout
State.dive = {
	active = false,
	blackout = false,
	oxygen = 0,
	max = 1,
	cargo = 0,
	chestCarried = false,
	depth = 0,
	inWater = false,
	swimming = false,
} :: Dive
State.traveling = false

State.profileChanged = Signal.new()
State.worldChanged = Signal.new()
State.layoutChanged = Signal.new()
State.diveChanged = Signal.new()
State.languageChanged = Signal.new()
State.settingsChanged = Signal.new()

function State.applyView(view: any)
	if type(view) ~= "table" or type(view.profile) ~= "table" then
		return
	end
	local previousWorld = State.world
	local previousLang = State.profile and State.profile.settings.lang
	local previousSettings = State.profile and State.profile.settings
	State.profile = view.profile
	State.passes = view.passes or {}
	State.memory = view.memory == true
	State.world = view.world or view.profile.world or 1
	if type(view.profile.backpack) == "table" then
		State.dive.cargo = #view.profile.backpack
	end
	State.profileChanged:Fire(State.profile)
	if State.world ~= previousWorld then
		State.worldChanged:Fire(State.world)
	end
	local profile = State.profile :: Profile.Data
	if profile.settings.lang ~= previousLang then
		State.languageChanged:Fire(profile.settings.lang)
	end
	if previousSettings ~= profile.settings then
		State.settingsChanged:Fire(profile.settings)
	end
end

-- Stat from the equipped gear in a slot ("tank", "pack", "fins", "magnet").
function State.upgrade(track: string): number
	local profile = State.profile
	return Economy.stat(if profile then profile.gear.equip else nil, track)
end

function State.capacity(): number
	return State.upgrade("pack")
end

function State.swimSpeed(): number
	return State.upgrade("fins") * (if State.passes.SwiftFins then Config.SwiftFinsBonus else 1)
end

function State.boostSum(): number
	local profile = State.profile
	if not profile then
		return 0
	end
	local sum = 0
	for _, id in profile.equipped do
		local pet = profile.pets[id]
		if pet then
			sum += Economy.petPower(pet.s, pet.m)
		end
	end
	return sum
end

function State.multiplier(): number
	local profile = State.profile
	local boosted = profile ~= nil and profile.boostUntil > os.time()
	return Economy.coinMultiplier(State.boostSum(), State.passes.DoubleCoins == true, boosted)
end

function State.equipCap(): number
	return Config.PetEquipBase + (if State.passes.PetSlots then Config.PetEquipPass else 0)
end

function State.progress(world: number?): Profile.WorldProgress
	local profile = State.profile
	local w = world or State.world
	if not profile then
		return { sold = 0, cleared = false, best = 0 }
	end
	return profile.worlds[tostring(w)] or { sold = 0, cleared = false, best = 0 }
end

function State.settings()
	local profile = State.profile
	if profile then
		return profile.settings
	end
	return { music = true, sfx = true, lowFx = false, hidePets = false, lang = Config.DefaultLanguage }
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="78">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Anim</string>
              <string name="Source"><![CDATA[--!strict
-- Tween helpers: pops, shakes, pulses, counters.

local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Anim = {}

function Anim.tween(instance: Instance, duration: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(instance, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- UIScale child used for pop/press animations (created on demand).
function Anim.scaleOf(gui: GuiObject): UIScale
	local scale = gui:FindFirstChild("AnimScale")
	if scale and scale:IsA("UIScale") then
		return scale
	end
	local created = Instance.new("UIScale")
	created.Name = "AnimScale"
	created.Parent = gui
	return created
end

function Anim.pop(gui: GuiObject, amount: number?)
	local scale = Anim.scaleOf(gui)
	scale.Scale = 1 + (amount or 0.18)
	Anim.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

function Anim.appear(gui: GuiObject, duration: number?)
	local scale = Anim.scaleOf(gui)
	scale.Scale = 0.4
	Anim.tween(scale, duration or 0.4, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

function Anim.shake(gui: GuiObject, strength: number?)
	local origin = gui.Position
	local s = strength or 6
	task.spawn(function()
		for i = 1, 6 do
			local offset = (if i % 2 == 0 then 1 else -1) * s * (1 - i / 7)
			gui.Position = origin + UDim2.fromOffset(offset, 0)
			task.wait(0.03)
		end
		gui.Position = origin
	end)
end

-- Counts a TextLabel from `from` to `to` using `formatter`.
function Anim.count(label: TextLabel, from: number, to: number, duration: number, formatter: (number) -> string)
	local token = ((label:GetAttribute("CountToken") :: number?) or 0) + 1
	label:SetAttribute("CountToken", token)
	local start = os.clock()
	task.spawn(function()
		while true do
			if label:GetAttribute("CountToken") ~= token then
				return
			end
			local t = math.clamp((os.clock() - start) / duration, 0, 1)
			local eased = 1 - (1 - t) ^ 3
			label.Text = formatter(from + (to - from) * eased)
			if t >= 1 then
				return
			end
			RunService.RenderStepped:Wait()
		end
	end)
end

function Anim.fade(group: CanvasGroup, to: number, duration: number?)
	return Anim.tween(group, duration or 0.25, { GroupTransparency = to })
end

return Anim
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Clear</string>
              <string name="Source"><![CDATA[--!strict
-- "WORLD CLEARED!" celebration with the Ancient Chest, reward and the next-world unlock.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Anim = require(script.Parent.Anim)
local Effects = require(script.Parent.Effects)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Viewport = require(script.Parent.Viewport)

local Clear = {}

local C = Theme.C

export type ClearData = { world: number, reward: number, nextWorld: number?, unlockCost: number?, all: boolean? }

-- onUnlock(world, travel) pays the next world's unlock fee and returns true on success.
function Clear.show(data: ClearData, onUnlock: (number, boolean) -> boolean, sfx: (string) -> ())
	local root = Kit.new("Frame", {
		Name = "Clear",
		BackgroundColor3 = Color3.fromRGB(6, 16, 34),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 85,
		Parent = Gui.overlay,
	}) :: Frame
	Anim.tween(root, 0.35, { BackgroundTransparency = 0.3 })
	sfx("Clear")
	Effects.confetti(150)

	local card = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(620, 470),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 86,
		Parent = root,
	})
	Kit.corner(card, 26)
	Kit.stroke(card, C.Outline, 4)
	Kit.gradient(card, Color3.fromRGB(255, 252, 235), Color3.fromRGB(255, 226, 150))
	Anim.appear(card, 0.5)

	local ribbon = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 60, 0, 84),
		Position = UDim2.new(0.5, 0, 0, -40),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 88,
		Parent = card,
	})
	Kit.corner(ribbon, 24)
	Kit.gradient(ribbon, Theme.Buttons.Gold[1], Theme.Buttons.Gold[2])
	Kit.stroke(ribbon, Theme.Buttons.Gold[3], 4)
	Kit.text({
		Text = Strings.get("worldCleared"),
		TextSize = 50,
		Size = UDim2.fromScale(1, 1),
		Stroke = 4,
		StrokeColor = Theme.Buttons.Gold[3],
		ZIndex = 89,
		Parent = ribbon,
	})

	local view = Viewport.new(card, UDim2.fromOffset(240, 200), UDim2.new(0.5, 0, 0, 50), Vector2.new(0.5, 0))
	view.setModel(Viewport.chest(data.world))
	view.setSpin(true)

	local worldData = Worlds.get(data.world)
	Kit.text({
		Text = Strings.get("world", { n = data.world }) .. "  -  " .. Strings.name(worldData.name),
		TextSize = 26,
		Color = C.Navy,
		Stroke = 0,
		Size = UDim2.new(1, -20, 0, 32),
		Position = UDim2.new(0.5, 0, 0, 252),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 87,
		Parent = card,
	})

	local rewardRow =
		Kit.pill({ Size = UDim2.fromOffset(300, 58), Position = UDim2.new(0.5, 0, 0, 292), AnchorPoint = Vector2.new(0.5, 0), Parent = card })
	local coin = Kit.Icons.coin(46, rewardRow)
	coin.Position = UDim2.fromOffset(8, 6)
	local rewardLabel = Kit.text({
		Text = "+0",
		TextSize = 34,
		Size = UDim2.new(1, -64, 1, 0),
		Position = UDim2.fromOffset(60, 0),
		XAlign = Enum.TextXAlignment.Left,
		Parent = rewardRow,
	})
	Anim.count(rewardLabel, 0, data.reward, 1.2, function(n)
		return "+" .. Format.commas(n)
	end)

	local subText = if data.all then Strings.get("allCleared") elseif data.nextWorld then Strings.get("unlockReady", { n = data.nextWorld }) else ""
	Kit.text({
		Text = subText,
		TextSize = 26,
		Color = C.GreenDark,
		Stroke = 0,
		Size = UDim2.new(1, -20, 0, 32),
		Position = UDim2.new(0.5, 0, 0, 356),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 87,
		Parent = card,
	})

	local buttons = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -40, 0, 64),
		Position = UDim2.new(0.5, 0, 1, -18),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 87,
		Parent = card,
	})
	Kit.list(buttons, Enum.FillDirection.Horizontal, 16)

	local function close()
		Anim.tween(root, 0.25, { BackgroundTransparency = 1 })
		Anim.tween(Anim.scaleOf(card), 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Once(function()
			root:Destroy()
		end)
	end
	if data.nextWorld then
		local cost = data.unlockCost or 0
		local unlock = Kit.button({
			Text = Strings.get("unlockButton", { n = Format.short(cost) }),
			TextSize = 24,
			Palette = "Green",
			Size = UDim2.fromOffset(280, 60),
			LayoutOrder = 1,
			Parent = buttons,
			OnClick = function()
				if onUnlock(data.nextWorld :: number, true) then
					close()
				end
			end,
		})
		local coinIcon = Kit.Icons.coin(30, unlock.button:FindFirstChild("Content") :: Instance)
		coinIcon.LayoutOrder = 0
		Kit.button({
			Text = Strings.get("stay"),
			TextSize = 24,
			Palette = "Gray",
			Size = UDim2.fromOffset(200, 60),
			LayoutOrder = 2,
			Parent = buttons,
			OnClick = close,
		})
	else
		Kit.button({
			Text = Strings.get("continue"),
			TextSize = 26,
			Palette = "Blue",
			Size = UDim2.fromOffset(250, 60),
			LayoutOrder = 1,
			Parent = buttons,
			OnClick = close,
		})
	end
end

return Clear
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Screen-space juice: floating numbers, coin bursts that fly into the coin counter, flashes,
-- confetti and the low-oxygen vignette.

local RunService = game:GetService("RunService")

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Effects = {}

local C = Theme.C

function Effects.floatText(text: string, color: Color3, position: UDim2, size: number?)
	local label = Kit.text({
		Text = text,
		TextSize = size or 34,
		Color = color,
		Stroke = 3,
		Size = UDim2.fromOffset(600, (size or 34) + 10),
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 50,
		Parent = Gui.hud,
	})
	Anim.appear(label, 0.3)
	Anim.tween(label, 1.3, { Position = position - UDim2.fromOffset(0, 70) }, Enum.EasingStyle.Quad)
	task.delay(0.8, function()
		Anim.tween(label, 0.5, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			Anim.tween(stroke, 0.5, { Transparency = 1 })
		end
	end)
	task.delay(1.4, function()
		label:Destroy()
	end)
end

-- Coins spray from `from` (fraction of the HUD canvas) and home into `target`. Runs on the HUD
-- layer so positions share one coordinate space with the coin counter.
function Effects.coinBurst(count: number, from: Vector2, target: GuiObject?, onEach: (() -> ())?)
	local overlay = Gui.hud
	local canvasSize = overlay.AbsoluteSize / Gui.scale
	local start = Vector2.new(from.X * canvasSize.X, from.Y * canvasSize.Y)
	local goal = start - Vector2.new(0, 300)
	if target then
		local absolute = target.AbsolutePosition + target.AbsoluteSize / 2 - overlay.AbsolutePosition
		goal = absolute / Gui.scale
	end
	for i = 1, count do
		task.delay(i * 0.035, function()
			local coin = Kit.Icons.coin(34, overlay)
			coin.AnchorPoint = Vector2.new(0.5, 0.5)
			coin.ZIndex = 60
			coin.Position = UDim2.fromOffset(start.X, start.Y)
			local spread = Vector2.new(math.random(-160, 160), math.random(-150, -40))
			local mid = start + spread
			local t0 = os.clock()
			local duration = 0.75 + math.random() * 0.2
			local connection
			connection = RunService.RenderStepped:Connect(function()
				local t = math.clamp((os.clock() - t0) / duration, 0, 1)
				local a = start:Lerp(mid, t)
				local b = mid:Lerp(goal, t)
				local p = a:Lerp(b, t * t)
				coin.Position = UDim2.fromOffset(p.X, p.Y)
				coin.Rotation = t * 360
				local s = 1 - t * 0.35
				coin.Size = UDim2.fromOffset(34 * s, 34 * s)
				if t >= 1 then
					connection:Disconnect()
					coin:Destroy()
					if onEach then
						onEach()
					end
				end
			end)
		end)
	end
end

local flashFrame = Kit.new("Frame", {
	Name = "Flash",
	BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 40,
	Parent = Gui.overlay,
})

function Effects.flash(color: Color3, strength: number?, duration: number?)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - (strength or 0.5)
	Anim.tween(flashFrame, duration or 0.45, { BackgroundTransparency = 1 })
end

local CONFETTI = { C.Gold, C.Pink, C.Cyan, C.Green, C.Purple, C.Orange, C.Red }

function Effects.confetti(amount: number?)
	local overlay = Gui.overlay
	local size = overlay.AbsoluteSize / Gui.scale
	for i = 1, amount or 90 do
		task.delay(math.random() * 0.6, function()
			local piece = Kit.new("Frame", {
				BackgroundColor3 = CONFETTI[(i % #CONFETTI) + 1],
				Size = UDim2.fromOffset(math.random(10, 18), math.random(6, 12)),
				Position = UDim2.fromOffset(math.random() * size.X, -20),
				Rotation = math.random(0, 360),
				ZIndex = 70,
				Parent = overlay,
			})
			Kit.corner(piece, 3)
			local fall = 2 + math.random() * 1.6
			local drift = math.random(-140, 140)
			local start = piece.Position
			Anim.tween(
				piece,
				fall,
				{ Position = start + UDim2.fromOffset(drift, size.Y + 60), Rotation = piece.Rotation + math.random(-540, 540) },
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.In
			)
			task.delay(fall, function()
				piece:Destroy()
			end)
		end)
	end
end

-- Low oxygen vignette: four gradient edges on the world layer.
local vignette: { Frame } = {}
local VIGNETTE_EDGES: { { any } } = {
	{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0), 90 },
	{ UDim2.new(1, 0, 0.22, 0), UDim2.fromScale(0, 0.78), 270 },
	{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
	{ UDim2.new(0.16, 0, 1, 0), UDim2.fromScale(0.84, 0), 180 },
}
for _, spec in VIGNETTE_EDGES do
	local edge = Kit.new("Frame", {
		BackgroundColor3 = C.Danger,
		BackgroundTransparency = 1,
		Size = spec[1],
		Position = spec[2],
		Parent = Gui.world,
	})
	Kit.new("UIGradient", { Rotation = spec[3], Transparency = NumberSequence.new(0.2, 1), Parent = edge })
	table.insert(vignette, edge)
end

function Effects.setVignette(strength: number, color: Color3?)
	for _, edge in vignette do
		edge.BackgroundTransparency = 1 - math.clamp(strength, 0, 1)
		if color then
			edge.BackgroundColor3 = color
		end
	end
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Gui</string>
              <string name="Source"><![CDATA[--!strict
-- Screen layers with resolution-independent scaling. Everything is laid out against a 1280x700
-- reference canvas (the usable area below the Roblox top bar) and scaled to the device.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))

local Gui = {}

local REFERENCE = Vector2.new(1280, 700)
-- Touch screens get bigger UI, but never so big that the canvas drops below this height
-- (the HUD switches to a compact two-column menu and panels shrink to fit below 690).
local TOUCH_BOOST = 1.18
local MIN_CANVAS_HEIGHT = 600

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

Gui.scale = 1
Gui.canvasSize = REFERENCE
Gui.resized = Signal.new()
Gui.promptParent = playerGui
local scalers: { { frame: Frame, scale: UIScale } } = {}
local safeScreen: ScreenGui? = nil

function Gui.isTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

-- Usable screen area: inside the top bar and device safe insets.
local function usableSize(): Vector2
	local screen = safeScreen
	if screen and screen.AbsoluteSize.X > 1 and screen.AbsoluteSize.Y > 1 then
		return screen.AbsoluteSize
	end
	local camera = Workspace.CurrentCamera
	return if camera then camera.ViewportSize - Vector2.new(0, 58) else REFERENCE
end

local function computeScale(usable: Vector2): number
	local s = math.min(usable.X / REFERENCE.X, usable.Y / REFERENCE.Y)
	if Gui.isTouch() then
		s = math.min(s * TOUCH_BOOST, usable.Y / MIN_CANVAS_HEIGHT)
	end
	-- Never scale above the reference size: big monitors get more room, not bigger buttons.
	return math.clamp(s, 0.45, 1)
end

local function layer(name: string, order: number, fullscreen: boolean): Frame
	local screen = Instance.new("ScreenGui")
	screen.Name = name
	screen.ResetOnSpawn = false
	screen.DisplayOrder = order
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = fullscreen
	screen.ScreenInsets = if fullscreen then Enum.ScreenInsets.None else Enum.ScreenInsets.CoreUISafeInsets
	screen.Parent = playerGui
	if not fullscreen and not safeScreen then
		safeScreen = screen
	end
	local container = Instance.new("Frame")
	container.Name = "Canvas"
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromScale(1, 1)
	container.Parent = screen
	local scale = Instance.new("UIScale")
	scale.Parent = container
	table.insert(scalers, { frame = container, scale = scale })
	return container
end

local function refresh()
	local usable = usableSize()
	local s = computeScale(usable)
	local canvas = usable / s
	local changed = math.abs(s - Gui.scale) > 1e-4 or (canvas - Gui.canvasSize).Magnitude > 0.5
	Gui.scale = s
	Gui.canvasSize = canvas
	for _, entry in scalers do
		entry.scale.Scale = s
		entry.frame.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	if changed then
		Gui.resized:Fire(canvas, s)
	end
end

Gui.world = layer("DeepDiveWorldFx", 1, true) -- vignettes, underwater tint
Gui.hud = layer("DeepDiveHud", 5, false)
-- Same level as the HUD but drawn from the very top of the screen (the player list sits in the
-- Roblox top-bar row, which is empty on the right).
Gui.hudTop = layer("DeepDiveHudTop", 6, true)
Gui.panels = layer("DeepDivePanels", 10, false)
Gui.overlay = layer("DeepDiveOverlay", 20, true)
Gui.top = layer("DeepDiveTop", 30, true) -- loading screen, transitions

refresh()
if safeScreen then
	safeScreen:GetPropertyChangedSignal("AbsoluteSize"):Connect(refresh)
end
local function watchCamera()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
	end
	refresh()
end
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

return Gui
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Hatch</string>
              <string name="Source"><![CDATA[--!strict
-- Egg hatching sequence: eggs drop in, wobble harder and harder, burst in a flash and reveal
-- the pet with a rarity-coloured sunburst, name and NEW! badge.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Anim = require(script.Parent.Anim)
local Effects = require(script.Parent.Effects)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local Viewport = require(script.Parent.Viewport)

local Hatch = {}

local C = Theme.C

Hatch.sfx = function(_name: string) end
Hatch.playing = false

local function sunburst(parent: GuiObject, color: Color3, size: number): Frame
	local holder = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size, size),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 1,
		Parent = parent,
	}) :: Frame
	for i = 0, 11 do
		local ray = Kit.new("Frame", {
			BackgroundColor3 = color,
			BackgroundTransparency = 0.45,
			Size = UDim2.new(0, size * 0.09, 0.5, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 1),
			Rotation = i * 30,
			ZIndex = 1,
			Parent = holder,
		})
		Kit.new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0.1), Parent = ray })
	end
	local glow = Kit.new("Frame", {
		BackgroundColor3 = color,
		BackgroundTransparency = 0.35,
		Size = UDim2.fromScale(0.55, 0.55),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 1,
		Parent = holder,
	})
	Kit.round(glow)
	Kit.new("UIGradient", { Transparency = NumberSequence.new(0, 0.9), Parent = glow })
	return holder
end

function Hatch.play(world: number, results: { { id: string, key: string, new: boolean } }, onDone: () -> ())
	Hatch.playing = true
	local root = Kit.new("TextButton", {
		Name = "Hatch",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(6, 16, 34),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 80,
		Parent = Gui.overlay,
	}) :: TextButton
	Anim.tween(root, 0.3, { BackgroundTransparency = 0.25 })

	local count = #results
	local slotSize = if count == 1 then 320 elseif count <= 3 then 240 else 200
	local row = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(count * (slotSize + 30), slotSize + 140),
		Position = UDim2.fromScale(0.5, 0.48),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 81,
		Parent = root,
	})
	Kit.list(row, Enum.FillDirection.Horizontal, 30)

	type Slot = { frame: Frame, view: Viewport.ViewApi, result: any }
	local slots: { Slot } = {}
	for i, result in results do
		local frame = Kit.new(
			"Frame",
			{ BackgroundTransparency = 1, Size = UDim2.fromOffset(slotSize, slotSize + 130), LayoutOrder = i, ZIndex = 81, Parent = row }
		) :: Frame
		local view = Viewport.new(frame, UDim2.fromOffset(slotSize, slotSize), UDim2.new(0.5, 0, 0, -400), Vector2.new(0.5, 0))
		view.frame.ZIndex = 3
		view.setModel(Viewport.egg(world))
		table.insert(slots, { frame = frame, view = view, result = result })
		Anim.tween(view.frame, 0.55, { Position = UDim2.new(0.5, 0, 0, 0) }, Enum.EasingStyle.Bounce)
	end

	local finished = false
	local canSkip = false
	local function finish()
		if finished or not canSkip then
			return
		end
		finished = true
		Anim.tween(root, 0.25, { BackgroundTransparency = 1 })
		for _, slot in slots do
			Anim.tween(Anim.scaleOf(slot.frame), 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		end
		task.delay(0.3, function()
			root:Destroy()
			Hatch.playing = false
			onDone()
		end)
	end
	root.Activated:Connect(finish)

	task.spawn(function()
		task.wait(0.6)
		-- Wobble with rising intensity.
		for shake = 1, 3 do
			Hatch.sfx("EggShake")
			local amplitude = 8 + shake * 7
			local start = os.clock()
			while os.clock() - start < 0.32 do
				local t = (os.clock() - start) / 0.32
				for _, slot in slots do
					slot.view.frame.Rotation = math.sin(t * math.pi * 4) * amplitude
				end
				RunService.RenderStepped:Wait()
			end
			for _, slot in slots do
				slot.view.frame.Rotation = 0
			end
			task.wait(0.18)
		end
		local best = 1
		for _, slot in slots do
			local pet = Worlds.pets[slot.result.key]
			if pet and pet.rarity > best then
				best = pet.rarity
			end
		end
		Hatch.sfx("EggCrack")
		Effects.flash(Color3.new(1, 1, 1), if best >= 5 then 0.95 else 0.8, 0.6)
		for _, slot in slots do
			local pet = Worlds.pets[slot.result.key]
			local rarity = Config.Rarities[pet.rarity]
			local color = Theme.Rarity[rarity]
			local burst = sunburst(slot.frame, color, slotSize * 1.5)
			burst.Position = UDim2.new(0.5, 0, 0, slotSize / 2)
			task.spawn(function()
				while burst.Parent do
					burst.Rotation += 0.6
					RunService.RenderStepped:Wait()
				end
			end)
			slot.view.setModel(Viewport.pet(slot.result.key))
			slot.view.setSpin(true)
			Anim.appear(slot.view.frame, 0.5)
			local name = Kit.text({
				Text = Strings.name(pet.name),
				TextSize = if count == 1 then 40 elseif count <= 3 then 30 else 24,
				Size = UDim2.new(1, 60, 0, 46),
				Position = UDim2.new(0.5, 0, 0, slotSize + 4),
				AnchorPoint = Vector2.new(0.5, 0),
				ZIndex = 5,
				Stroke = 4,
				StrokeColor = color:Lerp(Color3.new(0, 0, 0), 0.6),
				Parent = slot.frame,
			})
			Anim.appear(name, 0.4)
			local chip = Kit.new("Frame", {
				BackgroundColor3 = color,
				Size = UDim2.fromOffset(170, 36),
				Position = UDim2.new(0.5, 0, 0, slotSize + 54),
				AnchorPoint = Vector2.new(0.5, 0),
				ZIndex = 5,
				Parent = slot.frame,
			})
			Kit.round(chip)
			Kit.stroke(chip, color:Lerp(Color3.new(0, 0, 0), 0.5), 3)
			Kit.text({ Text = Strings.get("rarity." .. rarity), TextSize = 22, Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = chip })
			if slot.result.new then
				local badge = Kit.new("Frame", {
					BackgroundColor3 = C.Red,
					Size = UDim2.fromOffset(90, 40),
					Position = UDim2.new(1, -10, 0, 20),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Rotation = 12,
					ZIndex = 7,
					Parent = slot.frame,
				})
				Kit.round(badge)
				Kit.stroke(badge, C.White, 3)
				Kit.text({ Text = Strings.get("newPet"), TextSize = 22, Size = UDim2.fromScale(1, 1), ZIndex = 8, Parent = badge })
				task.delay(0.3, function()
					Anim.pop(badge, 0.5)
				end)
			end
		end
		if best >= 5 then
			Hatch.sfx("Legendary")
			Effects.confetti(120)
		else
			Hatch.sfx("Reveal")
		end
		local hint = Kit.text({
			Text = Strings.get("tapToContinue"),
			TextSize = 22,
			Color = Color3.fromRGB(200, 230, 255),
			Size = UDim2.fromOffset(500, 30),
			Position = UDim2.new(0.5, 0, 1, -40),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = 82,
			Parent = root,
		})
		hint.TextTransparency = 1
		task.wait(0.9)
		canSkip = true
		Anim.tween(hint, 0.3, { TextTransparency = 0 })
		task.wait(2.6)
		finish()
	end)
end

return Hatch
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- Heads-up display, kept small and out of the way:
--   top-left     wallet (coins with a "+" shop shortcut, pet boost)
--   top-centre   slim world chip with treasure progress (hidden while diving)
--   left         menu rail
--   bottom       one dive bar while in the water: oxygen, depth, backpack
-- Touch devices also get swim buttons in the bottom-right corner.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Hud = {}

local C = Theme.C
local root = Gui.hud
local MARGIN = 16
-- Touch screens get the HUD groups 20% bigger (each scales from its own anchor corner).
local TOUCH_SCALE = if Gui.isTouch() then 1.2 else 1

export type Actions = {
	openWorlds: () -> (),
	openUpgrades: () -> (),
	openPets: () -> (),
	openShop: () -> (),
	openSettings: () -> (),
	openProfile: () -> (),
	swimInput: (string, boolean) -> (),
}

Hud.coinTarget = nil :: GuiObject?
local refreshers: { () -> () } = {}

local function onRefresh(fn: () -> ())
	table.insert(refreshers, fn)
	fn()
end

function Hud.refresh()
	for _, fn in refreshers do
		fn()
	end
end

-- Wallet -----------------------------------------------------------------------------------------

local wallet = Kit.new("Frame", {
	Name = "Wallet",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(250, 84),
	Position = UDim2.fromOffset(MARGIN, 12),
	Parent = root,
})
local coinPill = Kit.pill({ Name = "Coins", Size = UDim2.fromOffset(250, 44), Outline = 2.5, Parent = wallet })
local coinIcon = Kit.Icons.coin(34, coinPill)
coinIcon.Position = UDim2.new(0, 5, 0.5, 0)
coinIcon.AnchorPoint = Vector2.new(0, 0.5)
coinIcon.ZIndex = 3
local coinLabel = Kit.text({
	Text = "0",
	TextSize = 24,
	Size = UDim2.new(1, -86, 1, 0),
	Position = UDim2.fromOffset(46, 0),
	XAlign = Enum.TextXAlignment.Left,
	Stroke = 2.5,
	Parent = coinPill,
})
Hud.coinTarget = coinIcon
local shownCoins = 0
-- Full digits while they fit the pill; short form ("1.2B") beyond that.
local function walletText(n: number): string
	return if n >= 1e9 then Format.short(n) else Format.commas(n)
end
local addCoins = Kit.button({
	Name = "AddCoins",
	Text = "+",
	TextSize = 24,
	Palette = "Green",
	Size = UDim2.fromOffset(32, 32),
	Position = UDim2.new(1, -6, 0.5, 0),
	AnchorPoint = Vector2.new(1, 0.5),
	Radius = 16,
	Stroke = 2,
	Parent = coinPill,
})

local boostChip = Kit.new("TextButton", {
	Name = "Boost",
	Text = "",
	AutoButtonColor = false,
	BackgroundColor3 = Color3.new(1, 1, 1),
	Size = UDim2.fromOffset(122, 30),
	Position = UDim2.fromOffset(10, 52),
	Parent = wallet,
}) :: TextButton
Kit.round(boostChip)
Kit.gradient(boostChip, Theme.Buttons.Pink[1], Theme.Buttons.Pink[2])
Kit.stroke(boostChip, Theme.Buttons.Pink[3], 2.5)
local boostLabel =
	Kit.text({ Text = "x1", TextSize = 16, Size = UDim2.fromScale(1, 1), Stroke = 2, StrokeColor = Theme.Buttons.Pink[3], Parent = boostChip })

-- World chip -------------------------------------------------------------------------------------

local banner = Kit.pill({
	Name = "WorldBanner",
	Size = UDim2.fromOffset(300, 52),
	Position = UDim2.new(0.5, 0, 0, 10),
	AnchorPoint = Vector2.new(0.5, 0),
	Transparency = 0.3,
	Outline = 2.5,
	Parent = root,
})
local worldTitle =
	Kit.text({ Text = "", TextSize = 18, Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 4), Stroke = 2, Parent = banner })
local progress = Kit.progress({
	Size = UDim2.new(1, -28, 0, 17),
	Position = UDim2.new(0.5, 0, 0, 28),
	AnchorPoint = Vector2.new(0.5, 0),
	Colors = { C.Gold, C.Orange },
	TextSize = 13,
	Outline = 2,
	LabelStroke = 1.6,
	Parent = banner,
})
local chestPulse = false

local function refreshBanner()
	local world = State.world
	local data = Worlds.get(world)
	worldTitle.Text = Strings.get("world", { n = world }) .. "  ·  " .. Strings.name(data.name)
	local titleStroke = worldTitle:FindFirstChildOfClass("UIStroke")
	if titleStroke then
		titleStroke.Color = Color.darken(Color.hex(data.accent[2]), 0.45)
	end
	local p = State.progress(world)
	local goal = Economy.goal(world)
	chestPulse = false
	if p.cleared then
		progress.setColors(C.Green, C.GreenDark)
		progress.set(1, Strings.get("clearedTag") .. "  " .. utf8.char(0x2714))
	elseif p.sold >= goal then
		progress.setColors(Color.hex("#ffe96b"), Color.hex("#ff9b2e"))
		progress.set(1, Strings.get("findChest"))
		chestPulse = true
	else
		progress.setColors(C.Cyan, C.Blue)
		progress.set(p.sold / goal, Strings.get("treasure", { a = p.sold, b = goal }))
	end
end

-- Menu rail --------------------------------------------------------------------------------------

local MENU_BUTTON = 76
local MENU_GAP = 10
local MENU_COUNT = 6
local menu = Kit.new("Frame", {
	Name = "Menu",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(MENU_BUTTON + 4, MENU_COUNT * MENU_BUTTON + (MENU_COUNT - 1) * MENU_GAP),
	Position = UDim2.new(0, MARGIN, 0.5, if TOUCH_SCALE > 1 then 42 else 34),
	AnchorPoint = Vector2.new(0, 0.5),
	Parent = root,
})
-- One column on roomy screens; two columns of three when the canvas is short (and on phones).
local menuGrid = Kit.new("UIGridLayout", {
	CellSize = UDim2.fromOffset(MENU_BUTTON, MENU_BUTTON),
	CellPadding = UDim2.fromOffset(MENU_GAP, MENU_GAP),
	FillDirection = Enum.FillDirection.Vertical,
	FillDirectionMaxCells = MENU_COUNT,
	HorizontalAlignment = Enum.HorizontalAlignment.Left,
	VerticalAlignment = Enum.VerticalAlignment.Center,
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = menu,
}) :: UIGridLayout
local function layoutMenu(canvas: Vector2)
	local compact = TOUCH_SCALE > 1 or canvas.Y < 660
	local perColumn = if compact then 3 else MENU_COUNT
	local columns = math.ceil(MENU_COUNT / perColumn)
	menuGrid.FillDirectionMaxCells = perColumn
	menu.Size = UDim2.fromOffset(columns * MENU_BUTTON + (columns - 1) * MENU_GAP + 4, perColumn * MENU_BUTTON + (perColumn - 1) * MENU_GAP)
end
layoutMenu(Gui.canvasSize)
Gui.resized:Connect(layoutMenu)
local badges: { [string]: Frame } = {}
local menuLabels: { [string]: TextLabel } = {}

local function menuButton(key: string, emoji: string, palette: string, order: number, onClick: () -> ())
	local api = Kit.button({
		Name = key,
		Icon = emoji,
		IconSize = 34,
		Palette = palette,
		Size = UDim2.fromOffset(MENU_BUTTON, MENU_BUTTON),
		Radius = 18,
		Stroke = 2.5,
		LayoutOrder = order,
		Parent = menu,
		OnClick = onClick,
	})
	local content = api.button:FindFirstChild("Content") :: Frame?
	if content then
		content.Position = UDim2.fromOffset(0, -9)
	end
	local label = Kit.text({
		Text = "",
		TextSize = 15,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -21),
		ZIndex = 4,
		Stroke = 2,
		StrokeColor = (Theme.Buttons[palette] or Theme.Buttons.Blue)[3],
		Parent = api.button,
	})
	menuLabels[key] = label
	local badge = Kit.new("Frame", {
		Name = "Badge",
		BackgroundColor3 = C.Red,
		Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(1, -4, 0, 4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 5,
		Parent = api.button,
	})
	Kit.round(badge)
	Kit.stroke(badge, C.White, 2)
	Kit.text({ Text = "!", TextSize = 14, Size = UDim2.fromScale(1, 1), ZIndex = 6, Stroke = 1.5, Parent = badge })
	badges[key] = badge
	return api
end

Hud.menuButtons = {} :: { [string]: Kit.ButtonApi }

function Hud.setBadge(key: string, visible: boolean)
	local badge = badges[key]
	if badge and badge.Visible ~= visible then
		badge.Visible = visible
		if visible then
			Anim.pop(badge, 0.6)
		end
	end
end

-- Dive bar ---------------------------------------------------------------------------------------

local dive = Kit.new("Frame", {
	Name = "Dive",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(560, 88),
	Position = UDim2.new(0.5, 0, 1, -14),
	AnchorPoint = Vector2.new(0.5, 1),
	Parent = root,
})
-- Bottom row: [bubble + oxygen] [depth, in water only] [backpack], centred as a group.
local diveRow = Kit.new("Frame", {
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 0, 40),
	Position = UDim2.new(0, 0, 1, 0),
	AnchorPoint = Vector2.new(0, 1),
	Parent = dive,
})
Kit.list(diveRow, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
local oxygenGroup = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(284, 40), LayoutOrder = 1, Parent = diveRow })
local oxygenBar = Kit.progress({
	Size = UDim2.fromOffset(250, 28),
	Position = UDim2.new(0, 34, 0.5, 0),
	AnchorPoint = Vector2.new(0, 0.5),
	Colors = { C.Oxygen, C.OxygenDeep },
	TextSize = 18,
	Outline = 2.5,
	LabelStroke = 2,
	Parent = oxygenGroup,
})
local bubble = Kit.Icons.bubble(42, oxygenGroup)
bubble.Position = UDim2.new(0, 4, 0.5, 0)
bubble.AnchorPoint = Vector2.new(0, 0.5)
bubble.ZIndex = 3

local depthChip = Kit.pill({ Name = "Depth", Size = UDim2.fromOffset(136, 36), Outline = 2.5, Parent = diveRow })
depthChip.LayoutOrder = 2
local depthRow = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = depthChip })
Kit.list(depthRow, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
Kit.text({ Text = utf8.char(0x1F30A), TextSize = 17, Size = UDim2.fromOffset(22, 22), Stroke = 0, LayoutOrder = 1, Parent = depthRow })
local depthLabel =
	Kit.text({ Text = "0m", TextSize = 19, Size = UDim2.new(0, 0, 1, 0), AutoX = true, Stroke = 2, LayoutOrder = 2, Parent = depthRow })
local depthMax = Kit.text({
	Text = "",
	TextSize = 13,
	Color = Color.hex("#c4dcf2"),
	Size = UDim2.new(0, 0, 1, 0),
	AutoX = true,
	Stroke = 1.6,
	LayoutOrder = 3,
	Parent = depthRow,
})

local cargoChip = Kit.pill({ Name = "Cargo", Size = UDim2.fromOffset(118, 36), Outline = 2.5, Parent = diveRow })
cargoChip.LayoutOrder = 3
local bag = Kit.Icons.bag(32, cargoChip)
bag.Position = UDim2.new(0, 6, 0.5, 0)
bag.AnchorPoint = Vector2.new(0, 0.5)
local cargoLabel = Kit.text({
	Text = "0/5",
	TextSize = 20,
	Size = UDim2.new(1, -48, 1, 0),
	Position = UDim2.fromOffset(42, 0),
	XAlign = Enum.TextXAlignment.Left,
	Stroke = 2,
	Parent = cargoChip,
})

local pressureChip = Kit.pill({
	Name = "Pressure",
	Size = UDim2.fromOffset(150, 24),
	Position = UDim2.new(0, 58, 1, -40),
	AnchorPoint = Vector2.new(0, 1),
	Outline = 2,
	Parent = dive,
})
local pressureLabel = Kit.text({ Text = "", TextSize = 14, Size = UDim2.fromScale(1, 1), Stroke = 1.6, Parent = pressureChip })
pressureChip.Visible = false
local lowLabel = Kit.text({
	Text = "",
	TextSize = 22,
	Color = Color.hex("#ffd0d4"),
	Size = UDim2.fromOffset(300, 28),
	Position = UDim2.new(0, 34, 1, -68),
	AnchorPoint = Vector2.new(0, 1),
	Stroke = 2.5,
	StrokeColor = C.RedDark,
	Parent = dive,
})

-- Touch swim buttons ------------------------------------------------------------------------------

local touchPad = Kit.new("Frame", {
	Name = "SwimPad",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(260, 260),
	-- Roblox hides its jump button while the swim controller has Jumping disabled, so the pad
	-- takes that bottom-right corner.
	Position = UDim2.new(1, -12, 1, -12),
	AnchorPoint = Vector2.new(1, 1),
	Visible = false,
	Parent = root,
})
local touchButtons: { [string]: Kit.ButtonApi } = {}

if TOUCH_SCALE > 1 then
	for _, group in { wallet, menu, dive } :: { GuiObject } do
		local scale = Instance.new("UIScale")
		scale.Name = "TouchScale"
		scale.Scale = TOUCH_SCALE
		scale.Parent = group
	end
end

local memoryLabel = Kit.text({
	Text = "",
	TextSize = 14,
	Color = Color.hex("#ffe08a"),
	Size = UDim2.fromOffset(420, 18),
	Position = UDim2.new(0, MARGIN, 1, -8),
	AnchorPoint = Vector2.new(0, 1),
	XAlign = Enum.TextXAlignment.Left,
	Stroke = 2,
	Parent = root,
})

-- Wiring -----------------------------------------------------------------------------------------

function Hud.init(actions: Actions)
	Hud.menuButtons.worlds = menuButton("worlds", utf8.char(0x1F30D), "Blue", 1, actions.openWorlds)
	Hud.menuButtons.upgrades = menuButton("upgrades", utf8.char(0x1F93F), "Orange", 2, actions.openUpgrades)
	Hud.menuButtons.pets = menuButton("pets", utf8.char(0x1F43E), "Pink", 3, actions.openPets)
	Hud.menuButtons.profile = menuButton("profile", utf8.char(0x1F464), "Purple", 4, actions.openProfile)
	Hud.menuButtons.shop = menuButton("shop", utf8.char(0x1F6D2), "Green", 5, actions.openShop)
	Hud.menuButtons.settings = menuButton("settings", utf8.char(0x2699) .. utf8.char(0xFE0F), "Gray", 6, actions.openSettings)
	boostChip.Activated:Connect(actions.openPets)
	addCoins.button.Activated:Connect(actions.openShop)

	local function padButton(key: string, text: string, palette: string, size: number, position: UDim2)
		local api = Kit.button({
			Name = key,
			Text = text,
			TextSize = if size > 100 then 26 else 22,
			Palette = palette,
			Size = UDim2.fromOffset(size, size),
			Position = position,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Radius = math.floor(size / 2),
			Parent = touchPad,
		})
		api.button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				actions.swimInput(key, true)
			end
		end)
		api.button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				actions.swimInput(key, false)
			end
		end)
		touchButtons[key] = api
	end
	padButton("dash", "", "Cyan", 118, UDim2.fromScale(0.34, 0.62))
	padButton("up", "", "Green", 88, UDim2.fromScale(0.78, 0.3))
	padButton("down", "", "Purple", 88, UDim2.fromScale(0.78, 0.78))

	onRefresh(function()
		for key, label in menuLabels do
			label.Text = Strings.get("menu." .. key)
		end
		touchButtons.dash.setText(Strings.get("dash"))
		touchButtons.up.setText(Strings.get("up"))
		touchButtons.down.setText(Strings.get("down"))
		if State.memory then
			memoryLabel.Text = Strings.get("studioSave")
		end
		refreshBanner()
	end)

	State.profileChanged:Connect(function()
		local profile = State.profile
		if not profile then
			return
		end
		if profile.coins > shownCoins and shownCoins > 0 then
			Anim.count(coinLabel, shownCoins, profile.coins, 0.8, walletText)
			Anim.pop(coinPill, 0.08)
		else
			coinLabel.Text = walletText(profile.coins)
		end
		shownCoins = profile.coins
		boostLabel.Text = utf8.char(0x1F43E) .. " " .. Format.multiplier(State.multiplier())
		if State.memory then
			memoryLabel.Text = Strings.get("studioSave")
		end
		refreshBanner()
	end)
	State.worldChanged:Connect(refreshBanner)
	State.languageChanged:Connect(Hud.refresh)
end

-- Brief "Saved" note where the Studio notice lives (the server pushes "saved" after each save).
local savedToken = 0
function Hud.showSaved()
	if State.memory then
		return
	end
	savedToken += 1
	local token = savedToken
	memoryLabel.Text = utf8.char(0x1F4BE) .. " " .. Strings.get("saved")
	memoryLabel.TextColor3 = Color.hex("#a8ffbf")
	memoryLabel.TextTransparency = 0
	task.delay(2.5, function()
		if token == savedToken then
			Anim.tween(memoryLabel, 0.6, { TextTransparency = 1 })
		end
	end)
	task.delay(3.2, function()
		if token == savedToken then
			memoryLabel.Text = ""
			memoryLabel.TextTransparency = 0
		end
	end)
end

function Hud.bumpCargo()
	Anim.pop(cargoChip, 0.2)
end

function Hud.flashFull()
	Anim.shake(cargoChip, 8)
	cargoChip.BackgroundColor3 = C.Red
	task.delay(0.4, function()
		cargoChip.BackgroundColor3 = C.Navy
	end)
end

-- Per-frame readouts driven by State.dive.
local diveAlpha = 0
local lowPulse = 0
RunService.RenderStepped:Connect(function(dt: number)
	local d = State.dive
	local world = State.world
	local showDive = d.inWater or d.active
	diveAlpha += ((if showDive then 1 else 0) - diveAlpha) * math.clamp(dt * 6, 0, 1)
	-- The oxygen/backpack bar is always on screen (how long you can dive, what you carry);
	-- the depth readout joins it in the water.
	depthChip.Visible = diveAlpha > 0.5
	-- The world chip steps aside while diving so the view stays clear.
	banner.Visible = diveAlpha < 0.5

	local max = math.max(1, d.max)
	local ratio = math.clamp(d.oxygen / max, 0, 1)
	oxygenBar.fill.Size = UDim2.fromScale(ratio, 1)
	oxygenBar.fill.Visible = ratio > 0.01
	oxygenBar.label.Text = if d.active then Format.seconds(d.oxygen) else Strings.get("diveTime", { t = Format.seconds(max) })
	local drain = Economy.oxygenDrain(world, math.max(0, d.depth))
	if d.active and drain >= 1.3 then
		pressureChip.Visible = true
		pressureLabel.Text = Strings.get("pressure", { x = Format.multiplier(drain) })
	else
		pressureChip.Visible = false
	end
	if d.active and ratio <= Config.Dive.OxygenDanger then
		lowPulse += dt * 8
		oxygenBar.setColors(C.Danger, C.RedDark)
		lowLabel.Text = Strings.get("lowOxygen")
		lowLabel.TextTransparency = 0.25 - math.sin(lowPulse) * 0.25
	elseif d.active and ratio <= Config.Dive.OxygenWarn then
		oxygenBar.setColors(C.Orange, C.RedDark)
		lowLabel.Text = ""
	else
		oxygenBar.setColors(C.Oxygen, C.OxygenDeep)
		lowLabel.Text = ""
	end

	local capacity = State.capacity()
	cargoLabel.Text = if d.cargo >= capacity then Strings.get("full") else string.format("%d/%d", d.cargo, capacity)
	local cargoStroke = cargoLabel:FindFirstChildOfClass("UIStroke")
	if cargoStroke then
		cargoStroke.Color = if d.cargo >= capacity then C.RedDark else C.Ink
	end

	depthLabel.Text = tostring(Economy.displayMeters(world, math.max(0, d.depth))) .. "m"
	depthMax.Text = "/ " .. tostring(Worlds.get(world).meters) .. "m"

	touchPad.Visible = Gui.isTouch() and d.swimming

	-- The world chip's one UIScale carries both the touch size and the chest pulse.
	local bannerScale = Anim.scaleOf(banner)
	if chestPulse then
		bannerScale.Scale = TOUCH_SCALE * (1 + math.sin(os.clock() * 5) * 0.03)
	elseif bannerScale.Scale ~= TOUCH_SCALE then
		bannerScale.Scale = TOUCH_SCALE
	end
end)

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- UI component kit: rounded FredokaOne text with outlines, bubbly buttons with press/hover
-- animation, pills, progress bars, drawn icons and modal panels.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Anim = require(script.Parent.Anim)
local Theme = require(script.Parent.Theme)

local Kit = {}

local C = Theme.C

Kit.clickSound = nil :: (() -> ())?
Kit.hoverSound = nil :: (() -> ())?

local TEXT_CLASSES = { TextLabel = true, TextButton = true, TextBox = true }

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	if TEXT_CLASSES[className] then
		-- Every text object defaults to the rounded font, even text-less button containers.
		(instance :: any).FontFace = Theme.Font
	end
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Kit.corner(gui: GuiObject, radius: number?): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Radius.Medium), Parent = gui })
end

function Kit.round(gui: GuiObject): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = gui })
end

function Kit.stroke(gui: GuiObject, color: Color3?, thickness: number?, contextual: boolean?): UIStroke
	return Kit.new("UIStroke", {
		Color = color or C.Outline,
		Thickness = thickness or 3,
		ApplyStrokeMode = if contextual then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = gui,
	})
end

-- A second, larger stroke layered behind the normal one, breathing in thickness and transparency
-- for a glowing neon-sign look (used for the Operator's name everywhere it appears).
function Kit.neon(gui: GuiObject, color: Color3): UIStroke
	local glow = Kit.new("UIStroke", {
		Name = "NeonGlow",
		Color = color,
		Thickness = 2,
		Transparency = 0.25,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = gui,
	}) :: UIStroke
	TweenService
		:Create(glow, TweenInfo.new(0.85, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 6, Transparency = 0.75 })
		:Play()
	return glow
end

-- Animated "chroma" colour sweep: a looping gradient sliding across `parent` (a text label,
-- frame or UIStroke). Text and strokes take the gradient's colours directly, so labels should use
-- a white TextColor3.
function Kit.chroma(parent: Instance, colors: { Color3 }, seconds: number?): UIGradient
	local keypoints = {}
	local count = #colors
	for i = 0, count do
		table.insert(keypoints, ColorSequenceKeypoint.new(i / count, colors[i % count + 1]))
	end
	local gradient = Kit.new("UIGradient", {
		Name = "Chroma",
		Color = ColorSequence.new(keypoints),
		Offset = Vector2.new(-0.5, 0),
		Parent = parent,
	}) :: UIGradient
	TweenService:Create(gradient, TweenInfo.new(seconds or 2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), {
		Offset = Vector2.new(0.5, 0),
	}):Play()
	return gradient
end

function Kit.gradient(gui: GuiObject, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return Kit.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90, Parent = gui })
end

function Kit.padding(gui: GuiObject, top: number, right: number?, bottom: number?, left: number?): UIPadding
	return Kit.new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right or top),
		PaddingBottom = UDim.new(0, bottom or top),
		PaddingLeft = UDim.new(0, left or right or top),
		Parent = gui,
	})
end

function Kit.list(
	gui: GuiObject,
	direction: Enum.FillDirection,
	spacing: number,
	hAlign: Enum.HorizontalAlignment?,
	vAlign: Enum.VerticalAlignment?
): UIListLayout
	return Kit.new("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, spacing),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = gui,
	})
end

export type TextProps = {
	Text: string?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	TextSize: number?,
	Color: Color3?,
	Stroke: number?,
	StrokeColor: Color3?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	Parent: Instance?,
	ZIndex: number?,
	Wrapped: boolean?,
	Rich: boolean?,
	Name: string?,
	LayoutOrder: number?,
	AutoX: boolean?,
}

function Kit.text(props: TextProps): TextLabel
	local label = Kit.new("TextLabel", {
		Name = props.Name or "Text",
		BackgroundTransparency = 1,
		FontFace = Theme.Font,
		Text = props.Text or "",
		TextSize = props.TextSize or 22,
		TextColor3 = props.Color or C.White,
		Size = props.Size or UDim2.new(1, 0, 0, (props.TextSize or 22) + 6),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrapped == true,
		RichText = props.Rich == true,
		ZIndex = props.ZIndex or 1,
		LayoutOrder = props.LayoutOrder or 0,
		AutomaticSize = if props.AutoX then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		Parent = props.Parent,
	})
	local thickness = props.Stroke or Theme.TextStroke
	if thickness > 0 then
		Kit.new("UIStroke", {
			Color = props.StrokeColor or C.Ink,
			Thickness = thickness,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = label,
		})
	end
	return label
end

-- Soft drop shadow: a sibling placed just behind `gui` (call after `gui` is parented).
function Kit.shadow(gui: GuiObject, offset: number?, radius: number?): Frame
	local shadow = Kit.new("Frame", {
		Name = gui.Name .. "Shadow",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.7,
		Size = gui.Size,
		Position = gui.Position + UDim2.fromOffset(0, offset or 5),
		AnchorPoint = gui.AnchorPoint,
		ZIndex = gui.ZIndex - 1,
		LayoutOrder = gui.LayoutOrder,
		Parent = gui.Parent,
	})
	Kit.corner(shadow, radius or Theme.Radius.Medium)
	return shadow
end

export type ButtonProps = {
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Text: string?,
	TextSize: number?,
	Palette: string?,
	Icon: string?,
	IconSize: number?,
	Radius: number?,
	LayoutOrder: number?,
	ZIndex: number?,
	Name: string?,
	OnClick: (() -> ())?,
	Stroke: number?,
}

export type ButtonApi = {
	button: TextButton,
	label: TextLabel,
	icon: TextLabel?,
	setText: (string) -> (),
	setPalette: (string) -> (),
	setEnabled: (boolean) -> (),
	enabled: boolean,
}

function Kit.button(props: ButtonProps): ButtonApi
	local palette = Theme.Buttons[props.Palette or "Blue"] or Theme.Buttons.Blue
	local radius = props.Radius or Theme.Radius.Medium
	local button = Kit.new("TextButton", {
		Name = props.Name or "Button",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = props.Size or UDim2.fromOffset(160, 54),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 2,
		Parent = props.Parent,
	}) :: TextButton
	Kit.corner(button, radius)
	local gradient = Kit.gradient(button, palette[1], palette[2])
	local stroke = Kit.stroke(button, palette[3], props.Stroke or 3)
	-- Glossy highlight on the upper half. Circular buttons get a smaller centred highlight so it
	-- stays inside the curve (children are not clipped to a UICorner).
	local size = props.Size or UDim2.fromOffset(160, 54)
	local circular = radius * 2 >= math.min(size.X.Offset, size.Y.Offset) - 2 and size.X.Offset > 0
	local gloss = Kit.new("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.78,
		Size = if circular then UDim2.fromScale(0.62, 0.34) else UDim2.new(1, -10, 0.42, 0),
		Position = if circular then UDim2.fromScale(0.19, 0.09) else UDim2.fromOffset(5, 4),
		ZIndex = button.ZIndex,
		Parent = button,
	})
	if circular then
		Kit.round(gloss)
	else
		Kit.corner(gloss, math.max(4, radius - 4))
	end
	local content = Kit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = button.ZIndex + 1,
		Parent = button,
	})
	Kit.list(content, Enum.FillDirection.Horizontal, 6)
	local icon: TextLabel? = nil
	if props.Icon then
		icon = Kit.text({
			Name = "Icon",
			Text = props.Icon,
			TextSize = props.IconSize or (props.TextSize or 24) + 4,
			Size = UDim2.fromOffset((props.IconSize or 28) + 4, (props.IconSize or 28) + 4),
			Stroke = 0,
			ZIndex = button.ZIndex + 1,
			LayoutOrder = 1,
			Parent = content,
		})
	end
	local label = Kit.text({
		Name = "Label",
		Text = props.Text or "",
		TextSize = props.TextSize or 24,
		Size = UDim2.new(0, 0, 1, 0),
		AutoX = true,
		ZIndex = button.ZIndex + 1,
		LayoutOrder = 2,
		StrokeColor = palette[3],
		Parent = content,
	})
	if (props.Text or "") == "" then
		label.Visible = false
	end

	local api: ButtonApi = {
		button = button,
		label = label,
		icon = icon,
		enabled = true,
		setText = function(_) end,
		setPalette = function(_) end,
		setEnabled = function(_) end,
	}
	api.setText = function(text: string)
		label.Text = text
		label.Visible = text ~= ""
	end
	api.setPalette = function(name: string)
		local p = Theme.Buttons[name] or Theme.Buttons.Blue
		gradient.Color = ColorSequence.new(p[1], p[2])
		stroke.Color = p[3]
		local labelStroke = label:FindFirstChildOfClass("UIStroke")
		if labelStroke then
			labelStroke.Color = p[3]
		end
	end
	api.setEnabled = function(enabled: boolean)
		api.enabled = enabled
		button.Active = enabled
		button.AutoButtonColor = false
		content.Visible = true
		gloss.Visible = enabled
	end

	local scale = Anim.scaleOf(button)
	local hovering = false
	button.MouseEnter:Connect(function()
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			return
		end
		hovering = true
		Anim.tween(scale, 0.15, { Scale = 1.05 }, Enum.EasingStyle.Back)
		if Kit.hoverSound then
			Kit.hoverSound()
		end
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		Anim.tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Anim.tween(scale, 0.08, { Scale = 0.92 })
	end)
	button.MouseButton1Up:Connect(function()
		Anim.tween(scale, 0.3, { Scale = if hovering then 1.05 else 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(function()
		if not api.enabled then
			Anim.shake(button, 4)
			return
		end
		if Kit.clickSound then
			Kit.clickSound()
		end
		if props.OnClick then
			props.OnClick()
		end
	end)
	return api
end

-- Rounded translucent navy capsule used by HUD readouts.
function Kit.pill(props: {
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Name: string?,
	Transparency: number?,
	Outline: number?,
}): Frame
	local frame = Kit.new("Frame", {
		Name = props.Name or "Pill",
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = props.Transparency or 0.18,
		Size = props.Size or UDim2.fromOffset(200, 52),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Parent = props.Parent,
	})
	Kit.round(frame)
	Kit.stroke(frame, C.Outline, props.Outline or 3)
	Kit.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 214, 230))
	return frame
end

export type ProgressApi = { frame: Frame, fill: Frame, label: TextLabel, set: (number, string?) -> (), setColors: (Color3, Color3) -> () }

function Kit.progress(props: {
	Parent: Instance?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Colors: { Color3 }?,
	TextSize: number?,
	Outline: number?,
	LabelStroke: number?,
}): ProgressApi
	local frame = Kit.new("Frame", {
		Name = "Progress",
		BackgroundColor3 = C.Ink,
		BackgroundTransparency = 0.35,
		Size = props.Size or UDim2.fromOffset(300, 24),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		ClipsDescendants = false,
		Parent = props.Parent,
	})
	Kit.round(frame)
	Kit.stroke(frame, C.Outline, props.Outline or 3)
	local fill = Kit.new("Frame", {
		Name = "Fill",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(0, 1),
		Parent = frame,
	})
	Kit.round(fill)
	local colors = props.Colors or { C.Cyan, C.Blue }
	local gradient = Kit.gradient(fill, colors[1], colors[2])
	local shine = Kit.new("Frame", {
		Name = "Shine",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.65,
		Size = UDim2.new(1, -8, 0.35, 0),
		Position = UDim2.fromOffset(4, 2),
		Parent = fill,
	})
	Kit.round(shine)
	local label =
		Kit.text({ Text = "", TextSize = props.TextSize or 16, Size = UDim2.fromScale(1, 1), ZIndex = 3, Stroke = props.LabelStroke, Parent = frame })
	local api: ProgressApi = {
		frame = frame,
		fill = fill,
		label = label,
		set = function(_, _) end,
		setColors = function(_, _) end,
	}
	api.set = function(ratio: number, text: string?)
		ratio = math.clamp(ratio, 0, 1)
		Anim.tween(fill, 0.35, { Size = UDim2.fromScale(ratio, 1) })
		fill.Visible = ratio > 0.01
		if text then
			label.Text = text
		end
	end
	api.setColors = function(a: Color3, b: Color3)
		gradient.Color = ColorSequence.new(a, b)
	end
	return api
end

-- Drawn icons ----------------------------------------------------------------------------------

Kit.Icons = {}

function Kit.Icons.coin(size: number, parent: Instance?): Frame
	local coin = Kit.new("Frame", { Name = "Coin", Size = UDim2.fromOffset(size, size), BackgroundColor3 = C.Gold, Parent = parent })
	Kit.round(coin)
	Kit.stroke(coin, C.GoldDark, math.max(2, size * 0.07))
	Kit.gradient(coin, Color3.fromRGB(255, 236, 140), Color3.fromRGB(255, 176, 40))
	local inner = Kit.new("Frame", {
		Size = UDim2.fromScale(0.62, 0.62),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromRGB(255, 214, 80),
		Parent = coin,
	})
	Kit.round(inner)
	Kit.stroke(inner, Color3.fromRGB(230, 160, 30), math.max(1.5, size * 0.05))
	local shine = Kit.new("Frame", {
		Size = UDim2.fromScale(0.22, 0.22),
		Position = UDim2.fromScale(0.24, 0.2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.15,
		Parent = coin,
	})
	Kit.round(shine)
	return coin
end

function Kit.Icons.bubble(size: number, parent: Instance?): Frame
	local bubble = Kit.new("Frame", { Name = "Bubble", Size = UDim2.fromOffset(size, size), BackgroundColor3 = C.Oxygen, Parent = parent })
	Kit.round(bubble)
	Kit.stroke(bubble, Color3.fromRGB(20, 90, 150), math.max(2, size * 0.07))
	Kit.gradient(bubble, Color3.fromRGB(170, 245, 255), Color3.fromRGB(40, 160, 255))
	local shine = Kit.new("Frame", {
		Size = UDim2.fromScale(0.34, 0.2),
		Position = UDim2.fromScale(0.2, 0.18),
		Rotation = -30,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.1,
		Parent = bubble,
	})
	Kit.round(shine)
	local small = Kit.new("Frame", {
		Size = UDim2.fromScale(0.3, 0.3),
		Position = UDim2.fromScale(0.78, 0.72),
		BackgroundColor3 = Color3.fromRGB(150, 235, 255),
		Parent = bubble,
	})
	Kit.round(small)
	Kit.stroke(small, Color3.fromRGB(20, 90, 150), 1.5)
	return bubble
end

function Kit.Icons.bag(size: number, parent: Instance?): Frame
	local holder = Kit.new("Frame", { Name = "Bag", Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Parent = parent })
	local body = Kit.new("Frame", {
		Size = UDim2.fromScale(0.86, 0.72),
		Position = UDim2.fromScale(0.5, 1),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = C.Orange,
		Parent = holder,
	})
	Kit.corner(body, math.floor(size * 0.22))
	Kit.stroke(body, Color3.fromRGB(122, 64, 12), math.max(2, size * 0.07))
	Kit.gradient(body, Color3.fromRGB(255, 200, 110), Color3.fromRGB(240, 130, 40))
	local handle = Kit.new("Frame", {
		Size = UDim2.fromScale(0.46, 0.34),
		Position = UDim2.fromScale(0.5, 0.06),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	Kit.corner(handle, math.floor(size * 0.18))
	Kit.stroke(handle, Color3.fromRGB(122, 64, 12), math.max(2, size * 0.08))
	local pocket = Kit.new("Frame", {
		Size = UDim2.fromScale(0.5, 0.26),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(255, 220, 150),
		Parent = holder,
	})
	Kit.corner(pocket, math.floor(size * 0.1))
	return holder
end

function Kit.Icons.emoji(text: string, size: number, parent: Instance?): TextLabel
	return Kit.text({ Text = text, TextSize = size, Size = UDim2.fromOffset(size + 6, size + 6), Stroke = 0, Parent = parent })
end

-- Toggle switch.
export type ToggleApi = { frame: TextButton, set: (boolean) -> () }

function Kit.toggle(
	props: { Parent: Instance?, Position: UDim2?, AnchorPoint: Vector2?, Value: boolean, OnChange: (boolean) -> (), LayoutOrder: number? }
): ToggleApi
	local value = props.Value
	local frame = Kit.new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(86, 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = if value then C.Green else C.Gray,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}) :: TextButton
	Kit.round(frame)
	Kit.stroke(frame, C.Outline, 3)
	local knob = Kit.new("Frame", {
		Size = UDim2.fromOffset(32, 32),
		Position = if value then UDim2.new(1, -36, 0.5, 0) else UDim2.new(0, 4, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = frame,
	})
	Kit.round(knob)
	Kit.stroke(knob, C.Outline, 2)
	local api: ToggleApi = { frame = frame, set = function(_) end }
	api.set = function(v: boolean)
		value = v
		Anim.tween(frame, 0.2, { BackgroundColor3 = if v then C.Green else C.Gray })
		Anim.tween(knob, 0.25, { Position = if v then UDim2.new(1, -36, 0.5, 0) else UDim2.new(0, 4, 0.5, 0) }, Enum.EasingStyle.Back)
	end
	frame.Activated:Connect(function()
		if Kit.clickSound then
			Kit.clickSound()
		end
		api.set(not value)
		props.OnChange(value)
	end)
	return api
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Offers</string>
              <string name="Source"><![CDATA[--!strict
-- Purchase offers: a small card that slides in from the right when an item is relevant
-- (backpack full, blacked out, short on coins) plus an occasional rotating suggestion. Rate
-- limited by Config.OfferGap / OfferRepeat / OfferMaxPerSession, and never over an open panel.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Purchase = require(script.Parent.Purchase)
local Theme = require(script.Parent.Theme)

local Offers = {}

local C = Theme.C
local SHOW_FOR = 14
local WIDTH = 340
-- Clears the right-hand HUD column (one column on desktop, two on phones).
local RIGHT = if Gui.isTouch() then 236 else 112

-- reason -> { item key, headline string key, icon }
local REASONS: { [string]: { key: string, line: string, icon: string } } = {
	full = { key = "AutoSell", line = "offer.full", icon = utf8.char(0x1F4B8) },
	blackout = { key = "SwiftFins", line = "offer.blackout", icon = utf8.char(0x1F42C) },
	unlock = { key = "UnlockBoost", line = "offer.unlock", icon = utf8.char(0x1F513) },
	starter = { key = "StarterPack", line = "offer.starter", icon = utf8.char(0x1F381) },
	double = { key = "DoubleCoins", line = "offer.double", icon = utf8.char(0x1F4B0) },
	boost = { key = "TimedBoost", line = "offer.boost", icon = utf8.char(0x26A1) },
	eggs = { key = "LuckyEggs", line = "offer.eggs", icon = utf8.char(0x1F340) },
	rank = { key = "TimedBoost", line = "offer.rank", icon = utf8.char(0x1F4C8) },
	rankDouble = { key = "DoubleCoins", line = "offer.rank", icon = utf8.char(0x1F3C6) },
	coins = { key = "CoinsMedium", line = "offer.coins", icon = utf8.char(0x1F4B0) },
	godShark = { key = "GodShark", line = "offer.godShark", icon = utf8.char(0x1F988) },
}

-- `rankOf` gives a UserId's weekly ranking position (nil when outside the top 10).
function Offers.init(app: any, starterLeft: () -> number?, rankOf: (number) -> number?)
	local card = Kit.new("Frame", {
		Name = "Offer",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(WIDTH, 132),
		Position = UDim2.new(1, WIDTH + 40, 0.5, -30),
		AnchorPoint = Vector2.new(1, 0.5),
		Visible = false,
		ZIndex = 10,
		Parent = Gui.hud,
	}) :: Frame
	Kit.corner(card, 18)
	Kit.gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(214, 238, 255))
	Kit.stroke(card, C.Outline, 3)
	if Gui.isTouch() then
		local scale = Instance.new("UIScale")
		scale.Scale = 1.1
		scale.Parent = card
	end
	local icon = Kit.text({
		Text = "",
		TextSize = 46,
		Size = UDim2.fromOffset(64, 64),
		Position = UDim2.fromOffset(10, 14),
		Stroke = 0,
		ZIndex = 11,
		Parent = card,
	})
	local line = Kit.text({
		Text = "",
		TextSize = 15,
		Color = C.Pink,
		Stroke = 0,
		Size = UDim2.new(1, -120, 0, 20),
		Position = UDim2.fromOffset(80, 10),
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 11,
		Parent = card,
	})
	local name = Kit.text({
		Text = "",
		TextSize = 22,
		Color = C.Navy,
		Stroke = 0,
		Size = UDim2.new(1, -96, 0, 26),
		Position = UDim2.fromOffset(80, 30),
		XAlign = Enum.TextXAlignment.Left,
		ZIndex = 11,
		Parent = card,
	})
	local desc = Kit.text({
		Text = "",
		TextSize = 14,
		Color = C.Muted,
		Stroke = 0,
		Wrapped = true,
		Size = UDim2.new(1, -96, 0, 34),
		Position = UDim2.fromOffset(80, 56),
		XAlign = Enum.TextXAlignment.Left,
		YAlign = Enum.TextYAlignment.Top,
		ZIndex = 11,
		Parent = card,
	})

	local current: string? = nil
	local token = 0

	local function hide()
		if not card.Visible then
			return
		end
		token += 1
		local mine = token
		Anim.tween(card, 0.25, { Position = UDim2.new(1, WIDTH + 40, 0.5, -30) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.3, function()
			if mine == token then
				card.Visible = false
			end
		end)
	end

	local buy = Kit.button({
		Name = "Buy",
		Text = "",
		TextSize = 18,
		Palette = "Green",
		Size = UDim2.fromOffset(150, 34),
		Position = UDim2.new(1, -12, 1, -10),
		AnchorPoint = Vector2.new(1, 1),
		Radius = 12,
		Stroke = 2,
		ZIndex = 11,
		Parent = card,
		OnClick = function()
			local key = current
			hide()
			if key and not Purchase.prompt(key, app.State.passes) then
				app.Toasts.show(Strings.get("comingSoon"), "info")
			end
		end,
	})
	buy.button.ZIndex = 11
	local close = Kit.button({
		Name = "Close",
		Text = "X",
		TextSize = 16,
		Palette = "Gray",
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, -8, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		Radius = 14,
		Stroke = 2,
		ZIndex = 12,
		Parent = card,
		OnClick = hide,
	})
	close.button.ZIndex = 12

	local lastShown = -math.huge
	local lastByKey: { [string]: number } = {}
	local shownCount = 0

	local function eligible(reason: string): boolean
		local spec = REASONS[reason]
		local def = spec and Purchase.find(spec.key)
		if not def or def.id <= 0 or app.State.passes[spec.key] then
			return false
		end
		local profile = app.State.profile
		if not profile then
			return false
		end
		if spec.key == "StarterPack" and profile.starterPackGranted then
			return false
		end
		if spec.key == "TimedBoost" and profile.boostUntil > os.time() then
			return false
		end
		return true
	end

	-- Shows the offer for `reason` if it is relevant and the rate limits allow it.
	function Offers.trigger(reason: string): boolean
		local now = os.clock()
		if
			not eligible(reason)
			or shownCount >= Config.OfferMaxPerSession
			or now - lastShown < Config.OfferGap
			or now - (lastByKey[REASONS[reason].key] or -math.huge) < Config.OfferRepeat
			or app.isUiBlocking()
			or app.State.traveling
		then
			return false
		end
		local spec = REASONS[reason]
		local found, kind = Purchase.find(spec.key)
		local def = found :: Purchase.Def
		lastShown = now
		lastByKey[spec.key] = now
		shownCount += 1
		current = spec.key
		icon.Text = spec.icon
		local left = if spec.key == "StarterPack" then starterLeft() else nil
		line.Text = if left then Strings.get("endsIn", { t = Format.clock(left) }) else Strings.get(spec.line)
		name.Text = Strings.get(tostring(kind) .. "." .. spec.key)
		desc.Text = Strings.get(tostring(kind) .. "." .. spec.key .. ".desc", { n = Config.TimedBoostMinutes })
		buy.setText("R$ " .. tostring(def.price))
		token += 1
		local mine = token
		card.Visible = true
		card.Position = UDim2.new(1, WIDTH + 40, 0.5, -30)
		Anim.tween(card, 0.4, { Position = UDim2.new(1, -RIGHT, 0.5, -30) }, Enum.EasingStyle.Back)
		if app.Sfx then
			app.Sfx.play("Open")
		end
		task.delay(SHOW_FOR, function()
			if mine == token then
				hide()
			end
		end)
		return true
	end

	-- What this diver is missing right now, most relevant first: the starter pack, a push up the
	-- weekly ranking, the next world's fee, pets, then general boosts.
	local function needs(): { string }
		local list = { "starter", "godShark" }
		local profile = app.State.profile
		if not profile then
			return list
		end
		local rank = rankOf(Players.LocalPlayer.UserId)
		if not rank or rank > 3 then
			table.insert(list, "rank")
			table.insert(list, "rankDouble")
		end
		local nextWorld = profile.unlocked + 1
		local current = profile.worlds[tostring(profile.unlocked)]
		if nextWorld <= Config.WorldCount and current and current.cleared and profile.coins < Economy.unlockCost(nextWorld) then
			table.insert(list, "unlock")
		end
		if next(profile.pets) == nil then
			table.insert(list, "eggs")
		end
		for _, reason in { "full", "double", "boost", "eggs", "coins" } do
			table.insert(list, reason)
		end
		return list
	end

	-- A suggestion every OfferGap (3 minutes), the first after OfferFirstDelay.
	task.spawn(function()
		task.wait(Config.OfferFirstDelay)
		while true do
			for _, reason in needs() do
				if Offers.trigger(reason) then
					break
				end
			end
			task.wait(Config.OfferGap)
		end
	end)
end

return Offers
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="87">
            <Properties>
              <string name="Name">Overlays</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">Panel</string>
              <string name="Source"><![CDATA[--!strict
-- Modal panel: dimmed backdrop, rounded window with a coloured header ribbon and close button.
-- Only one panel is open at a time.

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Panel = {}

local C = Theme.C

export type PanelApi = {
	root: Frame,
	window: Frame,
	body: Frame,
	title: TextLabel,
	isOpen: boolean,
	open: () -> (),
	close: () -> (),
	toggle: () -> (),
	setTitle: (string) -> (),
	onOpen: (() -> ())?,
	onClose: (() -> ())?,
}

local current: PanelApi? = nil

function Panel.closeAll()
	if current then
		current.close()
	end
end

function Panel.current(): PanelApi?
	return current
end

export type PanelProps = { Parent: Instance, Title: string, Icon: string?, Palette: string?, Size: Vector2? }

function Panel.new(props: PanelProps): PanelApi
	local palette = Theme.Buttons[props.Palette or "Blue"] or Theme.Buttons.Blue
	local size = props.Size or Vector2.new(720, 470)

	local root = Kit.new("Frame", {
		Name = "Panel_" .. props.Title,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 20,
		Parent = props.Parent,
	}) :: Frame
	local backdrop = Kit.new("TextButton", {
		Name = "Backdrop",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(4, 14, 28),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Parent = root,
	}) :: TextButton
	-- Holder scales as one unit; the shadow is a sibling so it renders behind the window
	-- (ScreenGuis use Sibling z-ordering: children always draw above their parent).
	local holder = Kit.new("Frame", {
		Name = "Holder",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.fromScale(0.5, 0.53),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 21,
		Parent = root,
	}) :: Frame
	local shadow = Kit.new("Frame", {
		Name = "Shadow",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, 8),
		ZIndex = 1,
		Parent = holder,
	})
	Kit.corner(shadow, Theme.Radius.Large)
	local window = Kit.new("Frame", {
		Name = "Window",
		BackgroundColor3 = C.Panel,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = holder,
	}) :: Frame
	Kit.corner(window, Theme.Radius.Large)
	Kit.stroke(window, C.Outline, 4)
	Kit.gradient(window, Color3.fromRGB(255, 255, 255), Color3.fromRGB(214, 238, 255))

	local header = Kit.new("Frame", {
		Name = "Header",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, 24, 0, 66),
		Position = UDim2.new(0.5, 0, 0, -26),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 23,
		Parent = window,
	})
	Kit.corner(header, 20)
	Kit.stroke(header, palette[3], 4)
	Kit.gradient(header, palette[1], palette[2])
	local gloss = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.8,
		Size = UDim2.new(1, -16, 0.42, 0),
		Position = UDim2.fromOffset(8, 5),
		ZIndex = 23,
		Parent = header,
	})
	Kit.corner(gloss, 14)
	local titleRow = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 24, Parent = header })
	Kit.list(titleRow, Enum.FillDirection.Horizontal, 10)
	if props.Icon then
		Kit.text({ Text = props.Icon, TextSize = 36, Size = UDim2.fromOffset(46, 46), Stroke = 0, ZIndex = 24, LayoutOrder = 1, Parent = titleRow })
	end
	local title = Kit.text({
		Text = props.Title,
		TextSize = 38,
		Size = UDim2.new(0, 0, 1, 0),
		AutoX = true,
		Stroke = 3,
		StrokeColor = palette[3],
		ZIndex = 24,
		LayoutOrder = 2,
		Parent = titleRow,
	})

	local body = Kit.new("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -36, 1, -66),
		Position = UDim2.fromOffset(18, 52),
		ZIndex = 22,
		Parent = window,
	}) :: Frame

	local api: PanelApi = {
		root = root,
		window = window,
		body = body,
		title = title,
		isOpen = false,
		open = function() end,
		close = function() end,
		toggle = function() end,
		setTitle = function(_) end,
		onOpen = nil,
		onClose = nil,
	}

	local closeButton = Kit.button({
		Name = "Close",
		Text = "X",
		TextSize = 30,
		Palette = "Red",
		Size = UDim2.fromOffset(54, 54),
		Position = UDim2.new(1, 14, 0, -34),
		AnchorPoint = Vector2.new(0.5, 0),
		Radius = 27,
		ZIndex = 26,
		Parent = window,
		OnClick = function()
			api.close()
		end,
	})
	closeButton.button.ZIndex = 26

	local scale = Anim.scaleOf(holder)
	-- Windows open a little under their design size on desktop (touch keeps full size for tap
	-- targets) and shrink further on short screens so the header ribbon and shadow always fit.
	local function fit(): number
		local canvas = Gui.canvasSize
		local base = if Gui.isTouch() then 1 else 0.9
		return math.min(base, (canvas.Y - 44) / (size.Y + 34), (canvas.X - 40) / (size.X + 24))
	end
	Gui.resized:Connect(function()
		if api.isOpen then
			scale.Scale = fit()
		end
	end)
	api.open = function()
		if api.isOpen then
			return
		end
		if current and current ~= api then
			current.close()
		end
		current = api
		api.isOpen = true
		root.Visible = true
		backdrop.BackgroundTransparency = 1
		Anim.tween(backdrop, 0.25, { BackgroundTransparency = 0.45 })
		scale.Scale = 0.82 * fit()
		Anim.tween(scale, 0.38, { Scale = fit() }, Enum.EasingStyle.Back)
		if api.onOpen then
			api.onOpen()
		end
	end
	api.close = function()
		if not api.isOpen then
			return
		end
		api.isOpen = false
		if current == api then
			current = nil
		end
		Anim.tween(backdrop, 0.18, { BackgroundTransparency = 1 })
		local tween = Anim.tween(scale, 0.18, { Scale = 0.85 * fit() }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tween.Completed:Once(function()
			if not api.isOpen then
				root.Visible = false
			end
		end)
		if api.onClose then
			api.onClose()
		end
	end
	api.toggle = function()
		if api.isOpen then
			api.close()
		else
			api.open()
		end
	end
	api.setTitle = function(text: string)
		title.Text = text
	end
	backdrop.Activated:Connect(api.close)
	return api
end

return Panel
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="89">
            <Properties>
              <string name="Name">Panels</string>
            </Properties>
            <Item class="ModuleScript" referent="90">
              <Properties>
                <string name="Name">Egg</string>
                <string name="Source"><![CDATA[--!strict
-- Egg stand panel: the world's egg, every pet inside with its chance, Hatch / Hatch x3 / Auto.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Anim = require(script.Parent.Parent.Anim)
local Kit = require(script.Parent.Parent.Kit)
local Panel = require(script.Parent.Parent.Panel)
local Theme = require(script.Parent.Parent.Theme)
local Viewport = require(script.Parent.Parent.Viewport)

local EggPanel = {}

local C = Theme.C

export type EggPanelApi = Panel.PanelApi & { openWorld: (number) -> () }

function EggPanel.new(app: any): EggPanelApi
	local panel =
		Panel.new({ Parent = app.Gui.panels, Title = "", Icon = utf8.char(0x1F95A), Palette = "Purple", Size = Vector2.new(860, 540) }) :: any
	local body = panel.body
	local world = 1
	local auto = false
	local busy = false
	local setAuto: (boolean) -> () = function() end

	local stage = Kit.new(
		"Frame",
		{ BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(0, 280, 1, -30), Position = UDim2.fromOffset(0, 24), Parent = body }
	)
	Kit.corner(stage, 20)
	Kit.stroke(stage, C.PanelLine, 3)
	local stageGradient = Kit.gradient(stage, Color3.fromRGB(255, 255, 255), Color3.fromRGB(220, 235, 255))
	local eggView = Viewport.new(stage, UDim2.fromOffset(220, 220), UDim2.new(0.5, 0, 0, 6), Vector2.new(0.5, 0))
	eggView.setSpin(true)
	-- World number on its own small line so long world names still fit the column.
	local worldLabel = Kit.text({
		Text = "",
		TextSize = 18,
		Color = C.Muted,
		Stroke = 0,
		Size = UDim2.new(1, -16, 0, 22),
		Position = UDim2.new(0.5, 0, 0, 226),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = stage,
	})
	local eggName = Kit.text({
		Text = "",
		TextSize = 24,
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.new(0.5, 0, 0, 248),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = stage,
	})
	local costPill =
		Kit.pill({ Size = UDim2.fromOffset(190, 50), Position = UDim2.new(0.5, 0, 0, 288), AnchorPoint = Vector2.new(0.5, 0), Parent = stage })
	local coin = Kit.Icons.coin(40, costPill)
	coin.Position = UDim2.fromOffset(6, 5)
	local costLabel = Kit.text({
		Text = "",
		TextSize = 28,
		Size = UDim2.new(1, -54, 1, 0),
		Position = UDim2.fromOffset(50, 0),
		XAlign = Enum.TextXAlignment.Left,
		Parent = costPill,
	})
	local autoRow = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 44),
		Position = UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = stage,
	})
	local autoLabel = Kit.text({
		Text = "Auto",
		TextSize = 22,
		Color = C.Navy,
		Stroke = 0,
		Size = UDim2.new(1, -96, 1, 0),
		XAlign = Enum.TextXAlignment.Left,
		Parent = autoRow,
	})
	local autoToggle = Kit.toggle({
		Value = false,
		Position = UDim2.new(1, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Parent = autoRow,
		OnChange = function(value)
			setAuto(value)
		end,
	})
	-- While auto-hatching the panel is hidden behind the hatch animation, so the way out lives
	-- on the overlay layer, above it.
	local stopAuto = Kit.button({
		Name = "StopAutoHatch",
		Text = "",
		TextSize = 24,
		Palette = "Red",
		Size = UDim2.fromOffset(300, 60),
		Position = UDim2.new(0.5, 0, 1, -24),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = app.Gui.overlay,
		OnClick = function()
			setAuto(false)
		end,
	})
	stopAuto.button.ZIndex = 50
	stopAuto.button.Visible = false
	setAuto = function(value: boolean)
		auto = value
		autoToggle.set(value)
		stopAuto.button.Visible = value and busy
	end

	local chancesTitle = Kit.text({
		Text = "",
		TextSize = 24,
		Color = C.Navy,
		Stroke = 0,
		Size = UDim2.new(1, -300, 0, 30),
		Position = UDim2.new(1, 0, 0, 24),
		AnchorPoint = Vector2.new(1, 0),
		XAlign = Enum.TextXAlignment.Left,
		Parent = body,
	})
	local grid = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -300, 0, 300),
		Position = UDim2.new(1, 0, 0, 60),
		AnchorPoint = Vector2.new(1, 0),
		Parent = body,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(160, 140),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		Parent = grid,
	})

	local buttons = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -300, 0, 70),
		Position = UDim2.new(1, 0, 1, -8),
		AnchorPoint = Vector2.new(1, 1),
		Parent = body,
	})
	Kit.list(buttons, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)

	local function doHatch(count: number)
		if busy then
			return
		end
		busy = true
		local result = app.Net.invoke("Hatch", { world = world, count = count })
		if not result.ok then
			busy = false
			setAuto(false)
			app.Sfx.play("Error")
			app.Toasts.show(Strings.get(result.err or "err.generic", { n = "" }), "bad")
			return
		end
		panel.root.Visible = false
		stopAuto.button.Visible = auto
		app.Hatch.play(world, result.data.results, function()
			busy = false
			stopAuto.button.Visible = false
			if panel.isOpen then
				panel.root.Visible = true
			end
			if auto and panel.isOpen then
				local profile = app.State.profile
				if profile and profile.coins >= Economy.eggCost(world) * count then
					task.delay(0.25, function()
						doHatch(count)
					end)
				else
					setAuto(false)
				end
			end
		end)
	end

	local hatchOne = Kit.button({
		Name = "Hatch1",
		Text = "",
		TextSize = 17,
		Palette = "Green",
		Size = UDim2.fromOffset(166, 64),
		LayoutOrder = 1,
		Parent = buttons,
		OnClick = function()
			doHatch(1)
		end,
	})
	local hatchThree = Kit.button({
		Name = "Hatch3",
		Text = "",
		TextSize = 17,
		Palette = "Gold",
		Size = UDim2.fromOffset(166, 64),
		LayoutOrder = 2,
		Parent = buttons,
		OnClick = function()
			doHatch(3)
		end,
	})
	local hatchFive = Kit.button({
		Name = "Hatch5",
		Text = "",
		TextSize = 17,
		Palette = "Pink",
		Size = UDim2.fromOffset(166, 64),
		LayoutOrder = 3,
		Parent = buttons,
		OnClick = function()
			doHatch(5)
		end,
	})

	local petCards: { Instance } = {}

	local function rebuild()
		for _, card in petCards do
			card:Destroy()
		end
		table.clear(petCards)
		local data = Worlds.get(world)
		local profile = app.State.profile
		local chances = Economy.eggChances(world, app.State.passes.LuckyEggs == true)
		for order, entry in chances do
			local pet = Worlds.pets[entry.key]
			local rarity = Config.Rarities[pet.rarity]
			local color = Theme.Rarity[rarity]
			local owned = profile ~= nil and profile.index[entry.key] == true
			local card = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, Parent = grid })
			Kit.corner(card, 16)
			Kit.gradient(card, color:Lerp(Color3.new(1, 1, 1), 0.6), color, 90)
			Kit.stroke(card, color:Lerp(Color3.new(0, 0, 0), 0.5), 3)
			local view = Viewport.new(card, UDim2.fromOffset(110, 78), UDim2.new(0.5, 0, 0, 2), Vector2.new(0.5, 0))
			if pet.secret and not owned then
				Kit.text({
					Text = "?",
					TextSize = 56,
					Size = UDim2.fromOffset(110, 78),
					Position = UDim2.new(0.5, 0, 0, 2),
					AnchorPoint = Vector2.new(0.5, 0),
					Parent = card,
				})
				view.frame.Visible = false
			else
				view.setModel(Viewport.pet(entry.key))
				view.setSpin(true)
			end
			Kit.text({
				Text = if pet.secret and not owned then "???" else Strings.name(pet.name),
				TextSize = 16,
				Size = UDim2.new(1, -6, 0, 20),
				Position = UDim2.new(0.5, 0, 0, 80),
				AnchorPoint = Vector2.new(0.5, 0),
				StrokeColor = color:Lerp(Color3.new(0, 0, 0), 0.6),
				Parent = card,
			})
			Kit.text({
				Text = Format.percent(entry.chance),
				TextSize = 20,
				Size = UDim2.new(1, 0, 0, 24),
				Position = UDim2.new(0, 0, 1, -28),
				Color = Color3.fromRGB(255, 255, 210),
				StrokeColor = color:Lerp(Color3.new(0, 0, 0), 0.6),
				Parent = card,
			})
			if owned then
				local tick = Kit.new("Frame", {
					BackgroundColor3 = C.Green,
					Size = UDim2.fromOffset(24, 24),
					Position = UDim2.new(1, -4, 0, 4),
					AnchorPoint = Vector2.new(1, 0),
					Parent = card,
				})
				Kit.round(tick)
				Kit.text({ Text = utf8.char(0x2714), TextSize = 14, Size = UDim2.fromScale(1, 1), Parent = tick })
			end
			table.insert(petCards, card)
		end
		eggView.setModel(Viewport.egg(world))
		local accent = Color.hex(data.egg.accent)
		stageGradient.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), accent:Lerp(Color3.new(1, 1, 1), 0.6))
	end

	local function refresh()
		local data = Worlds.get(world)
		local cost = Economy.eggCost(world)
		local profile = app.State.profile
		panel.setTitle(Strings.name(data.egg.name))
		worldLabel.Text = Strings.get("world", { n = world })
		eggName.Text = Strings.name(data.name)
		costLabel.Text = Format.short(cost)
		chancesTitle.Text = Strings.get("chances")
		autoLabel.Text = Strings.get("autoHatch")
		stopAuto.setText(Strings.get("autoStop"))
		hatchOne.setText(Strings.get("hatch") .. "  " .. Format.short(cost))
		hatchThree.setText(Strings.get("hatch3") .. "  " .. Format.short(cost * 3))
		hatchFive.setText(Strings.get("hatch5") .. "  " .. Format.short(cost * 5))
		local coins = if profile then profile.coins else 0
		hatchOne.setPalette(if coins >= cost then "Green" else "Gray")
		hatchThree.setPalette(if coins >= cost * 3 then "Gold" else "Gray")
		hatchFive.setPalette(if coins >= cost * 5 then "Pink" else "Gray")
	end

	function panel.openWorld(w: number)
		world = w
		rebuild()
		refresh()
		panel.open()
	end

	panel.onOpen = function()
		app.Sfx.play("Open")
		Anim.pop(stage, 0.05)
	end
	panel.onClose = function()
		if not busy then
			setAuto(false)
		end
	end
	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
	app.State.languageChanged:Connect(function()
		if panel.isOpen then
			rebuild()
			refresh()
		end
	end)
	return panel
end

return EggPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="91">
              <Properties>
                <string name="Name">Gear</string>
                <string name="Source"><![CDATA[--!strict
-- Gear shop: four slots (oxygen tank, treasure bag, flippers, magnet), each with two pieces per
-- world. Buying a piece equips it when it beats the one you wear, and it shows on your avatar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Gear = require(Shared.Data.Gear)
local Strings = require(Shared.Strings)

local Anim = require(script.Parent.Parent.Anim)
local Kit = require(script.Parent.Parent.Kit)
local Panel = require(script.Parent.Parent.Panel)
local Theme = require(script.Parent.Parent.Theme)
local Viewport = require(script.Parent.Parent.Viewport)

local GearPanel = {}

local C = Theme.C

local SLOT_ICON = {
	tank = utf8.char(0x1F4A8),
	pack = utf8.char(0x1F392),
	fins = utf8.char(0x1F9BF),
	magnet = utf8.char(0x1F9F2),
}
local SLOT_PALETTE = { tank = "Cyan", pack = "Orange", fins = "Green", magnet = "Red" }

function GearPanel.statText(slot: string, value: number): string
	local shown = if slot == "fins" or slot == "magnet" then string.format("%.1f", value) else tostring(math.floor(value))
	return Strings.get("upgrade." .. slot .. ".value", { n = shown })
end

function GearPanel.itemName(item: Gear.Item): string
	local name = Strings.get("gear." .. item.slot, { theme = Strings.name(item.theme) })
	return if item.pro then Strings.get("gearPro", { name = name }) else name
end

type Card = {
	frame: Frame,
	gradient: UIGradient,
	border: UIStroke,
	view: Viewport.ViewApi,
	name: TextLabel,
	stat: TextLabel,
	pro: Frame,
	worldTag: TextLabel,
	button: Kit.ButtonApi,
	coin: Frame,
	key: string,
}

function GearPanel.new(app: any): Panel.PanelApi
	local panel = Panel.new({
		Parent = app.Gui.panels,
		Title = Strings.get("menu.upgrades"),
		Icon = utf8.char(0x1F93F),
		Palette = "Orange",
		Size = Vector2.new(920, 580),
	})
	local body = panel.body
	local slot = "tank"

	-- Slot tabs ------------------------------------------------------------------------------------
	local tabs = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 62), Position = UDim2.fromOffset(0, 20), Parent = body })
	Kit.list(tabs, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
	local tabButtons: { [string]: Kit.ButtonApi } = {}

	-- Current gear strip --------------------------------------------------------------------------
	local strip = Kit.new("Frame", {
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = 0.1,
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 90),
		Parent = body,
	})
	Kit.round(strip)
	local stripText = Kit.text({ Text = "", TextSize = 18, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(12, 0), Parent = strip })

	-- Grid ----------------------------------------------------------------------------------------
	local grid = Kit.new("ScrollingFrame", {
		BackgroundColor3 = C.PanelAlt,
		BackgroundTransparency = 0.2,
		Size = UDim2.new(1, 0, 1, -140),
		Position = UDim2.fromOffset(0, 134),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = C.NavySoft,
		BorderSizePixel = 0,
		Parent = body,
	}) :: ScrollingFrame
	Kit.corner(grid, 16)
	Kit.padding(grid, 10, 16, 10, 10)
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(154, 206),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})

	local cards: { Card } = {}
	local refresh: () -> ()

	local function onCardClick(card: Card)
		local profile = app.State.profile
		local item = Gear.get(card.key)
		if not profile or not item then
			return
		end
		if profile.gear.owned[item.key] then
			if profile.gear.equip[item.slot] == item.key then
				return
			end
			local result = app.Net.invoke("EquipGear", { key = item.key })
			app.Sfx.play(if result.ok then "Upgrade" else "Error")
			if result.ok then
				Anim.pop(card.frame, 0.06)
			end
			return
		end
		local result = app.Net.invoke("BuyGear", { key = item.key })
		if result.ok then
			app.Sfx.play("Upgrade")
			Anim.pop(card.frame, 0.08)
			app.Toasts.show(Strings.get("gearBought", { name = GearPanel.itemName(item) }), "good", SLOT_ICON[item.slot])
		else
			app.Sfx.play("Error")
			Anim.shake(card.frame, 6)
			if result.err then
				app.Toasts.show(Strings.get(result.err), "bad")
			end
		end
	end

	for index = 1, Gear.Tiers do
		local frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = index, Parent = grid }) :: Frame
		Kit.corner(frame, 16)
		local gradient = Kit.gradient(frame, Color3.new(1, 1, 1), Color3.new(1, 1, 1), 90)
		local border = Kit.stroke(frame, C.Outline, 3)
		local view = Viewport.new(frame, UDim2.fromOffset(120, 84), UDim2.new(0.5, 0, 0, 8), Vector2.new(0.5, 0))
		local pro = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.fromOffset(46, 22),
			Position = UDim2.fromOffset(6, 6),
			ZIndex = 3,
			Parent = frame,
		}) :: Frame
		Kit.round(pro)
		Kit.gradient(pro, Theme.Buttons.Gold[1], Theme.Buttons.Gold[2])
		Kit.stroke(pro, Theme.Buttons.Gold[3], 2)
		Kit.text({ Text = "PRO", TextSize = 14, Size = UDim2.fromScale(1, 1), StrokeColor = Theme.Buttons.Gold[3], ZIndex = 4, Parent = pro })
		local worldTag = Kit.text({
			Text = "",
			TextSize = 14,
			Size = UDim2.fromOffset(44, 20),
			Position = UDim2.new(1, -6, 0, 6),
			AnchorPoint = Vector2.new(1, 0),
			XAlign = Enum.TextXAlignment.Right,
			ZIndex = 3,
			Parent = frame,
		})
		local name = Kit.text({
			Text = "",
			TextSize = 16,
			Wrapped = true,
			Size = UDim2.new(1, -12, 0, 38),
			Position = UDim2.new(0.5, 0, 0, 92),
			AnchorPoint = Vector2.new(0.5, 0),
			Parent = frame,
		})
		local stat = Kit.text({
			Text = "",
			TextSize = 15,
			Color = C.Ink,
			Stroke = 0,
			Size = UDim2.new(1, -12, 0, 20),
			Position = UDim2.new(0.5, 0, 0, 130),
			AnchorPoint = Vector2.new(0.5, 0),
			Parent = frame,
		})
		local card: Card
		local button = Kit.button({
			Text = "",
			TextSize = 17,
			Palette = "Green",
			Size = UDim2.new(1, -16, 0, 42),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 1),
			Parent = frame,
			OnClick = function()
				onCardClick(card)
			end,
		})
		local coin = Kit.Icons.coin(22, button.button:FindFirstChild("Content") :: Instance)
		coin.LayoutOrder = 0
		card = {
			frame = frame,
			gradient = gradient,
			border = border,
			view = view,
			name = name,
			stat = stat,
			pro = pro,
			worldTag = worldTag,
			button = button,
			coin = coin,
			key = "",
		}
		frame.MouseEnter:Connect(function()
			view.setSpin(true)
		end)
		frame.MouseLeave:Connect(function()
			view.setSpin(false)
		end)
		table.insert(cards, card)
	end

	local function selectSlot(newSlot: string, scroll: boolean)
		slot = newSlot
		for id, tab in tabButtons do
			tab.setPalette(if id == slot then SLOT_PALETTE[id] else "Navy")
		end
		refresh()
		if scroll then
			-- Jump to the first piece you do not own yet.
			local profile = app.State.profile
			local first = 1
			if profile then
				for index, item in Gear.bySlot[slot] do
					if not profile.gear.owned[item.key] then
						first = index
						break
					end
				end
			end
			local row = math.floor((first - 1) / 5)
			grid.CanvasPosition = Vector2.new(0, row * 216)
		end
	end

	for order, id in Gear.Slots do
		local api = Kit.button({
			Text = "",
			Icon = SLOT_ICON[id],
			IconSize = 26,
			TextSize = 19,
			Palette = "Navy",
			Size = UDim2.fromOffset(206, 56),
			LayoutOrder = order,
			Parent = tabs,
			OnClick = function()
				app.Sfx.play("Click")
				selectSlot(id, true)
			end,
		})
		tabButtons[id] = api
	end

	refresh = function()
		local profile = app.State.profile
		if not profile then
			return
		end
		panel.setTitle(Strings.get("menu.upgrades"))
		for id, tab in tabButtons do
			tab.setText(Strings.get("upgrade." .. id))
		end
		local equippedKey = profile.gear.equip[slot]
		local equippedItem = Gear.get(equippedKey)
		local currentTier = Gear.tier(equippedKey)
		local currentValue = Economy.gearValue(slot, currentTier)
		stripText.Text = Strings.get("gearWearing", {
			name = if equippedItem then GearPanel.itemName(equippedItem) else Strings.get("gearStarter"),
			stat = GearPanel.statText(slot, currentValue),
		})
		for index, item in Gear.bySlot[slot] do
			local card = cards[index]
			local c1, c2 = Color.hex(item.color), Color.hex(item.accent)
			if card.key ~= item.key then
				card.key = item.key
				card.view.setModel(Viewport.gear(item.key))
			end
			card.gradient.Color = ColorSequence.new(c1:Lerp(Color3.new(1, 1, 1), 0.7), c1:Lerp(Color3.new(1, 1, 1), 0.25))
			card.name.Text = GearPanel.itemName(item)
			local nameStroke = card.name:FindFirstChildOfClass("UIStroke")
			if nameStroke then
				nameStroke.Color = c2:Lerp(Color3.new(0, 0, 0), 0.55)
			end
			card.pro.Visible = item.pro
			card.worldTag.Text = "W" .. item.world
			local value = Economy.gearValue(slot, item.tier)
			local owned = profile.gear.owned[item.key] == true
			local wearing = equippedKey == item.key
			local locked = item.world > profile.unlocked
			card.stat.Text = GearPanel.statText(slot, value)
			card.stat.TextColor3 = if value > currentValue then C.GreenDark elseif value < currentValue then C.Muted else C.Ink
			card.border.Color = if wearing then C.Gold elseif owned then C.GreenDark else C.Outline
			card.border.Thickness = if wearing then 5 else 3
			card.coin.Visible = false
			if wearing then
				card.button.setText(utf8.char(0x2714) .. " " .. Strings.get("equipped.short"))
				card.button.setPalette("Gold")
				card.button.setEnabled(false)
			elseif owned then
				card.button.setText(Strings.get("equip"))
				card.button.setPalette("Blue")
				card.button.setEnabled(true)
			elseif locked then
				card.button.setText(utf8.char(0x1F512) .. " " .. Strings.get("world", { n = item.world }))
				card.button.setPalette("Gray")
				card.button.setEnabled(false)
			else
				local cost = Economy.gearCost(item.key) :: number
				card.coin.Visible = true
				card.button.setText(Format.short(cost))
				card.button.setPalette(if profile.coins >= cost then "Green" else "Gray")
				card.button.setEnabled(true)
			end
		end
	end

	panel.onOpen = function()
		app.Sfx.play("Open")
		selectSlot(slot, true)
	end
	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
	app.State.languageChanged:Connect(refresh)
	selectSlot(slot, false)
	return panel
end

-- True when a better piece than the one worn is affordable in some slot (HUD badge).
function GearPanel.anyAffordable(profile: any): boolean
	if not profile then
		return false
	end
	for _, slot in Gear.Slots do
		local current = Gear.tier(profile.gear.equip[slot])
		for _, item in Gear.bySlot[slot] do
			if item.tier > current and item.world <= profile.unlocked and not profile.gear.owned[item.key] then
				local cost = Economy.gearCost(item.key)
				if cost and profile.coins >= cost then
					return true
				end
			end
		end
	end
	return false
end

return GearPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="92">
              <Properties>
                <string name="Name">Pets</string>
                <string name="Source"><![CDATA[--!strict
-- Pet inventory: 3D pet cards by rarity, equip/lock/delete, equip best and total boost.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)
local Mutations = require(Shared.Models.Mutations)

local Anim = require(script.Parent.Parent.Anim)
local Kit = require(script.Parent.Parent.Kit)
local Panel = require(script.Parent.Parent.Panel)
local Theme = require(script.Parent.Parent.Theme)
local Viewport = require(script.Parent.Parent.Viewport)

local PetsPanel = {}

local C = Theme.C

function PetsPanel.boostText(key: string, mutations: { string }?): string
	return Format.multiplier(1 + Economy.petPower(key, mutations))
end

local LUCKY_PRODUCT = nil :: any
for _, product in Config.Products do
	if product.enchants > 0 then
		LUCKY_PRODUCT = product
	end
end

function PetsPanel.new(app: any): Panel.PanelApi
	local panel = Panel.new({
		Parent = app.Gui.panels,
		Title = Strings.get("petsTitle"),
		Icon = utf8.char(0x1F43E),
		Palette = "Pink",
		Size = Vector2.new(940, 620),
	})
	local body = panel.body

	-- Top bar ------------------------------------------------------------------------------------
	local top = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 20), Parent = body })
	Kit.list(top, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left)
	local function chip(order: number, palette: string, width: number): TextLabel
		local frame =
			Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(width, 44), LayoutOrder = order, Parent = top })
		Kit.round(frame)
		local p = Theme.Buttons[palette]
		Kit.gradient(frame, p[1], p[2])
		Kit.stroke(frame, p[3], 3)
		return Kit.text({ Text = "", TextSize = 20, Size = UDim2.fromScale(1, 1), StrokeColor = p[3], Parent = frame })
	end
	local equippedLabel = chip(1, "Green", 170)
	local boostLabel = chip(2, "Pink", 220)
	local countLabel = chip(3, "Navy", 150)
	local equipBest = Kit.button({
		Text = "",
		TextSize = 20,
		Palette = "Gold",
		Size = UDim2.fromOffset(170, 44),
		LayoutOrder = 4,
		Parent = top,
		OnClick = function()
			local result = app.Net.invoke("EquipBest")
			app.Sfx.play(if result.ok then "Upgrade" else "Error")
		end,
	})

	-- Grid ---------------------------------------------------------------------------------------
	local grid = Kit.new("ScrollingFrame", {
		BackgroundColor3 = C.PanelAlt,
		BackgroundTransparency = 0.2,
		Size = UDim2.new(1, -330, 1, -86),
		Position = UDim2.fromOffset(0, 80),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = C.NavySoft,
		BorderSizePixel = 0,
		Parent = body,
	}) :: ScrollingFrame
	Kit.corner(grid, 16)
	Kit.padding(grid, 10, 14, 10, 10)
	Kit.new(
		"UIGridLayout",
		{ CellSize = UDim2.fromOffset(104, 124), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid }
	)
	local empty = Kit.text({
		Text = "",
		TextSize = 22,
		Color = C.Muted,
		Stroke = 0,
		Wrapped = true,
		Size = UDim2.new(1, -330, 0, 80),
		Position = UDim2.fromOffset(0, 220),
		Parent = body,
	})

	-- Drag a card onto the bin to delete it (locked pets are refused by the server).
	local trash = Kit.new("Frame", {
		Name = "TrashZone",
		BackgroundColor3 = C.Red,
		BackgroundTransparency = 0.1,
		Size = UDim2.fromOffset(260, 70),
		Position = UDim2.new(0.5, -165, 1, -14),
		AnchorPoint = Vector2.new(0.5, 1),
		Visible = false,
		ZIndex = 30,
		Parent = body,
	}) :: Frame
	Kit.corner(trash, 18)
	local trashStroke = Kit.stroke(trash, C.White, 3)
	local trashLabel = Kit.text({
		Text = "",
		TextSize = 22,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 31,
		StrokeColor = C.RedDark,
		Parent = trash,
	})

	-- Detail -------------------------------------------------------------------------------------
	local detail = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(0, 310, 1, -86),
		Position = UDim2.new(1, 0, 0, 80),
		AnchorPoint = Vector2.new(1, 0),
		Parent = body,
	})
	Kit.corner(detail, 18)
	Kit.stroke(detail, C.PanelLine, 3)
	local detailGradient = Kit.gradient(detail, Color3.fromRGB(255, 255, 255), Color3.fromRGB(220, 240, 255))
	-- Vertical budget (detail is ~468 tall): preview 4-136, name, rarity, origin, boost, mutation
	-- chips up to ~290, then the action grid (3 rows, 148) pinned to the bottom.
	local bigView = Viewport.new(detail, UDim2.fromOffset(200, 132), UDim2.new(0.5, 0, 0, 4), Vector2.new(0.5, 0))
	bigView.setSpin(true)
	local detailName = Kit.text({
		Text = "",
		TextSize = 28,
		Size = UDim2.new(1, -16, 0, 32),
		Position = UDim2.new(0.5, 0, 0, 138),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = detail,
	})
	local rarityChip = Kit.new("Frame", {
		BackgroundColor3 = C.Gray,
		Size = UDim2.fromOffset(150, 28),
		Position = UDim2.new(0.5, 0, 0, 174),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = detail,
	})
	Kit.round(rarityChip)
	Kit.stroke(rarityChip, C.Outline, 2)
	local rarityLabel = Kit.text({ Text = "", TextSize = 18, Size = UDim2.fromScale(1, 1), Parent = rarityChip })
	local originLabel = Kit.text({
		Text = "",
		TextSize = 16,
		Color = C.Muted,
		Stroke = 0,
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.new(0.5, 0, 0, 206),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = detail,
	})
	local boostDetail = Kit.text({
		Text = "",
		TextSize = 26,
		Color = C.Gold,
		StrokeColor = C.GoldDark,
		Size = UDim2.new(1, -16, 0, 30),
		Position = UDim2.new(0.5, 0, 0, 228),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = detail,
	})
	-- Mutation chips (Gold x2, Lava x5, ...) or a hint when the pet has none.
	local mutationRow = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -12, 0, 26),
		Position = UDim2.new(0.5, 0, 0, 264),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = detail,
	})
	Kit.list(mutationRow, Enum.FillDirection.Horizontal, 4)
	local mutationHint = Kit.text({
		Text = "",
		TextSize = 15,
		Color = C.Muted,
		Stroke = 0,
		Size = UDim2.fromScale(1, 1),
		LayoutOrder = 99,
		Parent = mutationRow,
	})
	local mutationChips: { Frame } = {}
	local function setMutations(list: { string }?)
		for _, chip in mutationChips do
			chip:Destroy()
		end
		table.clear(mutationChips)
		mutationHint.Visible = not list or #list == 0
		mutationHint.Text = Strings.get("noMutations")
		if not list then
			return
		end
		for order, key in list do
			local color = Mutations.color(key)
			local chip = Kit.new("Frame", {
				BackgroundColor3 = color,
				Size = UDim2.fromOffset(0, 24),
				AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = order,
				Parent = mutationRow,
			}) :: Frame
			Kit.round(chip)
			Kit.stroke(chip, color:Lerp(Color3.new(0, 0, 0), 0.55), 2)
			Kit.padding(chip, 0, 7, 0, 7)
			Kit.text({
				Text = Strings.get("mutation." .. key) .. " x" .. Economy.Mutations[key].mult,
				TextSize = 13,
				AutoX = true,
				Size = UDim2.new(0, 0, 1, 0),
				StrokeColor = color:Lerp(Color3.new(0, 0, 0), 0.6),
				Parent = chip,
			})
			table.insert(mutationChips, chip)
		end
	end
	local actions = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 148),
		Position = UDim2.new(0.5, 0, 1, -8),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = detail,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(136, 44),
		CellPadding = UDim2.fromOffset(10, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = actions,
	})

	local selected: string? = nil
	local deleteArmed = false
	local cards: { [string]: { frame: TextButton, view: Viewport.ViewApi, key: string, look: string } } = {}

	local equipButton: Kit.ButtonApi
	local lockButton: Kit.ButtonApi
	local deleteButton: Kit.ButtonApi
	local enchantButton: Kit.ButtonApi
	local luckyButton: Kit.ButtonApi
	local enchantCoin: Frame

	local function refreshDetail()
		local profile = app.State.profile
		local pet = profile and selected and profile.pets[selected]
		detail.Visible = pet ~= nil
		if not profile or not pet or not selected then
			return
		end
		local data = Worlds.pets[pet.s]
		if not data then
			return
		end
		local rarity = Config.Rarities[data.rarity]
		local color = Theme.Rarity[rarity]
		detailName.Text = Strings.name(data.name)
		local stroke = detailName:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = color:Lerp(Color3.new(0, 0, 0), 0.55)
		end
		rarityChip.BackgroundColor3 = color
		rarityLabel.Text = Strings.get("rarity." .. rarity)
		originLabel.Text = Strings.get("world", { n = data.world }) .. "  -  " .. Strings.name(Worlds.get(data.world).egg.name)
		boostDetail.Text = Strings.get("boost", { x = PetsPanel.boostText(pet.s, pet.m) })
		setMutations(pet.m)
		local cost = Economy.mutateCost(pet.s, pet.m)
		if cost then
			enchantButton.setText(Format.short(cost))
			enchantButton.setPalette(if profile.coins >= cost then "Purple" else "Gray")
			enchantButton.setEnabled(true)
			enchantCoin.Visible = true
			luckyButton.setText(utf8.char(0x2728) .. " " .. Strings.get("lucky", { n = profile.enchants }))
			luckyButton.setEnabled(true)
		else
			enchantButton.setText(Strings.get("max"))
			enchantButton.setPalette("Gold")
			enchantButton.setEnabled(false)
			enchantCoin.Visible = false
			luckyButton.setText(Strings.get("max"))
			luckyButton.setEnabled(false)
		end
		detailGradient.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), color:Lerp(Color3.new(1, 1, 1), 0.7))
		local equipped = table.find(profile.equipped, selected) ~= nil
		equipButton.setText(Strings.get(if equipped then "unequip" else "equip"))
		equipButton.setPalette(if equipped then "Gray" else "Green")
		lockButton.setText(Strings.get(if pet.l then "unlock" else "lock"))
		deleteButton.setText(Strings.get(if deleteArmed then "deleteConfirm" else "delete"))
		deleteButton.setEnabled(not pet.l)
		deleteButton.setPalette(if pet.l then "Gray" else "Red")
	end

	equipButton = Kit.button({
		Text = "",
		TextSize = 20,
		Palette = "Green",
		LayoutOrder = 1,
		Parent = actions,
		OnClick = function()
			local profile = app.State.profile
			if not profile or not selected then
				return
			end
			local equipped = table.find(profile.equipped, selected) ~= nil
			local result = app.Net.invoke("Equip", { id = selected, on = not equipped })
			app.Sfx.play(if result.ok then "Upgrade" else "Error")
		end,
	})
	lockButton = Kit.button({
		Text = "",
		TextSize = 20,
		Palette = "Navy",
		LayoutOrder = 2,
		Parent = actions,
		OnClick = function()
			local profile = app.State.profile
			local pet = profile and selected and profile.pets[selected]
			if pet and selected then
				app.Net.invoke("SetLock", { id = selected, locked = not pet.l })
			end
		end,
	})
	local function enchant(lucky: boolean)
		local profile = app.State.profile
		if not profile or not selected then
			return
		end
		if lucky and profile.enchants < 1 then
			if LUCKY_PRODUCT and LUCKY_PRODUCT.id > 0 then
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, LUCKY_PRODUCT.id)
			else
				app.Toasts.show(Strings.get("comingSoon"), "info")
			end
			return
		end
		local result = app.Net.invoke("Mutate", { id = selected, lucky = lucky })
		if not result.ok then
			app.Sfx.play("Error")
			Anim.shake(detail, 6)
			if result.err then
				app.Toasts.show(Strings.get(result.err), "bad")
			end
			return
		end
		local key = result.data.mutation :: string
		local def = Economy.Mutations[key]
		local color = Mutations.color(key)
		app.Sfx.play(if def.mult >= 5 then "Legendary" elseif def.mult >= 4 then "Reveal" else "Upgrade")
		app.Effects.flash(color, if def.mult >= 5 then 0.55 else 0.35, 0.5)
		if def.mult >= 5 then
			app.Effects.confetti(40)
		end
		Anim.pop(detail, 0.08)
		app.Toasts.show(Strings.get("mutated", { name = Strings.get("mutation." .. key), x = def.mult }), "gold", utf8.char(0x2728))
	end
	enchantButton = Kit.button({
		Text = "",
		TextSize = 19,
		Palette = "Purple",
		LayoutOrder = 3,
		Parent = actions,
		OnClick = function()
			enchant(false)
		end,
	})
	enchantCoin = Kit.Icons.coin(22, enchantButton.button:FindFirstChild("Content") :: Instance)
	enchantCoin.LayoutOrder = 0
	luckyButton = Kit.button({
		Text = "",
		TextSize = 17,
		Palette = "Pink",
		LayoutOrder = 4,
		Parent = actions,
		OnClick = function()
			enchant(true)
		end,
	})
	deleteButton = Kit.button({
		Text = "",
		TextSize = 18,
		Palette = "Red",
		LayoutOrder = 5,
		Parent = actions,
		OnClick = function()
			if not selected then
				return
			end
			if not deleteArmed then
				deleteArmed = true
				refreshDetail()
				task.delay(2.5, function()
					deleteArmed = false
					refreshDetail()
				end)
				return
			end
			deleteArmed = false
			local result = app.Net.invoke("DeletePet", { id = selected })
			if result.ok then
				selected = nil
			end
		end,
	})

	local function select(id: string?)
		selected = id
		deleteArmed = false
		local profile = app.State.profile
		local pet = profile and id and profile.pets[id]
		if pet then
			bigView.setModel(Viewport.pet(pet.s, pet.m))
		else
			bigView.setModel(nil)
		end
		for cardId, card in cards do
			local border = card.frame:FindFirstChild("Border") :: UIStroke?
			if border then
				local isSelected = cardId == id
				border.Color = if isSelected then C.White else (card.frame:GetAttribute("BorderColor") :: Color3? or C.Outline)
				border.Thickness = if isSelected then 5 else 3
			end
		end
		refreshDetail()
	end

	local dragging: { id: string, ghost: GuiObject, input: InputObject }? = nil
	local justDragged = false

	local function overTrash(position: Vector3): boolean
		local at, size = trash.AbsolutePosition, trash.AbsoluteSize
		return position.X >= at.X and position.X <= at.X + size.X and position.Y >= at.Y and position.Y <= at.Y + size.Y
	end

	local function moveGhost(position: Vector3)
		local current = dragging
		if not current then
			return
		end
		local canvas = app.Gui.panels
		current.ghost.Position =
			UDim2.fromOffset((position.X - canvas.AbsolutePosition.X) / app.Gui.scale, (position.Y - canvas.AbsolutePosition.Y) / app.Gui.scale)
		local hot = overTrash(position)
		trash.BackgroundColor3 = if hot then C.RedDark else C.Red
		trashStroke.Thickness = if hot then 5 else 3
	end

	local function startDrag(id: string, frame: TextButton, input: InputObject)
		if dragging then
			return
		end
		local ghost = frame:Clone() :: GuiObject
		ghost.Name = "DragGhost"
		ghost.Size = UDim2.fromOffset(92, 110)
		ghost.AnchorPoint = Vector2.new(0.5, 0.5)
		ghost.ZIndex = 60
		ghost.Parent = app.Gui.panels
		dragging = { id = id, ghost = ghost, input = input }
		grid.ScrollingEnabled = false
		trash.Visible = true
		trashLabel.Text = utf8.char(0x1F5D1) .. "  " .. Strings.get("dropToDelete")
		app.Sfx.play("Click")
		moveGhost(input.Position)
	end

	local function endDrag(position: Vector3?)
		local current = dragging
		if not current then
			return
		end
		dragging = nil
		current.ghost:Destroy()
		grid.ScrollingEnabled = true
		trash.Visible = false
		justDragged = true
		task.delay(0.1, function()
			justDragged = false
		end)
		if position and overTrash(position) then
			local profile = app.State.profile
			local pet = profile and profile.pets[current.id]
			if pet and pet.l then
				app.Sfx.play("Error")
				app.Toasts.show(Strings.get("petLocked"), "bad", utf8.char(0x1F512))
				return
			end
			local result = app.Net.invoke("DeletePet", { id = current.id })
			if result.ok then
				app.Sfx.play("Sell")
				app.Toasts.show(Strings.get("petDeleted"), "info", utf8.char(0x1F5D1))
				if selected == current.id then
					selected = nil
				end
			else
				app.Sfx.play("Error")
				app.Toasts.show(Strings.get(result.err or "err.generic"), "bad")
			end
		end
	end

	UserInputService.InputChanged:Connect(function(input: InputObject)
		local current = dragging
		if current and (input == current.input or input.UserInputType == Enum.UserInputType.MouseMovement) then
			moveGhost(input.Position)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		local current = dragging
		if
			current
			and (input == current.input or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch)
		then
			endDrag(input.Position)
		end
	end)

	-- Mouse: drag once the pointer moves a little. Touch: press and hold (so swipes still scroll).
	local function hookDrag(id: string, frame: TextButton)
		frame.InputBegan:Connect(function(input: InputObject)
			local mouse = input.UserInputType == Enum.UserInputType.MouseButton1
			if not mouse and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local origin = input.Position
			local released = false
			local moved: RBXScriptConnection? = nil
			local ended: RBXScriptConnection? = nil
			local function cleanup()
				released = true
				if moved then
					moved:Disconnect()
				end
				if ended then
					ended:Disconnect()
				end
			end
			ended = UserInputService.InputEnded:Connect(function(other: InputObject)
				if other == input or (mouse and other.UserInputType == Enum.UserInputType.MouseButton1) then
					cleanup()
				end
			end)
			if mouse then
				moved = UserInputService.InputChanged:Connect(function(other: InputObject)
					if other.UserInputType == Enum.UserInputType.MouseMovement and (other.Position - origin).Magnitude > 10 then
						cleanup()
						startDrag(id, frame, input)
					end
				end)
			else
				task.delay(0.35, function()
					if not released and (input.Position - origin).Magnitude < 14 then
						cleanup()
						startDrag(id, frame, input)
					end
				end)
			end
		end)
	end

	local function buildCard(id: string, key: string, mutations: { string }?, order: number): TextButton
		local data = Worlds.pets[key]
		local rarity = Config.Rarities[data.rarity]
		local color = Theme.Rarity[rarity]
		local frame = Kit.new(
			"TextButton",
			{ Name = id, Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, Parent = grid }
		) :: TextButton
		Kit.corner(frame, 16)
		Kit.gradient(frame, color:Lerp(Color3.new(1, 1, 1), 0.55), color, 90)
		-- One UIStroke per object: selection recolours and thickens the border.
		local border = Kit.stroke(frame, color:Lerp(Color3.new(0, 0, 0), 0.5), 3)
		border.Name = "Border"
		frame:SetAttribute("BorderColor", border.Color)
		local view = Viewport.new(frame, UDim2.fromOffset(92, 86), UDim2.new(0.5, 0, 0, 4), Vector2.new(0.5, 0))
		view.setModel(Viewport.pet(key, mutations))
		local top = Mutations.top(mutations)
		if top then
			local tag = Kit.new("Frame", {
				Name = "Mutation",
				BackgroundColor3 = Mutations.color(top),
				Size = UDim2.fromOffset(0, 20),
				AutomaticSize = Enum.AutomaticSize.X,
				Position = UDim2.new(0.5, 0, 1, -48),
				AnchorPoint = Vector2.new(0.5, 0),
				ZIndex = 4,
				Parent = frame,
			})
			Kit.round(tag)
			Kit.padding(tag, 0, 6, 0, 6)
			Kit.stroke(tag, Mutations.color(top):Lerp(Color3.new(0, 0, 0), 0.55), 2)
			Kit.text({
				Text = Strings.get("mutation." .. top) .. (if mutations and #mutations > 1 then " +" .. (#mutations - 1) else ""),
				TextSize = 12,
				AutoX = true,
				Size = UDim2.new(0, 0, 1, 0),
				ZIndex = 5,
				Parent = tag,
			})
		end
		Kit.text({
			Name = "Boost",
			Text = PetsPanel.boostText(key, mutations),
			TextSize = 18,
			Size = UDim2.new(1, 0, 0, 24),
			Position = UDim2.new(0, 0, 1, -28),
			StrokeColor = color:Lerp(Color3.new(0, 0, 0), 0.6),
			Parent = frame,
		})
		local equipped = Kit.new("Frame", {
			Name = "Equipped",
			BackgroundColor3 = C.Green,
			Size = UDim2.fromOffset(28, 28),
			Position = UDim2.new(1, -4, 0, 4),
			AnchorPoint = Vector2.new(1, 0),
			ZIndex = 4,
			Visible = false,
			Parent = frame,
		})
		Kit.round(equipped)
		Kit.stroke(equipped, C.GreenDark, 2)
		Kit.text({ Text = utf8.char(0x2714), TextSize = 16, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = equipped })
		Kit.text({
			Name = "Lock",
			Text = utf8.char(0x1F512),
			TextSize = 18,
			Size = UDim2.fromOffset(24, 24),
			Position = UDim2.fromOffset(4, 4),
			Stroke = 0,
			ZIndex = 4,
			Visible = false,
			Parent = frame,
		})
		frame.MouseEnter:Connect(function()
			view.setSpin(true)
		end)
		frame.MouseLeave:Connect(function()
			view.setSpin(false)
		end)
		frame.Activated:Connect(function()
			if justDragged then
				return
			end
			app.Sfx.play("Click")
			select(id)
			Anim.pop(frame, 0.1)
		end)
		hookDrag(id, frame)
		cards[id] = { frame = frame, view = view, key = key, look = key .. table.concat(mutations or {}, ",") }
		return frame
	end

	local function refresh()
		local profile = app.State.profile
		if not profile then
			return
		end
		panel.setTitle(Strings.get("petsTitle"))
		equipBest.setText(Strings.get("equipBest"))
		local cap = app.State.equipCap()
		equippedLabel.Text = Strings.get("equipped", { a = #profile.equipped, b = cap })
		boostLabel.Text = Strings.get("totalBoost", { x = Format.multiplier(app.State.multiplier()) })
		local count = 0
		for _ in profile.pets do
			count += 1
		end
		countLabel.Text = Strings.get("inventory", { a = count, b = Config.PetInventoryCap })
		empty.Text = if count == 0 then Strings.get("noPets") else ""

		local ids = {}
		for id in profile.pets do
			table.insert(ids, id)
		end
		table.sort(ids, function(a, b)
			local ea, eb = table.find(profile.equipped, a) ~= nil, table.find(profile.equipped, b) ~= nil
			if ea ~= eb then
				return ea
			end
			local pa, pb = profile.pets[a], profile.pets[b]
			local ba, bb = Economy.petPower(pa.s, pa.m), Economy.petPower(pb.s, pb.m)
			if ba ~= bb then
				return ba > bb
			end
			return a < b
		end)
		local keep = {}
		local rebuiltSelected = false
		for order, id in ids do
			keep[id] = true
			local card = cards[id]
			local pet = profile.pets[id]
			local look = pet.s .. table.concat(pet.m or {}, ",")
			if not card or card.look ~= look then
				if card then
					card.frame:Destroy()
				end
				buildCard(id, pet.s, pet.m, order)
				card = cards[id]
				rebuiltSelected = rebuiltSelected or id == selected
			end
			card.frame.LayoutOrder = order
			local equippedBadge = card.frame:FindFirstChild("Equipped") :: Frame?
			if equippedBadge then
				equippedBadge.Visible = table.find(profile.equipped, id) ~= nil
			end
			local lockBadge = card.frame:FindFirstChild("Lock") :: TextLabel?
			if lockBadge then
				lockBadge.Visible = profile.pets[id].l == true
			end
		end
		for id, card in cards do
			if not keep[id] then
				card.frame:Destroy()
				cards[id] = nil
			end
		end
		if selected and not profile.pets[selected] then
			selected = nil
		end
		if not selected and ids[1] then
			select(ids[1])
		elseif rebuiltSelected then
			select(selected)
		else
			refreshDetail()
		end
	end

	panel.onOpen = function()
		app.Sfx.play("Open")
		refresh()
	end
	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
	app.State.languageChanged:Connect(refresh)
	return panel
end

return PetsPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="93">
              <Properties>
                <string name="Name">Profile</string>
                <string name="Source"><![CDATA[--!strict
-- Your profile: avatar, join date, playtime and lifetime stats on one tab; the relic index (every
-- world's five relics, undiscovered ones as black silhouettes) on the other.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Kit = require(script.Parent.Parent.Kit)
local Panel = require(script.Parent.Parent.Panel)
local Theme = require(script.Parent.Parent.Theme)
local Viewport = require(script.Parent.Parent.Viewport)

local ProfilePanel = {}

local C = Theme.C
local RELICS_PER_WORLD = 5

type RelicCard = {
	frame: Frame,
	view: Viewport.ViewApi,
	name: TextLabel,
	rarityChip: Frame,
	rarity: TextLabel,
	worth: TextLabel,
	count: TextLabel,
	key: string?,
}

local function discoveredIn(profile: any, world: number): number
	local n = 0
	for _, relic in Worlds.get(world).relics do
		if (profile.relics[relic.key] or 0) > 0 then
			n += 1
		end
	end
	return n
end

function ProfilePanel.totals(profile: any): (number, number)
	local found = 0
	for world = 1, Config.WorldCount do
		found += discoveredIn(profile, world)
	end
	return found, Config.WorldCount * RELICS_PER_WORLD
end

local function worldsCleared(profile: any): number
	local n = 0
	for _, entry in profile.worlds do
		if entry.cleared then
			n += 1
		end
	end
	return n
end

function ProfilePanel.new(app: any): Panel.PanelApi
	local panel = Panel.new({
		Parent = app.Gui.panels,
		Title = Strings.get("profileTitle"),
		Icon = utf8.char(0x1F464),
		Palette = "Purple",
		Size = Vector2.new(900, 560),
	})
	local body = panel.body
	local relicWorld = 1
	local tab = "info" -- "info" | "relics"

	-- Tab bar --------------------------------------------------------------------------------------
	local tabs = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 16), Parent = body })
	Kit.list(tabs, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left)
	local tabButtons: { [string]: Kit.ButtonApi } = {}
	local refresh: () -> ()
	local function selectTab(key: string)
		tab = key
		refresh()
	end
	for order, key in { "info", "relics" } do
		tabButtons[key] = Kit.button({
			Text = "",
			TextSize = 19,
			Palette = "Navy",
			Size = UDim2.fromOffset(180, 44),
			LayoutOrder = order,
			Parent = tabs,
			OnClick = function()
				app.Sfx.play("Click")
				selectTab(key)
			end,
		})
	end

	-- Info tab ---------------------------------------------------------------------------------------
	local info = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -66), Position = UDim2.fromOffset(0, 66), Parent = body })

	local card = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(0, 250, 1, 0),
		Parent = info,
	})
	Kit.corner(card, 18)
	Kit.stroke(card, C.PanelLine, 3)
	Kit.gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(228, 243, 255))
	local avatar = Kit.new("ImageLabel", {
		BackgroundColor3 = Color3.fromRGB(60, 90, 140),
		Size = UDim2.fromOffset(140, 140),
		Position = UDim2.new(0.5, 0, 0, 24),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = card,
	})
	Kit.round(avatar)
	Kit.stroke(avatar, C.Outline, 3)
	local nameLabel = Kit.text({
		Text = "",
		TextSize = 26,
		Size = UDim2.new(1, -16, 0, 34),
		Position = UDim2.new(0.5, 0, 0, 172),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = card,
	})
	local joinedLabel = Kit.text({
		Text = "",
		TextSize = 16,
		Color = C.Muted,
		Stroke = 0,
		Size = UDim2.new(1, -16, 0, 22),
		Position = UDim2.new(0.5, 0, 0, 208),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = card,
	})
	local playtimeChip = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.new(1, -30, 0, 44),
		Position = UDim2.new(0.5, 0, 0, 244),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = card,
	})
	Kit.round(playtimeChip)
	local pg = Theme.Buttons.Blue
	Kit.gradient(playtimeChip, pg[1], pg[2])
	Kit.stroke(playtimeChip, pg[3], 2.5)
	local playtimeLabel = Kit.text({ Text = "", TextSize = 17, Size = UDim2.fromScale(1, 1), StrokeColor = pg[3], Parent = playtimeChip })

	-- Stat grid.
	local statsFrame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -270, 1, 0),
		Position = UDim2.fromOffset(266, 0),
		Parent = info,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(276, 84),
		CellPadding = UDim2.fromOffset(12, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = statsFrame,
	})

	local STAT_DEFS = {
		{ key = "lifetime", label = "profileLifetime", icon = utf8.char(0x1F4B0), palette = "Gold" },
		{ key = "dives", label = "profileDives", icon = utf8.char(0x1F3CA), palette = "Blue" },
		{ key = "relicsFound", label = "profileRelicsFound", icon = utf8.char(0x1F4E6), palette = "Green" },
		{ key = "petsHatched", label = "profilePetsHatched", icon = utf8.char(0x1F95A), palette = "Pink" },
		{ key = "worldsCleared", label = "profileWorldsCleared", icon = utf8.char(0x1F3C6), palette = "Orange" },
		{ key = "blackouts", label = "profileBlackouts", icon = utf8.char(0x1F4A8), palette = "Red" },
	}
	local statLabels: { [string]: TextLabel } = {}
	local statValues: { [string]: TextLabel } = {}
	for order, def in STAT_DEFS do
		local palette = Theme.Buttons[def.palette]
		local tile = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, Parent = statsFrame })
		Kit.corner(tile, 16)
		Kit.stroke(tile, C.PanelLine, 2.5)
		local iconBack = Kit.new("Frame", {
			BackgroundColor3 = palette[2],
			Size = UDim2.fromOffset(56, 56),
			Position = UDim2.fromOffset(12, 14),
			Parent = tile,
		})
		Kit.round(iconBack)
		Kit.stroke(iconBack, palette[3], 2.5)
		Kit.text({ Text = def.icon, TextSize = 28, Size = UDim2.fromScale(1, 1), Stroke = 0, Parent = iconBack })
		statLabels[def.key] = Kit.text({
			Text = "",
			TextSize = 15,
			Color = C.Muted,
			Stroke = 0,
			Size = UDim2.new(1, -84, 0, 20),
			Position = UDim2.fromOffset(78, 14),
			XAlign = Enum.TextXAlignment.Left,
			Parent = tile,
		})
		statValues[def.key] = Kit.text({
			Text = "",
			TextSize = 24,
			Size = UDim2.new(1, -84, 0, 32),
			Position = UDim2.fromOffset(78, 36),
			XAlign = Enum.TextXAlignment.Left,
			Parent = tile,
		})
	end

	-- Relics tab (unchanged relic index) --------------------------------------------------------------
	local relics = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -66), Position = UDim2.fromOffset(0, 66), Parent = body })

	local progress = Kit.progress({
		Size = UDim2.new(1, -8, 0, 30),
		Position = UDim2.fromOffset(4, 0),
		Colors = { Color.hex("#d99bff"), Color.hex("#8a4fe0") },
		TextSize = 18,
		Parent = relics,
	})

	local list = Kit.new("ScrollingFrame", {
		BackgroundColor3 = C.PanelAlt,
		BackgroundTransparency = 0.2,
		Size = UDim2.new(0, 250, 1, -44),
		Position = UDim2.fromOffset(0, 44),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.NavySoft,
		BorderSizePixel = 0,
		Parent = relics,
	}) :: ScrollingFrame
	Kit.corner(list, 16)
	Kit.padding(list, 8, 12, 8, 8)
	Kit.list(list, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

	type Row = { button: TextButton, label: TextLabel, tally: TextLabel, stroke: UIStroke }
	local rows: { Row } = {}
	for world = 1, Config.WorldCount do
		local data = Worlds.get(world)
		local button = Kit.new("TextButton", {
			Name = "World" .. world,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.new(1, -4, 0, 46),
			LayoutOrder = world,
			Parent = list,
		}) :: TextButton
		Kit.corner(button, 12)
		Kit.gradient(button, Color.lighten(Color.hex(data.accent[1]), 0.25), Color.hex(data.accent[2]), 90)
		local stroke = Kit.stroke(button, Color.darken(Color.hex(data.accent[2]), 0.5), 2.5)
		local label = Kit.text({
			Text = "",
			TextSize = 16,
			Size = UDim2.new(1, -66, 1, 0),
			Position = UDim2.fromOffset(10, 0),
			XAlign = Enum.TextXAlignment.Left,
			Stroke = 2,
			StrokeColor = Color.darken(Color.hex(data.accent[2]), 0.55),
			Parent = button,
		})
		local tally = Kit.text({
			Text = "",
			TextSize = 15,
			Size = UDim2.fromOffset(58, 46),
			Position = UDim2.new(1, -60, 0, 0),
			Stroke = 2,
			Parent = button,
		})
		button.Activated:Connect(function()
			relicWorld = world
			app.Sfx.play("Click")
			refresh()
		end)
		rows[world] = { button = button, label = label, tally = tally, stroke = stroke }
	end

	local relicTitle = Kit.text({
		Text = "",
		TextSize = 26,
		Size = UDim2.new(1, -266, 0, 32),
		Position = UDim2.fromOffset(266, 2),
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 3,
		Parent = relics,
	})
	local completeChip = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(120, 30),
		Position = UDim2.new(1, -4, 0, 3),
		AnchorPoint = Vector2.new(1, 0),
		Visible = false,
		Parent = relics,
	})
	Kit.round(completeChip)
	Kit.gradient(completeChip, Theme.Buttons.Gold[1], Theme.Buttons.Gold[2])
	Kit.stroke(completeChip, Theme.Buttons.Gold[3], 2.5)
	local completeLabel =
		Kit.text({ Text = "", TextSize = 17, Size = UDim2.fromScale(1, 1), StrokeColor = Theme.Buttons.Gold[3], Parent = completeChip })

	local grid = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -266, 1, -44),
		Position = UDim2.fromOffset(266, 44),
		Parent = relics,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(186, 184),
		CellPadding = UDim2.fromOffset(12, 12),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	local lockedNote = Kit.text({
		Text = "",
		TextSize = 22,
		Color = C.Muted,
		Stroke = 0,
		Wrapped = true,
		Size = UDim2.new(1, -266, 0, 60),
		Position = UDim2.new(0, 266, 0.5, 0),
		Visible = false,
		Parent = relics,
	})

	local cards: { RelicCard } = {}
	for i = 1, RELICS_PER_WORLD do
		local frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = i, Parent = grid }) :: Frame
		Kit.corner(frame, 16)
		Kit.stroke(frame, C.Outline, 3)
		local view = Viewport.new(frame, UDim2.fromOffset(150, 88), UDim2.new(0.5, 0, 0, 6), Vector2.new(0.5, 0))
		view.setSpin(true)
		local name =
			Kit.text({ Text = "", TextSize = 17, Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 96), Stroke = 2, Parent = frame })
		local rarityChip = Kit.new("Frame", {
			BackgroundColor3 = C.Gray,
			Size = UDim2.fromOffset(110, 20),
			Position = UDim2.new(0.5, 0, 0, 120),
			AnchorPoint = Vector2.new(0.5, 0),
			Parent = frame,
		})
		Kit.round(rarityChip)
		Kit.stroke(rarityChip, C.Outline, 2)
		local rarity = Kit.text({ Text = "", TextSize = 13, Size = UDim2.fromScale(1, 1), Stroke = 1.6, Parent = rarityChip })
		local worthRow =
			Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 143), Parent = frame })
		Kit.list(worthRow, Enum.FillDirection.Horizontal, 4)
		local coin = Kit.Icons.coin(16, worthRow)
		coin.LayoutOrder = 1
		local worth =
			Kit.text({ Text = "", TextSize = 15, Size = UDim2.new(0, 0, 1, 0), AutoX = true, Stroke = 2, LayoutOrder = 2, Parent = worthRow })
		local count = Kit.text({
			Text = "",
			TextSize = 13,
			Color = C.Muted,
			Stroke = 0,
			Size = UDim2.new(1, -10, 0, 16),
			Position = UDim2.fromOffset(5, 164),
			Parent = frame,
		})
		cards[i] = { frame = frame, view = view, name = name, rarityChip = rarityChip, rarity = rarity, worth = worth, count = count, key = nil }
	end

	local function paintCard(card2: RelicCard, relic: any, found: number, world: number)
		local discovered = found > 0
		local rarityColor = Theme.rarityColor(relic.rarity)
		if card2.key ~= relic.key then
			card2.key = relic.key
			card2.view.setModel(Viewport.relic(relic.key))
		end
		card2.view.frame.Ambient = if discovered then Color3.fromRGB(190, 200, 215) else Color3.new(0, 0, 0)
		card2.view.frame.LightColor = if discovered then Color3.fromRGB(255, 250, 240) else Color3.new(0, 0, 0)
		card2.view.frame.ImageColor3 = if discovered then Color3.new(1, 1, 1) else Color3.fromRGB(20, 28, 44)
		card2.frame.BackgroundColor3 = if discovered then rarityColor:Lerp(Color3.new(1, 1, 1), 0.72) else Color3.fromRGB(196, 206, 220)
		card2.name.Text = if discovered then Strings.name(relic.name) else "???"
		local stroke = card2.name:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = if discovered then rarityColor:Lerp(Color3.new(0, 0, 0), 0.55) else C.Ink
		end
		card2.rarityChip.BackgroundColor3 = rarityColor
		card2.rarity.Text = Strings.get("rarity." .. Config.Rarities[relic.rarity])
		card2.worth.Text = Format.short(Economy.relicValue(world, relic.rarity))
		card2.count.Text = if discovered then Strings.get("indexCount", { n = Format.commas(found) }) else Strings.get("indexUndiscovered")
	end

	refresh = function()
		local profile = app.State.profile
		panel.setTitle(if tab == "info" then Strings.get("profileTitle") else Strings.get("indexTitle"))
		tabButtons.info.setText(Strings.get("profileTabInfo"))
		tabButtons.relics.setText(Strings.get("profileTabRelics"))
		tabButtons.info.setPalette(if tab == "info" then "Purple" else "Navy")
		tabButtons.relics.setPalette(if tab == "relics" then "Purple" else "Navy")
		info.Visible = tab == "info"
		relics.Visible = tab == "relics"
		if not profile then
			return
		end
		if tab == "info" then
			local player = Players.LocalPlayer
			avatar.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=180&h=180", math.max(1, player.UserId))
			local vip = player:GetAttribute("VIP") == true
			nameLabel.Text = (if vip then utf8.char(0x1F451) .. " " else "") .. player.DisplayName
			joinedLabel.Text = Strings.get("profileJoined", { date = Format.date(profile.created) })
			local h, m = Format.hoursMinutes(profile.stats.playtime)
			playtimeLabel.Text = Strings.get("profilePlaytime", { h = h, m = m })
			local found = ProfilePanel.totals(profile)
			local values = {
				lifetime = Format.commas(profile.lifetime),
				dives = Format.commas(profile.stats.dives),
				relicsFound = found .. "/" .. Config.WorldCount * RELICS_PER_WORLD,
				petsHatched = Format.commas(profile.stats.hatched),
				worldsCleared = worldsCleared(profile) .. "/" .. Config.WorldCount,
				blackouts = Format.commas(profile.stats.blackouts),
			}
			for _, def in STAT_DEFS do
				statLabels[def.key].Text = Strings.get(def.label)
				statValues[def.key].Text = values[def.key]
			end
		else
			local found, total = ProfilePanel.totals(profile)
			progress.set(found / total, Strings.get("indexProgress", { a = found, b = total }))
			for world, row in rows do
				local data = Worlds.get(world)
				local unlocked = world <= profile.unlocked
				local n = discoveredIn(profile, world)
				row.label.Text = (if unlocked then "" else utf8.char(0x1F512) .. " ") .. world .. ". " .. Strings.name(data.name)
				row.tally.Text = if n == RELICS_PER_WORLD then utf8.char(0x2714) else n .. "/" .. RELICS_PER_WORLD
				row.button.BackgroundTransparency = if unlocked then 0 else 0.45
				row.stroke.Thickness = if world == relicWorld then 4 else 2.5
				row.stroke.Color = if world == relicWorld then Color3.new(1, 1, 1) else Color.darken(Color.hex(data.accent[2]), 0.5)
			end
			local data = Worlds.get(relicWorld)
			relicTitle.Text = Strings.get("world", { n = relicWorld }) .. "  ·  " .. Strings.name(data.name)
			local titleStroke = relicTitle:FindFirstChildOfClass("UIStroke")
			if titleStroke then
				titleStroke.Color = Color.darken(Color.hex(data.accent[2]), 0.45)
			end
			relicTitle.TextColor3 = Color.lighten(Color.hex(data.accent[1]), 0.35)
			local count = discoveredIn(profile, relicWorld)
			completeChip.Visible = count == RELICS_PER_WORLD
			completeLabel.Text = Strings.get("indexComplete")
			local unlocked = relicWorld <= profile.unlocked
			for i, card2 in cards do
				local relic = data.relics[i]
				card2.frame.Visible = relic ~= nil
				if relic then
					paintCard(card2, relic, profile.relics[relic.key] or 0, relicWorld)
				end
			end
			lockedNote.Visible = not unlocked and count == 0
			lockedNote.Text = Strings.get("indexLocked")
			grid.Visible = unlocked or count > 0
		end
	end

	panel.onOpen = function()
		relicWorld = app.State.world
		refresh()
	end
	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
	app.State.languageChanged:Connect(refresh)
	return panel
end

return ProfilePanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="94">
              <Properties>
                <string name="Name">Rewards</string>
                <string name="Source"><![CDATA[--!strict
-- Rewards: the 7-day daily login streak and today's playtime reward tiers. The server checks
-- every claim; this panel only shows what it expects and asks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Rewards = require(Shared.Rewards)
local Strings = require(Shared.Strings)

local Kit = require(script.Parent.Parent.Kit)
local Panel = require(script.Parent.Parent.Panel)
local Theme = require(script.Parent.Parent.Theme)

local RewardsPanel = {}

local C = Theme.C
local ENCHANT = utf8.char(0x2728)
local BOOST = utf8.char(0x26A1)

-- Today's playtime as the client estimates it: the last synced value plus time since that sync.
local syncedAt = os.clock()

function RewardsPanel.track(app: any)
	app.State.profileChanged:Connect(function()
		syncedAt = os.clock()
	end)
end

function RewardsPanel.playSeconds(app: any): (number, { number })
	local profile = app.State.profile
	if not profile or profile.play.day ~= Rewards.dayOf(os.time()) then
		return 0, {}
	end
	return profile.play.seconds + (os.clock() - syncedAt), profile.play.claimed
end

-- Is anything claimable right now? (Drives the HUD badge.)
function RewardsPanel.anyReady(app: any): boolean
	local profile = app.State.profile
	if not profile then
		return false
	end
	local now = os.time()
	if Rewards.daily(profile, now).claimable then
		return true
	end
	local seconds, claimed = RewardsPanel.playSeconds(app)
	for tier in Config.PlaytimeRewards do
		if Rewards.tierStatus(tier, seconds, claimed) == "ready" then
			return true
		end
	end
	return false
end

-- Seconds until the next playtime tier unlocks (nil when every tier is unlocked or claimed).
function RewardsPanel.nextUnlock(app: any): number?
	local seconds, claimed = RewardsPanel.playSeconds(app)
	for tier, entry in Config.PlaytimeRewards do
		if Rewards.tierStatus(tier, seconds, claimed) == "locked" then
			return entry.minutes * 60 - seconds
		end
	end
	return nil
end

local function extras(reward: Rewards.Payout): string
	local parts = {}
	if reward.enchants > 0 then
		table.insert(parts, ENCHANT .. "+" .. reward.enchants)
	end
	if reward.boostMinutes > 0 then
		table.insert(parts, BOOST .. Strings.get("boostShort", { n = reward.boostMinutes }))
	end
	return table.concat(parts, " ")
end

type Card = {
	frame: Frame,
	stroke: UIStroke,
	title: TextLabel,
	coins: TextLabel,
	extra: TextLabel,
	status: TextLabel,
	button: Kit.ButtonApi?,
}

function RewardsPanel.new(app: any): Panel.PanelApi
	local panel = Panel.new({
		Parent = app.Gui.panels,
		Title = Strings.get("rewardsTitle"),
		Icon = utf8.char(0x1F381),
		Palette = "Pink",
		Size = Vector2.new(760, 480),
	})
	local body = panel.body
	Kit.list(body, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	Kit.padding(body, 20, 0, 0, 0)

	local function header(order: number): (TextLabel, TextLabel)
		local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = body })
		local title = Kit.text({
			Text = "",
			TextSize = 24,
			Color = C.Navy,
			Stroke = 0,
			Size = UDim2.new(0.5, 0, 1, 0),
			XAlign = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local info = Kit.text({
			Text = "",
			TextSize = 17,
			Color = C.Muted,
			Stroke = 0,
			Size = UDim2.new(0.5, 0, 1, 0),
			Position = UDim2.fromScale(0.5, 0),
			XAlign = Enum.TextXAlignment.Right,
			Parent = row,
		})
		return title, info
	end

	local function cardRow(order: number, height: number): Frame
		local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height), LayoutOrder = order, Parent = body })
		Kit.list(row, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		return row
	end

	local function card(parent: Frame, width: number, height: number, order: number, withButton: boolean, onClick: (() -> ())?): Card
		local frame = Kit.new("Frame", {
			Name = "Card" .. order,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.fromOffset(width, height),
			LayoutOrder = order,
			Parent = parent,
		}) :: Frame
		Kit.corner(frame, 14)
		local stroke = Kit.stroke(frame, C.PanelLine, 3)
		Kit.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(222, 240, 255))
		local title = Kit.text({
			Text = "",
			TextSize = 17,
			Color = C.Navy,
			Stroke = 0,
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.fromOffset(0, 6),
			Parent = frame,
		})
		local coinRow =
			Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 30), Parent = frame })
		Kit.list(coinRow, Enum.FillDirection.Horizontal, 4)
		local coin = Kit.Icons.coin(20, coinRow)
		coin.LayoutOrder = 1
		local coins =
			Kit.text({ Text = "", TextSize = 18, Size = UDim2.new(0, 0, 1, 0), AutoX = true, Stroke = 2, LayoutOrder = 2, Parent = coinRow })
		local extra = Kit.text({
			Text = "",
			TextSize = 12,
			Color = C.Purple,
			Stroke = 0,
			Wrapped = true,
			Size = UDim2.new(1, -6, 0, 28),
			Position = UDim2.fromOffset(3, 56),
			YAlign = Enum.TextYAlignment.Top,
			Parent = frame,
		})
		local status = Kit.text({
			Text = "",
			TextSize = 16,
			Color = C.GreenDark,
			Stroke = 0,
			Size = UDim2.fromOffset(20, 20),
			Position = UDim2.new(1, -4, 0, 4),
			AnchorPoint = Vector2.new(1, 0),
			Parent = frame,
		})
		local button: Kit.ButtonApi? = nil
		if withButton then
			button = Kit.button({
				Name = "Claim",
				Text = "",
				TextSize = 16,
				Palette = "Green",
				Size = UDim2.new(1, -12, 0, 30),
				Position = UDim2.new(0.5, 0, 1, -6),
				AnchorPoint = Vector2.new(0.5, 1),
				Radius = 10,
				Stroke = 2,
				Parent = frame,
				OnClick = onClick,
			})
		end
		return { frame = frame, stroke = stroke, title = title, coins = coins, extra = extra, status = status, button = button }
	end

	local function claimed(text: string)
		app.Sfx.play("Unlock")
		app.Toasts.show(text, "gold", utf8.char(0x1F381))
	end

	local function failed(err: string?)
		app.Sfx.play("Error")
		app.Toasts.show(Strings.get(err or "err.generic"), "bad")
	end

	local refresh: () -> () = function() end

	-- Daily login ------------------------------------------------------------------------------
	local dailyTitle, dailyInfo = header(1)
	local dailyRow = cardRow(2, 96)
	local dayCards: { Card } = {}
	for day in Config.DailyRewards do
		dayCards[day] = card(dailyRow, 96, 92, day, false)
	end
	local claimDaily = Kit.button({
		Name = "ClaimDaily",
		Text = "",
		TextSize = 20,
		Palette = "Gold",
		Size = UDim2.fromOffset(300, 44),
		LayoutOrder = 3,
		Parent = body,
		OnClick = function()
			local result = app.Net.invoke("ClaimDaily")
			if result.ok then
				claimed(Strings.get("rewardGot", { n = Format.commas(result.data.coins) }))
			else
				failed(result.err)
			end
			refresh()
		end,
	})

	-- Playtime ---------------------------------------------------------------------------------
	local spacer = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 4), LayoutOrder = 4, Parent = body })
	local _ = spacer
	local playTitle, playInfo = header(5)
	local playRow = cardRow(6, 128)
	local tierCards: { Card } = {}
	for tier in Config.PlaytimeRewards do
		tierCards[tier] = card(playRow, 112, 124, tier, true, function()
			local result = app.Net.invoke("ClaimPlaytime", { tier = tier })
			if result.ok then
				claimed(Strings.get("rewardGot", { n = Format.commas(result.data.coins) }))
			else
				failed(result.err)
			end
			refresh()
		end)
	end

	refresh = function()
		local profile = app.State.profile
		if not profile then
			return
		end
		local now = os.time()
		panel.setTitle(Strings.get("rewardsTitle"))
		local daily = Rewards.daily(profile, now)
		dailyTitle.Text = Strings.get("dailyTitle")
		dailyInfo.Text = Strings.get("dailyStreak", { n = if daily.claimable then daily.streak - 1 else daily.streak })
			.. "  ·  "
			.. Strings.get("dailyReset", { t = Format.clock(Rewards.untilReset(now)) })
		for day, c in dayCards do
			local reward = Rewards.dailyPayout(day, profile.unlocked)
			c.title.Text = Strings.get("dailyDay", { n = day })
			c.coins.Text = Format.short(reward.coins)
			c.extra.Text = extras(reward)
			local done = day < daily.day or (day == daily.day and not daily.claimable)
			local today = day == daily.day and daily.claimable
			c.status.Text = if done then utf8.char(0x2714) else ""
			c.stroke.Color = if today then C.Gold elseif done then C.Green else C.PanelLine
			c.stroke.Thickness = if today then 4 else 3
			c.frame.BackgroundTransparency = if day > daily.day then 0.35 else 0
		end
		claimDaily.setText(if daily.claimable then Strings.get("dailyClaim", { n = daily.day }) else Strings.get("dailyDone"))
		claimDaily.setPalette(if daily.claimable then "Gold" else "Gray")
		claimDaily.setEnabled(daily.claimable)

		local seconds, claimedTiers = RewardsPanel.playSeconds(app)
		local h, m = Format.hoursMinutes(seconds)
		playTitle.Text = Strings.get("playTitle")
		playInfo.Text = Strings.get("playToday", { h = h, m = m })
		for tier, c in tierCards do
			local entry = Config.PlaytimeRewards[tier]
			local reward = Rewards.playtimePayout(tier, profile.unlocked)
			c.title.Text = Strings.get("playMinutes", { n = entry.minutes })
			c.coins.Text = Format.short(reward.coins)
			c.extra.Text = extras(reward)
			local status = Rewards.tierStatus(tier, seconds, claimedTiers)
			local button = c.button :: Kit.ButtonApi
			if status == "ready" then
				button.button.Visible = true
				button.setText(Strings.get("claim"))
				button.setPalette("Green")
				button.setEnabled(true)
				c.stroke.Color = C.Gold
			elseif status == "claimed" then
				button.button.Visible = false
				c.status.Text = utf8.char(0x2714)
				c.stroke.Color = C.Green
			else
				button.button.Visible = true
				button.setText(Format.clock(entry.minutes * 60 - seconds))
				button.setPalette("Gray")
				button.setEnabled(false)
				c.stroke.Color = C.PanelLine
			end
			if status ~= "claimed" then
				c.status.Text = ""
			end
		end
	end

	panel.onOpen = function()
		refresh()
		task.spawn(function()
			while panel.isOpen do
				task.wait(1)
				if panel.isOpen then
					refresh()
				end
			end
		end)
	end
	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
	app.State.languageChanged:Connect(function()
		task.defer(refresh)
	end)
	return panel
end

return RewardsPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="95">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[--!strict
-- Settings: music, sound effects, low graphics, hide other pets, language.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)

local Kit = require(script.Parent.Parent.Kit)
local Panel = require(script.Parent.Parent.Panel)
local Theme = require(script.Parent.Parent.Theme)

local SettingsPanel = {}

local C = Theme.C

function SettingsPanel.new(app: any): Panel.PanelApi
	local panel = Panel.new({
		Parent = app.Gui.panels,
		Title = Strings.get("settingsTitle"),
		Icon = utf8.char(0x2699) .. utf8.char(0xFE0F),
		Palette = "Gray",
		Size = Vector2.new(640, 500),
	})
	local list =
		Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -20), Position = UDim2.fromOffset(0, 22), Parent = panel.body })
	Kit.list(list, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

	local labels: { [string]: TextLabel } = {}
	local toggles: { [string]: Kit.ToggleApi } = {}

	local function row(order: number): Frame
		local frame =
			Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, -10, 0, 60), LayoutOrder = order, Parent = list })
		Kit.corner(frame, 16)
		Kit.stroke(frame, C.PanelLine, 3)
		Kit.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(228, 243, 255))
		return frame
	end

	for order, key in { "music", "sfx", "lowFx", "hidePets" } do
		local frame = row(order)
		labels[key] = Kit.text({
			Text = "",
			TextSize = 24,
			Color = C.Navy,
			Stroke = 0,
			Size = UDim2.new(1, -140, 1, 0),
			Position = UDim2.fromOffset(20, 0),
			XAlign = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		toggles[key] = Kit.toggle({
			Value = true,
			Position = UDim2.new(1, -18, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Parent = frame,
			OnChange = function(value)
				app.setSetting(key, value)
			end,
		})
	end

	local langRow = row(5)
	labels.language = Kit.text({
		Text = "",
		TextSize = 24,
		Color = C.Navy,
		Stroke = 0,
		Size = UDim2.new(0.4, 0, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		XAlign = Enum.TextXAlignment.Left,
		Parent = langRow,
	})
	local langButtons: { [string]: Kit.ButtonApi } = {}
	for i, lang in { "en", "ko" } do
		langButtons[lang] = Kit.button({
			Text = if lang == "en" then "English" else "한국어",
			TextSize = 20,
			Palette = "Gray",
			Size = UDim2.fromOffset(130, 44),
			Position = UDim2.new(1, -18 - (2 - i) * 140, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Parent = langRow,
			OnClick = function()
				app.setSetting("lang", lang)
			end,
		})
	end

	-- Promo code redemption.
	local codeRow = row(6)
	local codeLabel = Kit.text({
		Text = "",
		TextSize = 24,
		Color = C.Navy,
		Stroke = 0,
		Size = UDim2.new(0.3, 0, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		XAlign = Enum.TextXAlignment.Left,
		Parent = codeRow,
	})
	local codeBox = Kit.new("TextBox", {
		Text = "",
		TextSize = 20,
		FontFace = Theme.Font,
		TextColor3 = C.Ink,
		PlaceholderColor3 = C.Muted,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		ClearTextOnFocus = false,
		Size = UDim2.fromOffset(180, 44),
		Position = UDim2.new(0.32, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = codeRow,
	}) :: TextBox
	Kit.corner(codeBox, 12)
	Kit.stroke(codeBox, C.PanelLine, 2)
	Kit.padding(codeBox, 0, 12, 0, 12)
	local redeemButton = Kit.button({
		Text = "",
		TextSize = 20,
		Palette = "Purple",
		Size = UDim2.fromOffset(120, 44),
		Position = UDim2.new(1, -18, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Parent = codeRow,
		OnClick = function()
			local code = codeBox.Text
			if code == "" then
				app.Toasts.show(Strings.get("enterCode"), "info")
				return
			end
			local result = app.Net.invoke("RedeemCode", { code = code })
			if result.ok then
				app.Sfx.play("Legendary")
				codeBox.Text = ""
				local reward = result.data or {}
				local parts = {}
				if (reward.coins or 0) > 0 then
					table.insert(parts, Format.commas(reward.coins) .. " " .. Strings.get("coins"))
				end
				if (reward.enchants or 0) > 0 then
					table.insert(parts, "+" .. reward.enchants .. " " .. utf8.char(0x2728))
				end
				app.Toasts.show(Strings.get("codeRedeemed") .. (if #parts > 0 then "  " .. table.concat(parts, ", ") else ""), "gold")
			else
				app.Sfx.play("Error")
				if result.err then
					app.Toasts.show(Strings.get(result.err), "bad")
				end
			end
		end,
	})

	local help = Kit.text({
		Text = "",
		TextSize = 16,
		Color = C.Muted,
		Stroke = 0,
		Wrapped = true,
		Size = UDim2.new(1, -20, 0, 44),
		LayoutOrder = 7,
		Parent = list,
	})
	local version = Kit.text({
		Text = Config.Title .. "  v" .. Config.Version,
		TextSize = 14,
		Color = C.Muted,
		Stroke = 0,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 8,
		Parent = list,
	})
	local _ = version

	local function refresh()
		local settings = app.State.settings()
		panel.setTitle(Strings.get("settingsTitle"))
		for key, label in labels do
			label.Text = Strings.get("setting." .. key)
		end
		for key, toggle in toggles do
			toggle.set((settings :: any)[key] == true)
		end
		for lang, button in langButtons do
			-- Highlight the language in effect (the saved value may be "auto").
			button.setPalette(if Strings.language == lang then "Blue" else "Gray")
		end
		help.Text = Strings.get(if app.Gui.isTouch() then "controlsTouch" else "controlsPc")
		codeLabel.Text = Strings.get("redeemLabel")
		codeBox.PlaceholderText = Strings.get("enterCode")
		redeemButton.setText(Strings.get("redeemButton"))
	end

	panel.onOpen = function()
		app.Sfx.play("Open")
		refresh()
	end
	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
	app.State.languageChanged:Connect(refresh)
	return panel
end

return SettingsPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="96">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[--!strict
-- Robux shop: game passes and coin packs. Items whose id is 0 show "Coming Soon".

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)

local Kit = require(script.Parent.Parent.Kit)
local Panel = require(script.Parent.Parent.Panel)
local Theme = require(script.Parent.Parent.Theme)

local ShopPanel = {}

local C = Theme.C

local ICONS = {
	DoubleCoins = utf8.char(0x1F4B0),
	LuckyEggs = utf8.char(0x1F340),
	PetSlots = utf8.char(0x1F43E),
	SwiftFins = utf8.char(0x1F42C),
	CoinsSmall = utf8.char(0x1FA99),
	CoinsMedium = utf8.char(0x1F4B0),
	CoinsLarge = utf8.char(0x1F451),
	LuckyEnchant = utf8.char(0x2728),
	VIPAura = utf8.char(0x1F451),
	UnlockBoost = utf8.char(0x1F513),
	AutoSell = utf8.char(0x1F4B8),
	SwimTrail = utf8.char(0x2728),
	BorderSilver = utf8.char(0x1F5BC) .. utf8.char(0xFE0F),
	BorderGold = utf8.char(0x1F5BC) .. utf8.char(0xFE0F),
	StarterPack = utf8.char(0x1F381),
	InstantUnlock = utf8.char(0x1F513),
	TimedBoost = utf8.char(0x26A1),
	GodShark = utf8.char(0x1F988),
	PetReroll = utf8.char(0x1F3B2),
	GuaranteedMutation = utf8.char(0x1F52E),
	BackpackFill = utf8.char(0x1F392),
}

type Card = { key: string, kind: string, name: TextLabel, desc: TextLabel, buy: Kit.ButtonApi, def: any }

function ShopPanel.new(app: any): Panel.PanelApi
	local panel = Panel.new({
		Parent = app.Gui.panels,
		Title = Strings.get("shopTitle"),
		Icon = utf8.char(0x1F6D2),
		Palette = "Green",
		Size = Vector2.new(860, 540),
	})
	local scroll = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -10),
		Position = UDim2.fromOffset(0, 14),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = C.NavySoft,
		BorderSizePixel = 0,
		Parent = panel.body,
	}) :: ScrollingFrame
	Kit.padding(scroll, 8, 16, 16, 8)
	Kit.list(scroll, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

	local cards: { Card } = {}
	local headers: { [string]: TextLabel } = {}

	local function section(key: string, order: number): Frame
		headers[key] = Kit.text({
			Text = "",
			TextSize = 26,
			Color = C.Navy,
			Stroke = 0,
			Size = UDim2.new(1, 0, 0, 34),
			XAlign = Enum.TextXAlignment.Left,
			LayoutOrder = order,
			Parent = scroll,
		})
		local grid = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order + 1,
			Parent = scroll,
		})
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(250, 210),
			CellPadding = UDim2.fromOffset(14, 14),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Parent = grid,
		})
		return grid
	end

	local function card(parent: Frame, def: any, kind: string, order: number)
		local color = Color.hex(def.color)
		local frame = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = order, Parent = parent })
		Kit.corner(frame, 20)
		Kit.gradient(frame, Color.lighten(color, 0.45), color, 100)
		Kit.stroke(frame, Color.darken(color, 0.55), 4)
		Kit.text({
			Text = ICONS[def.key] or utf8.char(0x2B50),
			TextSize = 54,
			Size = UDim2.new(1, 0, 0, 64),
			Position = UDim2.fromOffset(0, 8),
			Stroke = 0,
			Parent = frame,
		})
		local name = Kit.text({
			Text = "",
			TextSize = 24,
			Size = UDim2.new(1, -12, 0, 28),
			Position = UDim2.new(0.5, 0, 0, 74),
			AnchorPoint = Vector2.new(0.5, 0),
			StrokeColor = Color.darken(color, 0.6),
			Parent = frame,
		})
		local desc = Kit.text({
			Text = "",
			TextSize = 16,
			Wrapped = true,
			Size = UDim2.new(1, -20, 0, 42),
			Position = UDim2.new(0.5, 0, 0, 104),
			AnchorPoint = Vector2.new(0.5, 0),
			StrokeColor = Color.darken(color, 0.6),
			Stroke = 2,
			Parent = frame,
		})
		local buy = Kit.button({
			Text = "",
			TextSize = 22,
			Palette = "Green",
			Size = UDim2.new(1, -30, 0, 48),
			Position = UDim2.new(0.5, 0, 1, -12),
			AnchorPoint = Vector2.new(0.5, 1),
			Parent = frame,
			OnClick = function()
				if def.id <= 0 then
					app.Toasts.show(Strings.get("comingSoon"), "info")
					return
				end
				local player = Players.LocalPlayer
				if kind == "pass" then
					if app.State.passes[def.key] then
						return
					end
					MarketplaceService:PromptGamePassPurchase(player, def.id)
				else
					MarketplaceService:PromptProductPurchase(player, def.id)
				end
			end,
		})
		table.insert(cards, { key = def.key, kind = kind, name = name, desc = desc, buy = buy, def = def })
	end

	local passGrid = section("passes", 1)
	for i, def in Config.Passes do
		card(passGrid, def, "pass", i)
	end
	local productGrid = section("products", 3)
	for i, def in Config.Products do
		card(productGrid, def, "product", i)
	end

	local function refresh()
		panel.setTitle(Strings.get("shopTitle"))
		headers.passes.Text = Strings.get("passes")
		headers.products.Text = Strings.get("products")
		local profile = app.State.profile
		local unlocked = if profile then profile.unlocked else 1
		for _, c in cards do
			if c.kind == "pass" then
				c.name.Text = Strings.get("pass." .. c.key)
				c.desc.Text = Strings.get("pass." .. c.key .. ".desc")
			else
				c.name.Text = Strings.get("product." .. c.key)
				c.desc.Text = if c.def.dives > 0
					then Strings.get("product.desc", { n = Format.short(Economy.productCoins(c.def.dives, unlocked)) })
					else Strings.get("product." .. c.key .. ".desc", { n = Config.TimedBoostMinutes })
			end
			if c.kind == "pass" and app.State.passes[c.key] then
				c.buy.setText(Strings.get("owned"))
				c.buy.setPalette("Gold")
			elseif c.def.id <= 0 then
				c.buy.setText(Strings.get("comingSoon"))
				c.buy.setPalette("Gray")
			else
				c.buy.setText("R$ " .. tostring(c.def.price))
				c.buy.setPalette("Green")
			end
		end
	end

	panel.onOpen = function()
		app.Sfx.play("Open")
		refresh()
	end
	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
	app.State.languageChanged:Connect(refresh)
	return panel
end

return ShopPanel
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="97">
              <Properties>
                <string name="Name">Worlds</string>
                <string name="Source"><![CDATA[--!strict
-- World select: 20 themed cards with each world's egg, lock/clear state and one-tap travel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Anim = require(script.Parent.Parent.Anim)
local Kit = require(script.Parent.Parent.Kit)
local Panel = require(script.Parent.Parent.Panel)
local Theme = require(script.Parent.Parent.Theme)
local Viewport = require(script.Parent.Parent.Viewport)

local WorldsPanel = {}

local C = Theme.C

type Card = {
	button: TextButton,
	lock: Frame,
	lockText: TextLabel,
	here: Frame,
	check: Frame,
	name: TextLabel,
	number: TextLabel,
	depth: TextLabel,
	view: Viewport.ViewApi,
}

function WorldsPanel.new(app: any): Panel.PanelApi
	local panel = Panel.new({
		Parent = app.Gui.panels,
		Title = Strings.get("worldsTitle"),
		Icon = utf8.char(0x1F30D),
		Palette = "Blue",
		Size = Vector2.new(870, 540),
	})
	local scroll = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -10),
		Position = UDim2.fromOffset(0, 14),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = C.NavySoft,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		BorderSizePixel = 0,
		Parent = panel.body,
	}) :: ScrollingFrame
	Kit.padding(scroll, 10, 16, 16, 10)
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(186, 184),
		CellPadding = UDim2.fromOffset(12, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = scroll,
	})

	local cards: { Card } = {}
	local armed: number? = nil -- world whose unlock waits for a confirming second tap
	local refresh: () -> ()

	-- The world right after your frontier can be bought once the frontier is cleared.
	local function buyable(index: number): boolean
		local profile = app.State.profile
		return profile ~= nil and index == profile.unlocked + 1 and app.State.progress(profile.unlocked).cleared
	end

	for index = 1, Config.WorldCount do
		local data = Worlds.get(index)
		local a1, a2 = Color.hex(data.accent[1]), Color.hex(data.accent[2])
		local button = Kit.new("TextButton", {
			Name = "World" .. index,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = index,
			Parent = scroll,
		}) :: TextButton
		Kit.corner(button, 20)
		Kit.gradient(button, Color.lighten(a1, 0.15), a2, 120)
		Kit.stroke(button, Color.darken(a2, 0.55), 4)
		local gloss = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.82,
			Size = UDim2.new(1, -12, 0.4, 0),
			Position = UDim2.fromOffset(6, 5),
			Parent = button,
		})
		Kit.corner(gloss, 16)
		local numberBubble = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.fromOffset(44, 44),
			Position = UDim2.fromOffset(8, 8),
			ZIndex = 3,
			Parent = button,
		})
		Kit.round(numberBubble)
		Kit.stroke(numberBubble, Color.darken(a2, 0.5), 3)
		local number = Kit.text({
			Text = tostring(index),
			TextSize = 26,
			Color = Color.darken(a2, 0.35),
			Stroke = 0,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 4,
			Parent = numberBubble,
		})
		local view = Viewport.new(button, UDim2.fromOffset(120, 104), UDim2.new(0.5, 0, 0, 16), Vector2.new(0.5, 0))
		view.frame.ZIndex = 2
		view.setModel(Viewport.egg(index))
		local name = Kit.text({
			Text = "",
			TextSize = 20,
			Size = UDim2.new(1, -10, 0, 26),
			Position = UDim2.new(0.5, 0, 1, -54),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 3,
			StrokeColor = Color.darken(a2, 0.55),
			Parent = button,
		})
		local depth = Kit.text({
			Text = "",
			TextSize = 16,
			Size = UDim2.new(1, -10, 0, 20),
			Position = UDim2.new(0.5, 0, 1, -28),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 3,
			Color = Color.hex("#e8f8ff"),
			StrokeColor = Color.darken(a2, 0.55),
			Parent = button,
		})

		local here = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.fromOffset(78, 30),
			Position = UDim2.new(1, -6, 0, 8),
			AnchorPoint = Vector2.new(1, 0),
			ZIndex = 5,
			Visible = false,
			Parent = button,
		})
		Kit.round(here)
		Kit.gradient(here, Theme.Buttons.Gold[1], Theme.Buttons.Gold[2])
		Kit.stroke(here, Theme.Buttons.Gold[3], 3)
		Kit.text({
			Name = "HereText",
			Text = "",
			TextSize = 18,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 6,
			StrokeColor = Theme.Buttons.Gold[3],
			Parent = here,
		})
		local check = Kit.new("Frame", {
			BackgroundColor3 = C.Green,
			Size = UDim2.fromOffset(34, 34),
			Position = UDim2.new(1, -8, 0, 8),
			AnchorPoint = Vector2.new(1, 0),
			ZIndex = 5,
			Visible = false,
			Parent = button,
		})
		Kit.round(check)
		Kit.stroke(check, C.GreenDark, 3)
		Kit.text({ Text = utf8.char(0x2714), TextSize = 20, Size = UDim2.fromScale(1, 1), ZIndex = 6, StrokeColor = C.GreenDark, Parent = check })

		local lock = Kit.new("Frame", {
			BackgroundColor3 = Color.hex("#0a1626"),
			BackgroundTransparency = 0.35,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 8,
			Visible = false,
			Parent = button,
		})
		Kit.corner(lock, 20)
		Kit.text({
			Text = utf8.char(0x1F512),
			TextSize = 44,
			Size = UDim2.new(1, 0, 0, 56),
			Position = UDim2.fromOffset(0, 34),
			Stroke = 0,
			ZIndex = 9,
			Parent = lock,
		})
		local lockText = Kit.text({
			Text = "",
			TextSize = 18,
			Size = UDim2.new(1, -10, 0, 40),
			Position = UDim2.new(0.5, 0, 0, 98),
			AnchorPoint = Vector2.new(0.5, 0),
			Wrapped = true,
			ZIndex = 9,
			Parent = lock,
		})

		local card: Card = {
			button = button,
			lock = lock,
			lockText = lockText,
			here = here,
			check = check,
			name = name,
			number = number,
			depth = depth,
			view = view,
		}
		cards[index] = card

		button.MouseEnter:Connect(function()
			view.setSpin(true)
			Anim.tween(Anim.scaleOf(button), 0.15, { Scale = 1.04 }, Enum.EasingStyle.Back)
		end)
		button.MouseLeave:Connect(function()
			view.setSpin(false)
			Anim.tween(Anim.scaleOf(button), 0.15, { Scale = 1 })
		end)
		button.Activated:Connect(function()
			local profile = app.State.profile
			if not profile then
				return
			end
			if index > profile.unlocked then
				if buyable(index) then
					if profile.coins < Economy.unlockCost(index) then
						app.Sfx.play("Error")
						Anim.shake(button, 6)
						app.Toasts.show(Strings.get("notEnough"), "bad", utf8.char(0x1F512))
						app.Offers.trigger("unlock")
					elseif armed ~= index then
						app.Sfx.play("Click")
						armed = index
						refresh()
						task.delay(3, function()
							if armed == index then
								armed = nil
								refresh()
							end
						end)
					else
						armed = nil
						if app.unlockWorld(index, false) then
							Anim.pop(button, 0.12)
						end
						refresh()
					end
					return
				end
				app.Sfx.play("Error")
				Anim.shake(button, 6)
				app.Toasts.show(Strings.get("lockedHint", { n = index - 1 }), "bad", utf8.char(0x1F512))
				return
			end
			app.Sfx.play("Click")
			if index == app.State.world then
				panel.close()
				return
			end
			panel.close()
			app.travel(index)
		end)
	end

	refresh = function()
		local profile = app.State.profile
		panel.setTitle(Strings.get("worldsTitle"))
		for index, card in cards do
			local data = Worlds.get(index)
			card.name.Text = Strings.name(data.name)
			card.depth.Text = Strings.get("depthMax", { n = data.meters })
			local unlocked = profile ~= nil and index <= profile.unlocked
			local progress = app.State.progress(index)
			card.lock.Visible = not unlocked
			if buyable(index) then
				local cost = Economy.unlockCost(index)
				card.lockText.Text = if armed == index then Strings.get("unlockTap") else Strings.get("unlockCard", { n = Format.short(cost) })
				card.lockText.TextColor3 = if profile and profile.coins >= cost then Color.hex("#ffe27a") else C.White
			else
				card.lockText.Text = Strings.get("lockedHint", { n = index - 1 })
				card.lockText.TextColor3 = C.White
			end
			local current = index == app.State.world
			card.here.Visible = current
			local hereText = card.here:FindFirstChild("HereText") :: TextLabel?
			if hereText then
				hereText.Text = Strings.get("here")
			end
			card.check.Visible = progress.cleared and not current
		end
	end

	panel.onOpen = function()
		app.Sfx.play("Open")
		refresh()
		local profile = app.State.profile
		if profile then
			-- Scroll so the frontier world is visible.
			local row = math.floor((math.min(profile.unlocked, Config.WorldCount) - 1) / 4)
			scroll.CanvasPosition = Vector2.new(0, math.max(0, row - 1) * 198)
		end
	end
	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			refresh()
		end
	end)
	app.State.languageChanged:Connect(refresh)
	return panel
end

return WorldsPanel
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">PlayerList</string>
              <string name="Source"><![CDATA[--!strict
-- Custom player list (replaces Roblox's Tab list): avatar, nickname, coins and relics collected,
-- sorted by coins. Tab toggles it; touch screens get a button instead.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)
local TierStyle = require(script.Parent.TierStyle)

local PlayerList = {}

local C = Theme.C
local VIP_CROWN = utf8.char(0x1F451) .. " "
local OPERATOR_BADGE = utf8.char(0x1F6E1) .. utf8.char(0xFE0F) .. " " -- shield
local OPERATOR_RED_DARK = Color3.fromRGB(120, 10, 10)
local TAG_W = 40
local WIDTH = 430
local ROW = 38
-- Columns start after the avatar (42); the trade button (34) follows the relic column and the
-- row keeps an 8px right margin: 42 + 174 + 80 + 62 + 6 + 34 + 8 = 406 = 430 - 16 - 8.
local NAME_W, COIN_W, RELIC_W = 174, 80, 62
local TRADE_X = 42 + NAME_W + COIN_W + RELIC_W + 6

type Row = { frame: Frame, name: TextLabel, tag: TextLabel, coins: TextLabel, relics: TextLabel, stroke: UIStroke, director: boolean }

-- `rankOf` gives a UserId's weekly ranking position (shown as "#N" after the name).
function PlayerList.init(onTrade: ((Player) -> ())?, rankOf: ((number) -> number?)?)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	end)
	local localPlayer = Players.LocalPlayer

	local panel = Kit.new("Frame", {
		Name = "PlayerList",
		BackgroundColor3 = C.Navy,
		BackgroundTransparency = 0.18,
		Size = UDim2.fromOffset(WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(1, -16, 0, 10),
		AnchorPoint = Vector2.new(1, 0),
		Parent = Gui.hudTop,
	}) :: Frame
	Kit.corner(panel, 14)
	Kit.stroke(panel, C.Outline, 2.5)
	Kit.padding(panel, 0, 8, 8, 8)
	Kit.list(panel, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

	local header = Kit.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, 16, 0, 40), LayoutOrder = 0, Parent = panel })
	Kit.corner(header, 14)
	Kit.gradient(header, Theme.Buttons.Purple[1], Theme.Buttons.Blue[2], 0)
	local title = Kit.text({
		Text = "",
		TextSize = 19,
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		XAlign = Enum.TextXAlignment.Left,
		Stroke = 2.5,
		Parent = header,
	})

	local function columns(parent: Instance, size: number, color: Color3?, stroke: number?): (TextLabel, TextLabel, TextLabel)
		local name = Kit.text({
			Text = "",
			TextSize = size,
			Color = color,
			Stroke = stroke,
			Size = UDim2.fromOffset(NAME_W, ROW),
			Position = UDim2.fromOffset(42, 0),
			XAlign = Enum.TextXAlignment.Left,
			Parent = parent,
		})
		local coins = Kit.text({
			Text = "",
			TextSize = size,
			Color = color,
			Stroke = stroke,
			Size = UDim2.fromOffset(COIN_W, ROW),
			Position = UDim2.fromOffset(42 + NAME_W, 0),
			XAlign = Enum.TextXAlignment.Right,
			Parent = parent,
		})
		local relics = Kit.text({
			Text = "",
			TextSize = size,
			Color = color,
			Stroke = stroke,
			Size = UDim2.fromOffset(RELIC_W, ROW),
			Position = UDim2.fromOffset(42 + NAME_W + COIN_W, 0),
			XAlign = Enum.TextXAlignment.Right,
			Parent = parent,
		})
		return name, coins, relics
	end

	local labels = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Parent = panel })
	local labelName, labelCoins, labelRelics = columns(labels, 13, Color3.fromRGB(170, 196, 226), 0)
	for _, label in { labelName, labelCoins, labelRelics } do
		label.Size = UDim2.new(0, label.Size.X.Offset, 1, 0)
	end

	local rows: { [Player]: Row } = {}

	local function makeRow(player: Player): Row
		local frame = Kit.new("Frame", {
			Name = player.Name,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.9,
			Size = UDim2.new(1, 0, 0, ROW),
			Parent = panel,
		}) :: Frame
		Kit.corner(frame, 10)
		local stroke = Kit.stroke(frame, Theme.Buttons.Gold[2], 2)
		stroke.Enabled = player == localPlayer
		local avatar = Kit.new("ImageLabel", {
			BackgroundColor3 = Color3.fromRGB(60, 90, 140),
			Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", math.max(1, player.UserId)),
			Size = UDim2.fromOffset(30, 30),
			Position = UDim2.fromOffset(6, 4),
			Parent = frame,
		})
		Kit.round(avatar)
		Kit.stroke(avatar, C.Outline, 2)
		local name, coins, relics = columns(frame, 17, nil, 2)
		name.TextTruncate = Enum.TextTruncate.AtEnd
		name.Size = UDim2.fromOffset(NAME_W - TAG_W - 2, ROW)
		-- Long names shrink to fit (down to 10px) instead of being cut off.
		name.TextScaled = true
		Kit.new("UITextSizeConstraint", { MaxTextSize = 17, MinTextSize = 10, Parent = name })
		local tag = Kit.text({
			Name = "RankTag",
			Text = "",
			TextSize = 15,
			Stroke = 2,
			Size = UDim2.fromOffset(TAG_W, ROW),
			Position = UDim2.fromOffset(42 + NAME_W - TAG_W, 0),
			XAlign = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		coins.TextColor3 = Color3.fromRGB(255, 222, 92)
		relics.TextColor3 = Color3.fromRGB(150, 230, 255)
		if player ~= localPlayer and onTrade then
			Kit.button({
				Name = "Trade",
				Text = "",
				Icon = utf8.char(0x1F91D),
				IconSize = 17,
				Palette = "Cyan",
				Size = UDim2.fromOffset(34, 30),
				Position = UDim2.new(0, TRADE_X, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Radius = 10,
				Stroke = 2,
				Parent = frame,
				OnClick = function()
					onTrade(player)
				end,
			})
		end
		local row = { frame = frame, name = name, tag = tag, coins = coins, relics = relics, stroke = stroke, director = false }
		rows[player] = row
		return row
	end

	local function numberOf(player: Player, attribute: string): number
		local value = player:GetAttribute(attribute)
		return if type(value) == "number" then value else 0
	end

	local function refresh()
		local list = Players:GetPlayers()
		table.sort(list, function(a, b)
			local ca, cb = numberOf(a, "Coins"), numberOf(b, "Coins")
			if ca ~= cb then
				return ca > cb
			end
			return a.Name < b.Name
		end)
		for index, player in list do
			local row = rows[player] or makeRow(player)
			row.frame.LayoutOrder = 10 + index
			-- The Director (Operator) outranks tiers, VIP and nameplate borders.
			local operator = player:GetAttribute("Operator") == true
			local vip = player:GetAttribute("VIP") == true
			row.name.Text = (if operator then OPERATOR_BADGE elseif vip then VIP_CROWN else "") .. player.DisplayName
			if operator and not row.director then
				-- Black row, red chroma border, red chroma name and a "DIR" tag.
				row.director = true
				row.frame.BackgroundColor3 = Color3.fromRGB(6, 6, 8)
				row.frame.BackgroundTransparency = 0.1
				row.stroke.Enabled = true
				row.stroke.Thickness = 2.5
				row.stroke.Color = Color3.new(1, 1, 1)
				TierStyle.director(row.stroke)
				TierStyle.director(row.name)
				row.tag.Text = "DIR"
				TierStyle.director(row.tag)
			end
			if not operator then
				local fallback = if player == localPlayer then Color3.fromRGB(255, 232, 140) else C.White
				TierStyle.apply(row.name, tonumber(player:GetAttribute("Tier")) or 0, fallback)
				local rank = if rankOf then rankOf(player.UserId) else nil
				row.tag.Text = if rank then "#" .. rank else ""
				row.tag.TextColor3 = if rank and rank <= 3 then Color3.fromRGB(255, 214, 90) else Color3.fromRGB(190, 214, 240)
			end
			local border = player:GetAttribute("Border")
			local nameStroke = row.name:FindFirstChildOfClass("UIStroke")
			if nameStroke then
				nameStroke.Color = if operator
					then OPERATOR_RED_DARK
					elseif border == "Gold" then Color3.fromRGB(255, 214, 90)
					elseif border == "Silver" then Color3.fromRGB(210, 220, 232)
					else Color3.fromRGB(21, 38, 58)
			end
			row.coins.Text = Format.short(numberOf(player, "Coins"))
			row.relics.Text = Format.short(numberOf(player, "Relics"))
		end
		title.Text = utf8.char(0x1F465) .. "  " .. Strings.get("playersTitle") .. "  " .. #list
		labelName.Text = Strings.get("colName")
		labelCoins.Text = Strings.get("colCoins")
		labelRelics.Text = Strings.get("colRelics")
	end

	local function watch(player: Player)
		player:GetAttributeChangedSignal("Coins"):Connect(refresh)
		player:GetAttributeChangedSignal("Relics"):Connect(refresh)
		player:GetAttributeChangedSignal("VIP"):Connect(refresh)
		player:GetAttributeChangedSignal("Border"):Connect(refresh)
		player:GetAttributeChangedSignal("Operator"):Connect(refresh)
		player:GetAttributeChangedSignal("Tier"):Connect(refresh)
		refresh()
	end
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(player)
		local row = rows[player]
		if row then
			row.frame:Destroy()
			rows[player] = nil
		end
		task.defer(refresh)
	end)

	-- Visibility: open by default with a keyboard, toggled with Tab or the touch button.
	local touch = Gui.isTouch()
	panel.Visible = not touch
	local function setOpen(open: boolean)
		panel.Visible = open
		if open then
			Anim.pop(panel, 0.06)
			refresh()
		end
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Tab then
			setOpen(not panel.Visible)
		end
	end)
	if touch then
		local toggle = Kit.button({
			Name = "PlayersButton",
			Text = "",
			Icon = utf8.char(0x1F465),
			IconSize = 24,
			Palette = "Purple",
			Size = UDim2.fromOffset(52, 52),
			Position = UDim2.new(1, -16, 0, 6),
			AnchorPoint = Vector2.new(1, 0),
			Radius = 26,
			Stroke = 2.5,
			Parent = Gui.hudTop,
			OnClick = function()
				setOpen(not panel.Visible)
			end,
		})
		panel.Position = UDim2.new(1, -16, 0, 64)
		local _ = toggle
	end
	refresh()
	return { refresh = refresh, setOpen = setOpen }
end

return PlayerList
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">Purchase</string>
              <string name="Source"><![CDATA[--!strict
-- Robux purchase prompts by Config key (a game pass or a developer product).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Purchase = {}

export type Def = { key: string, id: number, price: number, color: string }

-- Returns the definition and "pass" | "product", or nil for an unknown key.
function Purchase.find(key: string): (Def?, string?)
	for _, def in Config.Passes do
		if def.key == key then
			return def :: any, "pass"
		end
	end
	for _, def in Config.Products do
		if def.key == key then
			return def :: any, "product"
		end
	end
	return nil, nil
end

-- Opens Roblox's purchase dialog. Returns false when the item has no id yet or is an owned pass.
function Purchase.prompt(key: string, ownedPasses: { [string]: boolean }): boolean
	local def, kind = Purchase.find(key)
	if not def or def.id <= 0 then
		return false
	end
	local player = Players.LocalPlayer
	if kind == "pass" then
		if ownedPasses[key] then
			return false
		end
		MarketplaceService:PromptGamePassPurchase(player, def.id)
	else
		MarketplaceService:PromptProductPurchase(player, def.id)
	end
	return true
end

return Purchase
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">RightRail</string>
              <string name="Source"><![CDATA[--!strict
-- Right-hand HUD column, laid out like the left menu rail (one column on desktop; on touch screens
-- a two-wide block kept above Roblox's jump button so it never covers the controls): the limited
-- GOD Shark, the Starter Pack (with a real countdown for the first
-- Config.StarterOfferHours after a player's first visit), Rewards, the group and friend invites.

local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Operators = require(Shared.Operators)
local Strings = require(Shared.Strings)

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Purchase = require(script.Parent.Purchase)
local Theme = require(script.Parent.Theme)
local RewardsPanel = require(script.Parent.Panels.Rewards)

local RightRail = {}

local C = Theme.C
local BUTTON = 76
local GAP = 10
local TOUCH_SCALE = if Gui.isTouch() then 1.2 else 1
local MARGIN = 16

-- How far up from the bottom of the screen (in pixels) Roblox's touch jump button reaches: read
-- from the live button when it exists, never less than where Roblox's own layout puts it.
local function jumpReach(): number
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 760)
	local small = math.min(viewport.X, viewport.Y) <= 500
	local reach = if small then 90 else 210
	local touchGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
	touchGui = touchGui and touchGui:FindFirstChild("TouchGui")
	local frame = touchGui and touchGui:FindFirstChild("TouchControlFrame")
	local jump = frame and frame:FindFirstChild("JumpButton")
	if frame and jump and frame:IsA("GuiObject") and jump:IsA("GuiObject") then
		local bottom = frame.AbsolutePosition.Y + frame.AbsoluteSize.Y
		reach = math.max(reach, bottom - jump.AbsolutePosition.Y)
	end
	return reach
end

type Item = { api: Kit.ButtonApi, label: TextLabel, badge: Frame }

-- Seconds left on the starter offer, or nil when it should not be advertised.
function RightRail.starterLeft(app: any): number?
	local profile = app.State.profile
	local def = Purchase.find("StarterPack")
	if not profile or not def or def.id <= 0 or app.State.passes.StarterPack or profile.starterPackGranted then
		return nil
	end
	local left = profile.created + Config.StarterOfferHours * 3600 - os.time()
	return if left > 0 then left else nil
end

-- Opens Roblox's purchase dialog for a Robux item, or says it is not on sale yet.
local function buy(app: any, key: string)
	if not Purchase.prompt(key, app.State.passes) then
		app.Toasts.show(Strings.get("comingSoon"), "info")
	end
end

function RightRail.init(app: any, openRewards: () -> ())
	local rail = Kit.new("Frame", {
		Name = "RightRail",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(BUTTON, BUTTON),
		Position = UDim2.new(1, -MARGIN, 1, -MARGIN),
		AnchorPoint = Vector2.new(1, 1),
		Parent = Gui.hud,
	}) :: Frame
	-- Touch: rows of two filled from the top-right corner (the GOD Shark nearest the edge).
	local touch = TOUCH_SCALE > 1
	local grid = Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(BUTTON, BUTTON),
		CellPadding = UDim2.fromOffset(GAP, GAP + 4),
		FillDirection = if touch then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		StartCorner = if touch then Enum.StartCorner.TopRight else Enum.StartCorner.TopLeft,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = if touch then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = rail,
	}) :: UIGridLayout
	if TOUCH_SCALE > 1 then
		local scale = Instance.new("UIScale")
		scale.Scale = TOUCH_SCALE
		scale.Parent = rail
	end

	local items: { Item } = {}

	local function item(name: string, icon: string, palette: string, order: number, onClick: () -> ()): Item
		local api = Kit.button({
			Name = name,
			Icon = icon,
			IconSize = 34,
			Palette = palette,
			Size = UDim2.fromOffset(BUTTON, BUTTON),
			Radius = 18,
			Stroke = 2.5,
			LayoutOrder = order,
			Parent = rail,
			OnClick = onClick,
		})
		local content = api.button:FindFirstChild("Content") :: Frame?
		if content then
			content.Position = UDim2.fromOffset(0, -9)
		end
		local label = Kit.text({
			Text = "",
			TextSize = 15,
			Size = UDim2.new(1, -4, 0, 18),
			Position = UDim2.new(0, 2, 1, -21),
			ZIndex = 4,
			Stroke = 2,
			StrokeColor = (Theme.Buttons[palette] or Theme.Buttons.Blue)[3],
			Parent = api.button,
		})
		label.TextScaled = true
		Kit.new("UITextSizeConstraint", { MaxTextSize = 15, MinTextSize = 9, Parent = label })
		local badge = Kit.new("Frame", {
			Name = "Badge",
			BackgroundColor3 = C.Red,
			Size = UDim2.fromOffset(20, 20),
			Position = UDim2.new(1, -4, 0, 4),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Visible = false,
			ZIndex = 5,
			Parent = api.button,
		}) :: Frame
		Kit.round(badge)
		Kit.stroke(badge, C.White, 2)
		Kit.text({ Text = "!", TextSize = 14, Size = UDim2.fromScale(1, 1), ZIndex = 6, Stroke = 1.5, Parent = badge })
		local entry = { api = api, label = label, badge = badge }
		table.insert(items, entry)
		return entry
	end

	local function ribbon(target: Item): TextLabel
		local frame = Kit.new("Frame", {
			Name = "Ribbon",
			BackgroundColor3 = C.Red,
			Size = UDim2.fromOffset(66, 18),
			Position = UDim2.new(0.5, 0, 0, -9),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 6,
			Parent = target.api.button,
		})
		Kit.round(frame)
		Kit.stroke(frame, C.White, 2)
		return Kit.text({ Text = "", TextSize = 11, Size = UDim2.fromScale(1, 1), ZIndex = 7, Stroke = 1.4, Parent = frame })
	end

	-- Limited GOD Shark: always on sale, glowing and pulsing so it stands out.
	local godShark = item("GodSharkButton", utf8.char(0x1F988), "Cyan", 1, function()
		buy(app, "GodShark")
	end)
	local godRibbon = ribbon(godShark)
	Kit.neon(godShark.api.button, C.Gold)

	local starter = item("StarterOffer", utf8.char(0x1F381), "Green", 2, function()
		buy(app, "StarterPack")
	end)
	local starterRibbon = ribbon(starter)

	local rewards = item("RewardsButton", utf8.char(0x1F381), "Pink", 3, openRewards)

	local group = item("GroupButton", utf8.char(0x1F465), "Blue", 4, function()
		local groupId = Operators.groupId()
		local profile = app.State.profile
		if groupId <= 0 or not profile then
			return
		end
		if profile.groupRewarded then
			app.Toasts.show(Strings.get("groupThanks"), "blue", utf8.char(0x1F465))
			return
		end
		pcall(function()
			GroupService:PromptJoinAsync(groupId)
		end)
		local result = app.Net.invoke("ClaimGroup")
		if result.ok then
			app.Sfx.play("Unlock")
			app.Toasts.show(Strings.get("groupReward", { n = Format.commas(result.data.coins) }), "gold", utf8.char(0x1F465))
		else
			app.Sfx.play("Error")
			app.Toasts.show(Strings.get(result.err or "err.generic"), "bad", utf8.char(0x1F465))
		end
	end)

	local invite = item("InviteButton", utf8.char(0x1F48C), "Purple", 5, function()
		local player = Players.LocalPlayer
		local ok, can = pcall(function()
			return SocialService:CanSendGameInviteAsync(player)
		end)
		if ok and can then
			pcall(function()
				SocialService:PromptGameInvite(player)
			end)
		end
	end)

	-- Desktop: one column bottom-right (two on short screens). Touch: a block two wide whose bottom
	-- sits above the jump button, widening to three if the space above it is too short.
	local function layout()
		local visible = 0
		for _, entry in items do
			if entry.api.button.Visible then
				visible += 1
			end
		end
		visible = math.max(visible, 1)
		local canvas = Gui.canvasSize
		local columns, rows
		if touch then
			local bottom = canvas.Y - jumpReach() / Gui.scale - 12
			local room = (bottom - 64) / TOUCH_SCALE
			columns = 2
			rows = math.ceil(visible / columns)
			if rows * BUTTON + (rows - 1) * (GAP + 4) > room then
				columns = 3
				rows = math.ceil(visible / columns)
			end
			grid.FillDirectionMaxCells = columns
			rail.Position = UDim2.new(1, -MARGIN, 0, math.max(bottom, 64))
		else
			local perColumn = if canvas.Y < 660 then 3 else visible
			columns = math.ceil(visible / perColumn)
			rows = math.min(visible, perColumn)
			grid.FillDirectionMaxCells = perColumn
			rail.Position = UDim2.new(1, -MARGIN, 1, -MARGIN)
		end
		rail.Size = UDim2.fromOffset(columns * BUTTON + (columns - 1) * GAP, rows * BUTTON + (rows - 1) * (GAP + 4))
	end
	Gui.resized:Connect(layout)

	local function refresh()
		local profile = app.State.profile
		local sharkDef = Purchase.find("GodShark")
		godShark.api.button.Visible = sharkDef ~= nil and sharkDef.id > 0
		godShark.label.Text = if sharkDef then "R$ " .. tostring(sharkDef.price) else ""
		godRibbon.Text = Strings.get("limited")

		local left = RightRail.starterLeft(app)
		starter.api.button.Visible = left ~= nil
		starter.label.Text = if left then Format.clock(left) else ""
		starterRibbon.Text = Strings.get("limited")

		local ready = RewardsPanel.anyReady(app)
		if ready ~= rewards.badge.Visible then
			rewards.badge.Visible = ready
			if ready then
				Anim.pop(rewards.badge, 0.6)
			end
		end
		local wait = if ready then nil else RewardsPanel.nextUnlock(app)
		rewards.label.Text = if wait then Format.clock(wait) else Strings.get("rewardsTitle")

		group.api.button.Visible = Operators.groupId() > 0
		group.badge.Visible = profile ~= nil and not profile.groupRewarded
		group.label.Text = Strings.get("groupButton")
		invite.label.Text = Strings.get("inviteButton")
		layout()
	end

	-- Phones need the corner for swim controls while in the water.
	RunService.RenderStepped:Connect(function()
		rail.Visible = not (Gui.isTouch() and app.State.dive.swimming)
	end)
	task.spawn(function()
		local tick = 0
		while true do
			refresh()
			tick += 1
			if tick % 4 == 0 and godShark.api.button.Visible then
				Anim.pop(godShark.api.button, 0.12)
			end
			task.wait(1)
		end
	end)
	app.State.languageChanged:Connect(function()
		task.defer(refresh)
	end)
end

return RightRail
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">Screens</string>
              <string name="Source"><![CDATA[--!strict
-- Full-screen moments: loading curtain, blackout, and the bubble wipe used for world travel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Screens = {}

local C = Theme.C

local function bubbles(parent: Frame, count: number)
	local alive = true
	task.spawn(function()
		while alive and parent.Parent do
			local size = math.random(10, 44)
			local bubble = Kit.new("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.72,
				Size = UDim2.fromOffset(size, size),
				Position = UDim2.new(math.random(), 0, 1, size),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Parent = parent,
			})
			Kit.round(bubble)
			Kit.stroke(bubble, Color3.new(1, 1, 1), 2).Transparency = 0.4
			local duration = 4 + math.random() * 4
			Anim.tween(
				bubble,
				duration,
				{ Position = UDim2.new(bubble.Position.X.Scale + (math.random() - 0.5) * 0.1, 0, -0.1, 0) },
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut
			)
			task.delay(duration, function()
				bubble:Destroy()
			end)
			task.wait(4 / count)
		end
	end)
	return function()
		alive = false
	end
end

-- Loading -----------------------------------------------------------------------------------------

local loading: Frame? = nil
local stopLoadingBubbles: (() -> ())? = nil
local loadingStatus: TextLabel? = nil

function Screens.showLoading()
	local frame = Kit.new("Frame", {
		Name = "Loading",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 100,
		Parent = Gui.top,
	}) :: Frame
	Kit.gradient(frame, Color.hex("#3fd6ff"), Color.hex("#0a1f4a"))
	stopLoadingBubbles = bubbles(frame, 16)

	local titleRow = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(900, 150),
		Position = UDim2.fromScale(0.5, 0.4),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 101,
		Parent = frame,
	})
	Kit.list(titleRow, Enum.FillDirection.Horizontal, 2)
	local letters = {}
	local title = Strings.get("title")
	for index, char in utf8.codes(title) do
		-- Each letter sits in a fixed-width holder so it can bob without fighting the list layout.
		local glyph = utf8.char(char)
		local width = if char == 32 then 36 else TextService:GetTextSize(glyph, 110, Enum.Font.FredokaOne, Vector2.new(1000, 1000)).X + 8
		local holder = Kit.new(
			"Frame",
			{ BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 140), LayoutOrder = index, ZIndex = 102, Parent = titleRow }
		)
		local letter = Kit.text({
			Text = glyph,
			TextSize = 110,
			Size = UDim2.fromScale(1, 1),
			Stroke = 6,
			StrokeColor = C.Outline,
			ZIndex = 102,
			Parent = holder,
		})
		Kit.gradient(letter, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 230, 255))
		table.insert(letters, letter)
	end
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not frame.Parent then
			connection:Disconnect()
			return
		end
		local t = os.clock() - start
		for i, letter in letters do
			letter.Position = UDim2.fromOffset(0, math.sin(t * 3 - i * 0.45) * 10)
			letter.Rotation = math.sin(t * 2 - i * 0.5) * 4
		end
	end)
	Kit.text({
		Text = Strings.get("subtitle"),
		TextSize = 30,
		Size = UDim2.fromOffset(800, 40),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 101,
		Parent = frame,
	})
	loadingStatus = Kit.text({
		Text = Strings.get("loading"),
		TextSize = 26,
		Color = Color.hex("#bdefff"),
		Size = UDim2.fromOffset(800, 36),
		Position = UDim2.fromScale(0.5, 0.78),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 101,
		Parent = frame,
	})
	local dots = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(120, 24),
		Position = UDim2.fromScale(0.5, 0.84),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 101,
		Parent = frame,
	})
	Kit.list(dots, Enum.FillDirection.Horizontal, 12)
	for i = 1, 3 do
		local dot = Kit.new(
			"Frame",
			{ BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(18, 18), LayoutOrder = i, ZIndex = 102, Parent = dots }
		)
		Kit.round(dot)
		task.spawn(function()
			while true do
				task.wait(i * 0.15)
				if not dot.Parent then
					break
				end
				Anim.pop(dot, 0.5)
				task.wait(1 - i * 0.15)
			end
		end)
	end
	loading = frame
end

function Screens.setLoadingStatus(text: string)
	if loadingStatus then
		loadingStatus.Text = text
	end
end

function Screens.hideLoading()
	local frame = loading
	if not frame then
		return
	end
	loading = nil
	if stopLoadingBubbles then
		stopLoadingBubbles()
	end
	local tween = Anim.tween(frame, 0.9, { Position = UDim2.fromScale(0, -1.1) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tween.Completed:Once(function()
		frame:Destroy()
	end)
end

-- Blackout ----------------------------------------------------------------------------------------

local blackoutFrame = Kit.new("Frame", {
	Name = "Blackout",
	BackgroundColor3 = Color.hex("#030a18"),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 90,
	Parent = Gui.top,
}) :: Frame
local blackoutTitle = Kit.text({
	Text = "",
	TextSize = 64,
	Size = UDim2.fromOffset(900, 80),
	Position = UDim2.fromScale(0.5, 0.44),
	AnchorPoint = Vector2.new(0.5, 0.5),
	Color = Color.hex("#ff8a95"),
	Stroke = 4,
	ZIndex = 91,
	Parent = blackoutFrame,
})
local blackoutSub = Kit.text({
	Text = "",
	TextSize = 28,
	Size = UDim2.fromOffset(900, 40),
	Position = UDim2.fromScale(0.5, 0.54),
	AnchorPoint = Vector2.new(0.5, 0.5),
	ZIndex = 91,
	Parent = blackoutFrame,
})

function Screens.blackout()
	blackoutFrame.Visible = true
	blackoutFrame.BackgroundTransparency = 1
	blackoutTitle.Text = Strings.get("blackout")
	blackoutSub.Text = ""
	blackoutTitle.TextTransparency = 1
	Anim.tween(blackoutFrame, 1.0, { BackgroundTransparency = 0 })
	task.delay(0.4, function()
		Anim.tween(blackoutTitle, 0.4, { TextTransparency = 0 })
		Anim.pop(blackoutTitle, 0.3)
	end)
end

function Screens.rescued(text: string)
	if not blackoutFrame.Visible then
		return
	end
	blackoutSub.Text = text
	Anim.pop(blackoutSub, 0.2)
	task.delay(1.4, function()
		Anim.tween(blackoutTitle, 0.4, { TextTransparency = 1 })
		Anim.tween(blackoutFrame, 0.8, { BackgroundTransparency = 1 }).Completed:Once(function()
			blackoutFrame.Visible = false
			blackoutSub.Text = ""
		end)
	end)
end

-- Travel wipe ------------------------------------------------------------------------------------

local wipe = Kit.new("Frame", {
	Name = "TravelWipe",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 95,
	Parent = Gui.top,
}) :: Frame
local circle = Kit.new("Frame", {
	BackgroundColor3 = Color3.new(1, 1, 1),
	Size = UDim2.fromOffset(0, 0),
	Position = UDim2.fromScale(0.5, 0.5),
	AnchorPoint = Vector2.new(0.5, 0.5),
	ZIndex = 95,
	Parent = wipe,
}) :: Frame
Kit.round(circle)
local circleGradient = Kit.gradient(circle, C.Cyan, C.DeepBlue)
local wipeTitle = Kit.text({
	Text = "",
	TextSize = 72,
	Size = UDim2.fromOffset(1000, 90),
	Position = UDim2.fromScale(0.5, 0.45),
	AnchorPoint = Vector2.new(0.5, 0.5),
	Stroke = 5,
	ZIndex = 96,
	Parent = wipe,
})
local wipeSub = Kit.text({
	Text = "",
	TextSize = 32,
	Size = UDim2.fromOffset(1000, 44),
	Position = UDim2.fromScale(0.5, 0.56),
	AnchorPoint = Vector2.new(0.5, 0.5),
	ZIndex = 96,
	Parent = wipe,
})
local stopWipeBubbles: (() -> ())? = nil

function Screens.travelStart(world: number)
	local data = Worlds.get(world)
	circleGradient.Color = ColorSequence.new(Color.hex(data.accent[1]), Color.hex(data.accent[2]))
	wipe.Visible = true
	wipeTitle.Text = ""
	wipeSub.Text = ""
	circle.Size = UDim2.fromOffset(0, 0)
	local size = math.max(Gui.top.AbsoluteSize.X, Gui.top.AbsoluteSize.Y) / Gui.scale * 1.6
	Anim.tween(circle, 0.55, { Size = UDim2.fromOffset(size, size) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.4, function()
		wipeTitle.Text = Strings.get("world", { n = world })
		wipeSub.Text = Strings.name(data.name)
		Anim.appear(wipeTitle, 0.45)
	end)
	stopWipeBubbles = bubbles(wipe, 14)
end

function Screens.travelEnd()
	if not wipe.Visible then
		return
	end
	task.delay(0.5, function()
		if stopWipeBubbles then
			stopWipeBubbles()
			stopWipeBubbles = nil
		end
		wipeTitle.Text = ""
		wipeSub.Text = ""
		Anim.tween(circle, 0.6, { Size = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out).Completed:Once(function()
			wipe.Visible = false
		end)
	end)
end

return Screens
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Visual language: rounded FredokaOne everywhere, bold outlines, bright ocean colours.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)

local Theme = {}

Theme.Font = Font.fromEnum(Enum.Font.FredokaOne)

local hex = Color.hex

Theme.C = {
	White = Color3.new(1, 1, 1),
	Ink = hex("#15263a"),
	Outline = hex("#10233a"),
	Navy = hex("#16324f"),
	NavySoft = hex("#1f4368"),
	Panel = hex("#f3fbff"),
	PanelAlt = hex("#dcf1ff"),
	PanelLine = hex("#b9dcf4"),
	Muted = hex("#6f87a0"),
	Cyan = hex("#34e0ff"),
	Blue = hex("#2f9bff"),
	DeepBlue = hex("#1f67d6"),
	Gold = hex("#ffd23f"),
	GoldDark = hex("#d99a12"),
	Orange = hex("#ffa53f"),
	Green = hex("#4fe07a"),
	GreenDark = hex("#23a84c"),
	Red = hex("#ff5a6a"),
	RedDark = hex("#d12f45"),
	Pink = hex("#ff7ad7"),
	Purple = hex("#b06bff"),
	Gray = hex("#a3b3c4"),
	GrayDark = hex("#6b7c8f"),
	Oxygen = hex("#3fd8ff"),
	OxygenDeep = hex("#2a86ff"),
	Danger = hex("#ff4b5c"),
}

-- Button palettes: top gradient, bottom gradient, outline.
Theme.Buttons = {
	Blue = { hex("#5cc3ff"), hex("#2a7fe8"), hex("#12417a") },
	Green = { hex("#7dee8f"), hex("#2fbf55"), hex("#146b2c") },
	Gold = { hex("#ffe27a"), hex("#ffb52e"), hex("#8a5a07") },
	Red = { hex("#ff8a8f"), hex("#e83a4f"), hex("#7a1523") },
	Pink = { hex("#ffa6e6"), hex("#f25ac6"), hex("#7a1a63") },
	Purple = { hex("#cf9bff"), hex("#9656f0"), hex("#4b2280") },
	Orange = { hex("#ffc37a"), hex("#ff8c2e"), hex("#8a4207") },
	Cyan = { hex("#8ff0ff"), hex("#2ec8f0"), hex("#0f5f7a") },
	Gray = { hex("#d6dee8"), hex("#9aaabb"), hex("#4a5a6b") },
	Navy = { hex("#3a6690"), hex("#1f4368"), hex("#0c1f33") },
}

Theme.Rarity = {} :: { [string]: Color3 }
for name, value in Config.RarityColors :: { [string]: string } do
	Theme.Rarity[name] = hex(value)
end

function Theme.rarityColor(index: number): Color3
	return Theme.Rarity[Config.Rarities[index] or "Common"] or Theme.C.Gray
end

Theme.Radius = { Small = 10, Medium = 16, Large = 22 }
Theme.TextStroke = 2.4

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">TierStyle</string>
              <string name="Source"><![CDATA[--!strict
-- Name colours for ranking tiers (Config.Tiers) and the Director's red chroma.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)

local Kit = require(script.Parent.Kit)

local TierStyle = {}

TierStyle.DirectorColors = { Color3.fromRGB(255, 40, 60), Color3.fromRGB(255, 140, 140), Color3.fromRGB(160, 0, 20) }
local PRISMATIC = { Color.hex("#7ff0ff"), Color.hex("#c99bff"), Color.hex("#ffe36b"), Color.hex("#ffffff") }

function TierStyle.color(tier: number): Color3?
	local def = Config.Tiers[tier]
	return if def then Color.hex(def.color) else nil
end

-- Applies the tier look to a label (or clears it for tier 0). `fallback` is the normal colour.
function TierStyle.apply(label: TextLabel, tier: number, fallback: Color3)
	local old = label:FindFirstChild("Chroma")
	local def = Config.Tiers[tier]
	if def and def.prismatic then
		label.TextColor3 = Color3.new(1, 1, 1)
		if not old then
			Kit.chroma(label, PRISMATIC, 3)
		end
		return
	end
	if old then
		old:Destroy()
	end
	label.TextColor3 = if def then Color.hex(def.color) else fallback
end

-- Red chroma for the Director's name and tags.
function TierStyle.director(target: Instance)
	if not target:FindFirstChild("Chroma") then
		if target:IsA("TextLabel") then
			target.TextColor3 = Color3.new(1, 1, 1)
		end
		Kit.chroma(target, TierStyle.DirectorColors, 1.6)
	end
end

return TierStyle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[--!strict
-- Stacked notification toasts under the world chip.

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Toasts = {}

local KIND: { [string]: { any } } = {
	info = { Theme.Buttons.Navy, "" },
	good = { Theme.Buttons.Green, "" },
	gold = { Theme.Buttons.Gold, "" },
	bad = { Theme.Buttons.Red, "" },
	rare = { Theme.Buttons.Purple, "" },
	blue = { Theme.Buttons.Blue, "" },
}

local stack = Kit.new("Frame", {
	Name = "Toasts",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(520, 240),
	Position = UDim2.new(0.5, 0, 0, 70),
	AnchorPoint = Vector2.new(0.5, 0),
	Parent = Gui.hud,
})
Kit.list(stack, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

local order = 0
local active: { Frame } = {}

function Toasts.show(text: string, kind: string?, icon: string?)
	local palette = (KIND[kind or "info"] or KIND.info)[1]
	order += 1
	local toast = Kit.new("Frame", {
		Name = "Toast",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(0, 36),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = order,
		Parent = stack,
	}) :: Frame
	Kit.round(toast)
	Kit.gradient(toast, palette[1], palette[2])
	Kit.stroke(toast, palette[3], 2.5)
	Kit.padding(toast, 0, 16, 0, 14)
	local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Parent = toast })
	Kit.list(row, Enum.FillDirection.Horizontal, 6)
	if icon then
		Kit.text({ Text = icon, TextSize = 20, Size = UDim2.fromOffset(24, 24), Stroke = 0, LayoutOrder = 1, Parent = row })
	end
	Kit.text({
		Text = text,
		TextSize = 18,
		Size = UDim2.new(0, 0, 1, 0),
		AutoX = true,
		Stroke = 2,
		StrokeColor = palette[3],
		LayoutOrder = 2,
		Parent = row,
	})
	Anim.appear(toast, 0.35)
	table.insert(active, toast)
	while #active > 3 do
		local oldest = table.remove(active, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	task.delay(2.8, function()
		if toast.Parent then
			local scale = Anim.scaleOf(toast)
			Anim.tween(scale, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Wait()
			local index = table.find(active, toast)
			if index then
				table.remove(active, index)
			end
			toast:Destroy()
		end
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">Trade</string>
              <string name="Source"><![CDATA[--!strict
-- Pet trading UI: an incoming-request popup and the trade window (both offers side by side,
-- your pets underneath to add or remove, Ready / Cancel and the final countdown).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Strings = require(Shared.Strings)
local Worlds = require(Shared.Data.Worlds)
local Mutations = require(Shared.Models.Mutations)

local Anim = require(script.Parent.Anim)
local Kit = require(script.Parent.Kit)
local Panel = require(script.Parent.Panel)
local Theme = require(script.Parent.Theme)
local Viewport = require(script.Parent.Viewport)

local Trade = {}

local C = Theme.C

type PetInfo = { id: string, s: string, m: { string }? }

local function petCell(parent: Instance, info: PetInfo, order: number, onClick: (() -> ())?): TextButton
	local data = Worlds.pets[info.s]
	local rarity = Config.Rarities[if data then data.rarity else 1]
	local color = Theme.Rarity[rarity]
	local cell = Kit.new("TextButton", {
		Name = info.id,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		Parent = parent,
	}) :: TextButton
	Kit.corner(cell, 14)
	Kit.gradient(cell, color:Lerp(Color3.new(1, 1, 1), 0.55), color, 90)
	Kit.stroke(cell, color:Lerp(Color3.new(0, 0, 0), 0.5), 3)
	local view = Viewport.new(cell, UDim2.new(1, -8, 1, -30), UDim2.new(0.5, 0, 0, 3), Vector2.new(0.5, 0))
	view.setModel(Viewport.pet(info.s, info.m))
	local top = Mutations.top(info.m)
	if top then
		local dot = Kit.new("Frame", {
			BackgroundColor3 = Mutations.color(top),
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.fromOffset(5, 5),
			ZIndex = 4,
			Parent = cell,
		})
		Kit.round(dot)
		Kit.stroke(dot, C.Outline, 2)
	end
	Kit.text({
		Text = Format.multiplier(1 + Economy.petPower(info.s, info.m)),
		TextSize = 15,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.new(0, 0, 1, -25),
		StrokeColor = color:Lerp(Color3.new(0, 0, 0), 0.6),
		Parent = cell,
	})
	if onClick then
		cell.Activated:Connect(onClick)
	end
	return cell
end

local function clearCells(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

function Trade.init(app: any)
	local current: any = nil -- latest trade view from the server
	local offered: { string } = {}

	-- Incoming request popup -----------------------------------------------------------------------
	local popup = Kit.new("Frame", {
		Name = "TradeRequest",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(420, 124),
		Position = UDim2.new(0.5, 0, 0, 132),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		ZIndex = 30,
		Parent = app.Gui.hud,
	}) :: Frame
	Kit.corner(popup, 20)
	Kit.gradient(popup, Theme.Buttons.Cyan[1], Theme.Buttons.Blue[2])
	Kit.stroke(popup, C.Outline, 3)
	local popupText = Kit.text({
		Text = "",
		TextSize = 22,
		Size = UDim2.new(1, -20, 0, 34),
		Position = UDim2.fromOffset(10, 8),
		ZIndex = 31,
		Parent = popup,
	})
	local popupTimer = Kit.progress({
		Size = UDim2.new(1, -40, 0, 10),
		Position = UDim2.fromOffset(20, 46),
		Colors = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 240, 255) },
		TextSize = 1,
		Parent = popup,
	})
	local popupButtons = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 0, 50),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 31,
		Parent = popup,
	})
	Kit.list(popupButtons, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center)
	local pending: { userId: number, expires: number, seconds: number }? = nil
	local function respond(accept: boolean)
		local request = pending
		pending = nil
		popup.Visible = false
		if not request then
			return
		end
		local result = app.Net.invoke("TradeRespond", { userId = request.userId, accept = accept })
		if not result.ok and result.err then
			app.Toasts.show(Strings.get(result.err), "bad")
		end
	end
	local acceptButton = Kit.button({
		Text = "",
		TextSize = 20,
		Palette = "Green",
		Size = UDim2.fromOffset(170, 46),
		LayoutOrder = 1,
		ZIndex = 32,
		Parent = popupButtons,
		OnClick = function()
			respond(true)
		end,
	})
	local declineButton = Kit.button({
		Text = "",
		TextSize = 20,
		Palette = "Red",
		Size = UDim2.fromOffset(170, 46),
		LayoutOrder = 2,
		ZIndex = 32,
		Parent = popupButtons,
		OnClick = function()
			respond(false)
		end,
	})
	RunService.Heartbeat:Connect(function()
		local request = pending
		if request then
			local left = request.expires - os.clock()
			if left <= 0 then
				pending = nil
				popup.Visible = false
			else
				popupTimer.set(left / request.seconds, "")
			end
		end
	end)

	-- Trade window ---------------------------------------------------------------------------------
	local panel = Panel.new({
		Parent = app.Gui.panels,
		Title = Strings.get("tradeTitle"),
		Icon = utf8.char(0x1F91D),
		Palette = "Cyan",
		Size = Vector2.new(940, 610),
	})
	local body = panel.body

	local function offerBox(x: number, anchor: number): (TextLabel, Frame, Frame)
		local box = Kit.new("Frame", {
			BackgroundColor3 = C.PanelAlt,
			Size = UDim2.new(0.5, -8, 0, 262),
			Position = UDim2.new(x, 0, 0, 20),
			AnchorPoint = Vector2.new(anchor, 0),
			Parent = body,
		}) :: Frame
		Kit.corner(box, 16)
		local stroke = Kit.stroke(box, C.PanelLine, 3)
		stroke.Name = "Border"
		local title = Kit.text({
			Text = "",
			TextSize = 20,
			Size = UDim2.new(1, -120, 0, 34),
			Position = UDim2.fromOffset(12, 4),
			XAlign = Enum.TextXAlignment.Left,
			StrokeColor = C.Navy,
			Parent = box,
		})
		local readyChip = Kit.new("Frame", {
			BackgroundColor3 = C.Gray,
			Size = UDim2.fromOffset(104, 28),
			Position = UDim2.new(1, -10, 0, 7),
			AnchorPoint = Vector2.new(1, 0),
			Parent = box,
		}) :: Frame
		Kit.round(readyChip)
		Kit.stroke(readyChip, C.Outline, 2)
		Kit.text({ Name = "Label", Text = "", TextSize = 15, Size = UDim2.fromScale(1, 1), Parent = readyChip })
		local grid = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -20, 1, -48),
			Position = UDim2.fromOffset(10, 42),
			Parent = box,
		}) :: Frame
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(98, 100),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Parent = grid,
		})
		return title, readyChip, grid
	end
	local myTitle, myReady, myGrid = offerBox(0, 0)
	local theirTitle, theirReady, theirGrid = offerBox(1, 1)

	local status = Kit.text({
		Text = "",
		TextSize = 22,
		Color = C.Ink,
		Stroke = 0,
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 288),
		Parent = body,
	})
	local inventoryLabel = Kit.text({
		Text = "",
		TextSize = 17,
		Color = C.Muted,
		Stroke = 0,
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(4, 320),
		XAlign = Enum.TextXAlignment.Left,
		Parent = body,
	})
	local inventory = Kit.new("ScrollingFrame", {
		BackgroundColor3 = C.PanelAlt,
		BackgroundTransparency = 0.2,
		Size = UDim2.new(1, 0, 0, 124),
		Position = UDim2.fromOffset(0, 344),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.NavySoft,
		BorderSizePixel = 0,
		Parent = body,
	}) :: ScrollingFrame
	Kit.corner(inventory, 14)
	Kit.padding(inventory, 8, 8, 12, 8)
	Kit.list(inventory, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)

	local buttons = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 56),
		Position = UDim2.new(0, 0, 1, -4),
		AnchorPoint = Vector2.new(0, 1),
		Parent = body,
	})
	Kit.list(buttons, Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center)
	local readyButton = Kit.button({
		Text = "",
		TextSize = 22,
		Palette = "Green",
		Size = UDim2.fromOffset(240, 54),
		LayoutOrder = 1,
		Parent = buttons,
		OnClick = function()
			if current then
				local result = app.Net.invoke("TradeReady", { ready = not current.myReady })
				app.Sfx.play(if result.ok then "Click" else "Error")
			end
		end,
	})
	local cancelButton = Kit.button({
		Text = "",
		TextSize = 22,
		Palette = "Red",
		Size = UDim2.fromOffset(200, 54),
		LayoutOrder = 2,
		Parent = buttons,
		OnClick = function()
			panel.close()
		end,
	})

	local function setReady(chip: Frame, ready: boolean)
		chip.BackgroundColor3 = if ready then C.Green else C.Gray
		local label = chip:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = if ready then utf8.char(0x2714) .. " " .. Strings.get("tradeReady") else Strings.get("tradeWaiting")
		end
	end

	local function sendOffer(ids: { string })
		local result = app.Net.invoke("TradeOffer", { ids = ids })
		if not result.ok then
			app.Sfx.play("Error")
			if result.err then
				app.Toasts.show(Strings.get(result.err), "bad")
			end
		else
			app.Sfx.play("Click")
		end
	end

	local function render()
		local view = current
		if not view then
			return
		end
		panel.setTitle(Strings.get("tradeWith", { name = view.partner.name }))
		myTitle.Text = Strings.get("tradeYours")
		theirTitle.Text = Strings.get("tradeTheirs", { name = view.partner.name })
		setReady(myReady, view.myReady)
		setReady(theirReady, view.theirReady)
		readyButton.setText(if view.myReady then Strings.get("tradeUnready") else Strings.get("tradeReadyButton"))
		readyButton.setPalette(if view.myReady then "Gray" else "Green")
		cancelButton.setText(Strings.get("cancel"))
		inventoryLabel.Text = Strings.get("tradePick", { n = Config.TradeMaxPets })

		offered = {}
		clearCells(myGrid)
		for order, info in view.mine do
			table.insert(offered, info.id)
			petCell(myGrid, info, order, function()
				local ids = table.clone(offered)
				local index = table.find(ids, info.id)
				if index then
					table.remove(ids, index)
				end
				sendOffer(ids)
			end)
		end
		clearCells(theirGrid)
		for order, info in view.theirs do
			petCell(theirGrid, info, order)
		end

		clearCells(inventory)
		local profile = app.State.profile
		if profile then
			local ids = {}
			for id, pet in profile.pets do
				if not table.find(offered, id) and not pet.l then
					table.insert(ids, id)
				end
			end
			table.sort(ids, function(a, b)
				local pa, pb = profile.pets[a], profile.pets[b]
				return Economy.petPower(pa.s, pa.m) > Economy.petPower(pb.s, pb.m)
			end)
			for order, id in ids do
				local pet = profile.pets[id]
				local cell = petCell(inventory, { id = id, s = pet.s, m = pet.m }, order, function()
					local next = table.clone(offered)
					table.insert(next, id)
					sendOffer(next)
				end)
				cell.Size = UDim2.fromOffset(92, 100)
			end
		end
	end

	RunService.Heartbeat:Connect(function()
		local view = current
		if not view or not panel.isOpen then
			return
		end
		if view.countdownEnds then
			local left = math.max(0, view.countdownEnds - os.clock())
			status.Text = Strings.get("tradeCountdown", { n = math.ceil(left) })
			status.TextColor3 = C.GreenDark
		elseif view.myReady and not view.theirReady then
			status.Text = Strings.get("tradeWaitingFor", { name = view.partner.name })
			status.TextColor3 = C.Muted
		else
			status.Text = Strings.get("tradeHint")
			status.TextColor3 = C.Muted
		end
	end)

	panel.onClose = function()
		if current then
			current = nil
			app.Net.invoke("TradeCancel")
		end
	end

	app.Net.on("tradeRequest", function(payload: any)
		if current then
			return
		end
		pending = { userId = payload.userId, expires = os.clock() + (payload.seconds or 20), seconds = payload.seconds or 20 }
		popupText.Text = Strings.get("tradeAsk", { name = payload.name })
		acceptButton.setText(Strings.get("accept"))
		declineButton.setText(Strings.get("decline"))
		popup.Visible = true
		Anim.pop(popup, 0.12)
		app.Sfx.play("Open")
	end)

	app.Net.on("trade", function(payload: any)
		local first = current == nil
		current = payload
		if payload.countdown then
			payload.countdownEnds = os.clock() + payload.countdown
		end
		pending = nil
		popup.Visible = false
		if first then
			app.closePanels()
			panel.open()
			app.Sfx.play("Open")
		end
		render()
	end)

	app.Net.on("tradeClosed", function(payload: any)
		current = nil
		if panel.isOpen then
			panel.close()
		end
		if payload.reason == "done" then
			app.Sfx.play("Legendary")
			app.Effects.confetti(50)
			app.Toasts.show(Strings.get("tradeDone", { n = payload.got or 0 }), "gold", utf8.char(0x1F91D))
		elseif payload.reason == "left" then
			app.Toasts.show(Strings.get("tradeLeft", { name = payload.partner or "" }), "bad")
		else
			app.Toasts.show(Strings.get("tradeCancelled"), "info")
		end
	end)

	app.State.profileChanged:Connect(function()
		if panel.isOpen then
			render()
		end
	end)
	app.State.languageChanged:Connect(render)

	-- Sends a trade request (from the player list).
	function app.requestTrade(userId: number)
		local result = app.Net.invoke("TradeRequest", { userId = userId })
		if result.ok then
			if not (result.data and result.data.started) then
				app.Toasts.show(Strings.get("tradeSent"), "info", utf8.char(0x1F91D))
			end
		else
			app.Sfx.play("Error")
			if result.err then
				app.Toasts.show(Strings.get(result.err), "bad")
			end
		end
	end

	return { panel = panel }
end

return Trade
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- First-time guidance: a banner with the next goal plus a bouncing 3D arrow over the target.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)
local Format = require(Shared.Format)
local Layout = require(Shared.Layout)
local Strings = require(Shared.Strings)

local Anim = require(script.Parent.Anim)
local Gui = require(script.Parent.Gui)
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Tutorial = {}

local C = Theme.C

function Tutorial.init(app: any)
	local banner = Kit.new("Frame", {
		Name = "Tutorial",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromOffset(0, 44),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.new(0.5, 0, 1, -112),
		AnchorPoint = Vector2.new(0.5, 1),
		Visible = false,
		Parent = Gui.hud,
	}) :: Frame
	Kit.round(banner)
	Kit.gradient(banner, Theme.Buttons.Gold[1], Theme.Buttons.Gold[2])
	Kit.stroke(banner, Theme.Buttons.Gold[3], 3)
	Kit.padding(banner, 0, 18, 0, 14)
	local row = Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Parent = banner })
	Kit.list(row, Enum.FillDirection.Horizontal, 8)
	local arrow = Kit.text({ Text = utf8.char(0x1F449), TextSize = 24, Size = UDim2.fromOffset(30, 30), Stroke = 0, LayoutOrder = 1, Parent = row })
	local label = Kit.text({
		Text = "",
		TextSize = 19,
		Stroke = 2,
		Size = UDim2.new(0, 0, 1, 0),
		AutoX = true,
		StrokeColor = Theme.Buttons.Gold[3],
		LayoutOrder = 2,
		Parent = row,
	})
	local okButton = Kit.button({
		Text = "OK",
		TextSize = 17,
		Palette = "Green",
		Size = UDim2.fromOffset(58, 32),
		Stroke = 2,
		LayoutOrder = 3,
		Parent = row,
		OnClick = function()
			app.Net.invoke("Tutorial", { step = 7 })
		end,
	})
	okButton.button.Visible = false

	-- World-space arrow.
	local anchor = Instance.new("Part")
	anchor.Name = "TutorialArrow"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Parent = Workspace
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(90, 90)
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.Adornee = anchor
	billboard.Enabled = false
	billboard.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local arrow3d =
		Kit.text({ Text = utf8.char(0x2B07) .. utf8.char(0xFE0F), TextSize = 70, Size = UDim2.fromScale(1, 1), Stroke = 0, Parent = billboard })

	local lastText = ""
	local target: Vector3? = nil
	RunService.RenderStepped:Connect(function()
		local profile = app.State.profile
		local text = ""
		target = nil
		local showOk = false
		if profile and not app.State.traveling then
			local step = profile.tutorial
			local world = app.State.world
			local info = Layout.info(world)
			local dock = Layout.dock(world)
			if step == 1 then
				text = Strings.get("tutorial.1")
				target = Layout.at(world, 0, 3, info.radius - 4)
			elseif step == 2 or step == 3 then
				if app.State.dive.cargo > 0 and not app.State.dive.active then
					-- Treasure in the backpack: point at the gold sell pad.
					text = Strings.get("tutorial.3")
					target = Layout.at(world, dock.sell.X, dock.sell.Y + 4, dock.sell.Z)
				elseif app.State.dive.cargo > 0 then
					text = Strings.get("tutorial.3")
				else
					text = Strings.get("tutorial.2")
					if app.Relics then
						target = app.Relics.nearest()
					end
				end
			elseif step == 4 then
				text = Strings.get("tutorial.4")
				target = Layout.at(world, dock.kiosk.X, dock.kiosk.Y + 13, dock.kiosk.Z)
			elseif step == 5 then
				local cost = Economy.eggCost(world)
				text = Strings.get("tutorial.5")
				if profile.coins < cost then
					text ..= "  (" .. Format.short(cost) .. ")"
				end
				target = Layout.at(world, dock.egg.X, dock.egg.Y + 11, dock.egg.Z)
			elseif step == 6 then
				text = Strings.get("tutorial.6")
				showOk = true
			end
		end
		if text ~= lastText then
			lastText = text
			label.Text = text
			banner.Visible = text ~= ""
			if text ~= "" then
				Anim.appear(banner, 0.35)
			end
		end
		okButton.button.Visible = showOk
		local t = os.clock()
		arrow.Rotation = math.sin(t * 6) * 10
		if target then
			billboard.Enabled = true
			anchor.Position = target + Vector3.new(0, 2 + math.abs(math.sin(t * 4)) * 1.5, 0)
		else
			billboard.Enabled = false
		end
		-- Sits above the dive bar while in the water, near the bottom edge on land.
		banner.Position = UDim2.new(0.5, 0, 1, if app.State.dive.inWater or app.State.dive.active then -112 else -70)
	end)
	local _ = arrow3d
	local _c = C
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">Viewport</string>
              <string name="Source"><![CDATA[--!strict
-- 3D model previews for UI (pets, eggs, relics) with a shared spin loop and a model cache.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GearModels = require(Shared.Models.GearModels)
local Mutations = require(Shared.Models.Mutations)
local PetModels = require(Shared.Models.PetModels)
local RelicModels = require(Shared.Models.RelicModels)

local Viewport = {}

export type ViewApi = { frame: ViewportFrame, setModel: (Model?) -> (), setSpin: (boolean) -> (), destroy: () -> () }

type Entry = { model: Model?, frame: ViewportFrame, spin: boolean, base: CFrame, angle: number, bob: number }

local entries: { [ViewportFrame]: Entry } = {}
local cache: { [string]: Model } = {}

local function cached(key: string, build: () -> Model): Model
	local model = cache[key]
	if not model then
		model = build()
		cache[key] = model
	end
	return model:Clone()
end

function Viewport.pet(key: string, mutations: { string }?): Model
	local top = Mutations.top(mutations)
	return cached("pet:" .. key .. ":" .. (top or ""), function()
		local model = PetModels.build(key, 3)
		Mutations.apply(model, mutations)
		return model
	end)
end

function Viewport.gear(key: string): Model
	return cached("gear:" .. key, function()
		return GearModels.build(key, 3)
	end)
end

function Viewport.relic(key: string): Model
	return cached("relic:" .. key, function()
		return RelicModels.build(key, 2)
	end)
end

function Viewport.egg(world: number): Model
	return cached("egg:" .. world, function()
		return RelicModels.buildEgg(world, 3)
	end)
end

function Viewport.chest(world: number): Model
	return cached("chest:" .. world, function()
		return RelicModels.buildChest(world, 3)
	end)
end

local function frameModel(entry: Entry)
	local model = entry.model
	if not model then
		return
	end
	local camera = entry.frame.CurrentCamera
	if not camera then
		return
	end
	local _, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 1.08
	camera.CFrame = CFrame.lookAt(Vector3.new(0, radius * 0.25, -distance), Vector3.zero)
end

function Viewport.new(parent: Instance, size: UDim2, position: UDim2?, anchor: Vector2?): ViewApi
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Size = size
	frame.Position = position or UDim2.new()
	frame.AnchorPoint = anchor or Vector2.zero
	frame.Ambient = Color3.fromRGB(190, 200, 215)
	frame.LightColor = Color3.fromRGB(255, 250, 240)
	frame.LightDirection = Vector3.new(-0.4, -1, 0.6)
	frame.ZIndex = (parent :: any).ZIndex or 1
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = frame
	frame.CurrentCamera = camera
	frame.Parent = parent

	local entry: Entry = { model = nil, frame = frame, spin = false, base = CFrame.identity, angle = math.pi * 0.85, bob = math.random() * 6 }
	entries[frame] = entry

	local api: ViewApi = {
		frame = frame,
		setModel = function(_) end,
		setSpin = function(_) end,
		destroy = function() end,
	}
	api.setModel = function(model: Model?)
		if entry.model then
			entry.model:Destroy()
		end
		entry.model = model
		if model then
			model:PivotTo(CFrame.Angles(0, entry.angle, 0))
			model.Parent = frame
			frameModel(entry)
		end
	end
	api.setSpin = function(spin: boolean)
		entry.spin = spin
	end
	api.destroy = function()
		entries[frame] = nil
		frame:Destroy()
	end
	frame.Destroying:Connect(function()
		entries[frame] = nil
	end)
	return api
end

RunService.RenderStepped:Connect(function(dt: number)
	local t = os.clock()
	for _, entry in entries do
		if entry.spin and entry.model and entry.frame.Visible then
			entry.angle += dt * 1.1
			entry.model:PivotTo(CFrame.new(0, math.sin(t * 2 + entry.bob) * 0.08, 0) * CFrame.Angles(0, entry.angle, 0))
		end
	end
end)

return Viewport
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">WorldFx</string>
            <string name="Source"><![CDATA[--!strict
-- World-space effects: sparkle bursts, expanding shockwave rings and coin fountains. Everything
-- is anchored, non-colliding and cleaned up automatically.

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local WorldFx = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function folder(): Instance
	local existing = Workspace:FindFirstChild("DeepDiveClient")
	if existing then
		return existing
	end
	local created = Instance.new("Folder")
	created.Name = "DeepDiveClient"
	created.Parent = Workspace
	return created
end

local function anchor(position: Vector3): Part
	local part = Instance.new("Part")
	part.Name = "Fx"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.CFrame = CFrame.new(position)
	part.Parent = folder()
	return part
end

local function emitter(parent: Instance, color: Color3, size: number, speed: NumberRange, lifetime: NumberRange): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE
	e.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.35), color)
	e.LightEmission = 0.9
	e.LightInfluence = 0
	e.Size =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(0.4, size * 0.8), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = lifetime
	e.Speed = speed
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-180, 180)
	e.Drag = 3
	e.Rate = 0
	e.Parent = parent
	return e
end

local function cleanup(instance: Instance, after: number)
	task.delay(after, function()
		instance:Destroy()
	end)
end

-- Star-sparkle burst, e.g. when a relic is collected.
function WorldFx.burst(position: Vector3, color: Color3, amount: number?, size: number?)
	local part = anchor(position)
	local s = size or 0.9
	emitter(part, color, s, NumberRange.new(6, 14), NumberRange.new(0.5, 0.9)):Emit(amount or 22)
	local glow = emitter(part, Color3.new(1, 1, 1), s * 2.6, NumberRange.new(0, 0.5), NumberRange.new(0.25, 0.35))
	glow.Drag = 0
	glow:Emit(2)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 12
	light.Brightness = 3
	light.Parent = part
	TweenService:Create(light, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Brightness = 0 }):Play()
	cleanup(part, 1.2)
end

-- Flat neon ring that expands and fades.
function WorldFx.ring(position: Vector3, color: Color3, radius: number?, duration: number?)
	local ring = Instance.new("Part")
	ring.Name = "FxRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.25
	ring.Size = Vector3.new(0.2, 1, 1)
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = folder()
	local r = (radius or 8) * 2
	local t = duration or 0.6
	TweenService:Create(ring, TweenInfo.new(t, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = Vector3.new(0.1, r, r), Transparency = 1 })
		:Play()
	cleanup(ring, t + 0.1)
end

-- Gold coins that pop up out of a spot and rain back down (sell stand).
function WorldFx.coinFountain(position: Vector3, count: number?)
	local n = math.clamp(count or 12, 4, 24)
	for i = 1, n do
		task.delay(i * 0.03, function()
			local coin = Instance.new("Part")
			coin.Name = "FxCoin"
			coin.Shape = Enum.PartType.Cylinder
			coin.Anchored = true
			coin.CanCollide = false
			coin.CanQuery = false
			coin.CanTouch = false
			coin.CastShadow = false
			coin.Material = Enum.Material.Neon
			coin.Color = Color3.fromRGB(255, 210, 70)
			coin.Size = Vector3.new(0.25, 1.1, 1.1)
			local start = position + Vector3.new(math.random(-10, 10) / 10, 0.5, math.random(-10, 10) / 10)
			coin.CFrame = CFrame.new(start)
			coin.Parent = folder()
			local angle = math.random() * math.pi * 2
			local outward = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (2 + math.random() * 3)
			local peak = start + outward * 0.5 + Vector3.new(0, 5 + math.random() * 3, 0)
			local land = start + outward + Vector3.new(0, -0.3, 0)
			local up = TweenService:Create(coin, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				CFrame = CFrame.new(peak) * CFrame.Angles(math.random() * 6, math.random() * 6, 0),
			})
			up:Play()
			up.Completed:Wait()
			local down = TweenService:Create(coin, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				CFrame = CFrame.new(land) * CFrame.Angles(0, 0, math.rad(90)),
				Transparency = 0.6,
			})
			down:Play()
			down.Completed:Wait()
			TweenService:Create(coin, TweenInfo.new(0.3), { Transparency = 1 }):Play()
			cleanup(coin, 0.35)
		end)
	end
	WorldFx.burst(position + Vector3.new(0, 1.5, 0), Color3.fromRGB(255, 214, 90), 30, 1.1)
	WorldFx.ring(position + Vector3.new(0, 0.6, 0), Color3.fromRGB(255, 214, 90), 9)
end

return WorldFx
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="109">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-1200</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
