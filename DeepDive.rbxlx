			{ "Shadow Ray", "그림자 가오리", "ray", "#0f0a12", "#7a2fff", "neon" },
			{ "Abyss Angler", "심연 아귀", "angler", "#3a1f5a", "#ff5fd8", "neon" },
			{ "Eldritch Squid", "엘드리치 오징어", "squid", "#1f3a2a", "#5fff8a", "neon" },
			{ "Leviathan", "리바이어던", "serpent", "#1a1420", "#ffd23f", "gold" },
		},
		secret = { "Cosmic Whale", "우주 고래", "whale", "#2a1f5a", "#ff9aff", "cosmic" },
		hazards = { { kind = "orb", count = 8 }, { kind = "eel", count = 2 } },
		fish = { "#b86bff", "#ffd23f", "#ff5fd8" },
		fishGlow = true,
	},
}

local Worlds = {}
Worlds.list = {} :: { World }
Worlds.byKey = {} :: { [string]: World }
Worlds.relics = {} :: { [string]: Relic }
Worlds.pets = {} :: { [string]: Pet }
Worlds.petOrder = {} :: { string }

local function named(pair: { string }): Named
	return { en = pair[1], ko = pair[2] }
end

for index, raw in RAW do
	local world: World = {
		index = index,
		key = raw.key,
		name = named(raw.name),
		kit = raw.kit,
		meters = raw.meters,
		water = raw.water,
		terrain = raw.terrain,
		sky = {
			time = raw.sky.time,
			bright = raw.sky.bright,
			ambient = raw.sky.ambient,
			outdoor = raw.sky.outdoor,
			density = raw.sky.density,
			haze = raw.sky.haze,
			atmo = raw.sky.atmo,
			decay = raw.sky.decay,
			glare = raw.sky.glare,
			clouds = raw.sky.clouds,
			cloudColor = raw.sky.cloudColor or "#ffffff",
			stars = raw.sky.stars == true,
		},
		under = raw.under,
		accent = raw.accent,
		relics = {},
		egg = { name = { en = raw.egg[1], ko = raw.egg[2] }, color = raw.egg[3], accent = raw.egg[4], style = raw.egg[5] },
		pets = {},
		secret = nil,
		hazards = raw.hazards,
		fish = raw.fish,
		fishGlow = raw.fishGlow == true,
	}
	for rarity, entry in raw.relics do
		local relic: Relic = {
			key = string.format("r%d.%d", index, rarity),
			world = index,
			rarity = rarity,
			name = { en = entry[1], ko = entry[2] },
			shape = entry[3],
			color = entry[4],
			accent = entry[5],
			style = entry[6],
		}
		table.insert(world.relics, relic)
		Worlds.relics[relic.key] = relic
	end
	for rarity, entry in raw.pets do
		local pet: Pet = {
			key = string.format("p%d.%d", index, rarity),
			world = index,
			rarity = rarity,
			name = { en = entry[1], ko = entry[2] },
			shape = entry[3],
			color = entry[4],
			accent = entry[5],
			style = entry[6],
			secret = false,
		}
		table.insert(world.pets, pet)
		Worlds.pets[pet.key] = pet
		table.insert(Worlds.petOrder, pet.key)
	end
	if raw.secret then
		local entry = raw.secret
		local pet: Pet = {
			key = string.format("s%d", index),
			world = index,
			rarity = 6,
			name = { en = entry[1], ko = entry[2] },
			shape = entry[3],
			color = entry[4],
			accent = entry[5],
			style = entry[6],
			secret = true,
		}
		world.secret = pet
		Worlds.pets[pet.key] = pet
		table.insert(Worlds.petOrder, pet.key)
	end
	table.insert(Worlds.list, world)
	Worlds.byKey[world.key] = world
end

-- Limited pets: sold for Robux (Config.Products), never found in eggs.
Worlds.pets.godShark = {
	key = "godShark",
	world = #Worlds.list,
	rarity = 6,
	name = { en = "GOD Shark", ko = "갓 샤크" },
	shape = "godshark",
	color = "#8fd8ff",
	accent = "#ffffff",
	style = nil,
	secret = false,
	limited = true,
}

function Worlds.get(index: number): World
	return Worlds.list[math.clamp(math.floor(index), 1, #Worlds.list)]
end

return Worlds
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
-- Pure economy formulas shared by server (authoritative) and client (display / prediction).

local Config = if script then require(script.Parent.Config) else require("./Config")
local Worlds = if script then require(script.Parent.Data.Worlds) else require("./Data/Worlds")
local Gear = if script then require(script.Parent.Data.Gear) else require("./Data/Gear")

local Economy = {}

-- Rounds to two significant digits so prices read cleanly (12,345 -> 12,000).
function Economy.nice(n: number): number
	if n < 100 then
		return math.max(1, math.floor(n + 0.5))
	end
	local magnitude = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / magnitude + 0.5) * magnitude
end

function Economy.depthStuds(world: number): number
	return math.floor(Config.DepthBase + Config.DepthStep * (world - 1) + 0.5)
end

function Economy.lagoonRadius(world: number): number
	return math.floor(Config.RadiusBase + Config.RadiusStep * (world - 1) + 0.5)
end

function Economy.goal(world: number): number
	return math.floor(Config.GoalBase * Config.GoalGrowth ^ (world - 1) + 0.5)
end

function Economy.worldValue(world: number): number
	return Config.RelicBaseValue * Config.RelicWorldGrowth ^ (world - 1)
end

function Economy.relicValue(world: number, rarity: number): number
	return math.floor(Economy.worldValue(world) * Config.RelicRarityValue[rarity] + 0.5)
end

function Economy.relicValueByKey(key: string): number
	local relic = Worlds.relics[key]
	if not relic then
		return 0
	end
	return Economy.relicValue(relic.world, relic.rarity)
end

function Economy.clearReward(world: number): number
	return Economy.nice(Economy.relicValue(world, 1) * Config.ClearRewardRelics)
end

-- Fee to unlock `world` after clearing the world before it (World 1 is free). It tracks what
-- a diver earns there: UnlockClears[world] x (one treasure goal of the previous world, sold as commons,
-- with three Epic pets of that world equipped; the pet part ramps in over the first
-- Config.UnlockPetRamp worlds, before most divers have strong pets).
function Economy.unlockCost(world: number): number
	if world <= 1 then
		return 0
	end
	local previous = world - 1
	local typicalBoost = 3 * Config.PetBaseBoost * Config.PetWorldGrowth ^ (previous - 1) * Config.PetRarityFactor[4]
	typicalBoost *= math.min(1, previous / Config.UnlockPetRamp)
	local clears = Config.UnlockClears[world] or Config.UnlockClears[#Config.UnlockClears]
	return Economy.nice(clears * Economy.goal(previous) * Economy.relicValue(previous, 1) * (1 + typicalBoost))
end

function Economy.eggCost(world: number): number
	return Economy.nice(Config.EggBaseCost * Config.EggWorldGrowth ^ (world - 1))
end

function Economy.petBoost(key: string): number
	local pet = Worlds.pets[key]
	if not pet then
		return 0
	end
	if pet.limited then
		local top = Worlds.list[#Worlds.list].secret
		return Config.LimitedPetFactor * (if top then Economy.petBoost(top.key) else 1)
	end
	return Config.PetBaseBoost * Config.PetWorldGrowth ^ (pet.world - 1) * Config.PetRarityFactor[pet.rarity]
end

function Economy.pressure(world: number): number
	return Config.PressureBase + Config.PressureStep * (world - 1) + Config.PressureCurve * (world - 1) ^ 2
end

-- Oxygen seconds consumed per real second at a given depth (studs below the surface).
function Economy.oxygenDrain(world: number, depth: number): number
	return 1 + math.max(0, depth) * Economy.pressure(world)
end

function Economy.displayMeters(world: number, depth: number): number
	local data = Worlds.get(world)
	return math.max(0, math.floor(depth / Economy.depthStuds(world) * data.meters + 0.5))
end

-- Gear stats ----------------------------------------------------------------------------------
-- Each slot has a continuous stat curve over a "level" (1 = starter gear). Gear tiers map onto
-- that curve: tier 40 (World 20 Pro) reaches the slot's max level, early tiers climb faster.

local TRACKS = {}
for _, track in Config.Upgrades do
	TRACKS[track.id] = track
end
Economy.Tracks = TRACKS

local VALUE = {
	tank = function(level: number): number
		local l = level - 1
		return math.floor(20 + 6 * l + 0.22 * l * l)
	end,
	pack = function(level: number): number
		local l = level - 1
		return math.floor(4 + l + 0.07 * l * l)
	end,
	fins = function(level: number): number
		return math.floor((15 + 0.8 * (level - 1)) * 10 + 0.5) / 10
	end,
	magnet = function(level: number): number
		return math.floor((5 + 0.8 * (level - 1)) * 10 + 0.5) / 10
	end,
}

-- Stat value at a (possibly fractional) level of a slot's curve.
function Economy.upgradeValue(track: string, level: number): number
	local fn = VALUE[track]
	local def = TRACKS[track]
	if not fn or not def then
		return 0
	end
	return fn(math.clamp(level, 1, def.max))
end

function Economy.gearLevel(slot: string, tier: number): number
	local def = TRACKS[slot]
	if not def or tier <= 0 then
		return 1
	end
	return 1 + (def.max - 1) * (math.min(tier, Gear.Tiers) / Gear.Tiers) ^ Config.GearCurve
end

-- Stat a slot gives with the gear of `tier` equipped (0 = starter gear).
function Economy.gearValue(slot: string, tier: number): number
	return Economy.upgradeValue(slot, Economy.gearLevel(slot, tier))
end

function Economy.gearCost(key: string): number?
	local item = Gear.byKey[key]
	if not item then
		return nil
	end
	local def = TRACKS[item.slot]
	local level = Economy.gearLevel(item.slot, item.tier)
	local curve = Config.GearPriceScale * def.base * def.growth ^ (level - 2)
	-- Floor so early pieces are never pocket change: this many common relics of their world.
	local floor = Config.GearFloorRelics * Economy.relicValue(item.world, 1) * (if item.pro then 1.45 else 1)
	return Economy.nice(math.max(curve, floor))
end

-- Stat from a profile's equipped gear map ({ slot = gearKey }).
function Economy.stat(equip: { [string]: string }?, slot: string): number
	return Economy.gearValue(slot, Gear.tier(equip and equip[slot]))
end

-- Pet mutations ---------------------------------------------------------------------------------
-- Mutations stack by adding their multipliers: Gold (x2) + Lava (x5) = x7 pet boost.

local MUTATIONS = {}
for _, mutation in Config.Mutations do
	MUTATIONS[mutation.key] = mutation
end
for _, mutation in Config.LimitedMutations do
	MUTATIONS[mutation.key] = mutation
end
Economy.Mutations = MUTATIONS

-- How many of the regular (enchantable) mutations a pet carries; limited ones do not count.
function Economy.regularMutations(list: { string }?): number
	local count = 0
	for _, mutation in Config.Mutations do
		if list and table.find(list, mutation.key) then
			count += 1
		end
	end
	return count
end

function Economy.mutationMultiplier(list: { string }?): number
	if not list or #list == 0 then
		return 1
	end
	local sum = 0
	for _, key in list do
		local mutation = MUTATIONS[key]
		if mutation then
			sum += mutation.mult
		end
	end
	return math.max(1, sum)
end

-- Boost of an owned pet entry, mutations included.
function Economy.petPower(key: string, mutations: { string }?): number
	return Economy.petBoost(key) * Economy.mutationMultiplier(mutations)
end

-- Price of the next enchant on a pet (nil once it carries every mutation).
function Economy.mutateCost(key: string, mutations: { string }?): number?
	local pet = Worlds.pets[key]
	local count = Economy.regularMutations(mutations)
	if not pet or count >= #Config.Mutations then
		return nil
	end
	return Economy.nice(Economy.eggCost(pet.world) * Config.MutationCost[count + 1])
end

-- Weighted roll among the mutations the pet does not have yet, optionally limited to `pool`
-- (Lucky Enchants). roll in [0, 1).
function Economy.rollMutation(existing: { string }?, roll: number, pool: { string }?): string?
	local total = 0
	local options = {}
	for _, mutation in Config.Mutations do
		if not (existing and table.find(existing, mutation.key)) and (not pool or table.find(pool, mutation.key)) then
			table.insert(options, mutation)
			total += mutation.weight
		end
	end
	if #options == 0 then
		return nil
	end
	local target = roll * total
	for _, mutation in options do
		target -= mutation.weight
		if target < 0 then
			return mutation.key
		end
	end
	return options[#options].key
end

-- Chance (0..1) of each still-missing mutation on the next enchant.
function Economy.mutationChances(existing: { string }?): { { key: string, chance: number } }
	local total = 0
	for _, mutation in Config.Mutations do
		if not (existing and table.find(existing, mutation.key)) then
			total += mutation.weight
		end
	end
	local out = {}
	for _, mutation in Config.Mutations do
		if not (existing and table.find(existing, mutation.key)) then
			table.insert(out, { key = mutation.key, chance = mutation.weight / total })
		end
	end
	return out
end

-- Relic rarity by depth ---------------------------------------------------------------------------

function Economy.rarityWeights(depthRatio: number): { number }
	local d = math.clamp(depthRatio, 0, 1)
	return { 55 * (1 - d) + 8, 26, 9 + 14 * d, 2.5 + 9 * d, 0.4 + 3.2 * d }
end

-- roll in [0, 1)
function Economy.rollRarity(depthRatio: number, roll: number): number
	local weights = Economy.rarityWeights(depthRatio)
	local total = 0
	for _, w in weights do
		total += w
	end
	local target = roll * total
	for index, w in weights do
		target -= w
		if target < 0 then
			return index
		end
	end
	return #weights
end

-- Eggs ------------------------------------------------------------------------------------------

export type Chance = { key: string, chance: number }

-- Per-pet hatch chances (0..1) for a world's egg, in display order.
function Economy.eggChances(world: number, lucky: boolean): { Chance }
	local data = Worlds.get(world)
	local odds = table.clone(Config.EggOdds)
	if lucky then
		odds[4] *= Config.LuckyMultiplier
		odds[5] *= Config.LuckyMultiplier
	end
	local total = 0
	for _, o in odds do
		total += o
	end
	local secretChance = if data.secret then Config.SecretChance * (if lucky then Config.LuckyMultiplier else 1) else 0
	local out: { Chance } = {}
	for rarity, pet in data.pets do
		table.insert(out, { key = pet.key, chance = odds[rarity] / total * (1 - secretChance) })
	end
	if data.secret then
		table.insert(out, { key = data.secret.key, chance = secretChance })
	end
	return out
end

-- roll in [0, 1)
function Economy.rollPet(world: number, lucky: boolean, roll: number): string
	local chances = Economy.eggChances(world, lucky)
	-- Secret first so its tiny slice is not eaten by rounding at the end.
	local last = chances[#chances]
	local data = Worlds.get(world)
	if data.secret and roll < last.chance then
		return last.key
	end
	local acc = if data.secret then last.chance else 0
	for _, entry in chances do
		if entry.key ~= (data.secret and data.secret.key) then
			acc += entry.chance
			if roll < acc then
				return entry.key
			end
		end
	end
	return data.pets[1].key
end

-- Multipliers ---------------------------------------------------------------------------------

function Economy.coinMultiplier(boostSum: number, doubleCoins: boolean, timedBoost: boolean?): number
	return (1 + boostSum) * (if doubleCoins then 2 else 1) * (if timedBoost then Config.TimedBoostMultiplier else 1)
end

function Economy.productCoins(dives: number, world: number): number
	return Economy.nice(dives * Economy.relicValue(world, 1) * 14)
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--!strict
-- Number and time formatting for UI text.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trim(text: string): string
	-- "12.30" -> "12.3", "5.00" -> "5"
	if string.find(text, "%.") then
		text = string.gsub(text, "0+$", "")
		text = string.gsub(text, "%.$", "")
	end
	return text
end

function Format.commas(n: number): string
	local negative = n < 0
	local digits = tostring(math.floor(math.abs(n)))
	local out = string.reverse((string.gsub(string.reverse(digits), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return if negative then "-" .. out else out
end

-- 999 -> "999", 12345 -> "12.3K", 1500000 -> "1.5M"
function Format.short(n: number): string
	if n ~= n then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local text = tostring(math.floor(n))
		return if negative then "-" .. text else text
	end
	local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
	local scaled = n / 10 ^ (tier * 3)
	local text
	if scaled >= 100 then
		text = string.format("%d", math.floor(scaled))
	elseif scaled >= 10 then
		text = trim(string.format("%.1f", math.floor(scaled * 10) / 10))
	else
		text = trim(string.format("%.2f", math.floor(scaled * 100) / 100))
	end
	text ..= SUFFIXES[tier + 1]
	return if negative then "-" .. text else text
end

-- Multiplier such as x1.25 or x340
function Format.multiplier(m: number): string
	if m >= 100 then
		return "x" .. Format.short(m)
	elseif m >= 10 then
		return "x" .. trim(string.format("%.1f", m))
	end
	return "x" .. trim(string.format("%.2f", m))
end

function Format.percent(fraction: number): string
	local value = fraction * 100
	if value >= 10 then
		return string.format("%d%%", math.floor(value + 0.5))
	elseif value >= 1 then
		return trim(string.format("%.1f", value)) .. "%"
	elseif value >= 0.1 then
		return trim(string.format("%.2f", value)) .. "%"
	end
	return trim(string.format("%.3f", value)) .. "%"
end

function Format.seconds(s: number): string
	s = math.max(0, math.floor(s + 0.5))
	if s < 60 then
		return tostring(s) .. "s"
	end
	return string.format("%d:%02d", s // 60, s % 60)
end

-- Countdown clock: "h:mm:ss" (or "m:ss" under an hour).
function Format.clock(s: number): string
	s = math.max(0, math.floor(s))
	if s < 3600 then
		return string.format("%d:%02d", s // 60, s % 60)
	end
	return string.format("%d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end

-- Days since the Unix epoch (UTC) into a proleptic-Gregorian y/m/d triple. Portable, pure-Luau
-- date math (Howard Hinnant's algorithm) since Roblox's os library has no os.date.
local function civilFromDays(z: number): (number, number, number)
	z += 719468
	local era = (if z >= 0 then z else z - 146096) // 146097
	local doe = z - era * 146097 -- [0, 146096]
	local yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365 -- [0, 399]
	local y = yoe + era * 400
	local doy = doe - (365 * yoe + yoe // 4 - yoe // 100) -- [0, 365]
	local mp = (5 * doy + 2) // 153 -- [0, 11]
	local d = doy - (153 * mp + 2) // 5 + 1 -- [1, 31]
	local m = if mp < 10 then mp + 3 else mp - 9 -- [1, 12]
	return (if m <= 2 then y + 1 else y), m, d
end

-- Unix timestamp (seconds, UTC) -> year, month, day.
function Format.ymd(timestamp: number): (number, number, number)
	return civilFromDays(math.floor(timestamp / 86400))
end

-- Unix timestamp (seconds, UTC) -> "2026.09.24".
function Format.date(timestamp: number): string
	local days = math.floor(timestamp / 86400)
	local y, m, d = civilFromDays(days)
	return string.format("%04d.%02d.%02d", y, m, d)
end

-- Seconds -> hours and minutes, for a "{h}h {m}m" / "{h}시간 {m}분" style playtime display.
function Format.hoursMinutes(seconds: number): (number, number)
	local total = math.max(0, math.floor(seconds))
	return total // 3600, (total % 3600) // 60
end

-- Replaces {name} placeholders with values from args.
function Format.fill(template: string, args: { [string]: any }?): string
	if not args then
		return template
	end
	return (
		string.gsub(template, "{(%w+)}", function(key)
			local value = args[key]
			if value == nil then
				return "{" .. key .. "}"
			end
			return tostring(value)
		end)
	)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Layout</string>
          <string name="Source"><![CDATA[--!strict
-- World geometry shared by the server builder and client systems. Every world is an island with
-- a terraced blue hole (lagoon) in the middle; the dock sits on the +Z rim of the lagoon.

local Config = require(script.Parent.Config)
local Economy = require(script.Parent.Economy)

local Layout = {}

export type Info = {
	world: number,
	origin: Vector3,
	radius: number, -- lagoon rim radius (shelf)
	depth: number, -- deepest floor (studs below surface)
	shelfDepth: number,
	midRadius: number,
	midDepth: number,
	deepRadius: number,
	islandRadius: number,
	landY: number,
}

local cache: { [number]: Info } = {}

function Layout.origin(world: number): Vector3
	local col = (world - 1) % Config.WorldColumns
	local row = (world - 1) // Config.WorldColumns
	return Vector3.new(col * Config.WorldSpacing, Config.SurfaceY, row * Config.WorldSpacing)
end

function Layout.info(world: number): Info
	local cached = cache[world]
	if cached then
		return cached
	end
	local radius = Economy.lagoonRadius(world)
	local depth = Economy.depthStuds(world)
	local info: Info = {
		world = world,
		origin = Layout.origin(world),
		radius = radius,
		depth = depth,
		shelfDepth = math.floor(11 + (world - 1) * 0.25),
		midRadius = math.floor(radius * 0.7),
		midDepth = math.floor(depth * 0.58),
		deepRadius = math.floor(radius * 0.44),
		islandRadius = radius + 66,
		landY = 2,
	}
	cache[world] = info
	return info
end

-- World-space point from lagoon-local coordinates.
function Layout.at(world: number, x: number, y: number, z: number): Vector3
	return Layout.origin(world) + Vector3.new(x, y, z)
end

function Layout.spawnCFrame(world: number): CFrame
	local info = Layout.info(world)
	local position = Layout.at(world, 0, info.landY + 4.6, info.radius + 30)
	return CFrame.lookAt(position, Layout.at(world, 0, info.landY + 4.6, 0))
end

-- Dock anchor points (lagoon-local offsets are relative to the dock centre at the +Z rim).
function Layout.dock(world: number)
	local info = Layout.info(world)
	local r = info.radius
	return {
		spawn = Vector3.new(0, info.landY, r + 30),
		egg = Vector3.new(-26, info.landY, r + 22),
		kiosk = Vector3.new(26, info.landY, r + 26),
		portal = Vector3.new(0, info.landY, r + 50),
		pierStart = Vector3.new(38, info.landY, r + 14),
		pierEnd = Vector3.new(38, info.landY, r - 26),
		sell = Vector3.new(-46, info.landY, r + 34),
		board = Vector3.new(48, info.landY, r + 46),
		enchant = Vector3.new(-24, info.landY, r + 54),
		godShark = Vector3.new(20, info.landY, r + 48),
		beachHalfWidth = 20,
	}
end

function Layout.horizontalDistance(world: number, position: Vector3): number
	local origin = Layout.origin(world)
	local dx, dz = position.X - origin.X, position.Z - origin.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- True if the position is over the lagoon water (including the beach inlet).
function Layout.overLagoon(world: number, position: Vector3): boolean
	local info = Layout.info(world)
	local origin = info.origin
	local lx, lz = position.X - origin.X, position.Z - origin.Z
	if lx * lx + lz * lz <= (info.radius + 1.5) ^ 2 then
		return true
	end
	-- Beach inlet on the dock side.
	return math.abs(lx) <= 21 and lz >= info.radius - 2 and lz <= info.radius + 14
end

-- Conservative swimmable radius at a depth (the terraces narrow as you go down).
function Layout.radiusAtDepth(world: number, depth: number): number
	local info = Layout.info(world)
	if depth <= info.shelfDepth - 1 then
		return info.radius - 1.5
	elseif depth <= info.midDepth - 1 then
		return info.midRadius - 1.5
	end
	return info.deepRadius - 1.5
end

-- Which world an arbitrary position belongs to (nearest island), or nil when far away.
function Layout.worldAt(position: Vector3): number?
	local col = math.floor(position.X / Config.WorldSpacing + 0.5)
	local row = math.floor(position.Z / Config.WorldSpacing + 0.5)
	if col < 0 or col >= Config.WorldColumns or row < 0 then
		return nil
	end
	local world = row * Config.WorldColumns + col + 1
	if world > Config.WorldCount then
		return nil
	end
	return world
end

function Layout.depthOf(position: Vector3): number
	return Config.SurfaceY - position.Y
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Models</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Build</string>
            <string name="Source"><![CDATA[--!strict
-- Primitive part helpers for the procedural models (pets, relics, eggs, decor). Parts are
-- anchored, non-colliding and non-queryable by default; callers opt into collision.

local Color = require(script.Parent.Parent.Color)

local Build = {}

export type Style = string?

local DEFAULTS = {
	Anchored = true,
	CanCollide = false,
	CanQuery = false,
	CanTouch = false,
	CastShadow = false,
	Material = Enum.Material.SmoothPlastic,
	TopSurface = Enum.SurfaceType.Smooth,
	BottomSurface = Enum.SurfaceType.Smooth,
}

local function apply(part: BasePart, color: Color3, cf: CFrame, parent: Instance)
	for key, value in DEFAULTS do
		(part :: any)[key] = value
	end
	part.Color = color
	part.CFrame = cf
	part.Parent = parent
end

function Build.model(name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	apply(root, Color3.new(1, 1, 1), CFrame.identity, model)
	model.PrimaryPart = root
	return model
end

function Build.block(parent: Instance, size: Vector3, cf: CFrame, color: Color3): Part
	local part = Instance.new("Part")
	part.Size = size
	apply(part, color, cf, parent)
	return part
end

function Build.ball(parent: Instance, diameter: number, cf: CFrame, color: Color3): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(diameter, diameter, diameter)
	apply(part, color, cf, parent)
	return part
end

-- Non-uniform sphere (SpecialMesh sphere stretched to the part size).
function Build.ellipsoid(parent: Instance, size: Vector3, cf: CFrame, color: Color3): Part
	local part = Instance.new("Part")
	part.Size = size
	apply(part, color, cf, parent)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = part
	return part
end

-- Cylinder whose axis runs along the CFrame's X axis.
function Build.cylinder(parent: Instance, length: number, diameter: number, cf: CFrame, color: Color3): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(length, diameter, diameter)
	apply(part, color, cf, parent)
	return part
end

-- Cylinder standing upright (axis along Y) centred at `position`.
function Build.column(parent: Instance, height: number, diameter: number, cf: CFrame, color: Color3): Part
	return Build.cylinder(parent, height, diameter, cf * CFrame.Angles(0, 0, math.rad(90)), color)
end

function Build.wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3): WedgePart
	local part = Instance.new("WedgePart")
	part.Size = size
	apply(part, color, cf, parent)
	return part
end

function Build.cornerWedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3): CornerWedgePart
	local part = Instance.new("CornerWedgePart")
	part.Size = size
	apply(part, color, cf, parent)
	return part
end

-- CFrame.lookAt that stays well defined when looking straight up/down or at the same point.
function Build.look(at: Vector3, target: Vector3): CFrame
	local direction = target - at
	if direction.Magnitude < 1e-5 then
		return CFrame.new(at)
	end
	local up = if math.abs(direction.Unit.Y) > 0.999 then Vector3.zAxis else Vector3.yAxis
	return CFrame.lookAt(at, target, up)
end

-- Tapered spike pointing along the CFrame's -Z (look) direction: two wedges back to back.
-- A WedgePart is tallest at +Z and thins to an edge at -Z, so no yaw is needed here.
function Build.spike(parent: Instance, length: number, width: number, cf: CFrame, color: Color3, accent: boolean?)
	local half = width / 2
	local upper = Build.wedge(parent, Vector3.new(width, half, length), cf * CFrame.new(0, half / 2, 0), color)
	local lower = Build.wedge(parent, Vector3.new(width, half, length), cf * CFrame.new(0, -half / 2, 0) * CFrame.Angles(0, 0, math.pi), color)
	if accent then
		upper:SetAttribute("Accent", true)
		lower:SetAttribute("Accent", true)
	end
	return upper, lower
end

-- Cute cartoon eye: white ball, dark pupil, tiny shine. `cf` looks outward from the face.
function Build.eye(parent: Instance, size: number, cf: CFrame, pupilColor: Color3?)
	local white = Build.ball(parent, size, cf, Color3.new(1, 1, 1))
	local pupil = Build.ball(parent, size * 0.62, cf * CFrame.new(0, 0, -size * 0.24), pupilColor or Color3.fromRGB(28, 28, 36))
	local shine = Build.ball(parent, size * 0.22, cf * CFrame.new(size * 0.14, size * 0.16, -size * 0.46), Color3.new(1, 1, 1))
	shine.Material = Enum.Material.Neon
	for _, part in { white, pupil, shine } do
		part:SetAttribute("Eye", true)
	end
end

-- Pair of eyes on a face whose front is -Z. `x` is half spacing, `y` height, `z` depth.
function Build.eyes(parent: Instance, base: CFrame, x: number, y: number, z: number, size: number, outward: number?)
	local turn = math.rad(outward or 18)
	Build.eye(parent, size, base * CFrame.new(-x, y, z) * CFrame.Angles(0, turn, 0))
	Build.eye(parent, size, base * CFrame.new(x, y, z) * CFrame.Angles(0, -turn, 0))
end

function Build.light(parent: BasePart, color: Color3, range: number, brightness: number): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
	return light
end

function Build.sparkles(parent: BasePart, color: Color3, rate: number?): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.8, 1.4)
	emitter.Rate = rate or 6
	emitter.Speed = NumberRange.new(0.5, 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = parent
	return emitter
end

-- Applies a visual style to a finished model. Parts named with the "Accent" attribute are the
-- highlight parts (fins, spots, gems); everything else is the body.
function Build.style(model: Model, style: Style, accent: Color3)
	if not style then
		return
	end
	local index = 0
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.Name ~= "Root" and part.Transparency < 1 then
			index += 1
			local isAccent = part:GetAttribute("Accent") == true
			local isEye = part:GetAttribute("Eye") == true
			if style == "neon" then
				if isAccent then
					part.Material = Enum.Material.Neon
				end
			elseif style == "glass" then
				if not isEye then
					part.Material = Enum.Material.Glass
					part.Transparency = math.max(part.Transparency, 0.3)
				end
			elseif style == "ghost" then
				if not isEye then
					part.Material = if isAccent then Enum.Material.Neon else Enum.Material.ForceField
				end
			elseif style == "gold" then
				if not isEye then
					part.Material = if isAccent then Enum.Material.Neon else Enum.Material.Metal
					part.Reflectance = if isAccent then 0 else 0.18
				end
			elseif style == "rainbow" then
				if not isEye then
					part.Color = Color.Rainbow[(index % #Color.Rainbow) + 1]
					if isAccent then
						part.Material = Enum.Material.Neon
					end
				end
			elseif style == "cosmic" then
				if not isEye then
					part.Material = if isAccent then Enum.Material.Neon else Enum.Material.ForceField
				end
			end
		end
	end
	local root = model.PrimaryPart
	if root and (style == "neon" or style == "rainbow" or style == "cosmic" or style == "gold" or style == "ghost") then
		Build.light(root, accent, 8, 1.2)
	end
	if root and (style == "cosmic" or style == "rainbow" or style == "gold") then
		Build.sparkles(root, accent, if style == "cosmic" then 10 else 4)
	end
end

function Build.markAccent(part: BasePart): BasePart
	part:SetAttribute("Accent", true)
	return part
end

-- Scales a finished model so its largest extent equals `size` studs.
function Build.fit(model: Model, size: number)
	local _, extents = model:GetBoundingBox()
	local largest = math.max(extents.X, extents.Y, extents.Z)
	if largest > 0 then
		model:ScaleTo(model:GetScale() * size / largest)
	end
end

return Build
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">GearModels</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural diving gear: oxygen tanks (back), treasure bags (hip), flippers (feet) and
-- treasure magnets (hand), tinted with each world's colours. Pro pieces get twin parts, neon
-- trim and, in later worlds, a glow. `dress` welds the equipped set onto a character so every
-- player sees it.

local Color = require(script.Parent.Parent.Color)
local Gear = require(script.Parent.Parent.Data.Gear)
local Build = require(script.Parent.Build)

local GearModels = {}

local V = Vector3.new
local cf = CFrame.new
local ang = CFrame.Angles
local rad = math.rad

local METAL = Color3.fromRGB(214, 222, 232)
local DARK = Color3.fromRGB(40, 46, 60)

local function trim(part: BasePart, pro: boolean)
	if pro then
		part.Material = Enum.Material.Neon
	end
end

local BUILDERS: { [string]: (Model, Gear.Item, Color3, Color3) -> () } = {}

-- Upright tank(s) centred on the origin, valve on top.
BUILDERS.tank = function(m, item, c1, c2)
	local offsets: { number } = if item.pro then { -0.42, 0.42 } else { 0 }
	for _, x in offsets do
		Build.column(m, 1.8, 0.78, cf(x, 0, 0), c1)
		Build.ball(m, 0.78, cf(x, 0.9, 0), c1)
		Build.ball(m, 0.78, cf(x, -0.9, 0), c1)
		for _, y in { -0.45, 0.45 } do
			trim(Build.column(m, 0.14, 0.84, cf(x, y, 0), c2), item.pro)
		end
		Build.column(m, 0.3, 0.3, cf(x, 1.3, 0), METAL)
		Build.cylinder(m, 0.4, 0.14, cf(x, 1.36, 0), METAL)
	end
	if item.pro then
		Build.block(m, V(1.2, 0.2, 0.3), cf(0, 1.25, 0), METAL)
	end
	-- Harness plate that sits against the back.
	Build.block(m, V(if item.pro then 1.5 else 0.9, 1.3, 0.12), cf(0, 0, -0.45), DARK)
end

-- Treasure pouch on the hip.
BUILDERS.pack = function(m, item, c1, c2)
	local sides: { number } = if item.pro then { -1, 1 } else { 1 }
	for _, side in sides do
		local x = side * 1.05
		Build.block(m, V(0.5, 0.75, 0.85), cf(x, 0, 0), c1)
		Build.wedge(m, V(0.54, 0.25, 0.89), cf(x, 0.45, 0) * ang(0, rad(side * 90), 0), c2)
		local clasp = Build.ball(m, 0.22, cf(x + side * 0.26, 0.2, 0), if item.pro then c2 else Color3.fromRGB(255, 214, 90))
		clasp.Material = Enum.Material.Neon
	end
	-- Belt.
	Build.block(m, V(2.1, 0.22, 1.1), cf(0, 0.1, 0), DARK)
	trim(Build.block(m, V(0.36, 0.3, 0.1), cf(0, 0.1, -0.56), Color3.fromRGB(255, 214, 90)), item.pro)
end

-- One flipper, foot at the origin, blade reaching forward (-Z).
BUILDERS.fins = function(m, item, c1, c2)
	local length = if item.pro then 2.3 else 1.8
	Build.block(m, V(0.95, 0.35, 1.0), cf(0, 0, 0), c2)
	Build.block(m, V(1.05, 0.12, length), cf(0, -0.12, -0.5 - length / 2), c1)
	for _, x in { -0.5, 0.5 } do
		trim(Build.block(m, V(0.1, 0.18, length), cf(x, -0.1, -0.5 - length / 2), c2), item.pro)
	end
	if item.pro then
		Build.block(m, V(0.12, 0.16, length * 0.8), cf(0, -0.04, -0.5 - length * 0.45), c2)
	end
end

-- Horseshoe magnet held in the hand, prongs pointing forward (-Z).
BUILDERS.magnet = function(m, item, c1, c2)
	for _, x in { -0.32, 0.32 } do
		Build.block(m, V(0.26, 0.26, 0.9), cf(x, 0, -0.35), c1)
		local tip = Build.block(m, V(0.28, 0.28, 0.24), cf(x, 0, -0.9), if item.pro then c2 else METAL)
		trim(tip, item.pro)
	end
	Build.cylinder(m, 0.9, 0.3, cf(0, 0, 0.1), c1)
	if item.pro then
		local core = Build.ball(m, 0.3, cf(0, 0, -0.9), c2)
		core.Material = Enum.Material.Neon
		core.Transparency = 0.3
	end
end

function GearModels.build(key: string, size: number?): Model
	local item = Gear.get(key)
	local model = Build.model("Gear_" .. key)
	if not item then
		return model
	end
	local c1, c2 = Color.hex(item.color), Color.hex(item.accent)
	BUILDERS[item.slot](model, item, c1, c2)
	local root = model.PrimaryPart
	if root and item.pro and item.world >= 11 then
		Build.light(root, c1, 6, 1)
	end
	if root and item.pro and item.world >= 15 then
		Build.sparkles(root, c1, 3)
	end
	if size then
		Build.fit(model, size)
	end
	model:SetAttribute("GearKey", key)
	return model
end

-- Where each slot sits on the body: { R15 part, R6 part, offset in that part's space }.
-- Characters face -Z, so the back is +Z.
type Mount = { r15: string, r6: string, offset: CFrame, r6Offset: CFrame }
local MOUNTS: { [string]: { Mount } } = {
	tank = { { r15 = "UpperTorso", r6 = "Torso", offset = cf(0, 0, 0.98), r6Offset = cf(0, 0.1, 0.98) } },
	pack = { { r15 = "LowerTorso", r6 = "Torso", offset = cf(0, 0, 0), r6Offset = cf(0, -0.8, 0) } },
	fins = {
		{ r15 = "LeftFoot", r6 = "Left Leg", offset = cf(0, -0.05, -0.1), r6Offset = cf(0, -0.85, -0.1) },
		{ r15 = "RightFoot", r6 = "Right Leg", offset = cf(0, -0.05, -0.1), r6Offset = cf(0, -0.85, -0.1) },
	},
	magnet = { { r15 = "RightHand", r6 = "Right Arm", offset = cf(0, -0.25, -0.2), r6Offset = cf(0, -1.1, -0.2) } },
}
GearModels.Mounts = MOUNTS

-- Rebuilds the worn gear on a character from an equip map ({ slot = gearKey }).
function GearModels.dress(character: Model, equip: { [string]: string })
	local old = character:FindFirstChild("DeepDiveGear")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "DeepDiveGear"
	for _, slot in Gear.Slots do
		local key = equip[slot]
		if not key or not Gear.get(key) then
			continue
		end
		for _, mount in MOUNTS[slot] do
			local r15 = character:FindFirstChild(mount.r15)
			local bone = r15 or character:FindFirstChild(mount.r6)
			if not bone or not bone:IsA("BasePart") then
				continue
			end
			local model = GearModels.build(key)
			model:PivotTo(bone.CFrame * (if r15 then mount.offset else mount.r6Offset))
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.Anchored = false
					part.Massless = true
					part.CanCollide = false
					part.CanQuery = false
					part.CanTouch = false
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = bone
					weld.Part1 = part
					weld.Parent = part
				end
			end
			model.Parent = folder
		end
	end
	folder.Parent = character
end

return GearModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Mutations</string>
            <string name="Source"><![CDATA[--!strict
-- Pet mutation looks. A pet shows its strongest mutation: Gold (polished metal), Diamond (icy
-- crystal), Galaxy (deep space with stars), Lava (cracked lava with embers) or GOAT (rainbow
-- shimmer). Weaker mutations on the same pet still add their multiplier.

local Color = require(script.Parent.Parent.Color)
local Config = require(script.Parent.Parent.Config)
local Build = require(script.Parent.Build)

local Mutations = {}

local RANK: { [string]: number } = {}
for index, mutation in Config.Mutations do
	RANK[mutation.key] = index
end
for index, mutation in Config.LimitedMutations do
	RANK[mutation.key] = #Config.Mutations + index
end

-- Strongest mutation in a list (nil for none).
function Mutations.top(list: { string }?): string?
	local best, bestRank = nil, 0
	if list then
		for _, key in list do
			local rank = RANK[key] or 0
			if rank > bestRank then
				best, bestRank = key, rank
			end
		end
	end
	return best
end

function Mutations.color(key: string): Color3
	for _, list in { Config.Mutations, Config.LimitedMutations } do
		for _, mutation in list do
			if mutation.key == key then
				return Color.hex(mutation.color)
			end
		end
	end
	return Color3.new(1, 1, 1)
end

-- Parses the replicated follower form "species|Gold,Lava".
function Mutations.parse(text: string): (string, { string })
	local bar = string.find(text, "|", 1, true)
	if not bar then
		return text, {}
	end
	local list = {}
	for key in string.gmatch(string.sub(text, bar + 1), "[^,]+") do
		table.insert(list, key)
	end
	return string.sub(text, 1, bar - 1), list
end

local function emitter(parent: BasePart, color: Color3, rate: number, size: number, texture: string?)
	local e = Build.sparkles(parent, color, rate)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	if texture then
		e.Texture = texture
	end
	return e
end

function Mutations.apply(model: Model, list: { string }?)
	local top = Mutations.top(list)
	if not top then
		return
	end
	local index = 0
	for _, part in model:GetDescendants() do
		if not part:IsA("BasePart") or part.Name == "Root" or part.Transparency >= 1 or part:GetAttribute("Eye") then
			continue
		end
		index += 1
		local accent = part:GetAttribute("Accent") == true
		part.Transparency = 0
		if top == "Gold" then
			part.Color = if accent then Color3.fromRGB(255, 244, 170) else Color3.fromRGB(255, 196, 46)
			part.Material = if accent then Enum.Material.Neon else Enum.Material.Metal
			part.Reflectance = if accent then 0 else 0.25
		elseif top == "Diamond" then
			part.Color = if accent then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(150, 236, 255)
			part.Material = if accent then Enum.Material.Neon else Enum.Material.Ice
			part.Reflectance = 0.3
		elseif top == "Galaxy" then
			part.Color = if accent then Color3.fromRGB(255, 110, 230) else Color3.fromRGB(58, 26, 120)
			part.Material = if accent then Enum.Material.Neon else Enum.Material.SmoothPlastic
			part.Reflectance = 0.1
		elseif top == "Lava" then
			part.Color = if accent then Color3.fromRGB(255, 140, 30) else Color3.fromRGB(255, 92, 30)
			part.Material = if accent then Enum.Material.Neon else Enum.Material.CrackedLava
			part.Reflectance = 0
		elseif top == "GOAT" then
			part.Color = Color.Rainbow[(index % #Color.Rainbow) + 1]
			part.Material = if accent then Enum.Material.Neon else Enum.Material.Glass
			part.Reflectance = 0.15
		elseif top == "GOD" then
			-- Keeps the pet's own colours; the trim turns to glowing light.
			if accent then
				part.Material = Enum.Material.Neon
			end
		end
	end
	local root = model.PrimaryPart
	if not root then
		return
	end
	local color = Mutations.color(top)
	Build.light(root, color, 9, if top == "Gold" then 1 else 1.6)
	if top == "Gold" then
		emitter(root, Color3.fromRGB(255, 226, 110), 5, 0.4)
	elseif top == "Diamond" then
		emitter(root, Color3.fromRGB(220, 250, 255), 7, 0.45)
	elseif top == "Galaxy" then
		emitter(root, Color3.fromRGB(200, 160, 255), 14, 0.35)
		emitter(root, Color3.fromRGB(255, 120, 230), 4, 0.6)
	elseif top == "Lava" then
		local embers = emitter(root, Color3.fromRGB(255, 120, 30), 12, 0.3)
		embers.Acceleration = Vector3.new(0, 3, 0)
	elseif top == "GOAT" then
		emitter(root, Color3.fromRGB(255, 255, 255), 10, 0.5)
		emitter(root, Color3.fromRGB(255, 90, 220), 6, 0.55)
	elseif top == "GOD" then
		emitter(root, Color3.fromRGB(255, 240, 120), 12, 0.5)
		emitter(root, Color3.fromRGB(255, 255, 255), 8, 0.35)
	end
	model:SetAttribute("Mutation", top)
end

return Mutations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PetModels</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural pet models. Every model faces -Z, is centred on its Root part and is built from
-- primitives only, so the same builder serves followers, egg displays and UI viewports.

local Build = require(script.Parent.Build)
local Color = require(script.Parent.Parent.Color)
local Worlds = require(script.Parent.Parent.Data.Worlds)

local PetModels = {}

local V = Vector3.new
local cf = CFrame.new
local ang = CFrame.Angles
local rad = math.rad
local E = Build.ellipsoid
local B = Build.ball
local K = Build.block
local W = Build.wedge
local A = Build.markAccent

local WHITE = Color3.new(1, 1, 1)
local DARK = Color3.fromRGB(34, 30, 40)
local ORANGE = Color3.fromRGB(255, 165, 63)
local BLUSH = Color3.fromRGB(255, 140, 170)

local function light(c: Color3): Color3
	return Color.lighten(c, 0.45)
end

local function shade(c: Color3): Color3
	return Color.darken(c, 0.25)
end

local function mouth(m: Model, position: Vector3, width: number)
	E(m, V(width, width * 0.28, width * 0.35), cf(position), DARK)
end

local function blush(m: Model, x: number, y: number, z: number, size: number)
	for _, side in { -1, 1 } do
		local part = E(m, V(size, size * 0.55, size * 0.3), cf(side * x, y, z) * ang(0, rad(side * -25), 0), BLUSH)
		part.Transparency = 0.25
		part:SetAttribute("Eye", true)
	end
end

-- Forked tail made of two wedges meeting at the tail root (z = root), spreading toward +Z.
local function forkTail(m: Model, root: number, height: number, length: number, color: Color3, y: number?)
	local oy = y or 0
	A(W(m, V(0.18, height, length), cf(0, oy + height / 2, root + length / 2) * ang(rad(-12), 0, 0), color))
	A(W(m, V(0.18, height, length), cf(0, oy - height / 2, root + length / 2) * ang(rad(12), 0, 0) * ang(0, 0, math.pi), color))
end

-- Flat horizontal flukes (whales, dolphins).
local function flukes(m: Model, z: number, span: number, color: Color3, y: number?)
	local oy = y or 0
	for _, side in { -1, 1 } do
		A(E(m, V(span, 0.16, span * 0.45), cf(side * span * 0.42, oy, z) * ang(0, rad(side * 28), 0), color))
	end
end

local function dorsal(m: Model, y: number, z: number, height: number, length: number, color: Color3)
	A(W(m, V(0.16, height, length), cf(0, y + height / 2, z), color))
end

local function sideFins(m: Model, x: number, y: number, z: number, size: Vector3, color: Color3, spread: number?)
	for _, side in { -1, 1 } do
		A(E(m, size, cf(side * x, y, z) * ang(0, rad(side * 30), rad(side * (spread or 35))), color))
	end
end

local function fibonacci(count: number): { Vector3 }
	local points = {}
	local golden = math.pi * (3 - math.sqrt(5))
	for i = 0, count - 1 do
		-- Half-step offset keeps samples off the exact poles (a vertical look has no defined up).
		local y = 1 - ((i + 0.5) / count) * 2
		local r = math.sqrt(1 - y * y)
		local theta = golden * i
		table.insert(points, V(math.cos(theta) * r, y, math.sin(theta) * r))
	end
	return points
end

local SHAPES: { [string]: (Model, Color3, Color3) -> () } = {}

SHAPES.fish = function(m, c1, c2)
	E(m, V(1.5, 1.6, 2.4), cf(0, 0, 0), c1)
	E(m, V(1.2, 0.95, 1.9), cf(0, -0.35, -0.1), light(c1))
	A(E(m, V(1.56, 1.3, 0.22), cf(0, 0, 0.35), c2))
	forkTail(m, 1.0, 1.0, 1.05, c2)
	dorsal(m, 0.62, 0.15, 0.7, 1.0, c2)
	sideFins(m, 0.78, -0.2, -0.05, V(0.12, 0.45, 0.75), c2)
	Build.eyes(m, CFrame.identity, 0.5, 0.25, -0.82, 0.58, 28)
	mouth(m, V(0, -0.18, -1.18), 0.3)
	blush(m, 0.56, -0.12, -0.82, 0.28)
end

SHAPES.lionfish = function(m, c1, c2)
	SHAPES.fish(m, c1, c2)
	for i = 0, 5 do
		local z = -0.55 + i * 0.3
		Build.spike(m, 1.0, 0.12, cf(0, 1.15, z) * ang(rad(108), 0, 0), if i % 2 == 0 then c2 else c1, true)
	end
	for _, z in { -0.25, 0.3 } do
		A(E(m, V(1.56, 1.66, 0.14), cf(0, 0, z), c2))
	end
end

SHAPES.puffer = function(m, c1, c2)
	B(m, 2.2, cf(0, 0, 0), c1)
	E(m, V(1.9, 1.1, 1.9), cf(0, -0.5, 0), light(c1))
	for _, dir in fibonacci(22) do
		if dir.Z > -0.55 then
			local pos = dir * 1.02
			Build.spike(m, 0.42, 0.14, Build.look(pos, pos + dir), c2, true)
		end
	end
	forkTail(m, 1.0, 0.7, 0.7, c2)
	sideFins(m, 1.05, -0.1, -0.1, V(0.12, 0.4, 0.55), c2)
	Build.eyes(m, CFrame.identity, 0.46, 0.25, -0.92, 0.66, 22)
	E(m, V(0.34, 0.3, 0.2), cf(0, -0.25, -1.1), DARK)
	blush(m, 0.62, -0.1, -0.86, 0.3)
end

SHAPES.turtle = function(m, c1, c2)
	E(m, V(2.4, 1.35, 2.8), cf(0, 0.25, 0.1), c1)
	E(m, V(2.25, 0.4, 2.6), cf(0, -0.28, 0.1), Color.lighten(c2, 0.55))
	for _, p in { V(0, 0.95, 0.1), V(-0.62, 0.72, -0.35), V(0.62, 0.72, -0.35), V(-0.62, 0.72, 0.6), V(0.62, 0.72, 0.6) } do
		local tilt = Build.look(p, p + (p - V(0, -0.4, 0.1)).Unit)
		A(E(m, V(0.62, 0.62, 0.16), tilt, shade(c1)))
	end
	E(m, V(0.95, 0.85, 1.0), cf(0, 0.15, -1.55), c2)
	for _, side in { -1, 1 } do
		E(m, V(1.3, 0.18, 0.55), cf(side * 1.2, -0.1, -0.7) * ang(0, rad(side * 30), rad(side * -10)), c2)
		E(m, V(0.8, 0.16, 0.45), cf(side * 0.95, -0.15, 1.15) * ang(0, rad(side * -30), 0), c2)
	end
	Build.eyes(m, CFrame.identity, 0.26, 0.3, -1.92, 0.42, 30)
	mouth(m, V(0, -0.02, -2.02), 0.26)
end

SHAPES.crab = function(m, c1, c2)
	E(m, V(2.4, 1.05, 1.8), cf(0, 0, 0), c1)
	E(m, V(2.0, 0.5, 1.5), cf(0, -0.35, 0), light(c1))
	for _, side in { -1, 1 } do
		Build.cylinder(m, 0.8, 0.26, cf(side * 1.25, 0.05, -0.7) * ang(0, rad(side * 40), 0), c1)
		E(m, V(0.8, 0.62, 0.95), cf(side * 1.55, 0.15, -1.2), c1)
		A(E(m, V(0.34, 0.36, 0.7), cf(side * 1.72, 0.48, -1.5) * ang(rad(20), 0, 0), c2))
		for i, z in { -0.2, 0.25, 0.65 } do
			Build.cylinder(m, 1.0, 0.16, cf(side * 1.35, -0.38, z) * ang(0, rad(side * (i - 2) * 12), rad(side * -35)), c2)
		end
		Build.column(m, 0.6, 0.14, cf(side * 0.42, 0.72, -0.55), c1)
	end
	Build.eyes(m, CFrame.identity, 0.42, 1.08, -0.62, 0.48, 12)
	mouth(m, V(0, 0.02, -0.9), 0.34)
	blush(m, 0.7, 0.1, -0.78, 0.3)
end

SHAPES.octopus = function(m, c1, c2)
	E(m, V(2.0, 2.2, 2.0), cf(0, 0.55, 0.15), c1)
	for i = 1, 8 do
		local a = (i - 0.5) / 8 * math.pi * 2
		local dir = V(math.cos(a), 0, math.sin(a))
		B(m, 0.62, cf(dir * 0.8 + V(0, -0.45, 0)), c1)
		B(m, 0.5, cf(dir * 1.15 + V(0, -0.85, 0)), c1)
		A(B(m, 0.38, cf(dir * 1.38 + V(0, -1.05, 0)), c2))
	end
	for _, p in { V(-0.55, 1.25, 0.35), V(0.45, 1.4, 0.55), V(0.1, 1.55, -0.05) } do
		A(E(m, V(0.36, 0.2, 0.36), cf(p), c2))
	end
	Build.eyes(m, CFrame.identity, 0.45, 0.45, -0.78, 0.64, 25)
	mouth(m, V(0, 0.02, -0.86), 0.28)
	blush(m, 0.66, 0.12, -0.7, 0.32)
end

SHAPES.jelly = function(m, c1, c2)
	local bell = E(m, V(2.4, 1.7, 2.4), cf(0, 0.45, 0), c1)
	bell.Transparency = 0.18
	A(E(m, V(1.5, 1.0, 1.5), cf(0, 0.4, 0), c2))
	E(m, V(2.5, 0.35, 2.5), cf(0, -0.3, 0), c1)
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		local x, z = math.cos(a) * 0.8, math.sin(a) * 0.8
		local sway = if i % 2 == 0 then 1 else -1
		A(E(m, V(0.18, 0.95, 0.18), cf(x, -0.85, z) * ang(rad(10 * sway), 0, rad(6 * sway)), c2))
		A(E(m, V(0.15, 0.8, 0.15), cf(x * 1.05, -1.6, z * 1.05) * ang(rad(-12 * sway), 0, 0), c2))
	end
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		E(m, V(0.35, 1.3, 0.25), cf(math.cos(a) * 0.25, -1.0, math.sin(a) * 0.25), light(c1))
	end
	Build.eyes(m, CFrame.identity, 0.42, 0.42, -1.02, 0.46, 26)
	mouth(m, V(0, 0.08, -1.12), 0.24)
end

SHAPES.starfish = function(m, c1, c2)
	E(m, V(1.2, 1.2, 0.6), cf(0, 0, 0), c1)
	for i = 0, 4 do
		local a = rad(90 + i * 72)
		local dir = V(math.cos(a), math.sin(a), 0)
		E(m, V(0.66, 1.55, 0.48), CFrame.new(dir * 0.85) * ang(0, 0, a - rad(90)), c1)
		A(B(m, 0.18, cf(dir * 0.8 + V(0, 0, -0.24)), c2))
		A(B(m, 0.14, cf(dir * 1.2 + V(0, 0, -0.18)), c2))
	end
	Build.eyes(m, CFrame.identity, 0.24, 0.14, -0.32, 0.36, 20)
	mouth(m, V(0, -0.18, -0.34), 0.2)
end

SHAPES.seahorse = function(m, c1, c2)
	E(m, V(0.85, 0.95, 1.05), cf(0, 1.15, -0.1), c1)
	Build.cylinder(m, 0.75, 0.32, cf(0, 1.02, -0.78) * ang(0, rad(90), 0), c1)
	E(m, V(0.95, 1.25, 1.05), cf(0, 0.3, 0.1), c1)
	E(m, V(0.72, 1.0, 0.62), cf(0, 0.25, -0.2), light(c1))
	local tailPoints = { V(0, -0.5, 0.25), V(0, -0.95, 0.22), V(0, -1.25, -0.02), V(0, -1.32, -0.34), V(0, -1.12, -0.5) }
	local tailSizes = { 0.62, 0.48, 0.36, 0.28, 0.22 }
	for i, point in tailPoints do
		B(m, tailSizes[i], cf(point), c1)
	end
	for i = 0, 2 do
		A(W(m, V(0.12, 0.35, 0.4), cf(0, 1.55 - i * 0.18, 0.2 + i * 0.22) * ang(rad(-30 - i * 15), 0, 0), c2))
	end
	dorsal(m, 0.15, 0.62, 0.55, 0.5, c2)
	Build.eyes(m, CFrame.identity, 0.34, 1.26, -0.36, 0.4, 40)
	blush(m, 0.4, 1.0, -0.4, 0.22)
end

SHAPES.shark = function(m, c1, c2)
	E(m, V(1.4, 1.35, 3.4), cf(0, 0, 0), c1)
	E(m, V(1.15, 0.8, 2.8), cf(0, -0.3, -0.1), c2)
	dorsal(m, 0.5, 0.2, 1.05, 1.1, c1)
	A(W(m, V(0.16, 1.2, 1.0), cf(0, 0.55, 2.0) * ang(rad(-25), 0, 0), c1))
	A(W(m, V(0.16, 0.7, 0.7), cf(0, -0.3, 1.95) * ang(rad(25), 0, 0) * ang(0, 0, math.pi), c1))
	sideFins(m, 0.7, -0.35, -0.2, V(0.14, 0.5, 1.0), c1, 55)
	Build.eyes(m, CFrame.identity, 0.46, 0.2, -1.22, 0.44, 40)
	E(m, V(0.62, 0.12, 0.22), cf(0, -0.36, -1.45), DARK)
	for i = -1, 1 do
		local tooth = W(m, V(0.1, 0.12, 0.08), cf(i * 0.16, -0.31, -1.52) * ang(0, 0, math.pi), WHITE)
		tooth:SetAttribute("Eye", true)
	end
	for _, side in { -1, 1 } do
		for i = 0, 2 do
			K(m, V(0.05, 0.4, 0.06), cf(side * 0.68, 0.0, -0.75 + i * 0.16), shade(c1))
		end
	end
end

-- Limited GOD Shark: a chubby baby shark with big eyes, a little smile and a golden halo.
SHAPES.godshark = function(m, c1, c2)
	local gold = Color3.fromRGB(255, 214, 72)
	E(m, V(2.1, 1.9, 2.9), cf(0, 0, 0.1), c1)
	E(m, V(1.75, 1.15, 2.4), cf(0, -0.42, -0.05), c2)
	A(W(m, V(0.2, 0.9, 0.9), cf(0, 1.15, 0.35), c1))
	for _, side in { -1, 1 } do
		E(m, V(0.22, 0.55, 0.95), cf(side * 1.0, -0.45, -0.1) * ang(0, rad(side * 25), rad(side * 50)), c1)
	end
	A(W(m, V(0.2, 0.95, 0.85), cf(0, 0.38, 1.85) * ang(rad(-30), 0, 0), c1))
	A(W(m, V(0.2, 0.6, 0.6), cf(0, -0.25, 1.8) * ang(rad(30), 0, 0) * ang(0, 0, math.pi), c1))
	Build.eyes(m, CFrame.identity, 0.5, 0.22, -1.2, 0.72, 34)
	E(m, V(0.5, 0.16, 0.2), cf(0, -0.32, -1.36), DARK)
	for _, x in { -0.12, 0.12 } do
		local tooth = W(m, V(0.1, 0.12, 0.08), cf(x, -0.27, -1.43) * ang(0, 0, math.pi), WHITE)
		tooth:SetAttribute("Eye", true)
	end
	blush(m, 0.66, -0.12, -1.12, 0.36)
	-- Halo of glowing beads.
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		A(B(m, 0.24, cf(math.cos(a) * 0.62, 1.55, 0.15 + math.sin(a) * 0.62), gold))
	end
	A(B(m, 0.26, cf(0, 0.55, -1.1), gold))
end

SHAPES.hammerhead = function(m, c1, c2)
	SHAPES.shark(m, c1, c2)
	E(m, V(2.5, 0.42, 0.85), cf(0, 0.1, -1.55), c1)
	Build.eye(m, 0.36, cf(-1.15, 0.12, -1.55) * ang(0, rad(75), 0))
	Build.eye(m, 0.36, cf(1.15, 0.12, -1.55) * ang(0, rad(-75), 0))
end

SHAPES.dolphin = function(m, c1, c2)
	E(m, V(1.35, 1.35, 3.2), cf(0, 0.1, 0), c1)
	E(m, V(1.1, 0.8, 2.6), cf(0, -0.25, -0.1), c2)
	E(m, V(1.12, 1.05, 1.2), cf(0, 0.25, -1.1), c1)
	E(m, V(0.5, 0.42, 0.9), cf(0, -0.08, -1.78), c1)
	dorsal(m, 0.62, 0.3, 0.8, 0.9, c1)
	flukes(m, 1.85, 1.3, c1, 0.1)
	sideFins(m, 0.68, -0.3, -0.45, V(0.12, 0.35, 0.8), c1, 50)
	Build.eyes(m, CFrame.identity, 0.52, 0.2, -1.0, 0.38, 45)
	E(m, V(0.5, 0.08, 0.2), cf(0, -0.25, -1.6), DARK)
	blush(m, 0.55, -0.02, -1.08, 0.26)
end

SHAPES.whale = function(m, c1, c2)
	E(m, V(2.4, 2.1, 3.6), cf(0, 0, 0), c1)
	E(m, V(2.0, 1.2, 3.0), cf(0, -0.5, -0.2), c2)
	for i = -1, 1 do
		K(m, V(0.08, 0.06, 2.2), cf(i * 0.4, -1.02, -0.3), shade(c2))
	end
	E(m, V(0.95, 0.85, 1.1), cf(0, 0.1, 1.65), c1)
	flukes(m, 2.15, 1.3, c1, 0.2)
	for _, side in { -1, 1 } do
		A(E(m, V(0.22, 0.45, 1.2), cf(side * 1.2, -0.45, -0.35) * ang(0, rad(side * 25), rad(side * 35)), c1))
	end
	Build.eyes(m, CFrame.identity, 0.88, -0.02, -1.15, 0.42, 48)
	E(m, V(0.9, 0.1, 0.25), cf(0, -0.3, -1.72), DARK)
	blush(m, 0.95, -0.25, -1.1, 0.34)
end

SHAPES.narwhal = function(m, c1, c2)
	E(m, V(2.0, 1.8, 3.2), cf(0, 0, 0), c1)
	E(m, V(1.7, 1.0, 2.6), cf(0, -0.45, -0.2), light(c1))
	for _, p in { V(-0.45, 0.8, 0.2), V(0.35, 0.75, 0.7), V(0.1, 0.85, -0.4) } do
		E(m, V(0.3, 0.12, 0.3), cf(p), shade(c1))
	end
	local base = cf(0, 0.38, -1.55) * ang(rad(12), 0, 0)
	A(Build.cylinder(m, 0.8, 0.28, base * cf(0, 0, -0.4) * ang(0, rad(90), 0), c2))
	A(Build.cylinder(m, 0.7, 0.2, base * cf(0, 0, -1.1) * ang(0, rad(90), 0), c2))
	A(Build.cylinder(m, 0.6, 0.12, base * cf(0, 0, -1.72) * ang(0, rad(90), 0), c2))
	flukes(m, 1.95, 1.1, c1, 0.15)
	sideFins(m, 1.0, -0.4, -0.4, V(0.18, 0.4, 0.9), c1, 35)
	Build.eyes(m, CFrame.identity, 0.72, 0.05, -1.08, 0.4, 45)
	blush(m, 0.8, -0.2, -1.0, 0.3)
end

SHAPES.ray = function(m, c1, c2)
	E(m, V(2.0, 0.5, 2.4), cf(0, 0, 0), c1)
	for _, side in { -1, 1 } do
		E(m, V(2.3, 0.36, 1.4), cf(side * 1.05, 0, 0.15) * ang(0, rad(side * 25), rad(side * -6)), c1)
		E(m, V(0.32, 0.26, 0.62), cf(side * 0.55, 0, -1.25), c1)
	end
	E(m, V(1.8, 0.3, 2.0), cf(0, -0.14, 0), c2)
	Build.cylinder(m, 2.0, 0.12, cf(0, 0, 2.1) * ang(0, rad(90), 0), c1)
	for _, p in { V(-0.45, 0.24, 0.35), V(0.45, 0.24, 0.35), V(0, 0.26, 0.75) } do
		A(E(m, V(0.3, 0.1, 0.3), cf(p), c2))
	end
	Build.eyes(m, cf(0, 0.12, 0) * ang(rad(-20), 0, 0), 0.42, 0.14, -0.9, 0.36, 22)
	blush(m, 0.62, 0.1, -0.85, 0.24)
end

SHAPES.squid = function(m, c1, c2)
	E(m, V(1.2, 1.2, 2.6), cf(0, 0.1, 0.6), c1)
	for _, side in { -1, 1 } do
		A(E(m, V(0.9, 0.12, 0.8), cf(side * 0.55, 0.1, 1.6) * ang(0, rad(side * 30), 0), c2))
	end
	E(m, V(1.05, 1.0, 0.95), cf(0, 0.05, -0.75), c1)
	for i = -2, 2 do
		E(m, V(0.2, 0.2, 0.95), cf(i * 0.2, -0.32, -1.45) * ang(rad(25), 0, 0), c1)
	end
	for _, side in { -1, 1 } do
		E(m, V(0.16, 0.16, 1.5), cf(side * 0.3, -0.45, -1.7) * ang(rad(18), 0, 0), c1)
		A(E(m, V(0.28, 0.24, 0.4), cf(side * 0.3, -0.72, -2.4), c2))
	end
	for _, p in { V(-0.3, 0.45, 0.6), V(0.25, 0.5, 1.05), V(0, 0.55, 0.2) } do
		A(B(m, 0.18, cf(p), c2))
	end
	Build.eyes(m, CFrame.identity, 0.42, 0.18, -1.05, 0.52, 36)
end

SHAPES.angler = function(m, c1, c2)
	B(m, 2.2, cf(0, 0, 0), c1)
	E(m, V(1.5, 0.72, 0.42), cf(0, -0.45, -0.95), DARK)
	for i = -2, 2 do
		local up = W(m, V(0.12, 0.2, 0.1), cf(i * 0.26, -0.2, -1.12) * ang(0, 0, math.pi), WHITE)
		up:SetAttribute("Eye", true)
		local down = W(m, V(0.12, 0.18, 0.1), cf(i * 0.26 + 0.13, -0.72, -1.08), WHITE)
		down:SetAttribute("Eye", true)
	end
	Build.cylinder(m, 0.9, 0.1, cf(0, 1.35, -0.35) * ang(0, rad(90), rad(70)), shade(c1))
	Build.cylinder(m, 0.8, 0.1, cf(0, 1.62, -0.95) * ang(0, rad(90), rad(-10)), shade(c1))
	local lure = A(B(m, 0.5, cf(0, 1.45, -1.38), c2))
	lure.Material = Enum.Material.Neon
	Build.light(lure :: BasePart, c2, 10, 2)
	forkTail(m, 1.0, 0.8, 0.8, shade(c1))
	sideFins(m, 1.05, -0.1, 0, V(0.12, 0.45, 0.6), shade(c1))
	Build.eyes(m, CFrame.identity, 0.55, 0.4, -0.86, 0.44, 30)
end

SHAPES.eel = function(m, c1, c2)
	E(m, V(0.95, 0.85, 1.1), cf(0, 0.05, -1.6), c1)
	local count = 7
	for i = 1, count do
		local t = i / count
		local z = -1.2 + t * 3.0
		local x = math.sin(i * 0.9) * 0.35
		local size = 0.9 - t * 0.5
		B(m, size, cf(x, 0, z), c1)
		A(K(m, V(0.08, size * 0.5, 0.45), cf(x, size * 0.55, z), c2))
	end
	Build.eyes(m, CFrame.identity, 0.3, 0.25, -1.96, 0.36, 30)
	E(m, V(0.5, 0.08, 0.2), cf(0, -0.18, -2.12), DARK)
end

SHAPES.axolotl = function(m, c1, c2)
	E(m, V(1.3, 1.0, 2.2), cf(0, -0.1, 0.3), c1)
	E(m, V(1.65, 1.2, 1.25), cf(0, 0.05, -0.85), c1)
	for _, side in { -1, 1 } do
		for k = 0, 2 do
			A(E(m, V(0.2, 0.55, 0.2), cf(side * 0.85, 0.3 + k * 0.08, -0.62 + k * 0.2) * ang(0, 0, rad(side * (-40 - k * 25))), c2))
		end
		E(m, V(0.3, 0.2, 0.5), cf(side * 0.6, -0.55, -0.35), c1)
		E(m, V(0.3, 0.2, 0.5), cf(side * 0.55, -0.55, 0.9), c1)
	end
	E(m, V(0.2, 0.75, 1.5), cf(0, 0.05, 1.65), c1)
	A(E(m, V(0.14, 0.9, 1.2), cf(0, 0.1, 1.8), c2))
	Build.eyes(m, CFrame.identity, 0.5, 0.18, -1.4, 0.34, 30)
	E(m, V(0.6, 0.08, 0.2), cf(0, -0.15, -1.45), DARK)
	blush(m, 0.62, -0.08, -1.3, 0.26)
end

SHAPES.penguin = function(m, c1, c2)
	E(m, V(1.7, 2.3, 1.6), cf(0, 0, 0), c1)
	E(m, V(1.3, 1.85, 1.0), cf(0, -0.12, -0.36), c2)
	W(m, V(0.3, 0.24, 0.45), cf(0, 0.52, -0.92) * ang(rad(-10), 0, 0), ORANGE)
	for _, side in { -1, 1 } do
		E(m, V(0.5, 0.18, 0.7), cf(side * 0.4, -1.15, -0.35), ORANGE)
		E(m, V(0.22, 1.2, 0.6), cf(side * 0.9, -0.05, 0) * ang(0, 0, rad(side * 15)), c1)
	end
	Build.eyes(m, CFrame.identity, 0.3, 0.75, -0.66, 0.36, 20)
	blush(m, 0.46, 0.45, -0.72, 0.24)
end

SHAPES.seal = function(m, c1, c2)
	E(m, V(1.6, 1.5, 2.6), cf(0, -0.1, 0.3), c1)
	B(m, 1.5, cf(0, 0.35, -0.85), c1)
	E(m, V(0.82, 0.5, 0.5), cf(0, 0.15, -1.5), c2)
	B(m, 0.24, cf(0, 0.32, -1.72), DARK)
	for _, side in { -1, 1 } do
		E(m, V(0.6, 0.16, 0.9), cf(side * 0.75, -0.6, -0.3) * ang(0, rad(side * 25), rad(side * -20)), c1)
		A(W(m, V(0.5, 0.14, 0.6), cf(side * 0.3, -0.2, 1.75) * ang(0, rad(side * 20), 0), c2))
	end
	Build.eye(m, 0.5, cf(-0.36, 0.55, -1.4) * ang(0, rad(22), 0), Color3.fromRGB(20, 18, 24))
	Build.eye(m, 0.5, cf(0.36, 0.55, -1.4) * ang(0, rad(-22), 0), Color3.fromRGB(20, 18, 24))
	blush(m, 0.5, 0.18, -1.45, 0.26)
end

SHAPES.otter = function(m, c1, c2)
	E(m, V(1.4, 1.9, 1.3), cf(0, -0.2, 0), c1)
	E(m, V(1.0, 1.4, 0.8), cf(0, -0.25, -0.36), c2)
	B(m, 1.3, cf(0, 1.0, -0.1), c1)
	E(m, V(1.0, 0.7, 0.6), cf(0, 0.85, -0.5), c2)
	for _, side in { -1, 1 } do
		B(m, 0.34, cf(side * 0.5, 1.55, 0), shade(c1))
		B(m, 0.34, cf(side * 0.32, -0.05, -0.72), shade(c1))
	end
	A(E(m, V(0.5, 0.2, 0.5), cf(0, 0.0, -0.78) * ang(rad(70), 0, 0), Color3.fromRGB(255, 200, 210)))
	B(m, 0.22, cf(0, 0.95, -0.82), DARK)
	E(m, V(0.5, 0.25, 1.3), cf(0, -1.05, 0.8), shade(c1))
	Build.eyes(m, CFrame.identity, 0.28, 1.15, -0.6, 0.32, 20)
	blush(m, 0.42, 0.85, -0.68, 0.22)
end

SHAPES.serpent = function(m, c1, c2)
	local count = 9
	for i = 0, count - 1 do
		local t = i / (count - 1)
		local z = -1.6 + t * 3.6
		local x = math.sin(t * math.pi * 1.5) * 0.6
		local y = math.cos(t * math.pi * 2) * 0.35
		local size = 1.1 - t * 0.55
		B(m, size, cf(x, y, z), c1)
		A(B(m, size * 0.7, cf(x, y - size * 0.22, z - 0.05), c2))
		if i % 2 == 0 and i < count - 1 then
			Build.spike(m, size * 0.55, 0.12, cf(x, y + size * 0.5, z) * ang(rad(105), 0, 0), c2, true)
		end
	end
	E(m, V(1.2, 1.0, 1.4), cf(0, 0.2, -2.1), c1)
	E(m, V(0.9, 0.6, 0.72), cf(0, 0.05, -2.75), c1)
	for _, side in { -1, 1 } do
		local base = V(side * 0.35, 0.65, -1.9)
		Build.spike(m, 0.8, 0.16, Build.look(base, base + V(side * 0.3, 0.7, 1)), c2, true)
		A(Build.cylinder(m, 0.9, 0.06, cf(side * 0.55, -0.05, -2.95) * ang(0, rad(side * 60), rad(-15)), c2))
	end
	Build.eyes(m, CFrame.identity, 0.38, 0.45, -2.38, 0.4, 32)
end

SHAPES.slug = function(m, c1, c2)
	E(m, V(1.2, 0.8, 2.6), cf(0, 0, 0), c1)
	E(m, V(1.45, 0.3, 2.8), cf(0, -0.32, 0), light(c1))
	for i = 1, 6 do
		local z = -0.95 + i * 0.3
		for _, side in { -1, 1 } do
			A(E(m, V(0.24, 0.5, 0.24), cf(side * 0.35, 0.45, z) * ang(0, 0, rad(side * -20)), c2))
		end
	end
	for _, side in { -1, 1 } do
		A(Build.column(m, 0.5, 0.16, cf(side * 0.25, 0.55, -1.0) * ang(rad(-15), 0, 0), c2))
	end
	Build.eyes(m, CFrame.identity, 0.26, 0.2, -1.22, 0.3, 25)
	mouth(m, V(0, -0.1, -1.3), 0.22)
end

local RARITY_SIZE = { 2.3, 2.5, 2.8, 3.1, 3.5, 4.0 }

function PetModels.build(key: string, sizeOverride: number?): Model
	local pet = Worlds.pets[key]
	local model = Build.model("Pet_" .. key)
	if not pet then
		Build.ball(model, 2, CFrame.identity, Color3.new(1, 0, 1))
		return model
	end
	local c1, c2 = Color.hex(pet.color), Color.hex(pet.accent)
	local builder = SHAPES[pet.shape] or SHAPES.fish
	builder(model, c1, c2)
	Build.style(model, pet.style, c2)
	Build.fit(model, sizeOverride or RARITY_SIZE[pet.rarity] or 2.5)
	model:SetAttribute("PetKey", key)
	return model
end

PetModels.Shapes = SHAPES

return PetModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">RelicModels</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural relic (treasure) models, the Ancient Chest and pet eggs.

local Build = require(script.Parent.Build)
local Color = require(script.Parent.Parent.Color)
local Worlds = require(script.Parent.Parent.Data.Worlds)

local RelicModels = {}

local V = Vector3.new
local cf = CFrame.new
local ang = CFrame.Angles
local rad = math.rad
local E = Build.ellipsoid
local B = Build.ball
local K = Build.block
local W = Build.wedge
local A = Build.markAccent

local DARK = Color3.fromRGB(34, 30, 40)
local WOOD = Color3.fromRGB(120, 78, 44)
local GOLD = Color3.fromRGB(255, 205, 64)

local function fibonacci(count: number): { Vector3 }
	local points = {}
	local golden = math.pi * (3 - math.sqrt(5))
	for i = 0, count - 1 do
		-- Half-step offset keeps samples off the exact poles (a vertical look has no defined up).
		local y = 1 - ((i + 0.5) / count) * 2
		local r = math.sqrt(1 - y * y)
		local theta = golden * i
		table.insert(points, V(math.cos(theta) * r, y, math.sin(theta) * r))
	end
	return points
end

-- Disc facing -Z (cylinder axis along Z).
local function disc(m: Model, thickness: number, diameter: number, at: CFrame, color: Color3): Part
	return Build.cylinder(m, thickness, diameter, at * ang(0, rad(90), 0), color)
end

local SHAPES: { [string]: (Model, Color3, Color3) -> () } = {}

SHAPES.shell = function(m, c1, c2)
	for i = -3, 3 do
		local a = rad(i * 17)
		local rib = E(m, V(0.36, 1.4, 0.18), ang(0, 0, a) * cf(0, 0.58, 0), if i % 2 == 0 then c1 else Color.lighten(c1, 0.2))
		rib.Name = "Rib"
	end
	A(E(m, V(0.62, 0.36, 0.24), cf(0, -0.02, 0), c2))
	for _, side in { -1, 1 } do
		A(W(m, V(0.2, 0.3, 0.3), cf(side * 0.36, -0.05, 0) * ang(0, rad(side * 90), 0), c2))
	end
end

SHAPES.conch = function(m, c1, c2)
	for i = 0, 6 do
		local t = i / 6
		local a = t * math.pi * 4
		local r = 0.45 * (1 - t)
		B(m, 1.2 * (1 - t * 0.78), cf(math.cos(a) * r, t * 1.5 - 0.45, math.sin(a) * r), c1)
		if i < 5 then
			local reach = r + 0.5 * (1 - t)
			A(W(m, V(0.12, 0.3, 0.2), cf(math.cos(a) * reach, t * 1.5 - 0.3, math.sin(a) * reach), c2))
		end
	end
	A(E(m, V(0.85, 1.05, 0.3), cf(0.05, -0.2, -0.5) * ang(0, 0, rad(-12)), c2))
end

SHAPES.sanddollar = function(m, c1, c2)
	disc(m, 0.2, 1.6, CFrame.identity, c1)
	for i = 0, 4 do
		local a = rad(90 + i * 72)
		A(E(m, V(0.2, 0.5, 0.06), cf(math.cos(a) * 0.35, math.sin(a) * 0.35, -0.11) * ang(0, 0, a - rad(90)), c2))
	end
	A(B(m, 0.14, cf(0, 0, -0.1), c2))
end

SHAPES.starfish = function(m, c1, c2)
	E(m, V(1.1, 1.1, 0.5), CFrame.identity, c1)
	for i = 0, 4 do
		local a = rad(90 + i * 72)
		local dir = V(math.cos(a), math.sin(a), 0)
		E(m, V(0.62, 1.5, 0.42), CFrame.new(dir * 0.8) * ang(0, 0, a - rad(90)), c1)
		A(B(m, 0.16, cf(dir * 0.7 + V(0, 0, -0.2)), c2))
		A(B(m, 0.13, cf(dir * 1.1 + V(0, 0, -0.16)), c2))
	end
end

SHAPES.pearl = function(m, c1, c2)
	E(m, V(1.8, 0.5, 1.4), cf(0, -0.3, 0), c1)
	E(m, V(1.8, 0.5, 1.4), cf(0, 0.32, 0.45) * ang(rad(-52), 0, 0), c1)
	E(m, V(1.4, 0.2, 1.05), cf(0, -0.12, 0), Color.lighten(c1, 0.35))
	local pearl = A(B(m, 0.72, cf(0, 0.1, -0.12), c2))
	pearl.Reflectance = 0.25
	pearl.Material = Enum.Material.Glass
end

SHAPES.coin = function(m, c1, c2)
	for i = 0, 2 do
		Build.column(m, 0.16, 1.0, cf(0.1 * i, -0.45 + i * 0.17, 0.35), c1)
	end
	disc(m, 0.2, 1.3, cf(0, 0.25, -0.05) * ang(rad(-8), rad(15), 0), c1)
	A(disc(m, 0.22, 0.95, cf(0, 0.25, -0.07) * ang(rad(-8), rad(15), 0), c2))
	A(B(m, 0.35, cf(0.05, 0.25, -0.2), c1))
end

SHAPES.bottle = function(m, c1, c2)
	local tilt = ang(0, 0, rad(-18))
	local body = Build.column(m, 1.4, 0.82, tilt * cf(0, -0.2, 0), c1)
	body.Material = Enum.Material.Glass
	body.Transparency = 0.35
	local neck = Build.column(m, 0.55, 0.36, tilt * cf(0, 0.75, 0), c1)
	neck.Material = Enum.Material.Glass
	neck.Transparency = 0.35
	Build.column(m, 0.28, 0.32, tilt * cf(0, 1.12, 0), WOOD)
	A(Build.column(m, 0.9, 0.34, tilt * cf(0, -0.2, 0), c2))
end

SHAPES.compass = function(m, c1, c2)
	disc(m, 0.3, 1.5, CFrame.identity, c1)
	disc(m, 0.1, 1.2, cf(0, 0, -0.16), Color3.fromRGB(245, 240, 225))
	A(K(m, V(0.12, 0.9, 0.06), cf(0, 0, -0.22) * ang(0, 0, rad(30)), Color3.fromRGB(230, 60, 60)))
	K(m, V(0.12, 0.45, 0.06), cf(0.11, -0.19, -0.23) * ang(0, 0, rad(30)), Color3.fromRGB(240, 240, 240))
	B(m, 0.16, cf(0, 0, -0.26), c2)
	A(Build.cylinder(m, 0.2, 0.3, cf(0, 0.82, 0), c2))
end

SHAPES.key = function(m, c1, c2)
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		B(m, 0.24, cf(math.cos(a) * 0.36, 0.72 + math.sin(a) * 0.36, 0), c1)
	end
	A(B(m, 0.3, cf(0, 0.72, 0), c2))
	Build.column(m, 1.35, 0.2, cf(0, -0.25, 0), c1)
	K(m, V(0.36, 0.14, 0.16), cf(0.22, -0.72, 0), c1)
	K(m, V(0.26, 0.14, 0.16), cf(0.17, -0.48, 0), c1)
end

SHAPES.gem = function(m, c1, c2)
	local outer = K(m, V(1.05, 1.05, 1.05), ang(rad(45), rad(45), 0), c1)
	outer.Material = Enum.Material.Glass
	outer.Transparency = 0.2
	outer.Reflectance = 0.15
	A(K(m, V(0.55, 0.55, 0.55), ang(rad(45), rad(45), 0), c2))
	for i = 0, 3 do
		local a = rad(i * 90)
		local facet = W(m, V(0.4, 0.35, 0.4), cf(math.cos(a) * 0.5, 0.62, math.sin(a) * 0.5) * ang(0, -a + rad(90), 0), c1)
		facet.Material = Enum.Material.Glass
		facet.Transparency = 0.2
	end
end

SHAPES.crystal = function(m, c1, c2)
	E(m, V(1.3, 0.4, 1.0), cf(0, -0.7, 0), Color3.fromRGB(70, 66, 80))
	local spots = { { 0, 0, 1.4, 0 }, { -0.35, 0.05, 1.0, -22 }, { 0.38, -0.05, 1.1, 20 }, { 0.1, 0.3, 0.8, 8 }, { -0.15, -0.3, 0.75, -12 } }
	for index, spot in spots do
		local height = spot[3]
		local base = cf(spot[1], -0.55 + height / 2, spot[2]) * ang(rad(spot[2] * 30), 0, rad(spot[4]))
		local color = if index == 1 then c2 else c1
		local shaft = K(m, V(0.32, height, 0.32), base, color)
		shaft.Material = Enum.Material.Glass
		shaft.Transparency = 0.15
		A(shaft)
		Build.spike(m, 0.35, 0.32, base * cf(0, height / 2 + 0.17, 0) * ang(rad(90), 0, 0), color, true)
	end
end

SHAPES.orb = function(m, c1, c2)
	local orb = A(B(m, 1.1, cf(0, 0.25, 0), c1))
	orb.Material = Enum.Material.Glass
	orb.Transparency = 0.2
	A(B(m, 0.55, cf(0, 0.25, 0), c2))
	Build.column(m, 0.5, 0.55, cf(0, -0.55, 0), Color3.fromRGB(90, 80, 100))
	Build.column(m, 0.15, 0.8, cf(0, -0.82, 0), Color3.fromRGB(90, 80, 100))
	for i = 0, 2 do
		local a = rad(i * 120)
		W(m, V(0.14, 0.5, 0.25), cf(math.cos(a) * 0.45, -0.2, math.sin(a) * 0.45) * ang(0, -a, 0), Color3.fromRGB(110, 100, 120))
	end
end

SHAPES.idol = function(m, c1, c2)
	K(m, V(0.95, 1.35, 0.8), cf(0, 0.05, 0), c1)
	K(m, V(1.2, 0.3, 0.95), cf(0, -0.75, 0), Color.darken(c1, 0.2))
	for _, side in { -1, 1 } do
		A(B(m, 0.26, cf(side * 0.22, 0.25, -0.38), c2))
		K(m, V(0.34, 0.08, 0.1), cf(side * 0.22, 0.45, -0.4) * ang(0, 0, rad(side * -15)), Color.darken(c1, 0.35))
	end
	A(K(m, V(0.5, 0.14, 0.1), cf(0, -0.22, -0.41), c2))
	for i = -1, 1 do
		A(W(m, V(0.26, 0.5, 0.3), cf(i * 0.3, 0.95, 0) * ang(0, math.pi / 2, 0), c2))
	end
end

SHAPES.crown = function(m, c1, c2)
	local count = 12
	for i = 0, count - 1 do
		local a = i / count * math.pi * 2
		K(m, V(0.32, 0.42, 0.14), cf(math.cos(a) * 0.62, 0, math.sin(a) * 0.62) * ang(0, -a + math.pi / 2, 0), c1)
	end
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		local p = V(math.cos(a) * 0.62, 0.45, math.sin(a) * 0.62)
		Build.spike(m, 0.5, 0.22, cf(p) * ang(rad(90), 0, 0), c1)
		A(B(m, 0.2, cf(p + V(0, 0.32, 0)), c2))
	end
	A(B(m, 0.26, cf(0, 0, -0.66), c2))
end

SHAPES.trident = function(m, c1, c2)
	Build.column(m, 2.0, 0.14, cf(0, -0.3, 0), c1)
	K(m, V(0.85, 0.14, 0.14), cf(0, 0.72, 0), c1)
	for _, x in { -0.36, 0, 0.36 } do
		local length = if x == 0 then 0.75 else 0.55
		Build.column(m, length * 0.6, 0.12, cf(x, 0.8 + length * 0.3, 0), c1)
		Build.spike(m, 0.35, 0.18, cf(x, 0.8 + length * 0.6 + 0.17, 0) * ang(rad(90), 0, 0), c1)
	end
	A(B(m, 0.26, cf(0, 0.72, -0.05), c2))
end

SHAPES.vase = function(m, c1, c2)
	E(m, V(1.0, 1.3, 1.0), CFrame.identity, c1)
	Build.column(m, 0.5, 0.42, cf(0, 0.82, 0), c1)
	Build.column(m, 0.12, 0.62, cf(0, 1.08, 0), c1)
	Build.column(m, 0.22, 0.55, cf(0, -0.72, 0), c1)
	A(Build.column(m, 0.14, 1.03, cf(0, 0.1, 0), c2))
	for _, side in { -1, 1 } do
		E(m, V(0.12, 0.55, 0.3), cf(side * 0.52, 0.6, 0) * ang(0, 0, rad(side * 20)), c1)
	end
end

SHAPES.goblet = function(m, c1, c2)
	E(m, V(0.95, 0.75, 0.95), cf(0, 0.45, 0), c1)
	Build.column(m, 0.1, 1.0, cf(0, 0.78, 0), c1)
	Build.column(m, 0.7, 0.2, cf(0, -0.1, 0), c1)
	Build.column(m, 0.12, 0.85, cf(0, -0.5, 0), c1)
	for i = 0, 2 do
		local a = rad(i * 120 + 90)
		A(B(m, 0.18, cf(math.cos(a) * 0.46, 0.45, math.sin(a) * 0.46), c2))
	end
end

SHAPES.mask = function(m, c1, c2)
	E(m, V(1.3, 1.6, 0.36), CFrame.identity, c1)
	for _, side in { -1, 1 } do
		E(m, V(0.36, 0.2, 0.12), cf(side * 0.3, 0.2, -0.18) * ang(0, 0, rad(side * -12)), DARK)
		A(B(m, 0.16, cf(side * 0.42, -0.2, -0.17), c2))
		A(W(m, V(0.18, 0.6, 0.25), cf(side * 0.4, 0.95, 0) * ang(0, 0, rad(side * -18)), c2))
	end
	E(m, V(0.5, 0.12, 0.12), cf(0, -0.42, -0.18), DARK)
	A(W(m, V(0.2, 0.8, 0.3), cf(0, 1.05, 0), c2))
end

SHAPES.skull = function(m, c1, c2)
	for _, a in { 35, -35 } do
		Build.cylinder(m, 2.0, 0.16, cf(0, -0.05, 0.25) * ang(0, 0, rad(a)), c1)
	end
	B(m, 1.3, cf(0, 0.15, 0), c1)
	E(m, V(0.9, 0.45, 0.8), cf(0, -0.45, -0.1), c1)
	for _, side in { -1, 1 } do
		A(E(m, V(0.34, 0.4, 0.2), cf(side * 0.27, 0.15, -0.55), c2))
	end
	W(m, V(0.16, 0.18, 0.1), cf(0, -0.12, -0.62), DARK)
	for i = -1, 1 do
		K(m, V(0.12, 0.14, 0.06), cf(i * 0.16, -0.42, -0.5), Color.lighten(c1, 0.3))
	end
end

SHAPES.sword = function(m, c1, c2)
	local blade = K(m, V(0.34, 1.3, 0.1), cf(0, 0.45, 0), c1)
	blade.Material = Enum.Material.Metal
	blade.Reflectance = 0.2
	local tip = W(m, V(0.1, 0.55, 0.34), cf(0, 1.36, 0) * ang(0, rad(90), 0), c1)
	tip.Material = Enum.Material.Metal
	K(m, V(0.85, 0.14, 0.22), cf(0, -0.25, 0), GOLD)
	Build.column(m, 0.5, 0.18, cf(0, -0.58, 0), WOOD)
	A(B(m, 0.26, cf(0, -0.9, 0), c2))
end

SHAPES.chest = function(m, c1, c2)
	K(m, V(1.6, 0.9, 1.0), CFrame.identity, c1)
	Build.cylinder(m, 1.6, 1.0, cf(0, 0.45, 0), c1)
	for _, x in { -0.6, 0.6 } do
		A(K(m, V(0.14, 0.95, 1.04), cf(x, 0, 0), c2))
		A(Build.cylinder(m, 0.14, 1.04, cf(x, 0.45, 0), c2))
	end
	A(K(m, V(0.28, 0.32, 0.12), cf(0, 0.2, -0.54), c2))
	A(B(m, 0.12, cf(0, 0.15, -0.62), DARK))
end

SHAPES.coral = function(m, c1, c2)
	Build.column(m, 0.7, 0.34, cf(0, -0.6, 0), c1)
	local branches = { { 0, 30, 0.9 }, { 120, 38, 0.8 }, { 240, 28, 0.85 }, { 60, 10, 1.0 } }
	for _, b in branches do
		local yaw, tilt, length = rad(b[1]), rad(b[2]), b[3]
		local base = cf(0, -0.3, 0) * ang(0, yaw, 0) * ang(tilt, 0, 0)
		Build.column(m, length, 0.24, base * cf(0, length / 2, 0), c1)
		A(B(m, 0.3, base * cf(0, length, 0), c2))
	end
end

SHAPES.fossil = function(m, c1, c2)
	E(m, V(1.6, 1.6, 0.4), cf(0, 0, 0.12), Color.darken(c1, 0.35))
	for i = 0, 11 do
		local a = i * 0.6
		local r = 0.62 * math.exp(-0.14 * i)
		local size = 0.5 * math.exp(-0.09 * i)
		local part = B(m, size, cf(math.cos(a) * r, math.sin(a) * r, -0.12), if i % 3 == 0 then c2 else c1)
		if i % 3 == 0 then
			A(part)
		end
	end
end

SHAPES.brain = function(m, c1, c2)
	B(m, 1.5, CFrame.identity, c1)
	for i = 0, 5 do
		A(E(m, V(1.54, 0.12, 0.3), ang(rad(i * 30), rad(i * 47), rad(i * 19)), c2))
	end
end

SHAPES.tablet = function(m, c1, c2)
	K(m, V(1.2, 1.3, 0.26), cf(0, -0.15, 0), c1)
	disc(m, 0.26, 1.2, cf(0, 0.5, 0), c1)
	for row = 0, 3 do
		for col = -1, 1 do
			K(m, V(0.22, 0.08, 0.05), cf(col * 0.3, 0.35 - row * 0.25, -0.14), Color.darken(c1, 0.4))
		end
	end
	A(B(m, 0.26, cf(0, 0.62, -0.12), c2))
end

SHAPES.medallion = function(m, c1, c2)
	for i = 0, 7 do
		local a = rad(i * 45)
		A(W(m, V(0.12, 0.35, 0.3), cf(math.cos(a) * 0.82, math.sin(a) * 0.82, 0) * ang(0, rad(90), a - rad(90)), c1))
	end
	disc(m, 0.2, 1.45, CFrame.identity, c1)
	A(disc(m, 0.22, 0.95, cf(0, 0, -0.02), c2))
	A(B(m, 0.4, cf(0, 0, -0.14), c1))
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		B(m, 0.12, cf(math.cos(a) * 0.12, 0.9 + math.sin(a) * 0.12, 0), c1)
	end
end

SHAPES.geode = function(m, c1, c2)
	E(m, V(1.4, 1.25, 1.3), cf(0, 0, 0.12), c1)
	E(m, V(1.0, 0.9, 0.2), cf(0, 0, -0.52), DARK)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		local p = V(math.cos(a) * 0.3, math.sin(a) * 0.28, -0.55)
		Build.spike(m, 0.38, 0.16, Build.look(p, p + V(math.cos(a) * 0.3, math.sin(a) * 0.3, -1)), c2, true)
	end
	Build.spike(m, 0.4, 0.2, cf(0, 0, -0.55), c2, true)
end

SHAPES.urchin = function(m, c1, c2)
	B(m, 1.1, CFrame.identity, c1)
	for _, dir in fibonacci(20) do
		local p = dir * 0.5
		Build.spike(m, 0.7, 0.09, Build.look(p, p + dir) * cf(0, 0, -0.3), c2, true)
	end
end

SHAPES.float = function(m, c1, c2)
	local glass = B(m, 1.3, CFrame.identity, c1)
	glass.Material = Enum.Material.Glass
	glass.Transparency = 0.3
	for i = 0, 2 do
		A(E(m, V(1.36, 1.36, 0.07), ang(0, rad(i * 60), 0), c2))
	end
	A(E(m, V(1.36, 0.07, 1.36), CFrame.identity, c2))
	Build.column(m, 0.25, 0.3, cf(0, 0.72, 0), c2)
end

SHAPES.tooth = function(m, c1, c2)
	E(m, V(0.8, 1.4, 0.7), cf(0, -0.1, 0), c1)
	Build.spike(m, 0.9, 0.55, cf(0, 0.95, 0) * ang(rad(90), 0, 0), c1)
	for _, side in { -1, 1 } do
		A(E(m, V(0.3, 0.6, 0.3), cf(side * 0.2, -0.85, 0) * ang(0, 0, rad(side * 12)), c2))
	end
end

local RARITY_SIZE = { 1.5, 1.65, 1.8, 2.0, 2.3 }

function RelicModels.build(key: string, sizeOverride: number?): Model
	local relic = Worlds.relics[key]
	local model = Build.model("Relic_" .. key)
	if not relic then
		Build.ball(model, 1.5, CFrame.identity, Color3.new(1, 0, 1))
		return model
	end
	local c1, c2 = Color.hex(relic.color), Color.hex(relic.accent)
	local builder = SHAPES[relic.shape] or SHAPES.gem
	builder(model, c1, c2)
	Build.style(model, relic.style, c2)
	Build.fit(model, sizeOverride or RARITY_SIZE[relic.rarity] or 1.6)
	model:SetAttribute("RelicKey", key)
	return model
end

-- The world's Ancient Chest: bigger, gilded, with a glowing seam.
function RelicModels.buildChest(world: number, size: number?): Model
	local data = Worlds.get(world)
	local accent = Color.hex(data.accent[1])
	local model = Build.model("AncientChest")
	local wood = Color3.fromRGB(96, 60, 36)
	K(model, V(2.4, 1.3, 1.5), CFrame.identity, wood)
	Build.cylinder(model, 2.4, 1.5, cf(0, 0.65, 0), wood)
	for _, x in { -1.0, 0, 1.0 } do
		K(model, V(0.18, 1.36, 1.56), cf(x, 0, 0), GOLD).Material = Enum.Material.Metal
		Build.cylinder(model, 0.18, 1.56, cf(x, 0.65, 0), GOLD).Material = Enum.Material.Metal
	end
	local seam = K(model, V(2.46, 0.1, 1.56), cf(0, 0.66, 0), accent)
	seam.Material = Enum.Material.Neon
	local lock = K(model, V(0.45, 0.5, 0.16), cf(0, 0.35, -0.8), GOLD)
	lock.Material = Enum.Material.Metal
	local gem = B(model, 0.26, cf(0, 0.35, -0.9), accent)
	gem.Material = Enum.Material.Neon
	for _, corner in { V(-1.15, -0.6, -0.72), V(1.15, -0.6, -0.72), V(-1.15, -0.6, 0.72), V(1.15, -0.6, 0.72) } do
		K(model, V(0.3, 0.3, 0.3), cf(corner), GOLD).Material = Enum.Material.Metal
	end
	local root = model.PrimaryPart :: BasePart
	Build.light(root, accent, 14, 2.5)
	Build.sparkles(root, GOLD, 12)
	Build.fit(model, size or 4)
	return model
end

-- Pet egg for a world, decorated with spots in the egg's accent colour.
function RelicModels.buildEgg(world: number, size: number?): Model
	local data = Worlds.get(world)
	local c1, c2 = Color.hex(data.egg.color), Color.hex(data.egg.accent)
	local model = Build.model("Egg_" .. world)
	E(model, V(2.2, 2.8, 2.2), cf(0, 0, 0), c1)
	local rng = Random.new(world * 7919)
	for i = 1, 9 do
		local phi = math.acos(1 - 2 * (i - 0.5) / 9)
		local theta = rng:NextNumber(0, math.pi * 2)
		local normal = V(math.sin(phi) * math.cos(theta), math.cos(phi), math.sin(phi) * math.sin(theta))
		local p = V(normal.X * 1.08, normal.Y * 1.38, normal.Z * 1.08)
		local d = 0.45 + rng:NextNumber(0, 0.3)
		A(E(model, V(d, d, 0.14), Build.look(p, p + normal), c2))
	end
	A(E(model, V(2.24, 0.22, 2.24), cf(0, -0.2, 0), c2))
	Build.style(model, data.egg.style, c2)
	Build.fit(model, size or 3)
	return model
end

RelicModels.Shapes = SHAPES

return RelicModels
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Operators</string>
          <string name="Source"><![CDATA[--!strict
-- The game's Directors (Operators): the solo creator plus Config.AdminUserIds. They wear the red
-- nameplate and aura, stand outside the rankings and get their own statue by the egg.

local Config = require(script.Parent.Config)

local Operators = {}

function Operators.is(userId: number): boolean
	return (userId == game.CreatorId and game.CreatorType == Enum.CreatorType.User) or table.find(Config.AdminUserIds, userId) ~= nil
end

-- The community group (Config.GroupId, or the group that owns the experience); 0 when none.
function Operators.groupId(): number
	if Config.GroupId > 0 then
		return Config.GroupId
	end
	return if game.CreatorType == Enum.CreatorType.Group then game.CreatorId else 0
end

-- Every Director's UserId (the creator first when the experience is user-owned).
function Operators.list(): { number }
	local list = table.clone(Config.AdminUserIds)
	if game.CreatorType == Enum.CreatorType.User and game.CreatorId > 0 and not table.find(list, game.CreatorId) then
		table.insert(list, 1, game.CreatorId)
	end
	return list
end

return Operators
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Profile</string>
          <string name="Source"><![CDATA[--!strict
-- Player save data: defaults, validation and repair. Pure module (tested outside Roblox).

local Config = if script then require(script.Parent.Config) else require("./Config")
local Worlds = if script then require(script.Parent.Data.Worlds) else require("./Data/Worlds")
local Gear = if script then require(script.Parent.Data.Gear) else require("./Data/Gear")
local Economy = if script then require(script.Parent.Economy) else require("./Economy")

local Profile = {}

-- s = species key, l = locked, m = mutations (Config.Mutations keys, in the order gained)
export type PetEntry = { s: string, l: boolean?, m: { string }? }
export type GearData = { owned: { [string]: boolean }, equip: { [string]: string } }
export type WorldProgress = { sold: number, cleared: boolean, best: number }
export type Data = {
	v: number,
	coins: number,
	lifetime: number,
	world: number,
	unlocked: number,
	worlds: { [string]: WorldProgress },
	gear: GearData,
	enchants: number, -- Lucky Enchant tokens (developer product)
	redeemed: { [string]: boolean }, -- promo codes already claimed (see Config.PromoCodes)
	boostUntil: number, -- os.time() the TimedBoost product's 2x coins expires (0 = inactive)
	starterPackGranted: boolean, -- guards the one-time StarterPack pass grant
	groupRewarded: boolean, -- one-time reward for joining the community group
	daily: { last: number, streak: number }, -- UTC day index of the last daily claim (see Rewards)
	play: { day: number, seconds: number, claimed: { number } }, -- today's playtime + claimed tiers
	period: { week: number, weekBase: number, month: number, monthBase: number }, -- lifetime at period start (see Rankings)
	pets: { [string]: PetEntry },
	equipped: { string },
	petSeq: number,
	index: { [string]: boolean },
	relics: { [string]: number },
	backpack: { string },
	tutorial: number,
	settings: { music: boolean, sfx: boolean, lowFx: boolean, hidePets: boolean, lang: string },
	stats: { dives: number, relics: number, blackouts: number, hatched: number, playtime: number },
	receipts: { string },
	created: number,
	seen: number,
}

function Profile.new(now: number): Data
	return {
		v = Config.SchemaVersion,
		coins = 0,
		lifetime = 0,
		world = 1,
		unlocked = 1,
		worlds = {},
		gear = { owned = {}, equip = {} },
		enchants = 0,
		redeemed = {},
		boostUntil = 0,
		starterPackGranted = false,
		groupRewarded = false,
		daily = { last = 0, streak = 0 },
		play = { day = 0, seconds = 0, claimed = {} },
		period = { week = 0, weekBase = 0, month = 0, monthBase = 0 },
		pets = {},
		equipped = {},
		petSeq = 0,
		index = {},
		relics = {},
		backpack = {},
		tutorial = 1,
		settings = { music = true, sfx = true, lowFx = false, hidePets = false, lang = Config.DefaultLanguage },
		stats = { dives = 0, relics = 0, blackouts = 0, hatched = 0, playtime = 0 },
		receipts = {},
		created = now,
		seen = now,
	}
end

local function number(value: any, fallback: number, min: number?, max: number?): number
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	if min and value < min then
		return min
	end
	if max and value > max then
		return max
	end
	return value
end

local function bool(value: any, fallback: boolean): boolean
	if type(value) == "boolean" then
		return value
	end
	return fallback
end

-- Returns a repaired copy of stored data (or a fresh profile). Never errors on bad input.
function Profile.reconcile(raw: any, now: number): Data
	local fresh = Profile.new(now)
	if type(raw) ~= "table" then
		return fresh
	end
	local data = fresh
	data.coins = math.floor(number(raw.coins, 0, 0))
	data.lifetime = math.floor(number(raw.lifetime, data.coins, 0))
	data.unlocked = math.floor(number(raw.unlocked, 1, 1, Config.WorldCount))
	data.world = math.floor(number(raw.world, 1, 1, data.unlocked))
	if type(raw.worlds) == "table" then
		for key, entry in raw.worlds do
			local index = tonumber(key)
			if index and index >= 1 and index <= Config.WorldCount and type(entry) == "table" then
				data.worlds[tostring(math.floor(index))] = {
					sold = math.floor(number(entry.sold, 0, 0)),
					cleared = bool(entry.cleared, false),
					best = number(entry.best, 0, 0),
				}
			end
		end
	end
	if type(raw.gear) == "table" then
		if type(raw.gear.owned) == "table" then
			for key, value in raw.gear.owned do
				if type(key) == "string" and Gear.byKey[key] and value == true then
					data.gear.owned[key] = true
				end
			end
		end
		if type(raw.gear.equip) == "table" then
			for _, slot in Gear.Slots do
				local key = raw.gear.equip[slot]
				local item = if type(key) == "string" then Gear.byKey[key] else nil
				if item and item.slot == slot and data.gear.owned[key] then
					data.gear.equip[slot] = key
				end
			end
		end
	elseif type(raw.upgrades) == "table" then
		-- Saves from before gear: grant the best piece whose stat the old upgrade level covered.
		for _, slot in Gear.Slots do
			local level = number(raw.upgrades[slot], 1, 1)
			for _, item in Gear.bySlot[slot] do
				if Economy.gearLevel(slot, item.tier) <= level + 1e-6 then
					data.gear.owned[item.key] = true
					data.gear.equip[slot] = item.key
				end
			end
		end
	end
	data.enchants = math.floor(number(raw.enchants, 0, 0, 9999))
	if type(raw.redeemed) == "table" then
		for key, value in raw.redeemed do
			if type(key) == "string" and value == true then
				data.redeemed[string.upper(key)] = true
			end
		end
	end
	data.boostUntil = number(raw.boostUntil, 0, 0)
	data.starterPackGranted = bool(raw.starterPackGranted, false)
	data.groupRewarded = bool(raw.groupRewarded, false)
	if type(raw.daily) == "table" then
		data.daily.last = math.floor(number(raw.daily.last, 0, 0))
		data.daily.streak = math.floor(number(raw.daily.streak, 0, 0))
	end
	if type(raw.period) == "table" then
		for key in data.period do
			(data.period :: any)[key] = math.floor(number(raw.period[key], 0, 0))
		end
	end
	if type(raw.play) == "table" then
		data.play.day = math.floor(number(raw.play.day, 0, 0))
		data.play.seconds = number(raw.play.seconds, 0, 0)
		if type(raw.play.claimed) == "table" then
			for _, tier in raw.play.claimed do
				if type(tier) == "number" and Config.PlaytimeRewards[tier] and not table.find(data.play.claimed, tier) then
					table.insert(data.play.claimed, tier)
				end
			end
		end
	end
	local count = 0
	if type(raw.pets) == "table" then
		for id, entry in raw.pets do
			if
				type(id) == "string"
				and type(entry) == "table"
				and type(entry.s) == "string"
				and Worlds.pets[entry.s]
				and count < Config.PetInventoryCap
			then
				local mutations: { string }? = nil
				if type(entry.m) == "table" then
					local list = {}
					for _, key in entry.m do
						if type(key) == "string" and Economy.Mutations[key] and not table.find(list, key) then
							table.insert(list, key)
						end
					end
					if #list > 0 then
						mutations = list
					end
				end
				data.pets[id] = { s = entry.s, l = entry.l == true, m = mutations }
				count += 1
			end
		end
	end
	if type(raw.equipped) == "table" then
		local seen = {}
		for _, id in raw.equipped do
			if type(id) == "string" and data.pets[id] and not seen[id] and #data.equipped < Config.PetEquipBase + Config.PetEquipPass then
				seen[id] = true
				table.insert(data.equipped, id)
			end
		end
	end
	data.petSeq = math.floor(number(raw.petSeq, count, 0))
	if type(raw.index) == "table" then
		for key, value in raw.index do
			if type(key) == "string" and Worlds.pets[key] and value == true then
				data.index[key] = true
			end
		end
	end
	for _, entry in data.pets do
		data.index[entry.s] = true
	end
	if type(raw.relics) == "table" then
		for key, value in raw.relics do
			if type(key) == "string" and Worlds.relics[key] then
				data.relics[key] = math.floor(number(value, 0, 0))
			end
		end
	end
	-- Unsold treasure carried between dives (sold only at a world's sell stand).
	if type(raw.backpack) == "table" then
		for _, key in raw.backpack do
			if type(key) == "string" and Worlds.relics[key] and #data.backpack < Config.BackpackHardCap then
				table.insert(data.backpack, key)
			end
		end
	end
	data.tutorial = math.floor(number(raw.tutorial, 1, 0, 99))
	if type(raw.settings) == "table" then
		local s = raw.settings
		data.settings.music = bool(s.music, true)
		data.settings.sfx = bool(s.sfx, true)
		data.settings.lowFx = bool(s.lowFx, false)
		data.settings.hidePets = bool(s.hidePets, false)
		if s.lang == "en" or s.lang == "ko" then
			data.settings.lang = s.lang
		end
	end
	if type(raw.stats) == "table" then
		for key in data.stats do
			(data.stats :: any)[key] = number(raw.stats[key], 0, 0)
		end
	end
	if type(raw.receipts) == "table" then
		for _, receipt in raw.receipts do
			if type(receipt) == "string" and #data.receipts < 60 then
				table.insert(data.receipts, receipt)
			end
		end
	end
	data.created = number(raw.created, now)
	data.seen = now
	return data
end

function Profile.progress(data: Data, world: number): WorldProgress
	local key = tostring(world)
	local entry = data.worlds[key]
	if not entry then
		entry = { sold = 0, cleared = false, best = 0 }
		data.worlds[key] = entry
	end
	return entry
end

-- Adds a pet (optionally with mutations) and returns its id. Ignores the inventory cap: callers
-- that grant paid pets must always deliver.
function Profile.addPet(data: Data, key: string, mutations: { string }?): string
	data.petSeq += 1
	local id = "P" .. tostring(data.petSeq)
	data.pets[id] = { s = key, l = false, m = if mutations then table.clone(mutations) else nil }
	data.index[key] = true
	return id
end

function Profile.petCount(data: Data): number
	local count = 0
	for _ in data.pets do
		count += 1
	end
	return count
end

return Profile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Rankings</string>
          <string name="Source"><![CDATA[--!strict
-- Ranking boards (weekly / monthly / all-time coins earned) and hold-time tiers. Pure module.
-- Weeks start Monday 00:00 UTC; months on the 1st, 00:00 UTC.

local Config = if script then require(script.Parent.Config) else require("./Config")
local Format = if script then require(script.Parent.Format) else require("./Format")

local Rankings = {}

local DAY = 86400

Rankings.Boards = { "weekly", "monthly", "alltime" }

export type Holds = { w: number, m: number } -- seconds spent in a top-3 spot, weekly / monthly

function Rankings.weekId(now: number): number
	-- Day 0 (1970-01-01) was a Thursday; +3 makes weeks roll over on Mondays.
	return (now // DAY + 3) // 7
end

function Rankings.monthId(now: number): number
	local y, m = Format.ymd(now)
	return y * 12 + (m - 1)
end

-- Seconds until the board's period resets (nil for the all-time board).
function Rankings.untilReset(board: string, now: number): number?
	if board == "weekly" then
		return (Rankings.weekId(now) + 1) * 7 * DAY - 3 * DAY - now
	elseif board == "monthly" then
		local current = Rankings.monthId(now)
		local day = now // DAY + 1
		while Rankings.monthId(day * DAY) == current do
			day += 1
		end
		return day * DAY - now
	end
	return nil
end

-- Starts a new week/month when needed; returns this week's and month's coins earned.
function Rankings.roll(data: any, now: number): (number, number)
	local period = data.period
	local week, month = Rankings.weekId(now), Rankings.monthId(now)
	if period.week ~= week then
		period.week = week
		period.weekBase = data.lifetime
	end
	if period.month ~= month then
		period.month = month
		period.monthBase = data.lifetime
	end
	return math.max(0, data.lifetime - period.weekBase), math.max(0, data.lifetime - period.monthBase)
end

local function held(holds: Holds, board: string): number
	return if board == "monthly" then holds.m else holds.w
end

-- Highest tier earned (0 = none).
function Rankings.tier(holds: Holds): number
	local best = 0
	for index, tier in Config.Tiers do
		if held(holds, tier.board) >= tier.hours * 3600 then
			best = index
		end
	end
	return best
end

-- The next tier a diver is working towards on `board` and the seconds of top-3 time still
-- needed. The all-time board shows the next tier of any kind. nil when nothing is left.
function Rankings.nextTier(holds: Holds, board: string): (number?, number?)
	for index, tier in Config.Tiers do
		if (board == "alltime" or tier.board == board) and held(holds, tier.board) < tier.hours * 3600 then
			return index, tier.hours * 3600 - held(holds, tier.board)
		end
	end
	return nil, nil
end

return Rankings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
