Decor.Kits = KITS

function Decor.palette(world: number): Pal
	local data = Worlds.get(world)
	local corals = {}
	for _, hex in data.fish do
		table.insert(corals, Color.hex(hex))
	end
	table.insert(corals, Color.hex(data.accent[1]))
	local land = Color.hex(data.terrain.landColor)
	return {
		a1 = Color.hex(data.accent[1]),
		a2 = Color.hex(data.accent[2]),
		corals = corals,
		rock = Color.hex(data.terrain.rockColor),
		land = land,
		sand = Color.hex(data.terrain.beachColor),
		leaf = if data.kit == "candy" then Color3.fromRGB(120, 230, 150) else Color.darken(land, 0.1):Lerp(Color3.fromRGB(60, 170, 70), 0.4),
		wood = Color3.fromRGB(128, 86, 54),
		bone = Color3.fromRGB(238, 230, 212),
		glow = data.fishGlow,
	}
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Include
raycastParams.IgnoreWater = true

local function groundAt(position: Vector3, depth: number): RaycastResult?
	raycastParams.FilterDescendantsInstances = { Workspace.Terrain }
	return Workspace:Raycast(position, Vector3.new(0, -depth, 0), raycastParams)
end

-- Random land spot on the island ring, away from the dock.
local function landSpot(ctx: Ctx): CFrame?
	local info = ctx.info
	for _ = 1, 12 do
		local a = ctx.rng:NextNumber(0, math.pi * 2)
		local r = ctx.rng:NextNumber(info.radius + 9, info.islandRadius - 10)
		local lx, lz = math.cos(a) * r, math.sin(a) * r
		local nearDock = math.abs(lx) < 56 and lz > info.radius - 4 and lz < info.radius + 64
		if not nearDock then
			local hit = groundAt(info.origin + Vector3.new(lx, 90, lz), 140)
			if hit and hit.Position.Y > 0.5 then
				return CFrame.new(hit.Position)
			end
		end
	end
	return nil
end

local function floorSpot(ctx: Ctx, band: string): CFrame?
	local info = ctx.info
	local inner, outer
	if band == "shelf" then
		inner, outer = info.midRadius + 2, info.radius - 3
	elseif band == "mid" then
		inner, outer = info.deepRadius + 2, info.midRadius - 3
	else
		inner, outer = 0, info.deepRadius - 4
	end
	for _ = 1, 10 do
		local a = ctx.rng:NextNumber(0, math.pi * 2)
		local r = ctx.rng:NextNumber(inner, math.max(inner + 1, outer))
		local lx, lz = math.cos(a) * r, math.sin(a) * r
		local hit = groundAt(info.origin + Vector3.new(lx, -1, lz), info.depth + 20)
		if hit then
			local up = hit.Normal:Lerp(Vector3.yAxis, 0.6).Unit
			local right = up:Cross(Vector3.zAxis)
			if right.Magnitude < 0.01 then
				right = Vector3.xAxis
			end
			return CFrame.fromMatrix(hit.Position, right.Unit, up)
		end
	end
	return nil
end

function Decor.build(world: number, parent: Instance, rng: Random)
	local data = Worlds.get(world)
	local kit = KITS[data.kit] or KITS.tropical
	local ctx: Ctx = {
		parent = parent,
		rng = rng,
		pal = Decor.palette(world),
		world = world,
		info = Layout.info(world),
		lights = 0,
		maxLights = MAX_LIGHTS,
	}
	local function place(entries: { [string]: number }, spot: (Ctx) -> CFrame?)
		local names = {}
		for name in entries do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in names do
			local builder = E[name]
			if builder then
				for _ = 1, entries[name] do
					local at = spot(ctx)
					if at then
						builder(ctx, at)
					end
				end
			end
		end
	end
	place(kit.land, landSpot)
	task.wait()
	place(kit.shelf, function(c)
		return floorSpot(c, "shelf")
	end)
	place(kit.mid, function(c)
		return floorSpot(c, "mid")
	end)
	place(kit.deep, function(c)
		return floorSpot(c, "deep")
	end)
	if kit.set and E[kit.set] then
		E[kit.set](ctx, CFrame.new(ctx.info.origin))
	end
end

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Dock</string>
            <string name="Source"><![CDATA[--!strict
-- The dock on the lagoon rim: spawn deck, pier + diving board, egg stand, upgrade kiosk, travel
-- portal and the island boundary. Prompt UI and sign text are rendered by the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Build = require(Shared.Models.Build)
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Mutations = require(Shared.Models.Mutations)
local PetModels = require(Shared.Models.PetModels)
local RelicModels = require(Shared.Models.RelicModels)
local Worlds = require(Shared.Data.Worlds)

local Dock = {}

local V = Vector3.new
local cf = CFrame.new
local ang = CFrame.Angles
local rad = math.rad

local WOOD = Color3.fromRGB(150, 104, 66)
local WOOD_DARK = Color3.fromRGB(104, 70, 44)

local function solid(part: BasePart): BasePart
	part.CanCollide = true
	part.CanQuery = true
	part.CastShadow = true
	return part
end

local function plankRow(parent: Instance, from: Vector3, to: Vector3, width: number, y: number)
	local dir = to - from
	local length = dir.Magnitude
	local count = math.max(1, math.floor(length / 2))
	local step = length / count
	local look = CFrame.lookAt(from, to).Rotation
	for i = 0, count - 1 do
		local center = from + dir.Unit * (step * (i + 0.5))
		local plank =
			Build.block(parent, V(width, 0.5, step - 0.15), cf(center.X, y, center.Z) * look, if i % 3 == 0 then Color.darken(WOOD, 0.08) else WOOD)
		plank.Material = Enum.Material.WoodPlanks
		solid(plank)
	end
end

local function prompt(parent: BasePart, kind: string, world: number, action: string, object: string, distance: number?)
	local p = Instance.new("ProximityPrompt")
	p.Name = kind .. "Prompt"
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = distance or 12
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Custom
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p:SetAttribute("Kind", kind)
	p:SetAttribute("World", world)
	p.Parent = parent
	return p
end

local function anchorPart(parent: Instance, name: string, at: CFrame, size: Vector3?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size or V(1, 1, 1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CFrame = at
	part.Parent = parent
	return part
end

local function lamp(parent: Instance, at: CFrame, color: Color3)
	Build.column(parent, 5, 0.3, at * cf(0, 2.5, 0), Color3.fromRGB(60, 56, 64))
	local head = Build.block(parent, V(1, 1.2, 1), at * cf(0, 5.4, 0), color)
	head.Material = Enum.Material.Neon
	Build.block(parent, V(1.4, 0.25, 1.4), at * cf(0, 6.1, 0), Color3.fromRGB(60, 56, 64))
	Build.light(head, color, 16, 1.2)
end

function Dock.build(world: number, parent: Instance): SpawnLocation
	local info = Layout.info(world)
	local data = Worlds.get(world)
	local o = info.origin
	local dock = Layout.dock(world)
	local accent = Color.hex(data.accent[1])
	local accent2 = Color.hex(data.accent[2])
	local landY = info.landY
	local folder = Instance.new("Folder")
	folder.Name = "Dock"
	folder.Parent = parent

	local function at(local3: Vector3, yOffset: number?): CFrame
		return cf(o + V(local3.X, local3.Y + (yOffset or 0), local3.Z))
	end
	local facing = ang(0, 0, 0) -- dock structures face -Z (toward the lagoon)

	-- Spawn deck with a glowing ring.
	local deck = Build.block(folder, V(20, 0.6, 22), at(dock.spawn, 0.25) * cf(0, 0, -2), WOOD)
	deck.Material = Enum.Material.WoodPlanks
	solid(deck)
	local pad = Build.column(folder, 0.3, 9, at(dock.spawn, 0.7), Color.lighten(accent, 0.6))
	pad.Material = Enum.Material.SmoothPlastic
	local ring = Build.column(folder, 0.32, 9.6, at(dock.spawn, 0.68), accent)
	ring.Material = Enum.Material.Neon
	-- Boardwalk to the beach and to the pier.
	plankRow(folder, o + V(0, 0, dock.spawn.Z - 12), o + V(0, 0, info.radius + 15), 8, landY + 0.25)
	plankRow(folder, o + V(10, 0, dock.spawn.Z - 6), o + V(dock.pierStart.X, 0, dock.pierStart.Z + 6), 5, landY + 0.25)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Size = V(8, 1, 8)
	spawn.CFrame = at(dock.spawn, 1.1) * facing
	spawn.Anchored = true
	spawn.CanCollide = false
	spawn.CanQuery = false
	spawn.CanTouch = false
	spawn.Transparency = 1
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Enabled = true
	spawn:SetAttribute("World", world)
	spawn.Parent = folder
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end

	-- Pier over the lagoon with posts, lamps and a diving board.
	local pierY = landY + 1.2
	plankRow(folder, o + V(dock.pierStart.X, 0, dock.pierStart.Z), o + V(dock.pierEnd.X, 0, dock.pierEnd.Z), 8, pierY)
	local z = dock.pierStart.Z
	while z >= dock.pierEnd.Z do
		for _, side in { -1, 1 } do
			local post = Build.column(folder, 14, 0.8, cf(o + V(dock.pierStart.X + side * 3.6, pierY - 7, z)), WOOD_DARK)
			solid(post)
		end
		z -= 7
	end
	for _, side in { -1, 1 } do
		lamp(folder, cf(o + V(dock.pierStart.X + side * 3.4, pierY + 0.25, dock.pierEnd.Z + 4)), Color3.fromRGB(255, 214, 140))
	end
	local boardBase = o + V(dock.pierEnd.X, pierY + 0.9, dock.pierEnd.Z - 5)
	local board = Build.block(folder, V(2.6, 0.4, 8), cf(boardBase) * ang(rad(-4), 0, 0), Color3.fromRGB(245, 248, 252))
	solid(board)
	local stripe = Build.block(folder, V(2.64, 0.42, 1), cf(boardBase) * ang(rad(-4), 0, 0) * cf(0, 0, -3.4), accent)
	solid(stripe)
	solid(Build.block(folder, V(2, 1.2, 1.4), cf(o + V(dock.pierEnd.X, pierY + 0.35, dock.pierEnd.Z - 1)), Color3.fromRGB(80, 90, 110)))

	-- Egg stand.
	local eggBase = at(dock.egg)
	local pedestal = Build.column(folder, 1.6, 7, eggBase * cf(0, 0.8, 0), Color3.fromRGB(245, 245, 250))
	solid(pedestal)
	local trim = Build.column(folder, 0.4, 7.4, eggBase * cf(0, 1.55, 0), accent)
	trim.Material = Enum.Material.Neon
	Build.column(folder, 0.9, 5.6, eggBase * cf(0, 2.0, 0), accent2)
	local egg = RelicModels.buildEgg(world, 5.2)
	egg.Name = "DisplayEgg"
	egg:PivotTo(eggBase * cf(0, 5.6, 0))
	egg:SetAttribute("Spin", 0.6)
	egg.Parent = folder
	local eggAnchor = anchorPart(folder, "EggAnchor", eggBase * cf(0, 5.6, 0), V(4, 5, 4))
	eggAnchor:SetAttribute("World", world)
	prompt(eggAnchor, "Egg", world, "Hatch", data.egg.name.en, 14)

	-- Upgrade kiosk: counter, posts and a striped awning.
	local spawnFlat = o + V(dock.spawn.X, landY, dock.spawn.Z)
	local kioskPosition = o + V(dock.kiosk.X, landY, dock.kiosk.Z)
	local kiosk = CFrame.lookAt(kioskPosition, spawnFlat)
	local counter = Build.block(folder, V(10, 3.4, 3.6), kiosk * cf(0, 1.7, 0), Color3.fromRGB(245, 240, 232))
	solid(counter)
	Build.block(folder, V(10.4, 0.4, 4), kiosk * cf(0, 3.6, 0), accent2)
	for _, x in { -4.6, 4.6 } do
		solid(Build.column(folder, 8, 0.6, kiosk * cf(x, 4, 1.4), Color3.fromRGB(245, 245, 250)))
	end
	for i = 0, 5 do
		local stripeColor = if i % 2 == 0 then accent else Color3.fromRGB(255, 255, 255)
		Build.wedge(folder, V(1.84, 1.4, 5), kiosk * cf(-4.6 + i * 1.84, 8.4, 0.4), stripeColor)
	end
	local kioskSign = Build.block(folder, V(7, 2.2, 0.3), kiosk * cf(0, 10.2, 1.2), Color3.fromRGB(40, 44, 60))
	kioskSign.Name = "KioskSign"
	kioskSign:SetAttribute("World", world)
	local kioskAnchor = anchorPart(folder, "KioskAnchor", kiosk * cf(0, 3, -2), V(8, 4, 3))
	prompt(kioskAnchor, "Kiosk", world, "Gear", "Gear Shop", 12)

	-- Travel portal behind the spawn.
	local portalPosition = o + V(dock.portal.X, landY, dock.portal.Z)
	local portal = CFrame.lookAt(portalPosition, spawnFlat)
	for i = 0, 19 do
		local a = i / 20 * math.pi * 2
		local seg = Build.block(
			folder,
			V(1.9, 1.6, 1.4),
			portal * cf(math.cos(a) * 6.4, 7.5 + math.sin(a) * 6.4, 0) * ang(0, 0, a),
			if i % 2 == 0 then Color3.fromRGB(245, 245, 250) else accent
		)
		solid(seg)
	end
	local swirl = Build.cylinder(folder, 0.4, 11.6, portal * cf(0, 7.5, 0) * ang(0, rad(90), 0), accent)
	swirl.Material = Enum.Material.Neon
	swirl.Transparency = 0.35
	swirl.Name = "PortalSwirl"
	swirl:SetAttribute("Spin", 1)
	Build.light(swirl, accent, 18, 1.5)
	for i = 0, 2 do
		local step = Build.block(folder, V(10 - i * 1.5, 0.5, 3.6 - i * 0.6), portal * cf(0, 0.25 + i * 0.5, 0), Color3.fromRGB(235, 235, 242))
		solid(step)
	end
	local portalAnchor = anchorPart(folder, "PortalAnchor", portal * cf(0, 4, 0), V(10, 8, 3))
	prompt(portalAnchor, "Portal", world, "Travel", "World Portal", 14)

	-- World sign facing the spawn.
	local signPosition = o + V(dock.spawn.X - 16, landY, dock.spawn.Z - 12)
	local signAt = CFrame.lookAt(signPosition, spawnFlat)
	for _, x in { -3.2, 3.2 } do
		solid(Build.column(folder, 6, 0.5, signAt * cf(x, 3, 0), WOOD_DARK))
	end
	local sign = Build.block(folder, V(8, 3.6, 0.4), signAt * cf(0, 5.2, 0), Color3.fromRGB(38, 42, 58))
	sign.Name = "WorldSign"
	sign:SetAttribute("World", world)
	solid(sign)
	local signTrim = Build.block(folder, V(8.4, 4, 0.3), signAt * cf(0, 5.2, 0.1), accent)
	signTrim.Material = Enum.Material.Neon

	-- Sell stand: a glowing gold pad (stepping on it sells the backpack) in front of a market
	-- stall. The server sells by distance to dock.sell; the pad is the visual.
	local sellPosition = o + V(dock.sell.X, landY, dock.sell.Z)
	local sell = CFrame.lookAt(sellPosition, spawnFlat)
	local GOLD = Color3.fromRGB(255, 208, 72)
	local GOLD_DARK = Color3.fromRGB(196, 132, 28)
	local sellRim = Build.column(folder, 0.34, Config.SellRadius * 2, sell * cf(0, 0.3, 0), GOLD_DARK)
	solid(sellRim)
	local sellPad = Build.column(folder, 0.36, Config.SellRadius * 2 - 1.6, sell * cf(0, 0.34, 0), GOLD)
	sellPad.Name = "SellPad"
	sellPad.Material = Enum.Material.Neon
	sellPad.Transparency = 0.2
	sellPad:SetAttribute("World", world)
	Build.light(sellPad, GOLD, 16, 1.4)
	local stall = sell * cf(0, 0, 7)
	solid(Build.block(folder, V(12, 3.4, 3.6), stall * cf(0, 1.7, 0), Color3.fromRGB(250, 244, 230)))
	Build.block(folder, V(12.4, 0.4, 4), stall * cf(0, 3.6, 0), GOLD_DARK)
	for _, x in { -5.6, 5.6 } do
		solid(Build.column(folder, 8, 0.6, stall * cf(x, 4, 1.2), Color3.fromRGB(245, 245, 250)))
	end
	for i = 0, 6 do
		local stripeColor = if i % 2 == 0 then Color3.fromRGB(76, 200, 110) else Color3.fromRGB(255, 255, 255)
		Build.wedge(folder, V(1.8, 1.4, 5), stall * cf(-5.4 + i * 1.8, 8.4, 0.2), stripeColor)
	end
	-- Coin piles and a treasure chest on the counter.
	for i, offset in { V(-3.6, 3.95, 0), V(-2.4, 3.95, 0.6), V(3.2, 3.95, -0.3) } do
		for layer = 0, 2 - (i - 1) % 2 do
			local coin = Build.cylinder(folder, 0.3, 1.2, stall * cf(offset + V(0, layer * 0.3, 0)) * ang(0, 0, rad(90)), GOLD)
			coin.Material = Enum.Material.Metal
		end
	end
	local counterChest = RelicModels.buildChest(world, 2.2)
	counterChest:PivotTo(stall * cf(0.6, 4.9, 0) * ang(0, math.pi, 0))
	counterChest.Parent = folder
	local sellSign = Build.block(folder, V(8, 2.4, 0.3), stall * cf(0, 10.3, 0.4), Color3.fromRGB(40, 44, 60))
	sellSign.Name = "SellSign"
	local sellAnchor = anchorPart(folder, "SellAnchor", sell * cf(0, 3, 0), V(6, 4, 6))
	prompt(sellAnchor, "Sell", world, "Sell", "Treasure Shop", Config.SellRadius + 4)

	-- Global leaderboard board (the client draws the rankings on BoardScreen).
	local boardPosition = o + V(dock.board.X, landY, dock.board.Z)
	local boardAt = CFrame.lookAt(boardPosition, spawnFlat)
	for _, x in { -8.6, 8.6 } do
		solid(Build.column(folder, 16, 1, boardAt * cf(x, 8, 0.6), WOOD_DARK))
	end
	local frame = Build.block(folder, V(18.4, 14.4, 0.8), boardAt * cf(0, 10, 0.4), accent2)
	solid(frame)
	local screen = Build.block(folder, V(17, 13, 0.3), boardAt * cf(0, 10, -0.1), Color3.fromRGB(18, 28, 52))
	screen.Name = "BoardScreen"
	-- Queryable so clicks on the board's arrows reach it (clients raycast against it).
	screen.CanQuery = true
	local crown = Build.block(folder, V(6, 1.6, 0.9), boardAt * cf(0, 17.8, 0.4), GOLD)
	crown.Material = Enum.Material.Neon

	-- Enchanting altar: a rune circle with a floating crystal (opens pet enchanting).
	local altarPosition = o + V(dock.enchant.X, landY, dock.enchant.Z)
	local altar = CFrame.lookAt(altarPosition, spawnFlat)
	local PURPLE = Color3.fromRGB(170, 90, 255)
	local STONE = Color3.fromRGB(70, 64, 92)
	solid(Build.column(folder, 1, 11, altar * cf(0, 0.5, 0), STONE))
	local runeRing = Build.column(folder, 0.2, 9.4, altar * cf(0, 1.05, 0), PURPLE)
	runeRing.Material = Enum.Material.Neon
	solid(Build.column(folder, 0.3, 8.4, altar * cf(0, 1.1, 0), STONE))
	solid(Build.column(folder, 3, 2.4, altar * cf(0, 2.6, 0), STONE))
	local bowl = Build.column(folder, 0.5, 3.4, altar * cf(0, 4.3, 0), Color3.fromRGB(255, 208, 72))
	bowl.Material = Enum.Material.Metal
	local crystal = Build.ball(folder, 2.2, altar * cf(0, 6.2, 0), PURPLE)
	crystal.Name = "EnchantCrystal"
	crystal.Material = Enum.Material.Neon
	crystal.Transparency = 0.15
	Build.light(crystal, PURPLE, 18, 2)
	Build.sparkles(crystal, Color3.fromRGB(230, 190, 255), 12)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local pillarAt = altar * cf(math.cos(a) * 4.4, 0, math.sin(a) * 4.4)
		solid(Build.column(folder, 4, 0.9, pillarAt * cf(0, 3, 0), STONE))
		local gem = Build.block(folder, V(0.7, 1, 0.7), pillarAt * cf(0, 5.6, 0) * ang(0, math.pi / 4, 0), PURPLE)
		gem.Material = Enum.Material.Neon
	end
	local enchantSign = Build.block(folder, V(7, 2, 0.3), altar * cf(0, 9.4, 0), Color3.fromRGB(40, 30, 64))
	enchantSign.Name = "EnchantSign"
	local enchantAnchor = anchorPart(folder, "EnchantAnchor", altar * cf(0, 3, 0), V(6, 5, 6))
	prompt(enchantAnchor, "Enchant", world, "Enchant", "Enchanting Altar", 14)

	-- GOD Shark stand: the limited pet floats big over a glowing pedestal; the prompt buys it.
	local standPosition = o + V(dock.godShark.X, landY, dock.godShark.Z)
	local stand = CFrame.lookAt(standPosition, spawnFlat)
	local NAVY = Color3.fromRGB(22, 34, 60)
	local GOLD_TRIM = Color3.fromRGB(255, 214, 72)
	solid(Build.column(folder, 1.2, 12, stand * cf(0, 0.6, 0), NAVY))
	local standRing = Build.column(folder, 0.25, 12.6, stand * cf(0, 1.25, 0), Color3.fromRGB(80, 220, 255))
	standRing.Material = Enum.Material.Neon
	solid(Build.column(folder, 2.6, 6, stand * cf(0, 2.5, 0), NAVY))
	local cap = Build.column(folder, 0.4, 6.6, stand * cf(0, 3.9, 0), GOLD_TRIM)
	cap.Material = Enum.Material.Neon
	local shark = PetModels.build("godShark", 10)
	Mutations.apply(shark, { "GOD" })
	shark.Name = "GodSharkDisplay"
	shark:PivotTo(stand * cf(0, 11, 0))
	shark:SetAttribute("Spin", 0.5)
	shark.Parent = folder
	local sharkSign = Build.block(folder, V(9, 2.6, 0.3), stand * cf(0, 3.2, -3.4), Color3.fromRGB(30, 20, 50))
	sharkSign.Name = "GodSharkSign"
	local sharkAnchor = anchorPart(folder, "GodSharkAnchor", stand * cf(0, 3, -2), V(8, 6, 6))
	prompt(sharkAnchor, "GodShark", world, "Buy", "GOD Shark", 16)

	-- Invisible boundary around the island so divers stay home.
	local walls = Instance.new("Folder")
	walls.Name = "Boundary"
	walls.Parent = parent
	local r = info.islandRadius - 4
	local segments = 40
	local width = 2 * math.pi * r / segments + 1
	for i = 0, segments - 1 do
		local a = i / segments * math.pi * 2
		local wall = Instance.new("Part")
		wall.Name = "Wall"
		wall.Size = V(width, 140, 2)
		wall.CFrame = CFrame.lookAt(o + V(math.cos(a) * r, 20, math.sin(a) * r), o + V(0, 20, 0))
		wall.Anchored = true
		wall.CanCollide = true
		wall.CanQuery = false
		wall.CanTouch = false
		wall.Transparency = 1
		wall.Parent = walls
	end

	return spawn
end

return Dock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Terrain</string>
            <string name="Source"><![CDATA[--!strict
-- Voxel terrain for the shared ocean and each world's island + terraced blue hole.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Color = require(Shared.Color)
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Worlds = require(Shared.Data.Worlds)

local TerrainBuilder = {}

local terrain = Workspace.Terrain
local WATER = Enum.Material.Water
local AIR = Enum.Material.Air

local function block(center: Vector3, size: Vector3, material: Enum.Material)
	terrain:FillBlock(CFrame.new(center), size, material)
end

-- Upright cylinder between two heights.
local function cylinder(origin: Vector3, radius: number, bottom: number, top: number, material: Enum.Material)
	local height = top - bottom
	if height <= 0 then
		return
	end
	terrain:FillCylinder(CFrame.new(origin + Vector3.new(0, bottom + height / 2, 0)), height, radius, material)
end

-- Ocean for one world's grid cell. Cells are WorldSpacing wide, so neighbouring patches tile
-- seamlessly and never reach another island. Edge cells extend outward to push the horizon back.
function TerrainBuilder.buildOcean(world: number)
	local o = Layout.origin(world)
	local half = Config.WorldSpacing / 2
	local rows = math.ceil(Config.WorldCount / Config.WorldColumns)
	local col = (world - 1) % Config.WorldColumns
	local row = (world - 1) // Config.WorldColumns
	local extra = 600
	local minX = o.X - half - (if col == 0 then extra else 0)
	local maxX = o.X + half + (if col == Config.WorldColumns - 1 then extra else 0)
	local minZ = o.Z - half - (if row == 0 then extra else 0)
	local maxZ = o.Z + half + (if row == rows - 1 or world + Config.WorldColumns > Config.WorldCount then extra else 0)
	local tile = 500
	local depth = Config.OceanDepth
	local x = minX
	while x < maxX do
		local z = minZ
		while z < maxZ do
			local sx, sz = math.min(tile, maxX - x), math.min(tile, maxZ - z)
			local cx, cz = x + sx / 2, z + sz / 2
			block(Vector3.new(cx, -depth - 3, cz), Vector3.new(sx, 6, sz), Enum.Material.Sand)
			block(Vector3.new(cx, -depth / 2, cz), Vector3.new(sx, depth, sz), WATER)
			z += tile
		end
		x += tile
	end
end

-- Builds the island, lagoon terraces, beach inlet and backdrop hills for a world.
function TerrainBuilder.buildIsland(world: number, rng: Random)
	local info = Layout.info(world)
	local data = Worlds.get(world)
	local o = info.origin
	local t = data.terrain
	local land = Color.material(t.land, Enum.Material.Grass)
	local beach = Color.material(t.beach, Enum.Material.Sand)
	local rock = Color.material(t.rock, Enum.Material.Rock)
	local floor = Color.material(t.floor, Enum.Material.Sand)
	local deep = Color.material(t.deep, Enum.Material.Slate)
	local R, D, Ri = info.radius, info.depth, info.islandRadius
	local landY = info.landY

	-- Solid rock core and a sloped sandy shoreline skirt.
	cylinder(o, Ri + 16, -Config.OceanDepth - 2, -9, beach)
	cylinder(o, Ri + 8, -9, -3, beach)
	cylinder(o, Ri + 3, -3, 1, beach)
	cylinder(o, Ri, -(D + 18), landY, rock)
	cylinder(o, Ri - 5, landY - 3, landY, land)
	for i = 1, 30 do
		local a = (i / 30) * math.pi * 2 + rng:NextNumber(-0.08, 0.08)
		local r = Ri + rng:NextNumber(-3, 5)
		terrain:FillBall(o + Vector3.new(math.cos(a) * r, rng:NextNumber(-3, -1), math.sin(a) * r), rng:NextNumber(6, 10), beach)
	end
	task.wait()

	-- Backdrop hills around the far side (the dock faces +Z, so keep that sector open).
	local kit = data.kit
	local hillMaterial = if kit == "ice" then Enum.Material.Glacier else rock
	local capMaterial = if kit == "ice" then Enum.Material.Snow elseif kit == "volcanic" or kit == "maw" or kit == "trench" then rock else land
	for i = 1, 16 do
		local a = math.rad(rng:NextNumber(140, 400))
		local r = Ri - rng:NextNumber(12, 26)
		local size = rng:NextNumber(14, 26)
		local base = o + Vector3.new(math.cos(a) * r, landY + rng:NextNumber(0, 10), math.sin(a) * r)
		terrain:FillBall(base, size, hillMaterial)
		if capMaterial ~= hillMaterial then
			terrain:FillBall(base + Vector3.new(0, size * 0.35, 0), size * 0.72, capMaterial)
		end
	end
	if kit == "volcanic" then
		-- A volcano cone behind the lagoon.
		local cone = o + Vector3.new(0, 0, -(Ri - 20))
		for step = 0, 7 do
			cylinder(cone, 46 - step * 5.5, landY + step * 7, landY + step * 7 + 8, rock)
		end
		cylinder(cone, 9, landY + 44, landY + 58, AIR)
		cylinder(cone, 9, landY + 40, landY + 45, Enum.Material.CrackedLava)
	elseif kit == "ice" or kit == "crystal" or kit == "trench" or kit == "maw" then
		-- Tall jagged cliffs.
		for i = 1, 9 do
			local a = math.rad(160 + i * 25 + rng:NextNumber(-8, 8))
			local r = Ri - 14
			local base = o + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			cylinder(base, rng:NextNumber(10, 16), landY, landY + rng:NextNumber(26, 48), hillMaterial)
		end
	end
	task.wait()

	-- Lagoon: shelf, middle terrace and deep pit. A Water fill only occupies empty space and
	-- leaves solid voxels alone, so every basin is first carved out of the rock core with Air,
	-- floored, then flooded with exactly the same shapes. Solid details (rocks, mounds, the beach
	-- ramp) go in last so they sit in the water.
	local shelf, midR, midD, deepR = info.shelfDepth, info.midRadius, info.midDepth, info.deepRadius
	cylinder(o, R, -shelf, landY + 12, AIR)
	cylinder(o, R, -shelf - 2, -shelf, floor)
	cylinder(o, midR, -midD, -shelf + 1, AIR)
	cylinder(o, midR, -midD - 2, -midD, floor)
	cylinder(o, deepR, -D, -midD + 1, AIR)
	cylinder(o, deepR, -D - 3, -D, deep)
	-- Beach inlet on the dock side, carved the same way.
	local inlet = o + Vector3.new(0, 0, R + 4)
	block(inlet, Vector3.new(42, 24, 22), AIR)
	task.wait()

	cylinder(o, R, -shelf, 0, WATER)
	cylinder(o, midR, -midD, -shelf, WATER)
	cylinder(o, deepR, -D, -midD, WATER)
	block(inlet + Vector3.new(0, -6, 0), Vector3.new(42, 12, 22), WATER)
	task.wait()

	-- Sandy ramp from the dock down into the shelf (a WedgePart is tallest at +Z, the dock side).
	terrain:FillWedge(CFrame.new(inlet + Vector3.new(0, -4, 0)), Vector3.new(42, 12, 22), beach)
	block(inlet + Vector3.new(0, -12, 0), Vector3.new(42, 4, 22), beach)

	-- Rugged walls: rocks jutting in around every terrace edge.
	local rings = {
		{ radius = R, top = 0, bottom = -shelf, count = 22, size = { 4, 7 } },
		{ radius = midR, top = -shelf, bottom = -midD, count = 16, size = { 4, 8 } },
		{ radius = deepR, top = -midD, bottom = -D, count = 12, size = { 4, 7 } },
	}
	for _, ring in rings do
		for i = 1, ring.count do
			local a = (i / ring.count) * math.pi * 2 + rng:NextNumber(-0.12, 0.12)
			-- Keep the beach inlet clear.
			if not (ring.radius == R and math.abs(math.cos(a)) < 0.3 and math.sin(a) > 0) then
				local r = ring.radius + rng:NextNumber(0, 3)
				local y = rng:NextNumber(ring.bottom, ring.top)
				terrain:FillBall(o + Vector3.new(math.cos(a) * r, y, math.sin(a) * r), rng:NextNumber(ring.size[1], ring.size[2]), rock)
			end
		end
	end
	-- Floor mounds so the bottom is not perfectly flat.
	local mounds = {
		{ inner = midR + 3, outer = R - 4, y = -shelf, material = floor, count = 14 },
		{ inner = deepR + 3, outer = midR - 3, y = -midD, material = floor, count = 10 },
		{ inner = 0, outer = deepR - 4, y = -D, material = deep, count = 7 },
	}
	for _, ring in mounds do
		for _ = 1, ring.count do
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(ring.inner, math.max(ring.inner + 1, ring.outer))
			terrain:FillBall(o + Vector3.new(math.cos(a) * r, ring.y - rng:NextNumber(2, 3.5), math.sin(a) * r), rng:NextNumber(3, 6), ring.material)
		end
	end
end

-- Server-side default palette (clients re-apply per world as they travel).
function TerrainBuilder.applyPalette(world: number)
	local t = Worlds.get(world).terrain
	for _, pair in { { t.land, t.landColor }, { t.beach, t.beachColor }, { t.rock, t.rockColor }, { t.floor, t.floorColor }, { t.deep, t.deepColor } } do
		local material = Color.material(pair[1], Enum.Material.Sand)
		terrain:SetMaterialColor(material, Color.hex(pair[2]))
	end
	terrain.WaterColor = Color.hex(Worlds.get(world).water)
end

return TerrainBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds worlds on demand (terrain, decor, dock), then scans the finished lagoon for relic spawn
-- points, the Ancient Chest spot and hazard placements, published as JSON attributes.

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Worlds = require(Shared.Data.Worlds)

local Decor = require(script.Parent.Decor)
local Dock = require(script.Parent.Dock)
local Terrain = require(script.Parent.Terrain)

local WorldBuilder = {}

export type Hazard = { kind: string, x: number, y: number, z: number, radius: number, range: number, speed: number, phase: number }

type Built = {
	folder: Folder,
	spawn: SpawnLocation,
	points: { Vector3 },
	depths: { number },
	chest: Vector3,
	hazards: { Hazard },
}

local root: Folder
local built: { [number]: Built } = {}
local building: { [number]: boolean } = {}

local POINT_COUNT = 30
local POINT_SPACING = 9

local function round(n: number): number
	return math.floor(n * 10 + 0.5) / 10
end

local function scanParams(world: Folder): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Workspace.Terrain, world }
	params.IgnoreWater = true
	return params
end

local function floorHit(world: number, params: RaycastParams, lx: number, lz: number): RaycastResult?
	local info = Layout.info(world)
	return Workspace:Raycast(info.origin + Vector3.new(lx, -0.6, lz), Vector3.new(0, -(info.depth + 24), 0), params)
end

local function scanPoints(world: number, folder: Folder, rng: Random): ({ Vector3 }, { number })
	local info = Layout.info(world)
	local params = scanParams(folder)
	local bands = {
		{ inner = info.midRadius + 1, outer = info.radius - 3, quota = math.floor(POINT_COUNT * 0.3), floorDepth = info.shelfDepth },
		{ inner = info.deepRadius + 1, outer = info.midRadius - 2, quota = math.floor(POINT_COUNT * 0.35), floorDepth = info.midDepth },
		{
			inner = 2,
			outer = info.deepRadius - 3,
			quota = POINT_COUNT - math.floor(POINT_COUNT * 0.3) - math.floor(POINT_COUNT * 0.35),
			floorDepth = info.depth,
		},
	}
	local points: { Vector3 } = {}
	local depths: { number } = {}
	for _, band in bands do
		local placed, attempts = 0, 0
		while placed < band.quota and attempts < 220 do
			attempts += 1
			local a = rng:NextNumber(0, math.pi * 2)
			local r = math.sqrt(rng:NextNumber((band.inner / band.outer) ^ 2, 1)) * band.outer
			local lx, lz = math.cos(a) * r, math.sin(a) * r
			local hit = floorHit(world, params, lx, lz)
			if hit then
				local p = hit.Position + hit.Normal * 1.7
				local depth = Config.SurfaceY - p.Y
				local farEnough = depth > 5
				if farEnough then
					for _, other in points do
						if (other - p).Magnitude < POINT_SPACING then
							farEnough = false
							break
						end
					end
				end
				if farEnough then
					table.insert(points, p)
					table.insert(depths, math.clamp(depth / info.depth, 0, 1))
					placed += 1
				end
			end
		end
		-- Real voxel terrain (coarse resolution, odd island shapes on some "kit" types) can make
		-- the raycast scan above miss far more than in flatter worlds, leaving a band short or
		-- empty. Fill any shortfall analytically from the lagoon geometry Terrain.buildIsland
		-- actually carved, so no band — and no world — ever ends up with zero relics.
		local fallbackAttempts = 0
		while placed < band.quota and fallbackAttempts < band.quota * 6 + 20 do
			fallbackAttempts += 1
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(band.inner, band.outer)
			local lx, lz = math.cos(a) * r, math.sin(a) * r
			local p = info.origin + Vector3.new(lx, -band.floorDepth + 1.7, lz)
			local farEnough = true
			for _, other in points do
				if (other - p).Magnitude < POINT_SPACING then
					farEnough = false
					break
				end
			end
			if farEnough then
				table.insert(points, p)
				table.insert(depths, math.clamp(band.floorDepth / info.depth, 0, 1))
				placed += 1
			end
		end
	end
	return points, depths
end

local function scanChest(world: number, folder: Folder): Vector3
	local info = Layout.info(world)
	local params = scanParams(folder)
	local best: Vector3? = nil
	for _, offset in { Vector2.new(0, 0), Vector2.new(4, 0), Vector2.new(-4, 0), Vector2.new(0, 4), Vector2.new(0, -4) } do
		local hit = floorHit(world, params, offset.X, offset.Y)
		if hit and (not best or hit.Position.Y < best.Y) then
			best = hit.Position
		end
	end
	return (best or (info.origin + Vector3.new(0, -info.depth, 0))) + Vector3.new(0, 1.8, 0)
end

local function scanHazards(world: number, folder: Folder, rng: Random, points: { Vector3 }): { Hazard }
	local info = Layout.info(world)
	local data = Worlds.get(world)
	local params = scanParams(folder)
	local hazards: { Hazard } = {}
	local dockPoint = info.origin + Vector3.new(0, 0, info.radius)
	for _, spec in data.hazards do
		local placed, attempts = 0, 0
		while placed < spec.count and attempts < 80 do
			attempts += 1
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(6, info.radius - 6)
			local lx, lz = math.cos(a) * r, math.sin(a) * r
			local hit = floorHit(world, params, lx, lz)
			if hit then
				local floor = hit.Position
				local depth = Config.SurfaceY - floor.Y
				local p = floor
				local radius, range, speed = 1.8, 0, rng:NextNumber(0.6, 1.1)
				if spec.kind == "urchin" then
					p = floor + Vector3.new(0, 0.9, 0)
					radius = 1.6
				elseif spec.kind == "eel" then
					p = floor + Vector3.new(0, 2.2, 0)
					radius, range = 1.5, rng:NextNumber(7, 12)
				elseif spec.kind == "lava" then
					p = floor + Vector3.new(0, 0.5, 0)
					radius, range = 1.9, math.min(14, depth - 4)
				else
					local lift = rng:NextNumber(5, math.max(6, math.min(22, depth - 7)))
					p = floor + Vector3.new(0, lift, 0)
					range = if spec.kind == "jelly" then rng:NextNumber(2.5, 5) else rng:NextNumber(5, 9)
				end
				local ok = depth > 8 and (p - dockPoint).Magnitude > 26 and Config.SurfaceY - p.Y > 5
				if ok then
					for _, point in points do
						if (point - p).Magnitude < 6 then
							ok = false
							break
						end
					end
				end
				if ok then
					table.insert(hazards, {
						kind = spec.kind,
						x = round(p.X),
						y = round(p.Y),
						z = round(p.Z),
						radius = radius,
						range = round(range),
						speed = round(speed * 100) / 100,
						phase = round(rng:NextNumber(0, math.pi * 2)),
					})
					placed += 1
				end
			end
		end
	end
	return hazards
end

function WorldBuilder.init()
	-- A place saved from a play session (or Team Create) can carry stale copies of these runtime
	-- folders. Clients look worlds up with Workspace:FindFirstChild("Worlds"), so a stale copy
	-- holding only World 1 would hide every freshly built world from them.
	for _, name in { "Worlds", "DeepDiveClient" } do
		local stale = Workspace:FindFirstChild(name)
		while stale do
			stale:Destroy()
			stale = Workspace:FindFirstChild(name)
		end
	end
	root = Instance.new("Folder")
	root.Name = "Worlds"
	root.Parent = Workspace

	local clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.5
	clouds.Density = 0.6
	clouds.Parent = Workspace.Terrain

	local terrain = Workspace.Terrain
	terrain.WaterWaveSize = 0.18
	terrain.WaterWaveSpeed = 10
	terrain.WaterReflectance = 0.6
	terrain.WaterTransparency = 0.72
	Terrain.applyPalette(1)
end

local function build(world: number): Built
	local started = os.clock()
	local rng = Random.new(world * 104729 + 17)
	local folder = Instance.new("Folder")
	folder.Name = "World" .. world
	folder:SetAttribute("World", world)
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = folder
	folder.Parent = root

	local ok, err = pcall(function()
		Terrain.buildOcean(world)
		task.wait()
		Terrain.buildIsland(world, rng)
		task.wait()
	end)
	if not ok then
		folder:Destroy()
		error(err, 0)
	end
	-- Decoration is cosmetic: a failure there must never make the world unplayable.
	local decorOk, decorErr = pcall(function()
		Decor.build(world, decor, rng)
	end)
	if not decorOk then
		warn(string.format("[DeepDive] World %d decor failed: %s", world, tostring(decorErr)))
	end
	task.wait()
	local spawnOk, spawn = pcall(Dock.build, world, folder)
	if not spawnOk then
		folder:Destroy()
		error(spawn, 0)
	end
	task.wait()

	local points, depths = scanPoints(world, folder, rng)
	local chest = scanChest(world, folder)
	local hazards = scanHazards(world, folder, rng, points)
	local encoded = {}
	for i, p in points do
		encoded[i] = { round(p.X), round(p.Y), round(p.Z) }
	end
	folder:SetAttribute("Points", HttpService:JSONEncode(encoded))
	folder:SetAttribute("Chest", HttpService:JSONEncode({ round(chest.X), round(chest.Y), round(chest.Z) }))
	folder:SetAttribute("Hazards", HttpService:JSONEncode(hazards))
	folder:SetAttribute("Ready", true)
	print(string.format("[DeepDive] World %d built in %.2fs (%d relic points, %d hazards)", world, os.clock() - started, #points, #hazards))
	return { folder = folder, spawn = spawn, points = points, depths = depths, chest = chest, hazards = hazards }
end

-- Yields until the world is built. Errors if the build fails (callers pcall where it matters).
function WorldBuilder.ensure(world: number): Built
	world = math.clamp(world, 1, Config.WorldCount)
	local existing = built[world]
	if existing then
		return existing
	end
	if building[world] then
		while building[world] do
			task.wait(0.1)
		end
		local finished = built[world]
		if not finished then
			error(string.format("World %d failed to build", world), 0)
		end
		return finished
	end
	building[world] = true
	local ok, result = pcall(build, world)
	building[world] = nil
	if not ok then
		warn(string.format("[DeepDive] World %d failed to build: %s", world, tostring(result)))
		error(result, 0)
	end
	built[world] = result
	return result
end

function WorldBuilder.get(world: number): Built?
	return built[world]
end

function WorldBuilder.buildRemaining()
	task.spawn(function()
		for world = 1, Config.WorldCount do
			if not built[world] then
				pcall(WorldBuilder.ensure, world)
				task.wait(0.25)
			end
		end
	end)
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
