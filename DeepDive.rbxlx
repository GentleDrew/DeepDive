			{ "Biolum Gem", "생물발광 보석", "gem", "#5fff8a", "#c8ffd8", "neon" },
			{ "Ancient Fossil", "고대 화석", "fossil", "#8a8070", "#d8c8a8" },
			{ "Abyss Orb", "심연 구슬", "orb", "#8a4fff", "#ff5fd8", "neon" },
