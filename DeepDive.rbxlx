  <Item class="ServerScriptService" referent="31">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="32">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="33">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Server entry point: builds the ocean + first world, loads profiles and spawns divers into the
-- world they last played. Remaining worlds build in the background.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Layout)
local Operators = require(Shared.Operators)
local Profile = require(Shared.Profile)

local Net = require(script.Parent.Net)
local ProfileStore = require(script.Parent.ProfileStore)
local Sessions = require(script.Parent.Sessions)
local Sync = require(script.Parent.Sync)
local WorldBuilder = require(script.Parent.World.WorldBuilder)
local ActionService = require(script.Parent.Services.ActionService)
local DiveService = require(script.Parent.Services.DiveService)
local GearService = require(script.Parent.Services.GearService)
local LeaderboardService = require(script.Parent.Services.LeaderboardService)
local PetService = require(script.Parent.Services.PetService)
local PurchaseService = require(script.Parent.Services.PurchaseService)
local RewardService = require(script.Parent.Services.RewardService)
local StatueService = require(script.Parent.Services.StatueService)
local TradeService = require(script.Parent.Services.TradeService)

Net.init()
ProfileStore.init()
ProfileStore.onSaved = function(player: Player)
	Net.push(player, "saved")
end
WorldBuilder.init()
DiveService.init()
PetService.init()
GearService.init()
TradeService.init()
ActionService.init()
PurchaseService.init()
RewardService.init()
LeaderboardService.init()
StatueService.init()

local function spawnCharacter(player: Player)
	if not player.Parent then
		return
	end
	local ok, err = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		warn("[DeepDive] LoadCharacterAsync failed: " .. tostring(err))
	end
end

local function onCharacter(session: Sessions.Session, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	character:PivotTo(Layout.spawnCFrame(session.world))
	humanoid.WalkSpeed = 20
	-- Clients draw their own nameplates (name + coins) above every diver.
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	-- Worn gear (tank, bag, flippers, magnet) once the body parts exist.
	character:WaitForChild(if humanoid.RigType == Enum.HumanoidRigType.R15 then "UpperTorso" else "Torso", 10)
	if Sessions.get(session.player) == session and session.player.Character == character then
		GearService.dress(session)
	end
	-- Avatar appearance loads after spawn and swaps body parts (body packages), which breaks the
	-- welds holding worn gear; dress again whenever a body part is replaced.
	local pending = false
	character.ChildAdded:Connect(function(child)
		if not child:IsA("BasePart") or pending then
			return
		end
		pending = true
		task.delay(0.2, function()
			pending = false
			if Sessions.get(session.player) == session and session.player.Character == character then
				GearService.dress(session)
			end
		end)
	end)
	humanoid.Died:Connect(function()
		DiveService.onDied(session)
		task.delay(2.5, function()
			if Sessions.get(session.player) == session then
				spawnCharacter(session.player)
			end
		end)
	end)
end

local function onPlayerAdded(player: Player)
	local profile = ProfileStore.load(player)
	if not player.Parent then
		-- Left while loading: release the session lock right away.
		ProfileStore.save(player, true)
		return
	end
	if not profile then
		player:Kick("Deep Dive could not load your save right now. Please rejoin in a moment.")
		return
	end
	local session = Sessions.create(player, profile)
	PurchaseService.loadPasses(session)
	local builtOk, built = pcall(WorldBuilder.ensure, session.world)
	if not builtOk then
		-- World 1 is built before anyone joins, so it is always a safe place to land.
		session.world = 1
		profile.world = 1
		built = WorldBuilder.ensure(1)
	end
	if not player.Parent then
		return
	end
	PetService.clampEquipped(session)
	player:SetAttribute("World", session.world)
	-- Red nameplate + aura: the game's creator (or anyone listed in Config.AdminUserIds).
	local isOperator = Operators.is(player.UserId)
	player:SetAttribute("Operator", isOperator)
	-- Operators always have every world open, so testing (relics, hazards, etc.) never waits on
	-- grinding through the economy to unlock worlds the normal way.
	if isOperator and profile.unlocked < Config.WorldCount then
		profile.unlocked = Config.WorldCount
	end
	-- Directors always keep one limited GOD Shark.
	if isOperator then
		local hasShark = false
		for _, pet in profile.pets do
			hasShark = hasShark or pet.s == "godShark"
		end
		if not hasShark then
			Profile.addPet(profile, "godShark", { "GOD" })
		end
	end
	player.RespawnLocation = built.spawn
	Sync.leaderstats(session)
	player.CharacterAdded:Connect(function(character)
		onCharacter(session, character)
	end)
	session.ready = true
	spawnCharacter(player)
	Sync.profile(session)
	DiveService.rollLayout(session)
end

local function onPlayerRemoving(player: Player)
	local session = Sessions.get(player)
	if session then
		TradeService.onLeave(session)
		DiveService.onLeave(session)
		Sessions.remove(player)
	end
	ProfileStore.save(player, true)
end

-- Build the ocean and World 1 before anyone spawns; the rest follows in the background.
WorldBuilder.ensure(1)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

WorldBuilder.buildRemaining()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- Server networking: creates the remotes, routes client actions to handlers with rate limits
-- and error isolation, and pushes state to clients.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Net = {}

type Handler = (player: Player, payload: any) -> (boolean, string?, any)
type Bucket = { tokens: number, updated: number }

local handlers: { [string]: Handler } = {}
local eventHandlers: { [string]: (Player, ...any) -> () } = {}
local buckets: { [Player]: { [string]: Bucket } } = {}

local folder: Folder
local invoke: RemoteFunction
local push: RemoteEvent

local RATE = { default = { rate = 6, burst = 10 }, Collect = { rate = 16, burst = 24 }, Hazard = { rate = 3, burst = 4 } }

local function allow(player: Player, name: string): boolean
	local limits = RATE[name] or RATE.default
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local bucket = perPlayer[name]
	local now = os.clock()
	if not bucket then
		bucket = { tokens = limits.burst, updated = now }
		perPlayer[name] = bucket
	end
	bucket.tokens = math.min(limits.burst, bucket.tokens + (now - bucket.updated) * limits.rate)
	bucket.updated = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

function Net.init()
	local existing = ReplicatedStorage:FindFirstChild(Remotes.Folder)
	if existing then
		existing:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = Remotes.Folder

	invoke = Instance.new("RemoteFunction")
	invoke.Name = Remotes.Invoke
	invoke.Parent = folder

	push = Instance.new("RemoteEvent")
	push.Name = Remotes.Push
	push.Parent = folder

	for _, name in { Remotes.Collect, Remotes.Hazard } do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		remote.OnServerEvent:Connect(function(player, ...)
			local handler = eventHandlers[name]
			if handler and allow(player, name) then
				local ok, err = pcall(handler :: any, player, ...)
				if not ok then
					warn("[Net] " .. name .. " failed: " .. tostring(err))
				end
			end
		end)
	end

	invoke.OnServerInvoke = function(player: Player, action: any, payload: any)
		if type(action) ~= "string" or not Remotes.Actions[action] then
			return { ok = false, err = "err.generic" }
		end
		if not allow(player, action) then
			return { ok = false, err = "err.busy" }
		end
		local handler = handlers[action]
		if not handler then
			return { ok = false, err = "err.generic" }
		end
		local called, ok, err, data = pcall(handler, player, payload)
		if not called then
			warn("[Net] action " .. action .. " errored: " .. tostring(ok))
			return { ok = false, err = "err.generic" }
		end
		return { ok = ok == true, err = err, data = data }
	end

	folder.Parent = ReplicatedStorage

	Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

function Net.on(action: string, handler: Handler)
	handlers[action] = handler
end

function Net.onEvent(name: string, handler: (Player, ...any) -> ())
	eventHandlers[name] = handler
end

function Net.push(player: Player, kind: string, payload: any?)
	if player.Parent then
		push:FireClient(player, kind, payload)
	end
end

function Net.pushAll(kind: string, payload: any?)
	push:FireAllClients(kind, payload)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[--!strict
-- DataStore persistence with a session lock so two servers never own the same profile.
-- Profiles live in memory and autosave; purchases force an immediate save. In Studio without
-- API access the store falls back to memory-only profiles (progress is not saved).

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Profile = require(Shared.Profile)

local ProfileStore = {}

local LOCK_TIMEOUT = 240
local AUTOSAVE_INTERVAL = 60
local jobId = if game.JobId ~= "" then game.JobId else "studio-" .. tostring(math.random(1, 1e9))

type Entry = { data: Profile.Data, dirty: boolean, saving: boolean, released: boolean, lastSave: number }

local entries: { [Player]: Entry } = {}
local store: DataStore? = nil
ProfileStore.memoryMode = false
-- Called after every successful DataStore write of a player's profile.
ProfileStore.onSaved = nil :: ((Player) -> ())?

local function key(userId: number): string
	return "p_" .. tostring(userId)
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
		return store
	end
	warn("[DeepDive] DataStore unavailable: " .. tostring(result))
	return nil
end

local function enterMemoryMode(reason: string)
	if not ProfileStore.memoryMode then
		ProfileStore.memoryMode = true
		warn("[DeepDive] Using session-only profiles (progress will not be saved): " .. reason)
		warn("[DeepDive] Publish the place and enable Game Settings > Security > 'Enable Studio Access to API Services' to test saving.")
	end
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	local waited = 0
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and waited < 8 do
		task.wait(0.5)
		waited += 0.5
	end
end

-- Yields. Returns the profile, or nil if the player left or loading failed.
function ProfileStore.load(player: Player): Profile.Data?
	local now = os.time()
	if ProfileStore.memoryMode then
		local data = Profile.new(now)
		entries[player] = { data = data, dirty = false, saving = false, released = false, lastSave = os.clock() }
		return data
	end
	local ds = getStore()
	if not ds then
		if RunService:IsStudio() then
			enterMemoryMode("no DataStore")
			return ProfileStore.load(player)
		end
		return nil
	end
	local attempt = 0
	while player.Parent do
		attempt += 1
		local loaded: Profile.Data? = nil
		local lockedBy: string? = nil
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player.UserId), function(record)
				loaded = nil
				lockedBy = nil
				local current = if type(record) == "table" then record else {}
				local lock = current.lock
				local stale = type(lock) ~= "table" or type(lock.time) ~= "number" or os.time() - lock.time > LOCK_TIMEOUT
				if type(lock) == "table" and lock.job ~= jobId and not stale then
					lockedBy = tostring(lock.job)
					return nil
				end
				local data = Profile.reconcile(current.data, os.time())
				loaded = data
				return { data = data, lock = { job = jobId, time = os.time() } }
			end)
		end)
		if ok and loaded then
			entries[player] = { data = loaded, dirty = false, saving = false, released = false, lastSave = os.clock() }
			return loaded
		elseif ok and lockedBy then
			-- Another server still owns this profile (the player just hopped servers). Wait for it.
			if attempt >= 45 then
				return nil
			end
			task.wait(5)
		else
			if RunService:IsStudio() then
				enterMemoryMode(tostring(err))
				return ProfileStore.load(player)
			end
			if attempt >= 6 then
				warn("[DeepDive] Profile load failed for " .. player.Name .. ": " .. tostring(err))
				return nil
			end
			task.wait(math.min(2 ^ attempt, 20))
		end
	end
	return nil
end

function ProfileStore.get(player: Player): Profile.Data?
	local entry = entries[player]
	return entry and entry.data
end

function ProfileStore.markDirty(player: Player)
	local entry = entries[player]
	if entry then
		entry.dirty = true
	end
end

-- Writes the profile. `release` drops the session lock (player leaving / shutdown).
function ProfileStore.save(player: Player, release: boolean?): boolean
	local entry = entries[player]
	if not entry or entry.released then
		return false
	end
	if ProfileStore.memoryMode then
		entry.dirty = false
		if release then
			entry.released = true
			entries[player] = nil
		end
		return true
	end
	local ds = getStore()
	if not ds then
		return false
	end
	while entry.saving do
		task.wait(0.1)
	end
	if entry.released then
		-- Another caller released the profile while this save was waiting.
		return true
	end
	entry.saving = true
	entry.data.seen = os.time()
	local snapshot = entry.data
	local success = false
	for attempt = 1, 4 do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local lost = false
		local ok, err = pcall(function()
			ds:UpdateAsync(key(player.UserId), function(record)
				local current = if type(record) == "table" then record else {}
				local lock = current.lock
				if type(lock) == "table" and lock.job ~= jobId and type(lock.time) == "number" and os.time() - lock.time <= LOCK_TIMEOUT then
					lost = true
					return nil
				end
				return { data = snapshot, lock = if release then nil else { job = jobId, time = os.time() } }
			end)
		end)
		if ok and not lost then
			success = true
			break
		elseif lost then
			warn("[DeepDive] Session lock lost for " .. player.Name .. "; not overwriting newer data.")
			break
		else
			warn("[DeepDive] Save attempt " .. attempt .. " failed: " .. tostring(err))
			task.wait(attempt * 1.5)
		end
	end
	entry.saving = false
	if success then
		entry.dirty = false
		entry.lastSave = os.clock()
		local onSaved = ProfileStore.onSaved
		if onSaved and not release then
			task.spawn(onSaved, player)
		end
	end
	if release then
		entry.released = true
		entries[player] = nil
	end
	return success
end

function ProfileStore.init()
	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for player, entry in entries do
				if
					not entry.released
					and not entry.saving
					and (entry.dirty or now - entry.lastSave > AUTOSAVE_INTERVAL * 2)
					and now - entry.lastSave > AUTOSAVE_INTERVAL
				then
					task.spawn(ProfileStore.save, player, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		-- Covers every loaded profile, including players whose PlayerRemoving save is still running.
		local pending = 0
		for player, entry in entries do
			if not entry.released then
				pending += 1
				task.spawn(function()
					ProfileStore.save(player, true)
					pending -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return ProfileStore
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ActionService</string>
            <string name="Source"><![CDATA[--!strict
-- Selling, travel, settings, tutorial progress and the client "Ready" handshake.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)

local Net = require(script.Parent.Parent.Net)
local ProfileStore = require(script.Parent.Parent.ProfileStore)
local Sessions = require(script.Parent.Parent.Sessions)
local Sync = require(script.Parent.Parent.Sync)
local DiveService = require(script.Parent.DiveService)

local ActionService = {}

local function teleport(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	local world = if type(payload) == "table" then tonumber(payload.world) else nil
	if not world then
		return false, "err.generic"
	end
	return DiveService.teleport(session, math.floor(world))
end

-- Pays the fee for the next world once the world before it is cleared.
local function unlockWorld(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	local world = if type(payload) == "table" then tonumber(payload.world) else nil
	local profile = session.profile
	if not world or world ~= profile.unlocked + 1 or world > Config.WorldCount then
		return false, "err.generic"
	end
	local previous = profile.worlds[tostring(world - 1)]
	if not previous or not previous.cleared then
		return false, "err.locked"
	end
	local cost = Economy.unlockCost(world)
	if profile.coins < cost then
		return false, "notEnough"
	end
	profile.coins -= cost
	profile.unlocked = world
	Sync.profile(session)
	task.spawn(ProfileStore.save, player, false)
	return true, nil, { world = world, cost = cost }
end

-- Promo codes: case-insensitive, one redemption per player, ever.
local function redeemCode(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or type(payload) ~= "table" or type(payload.code) ~= "string" then
		return false, "err.generic"
	end
	local code = string.upper((string.gsub(payload.code, "%s+", "")))
	if code == "" then
		return false, "codeInvalid"
	end
	local profile = session.profile
	if profile.redeemed[code] then
		return false, "codeUsed"
	end
	local entry = nil
	for _, candidate in Config.PromoCodes do
		if string.upper(candidate.code) == code then
			entry = candidate
			break
		end
	end
	if not entry then
		return false, "codeInvalid"
	end
	profile.redeemed[code] = true
	local coins = entry.coins or 0
	local enchants = entry.enchants or 0
	profile.coins += coins
	profile.lifetime += coins
	profile.enchants += enchants
	Sync.profile(session)
	task.spawn(ProfileStore.save, player, false)
	return true, nil, { coins = coins, enchants = enchants }
end

local BOOL_SETTINGS = { music = true, sfx = true, lowFx = true, hidePets = true }

local function setting(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or type(payload) ~= "table" or type(payload.key) ~= "string" then
		return false, "err.generic"
	end
	local settings = session.profile.settings :: any
	if BOOL_SETTINGS[payload.key] and type(payload.value) == "boolean" then
		settings[payload.key] = payload.value
	elseif payload.key == "lang" and (payload.value == "en" or payload.value == "ko") then
		settings.lang = payload.value
	else
		return false, "err.generic"
	end
	Sync.profile(session)
	return true
end

local function tutorial(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or type(payload) ~= "table" or type(payload.step) ~= "number" then
		return false, "err.generic"
	end
	local profile = session.profile
	-- The client may only advance informational steps (6 -> done) or skip the tutorial.
	local step = math.floor(payload.step)
	if (profile.tutorial == 6 and step == 7) or step == 99 then
		profile.tutorial = step
		Sync.profile(session)
		return true
	end
	return false, "err.generic"
end

local function ready(player: Player): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	DiveService.rollLayout(session)
	return true, nil, Sync.view(session)
end

function ActionService.init()
	Net.on("Sell", function(player: Player): (boolean, string?, any)
		local session = Sessions.get(player)
		if not session or not session.ready then
			return false, "err.notReady"
		end
		return DiveService.sell(session, true)
	end)
	Net.on("Teleport", teleport)
	Net.on("UnlockWorld", unlockWorld)
	Net.on("RedeemCode", redeemCode)
	Net.on("Setting", setting)
	Net.on("Tutorial", tutorial)
	Net.on("Ready", ready)
end

return ActionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">DiveService</string>
            <string name="Source"><![CDATA[--!strict
-- Authoritative dive loop: detects diving/surfacing from the character position, drains oxygen
-- with depth pressure, validates relic pickups, auto-sells on surfacing, handles blackouts, the
-- Ancient Chest, world clears and travel between worlds.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Layout = require(Shared.Layout)
local Profile = require(Shared.Profile)
local Remotes = require(Shared.Remotes)
local Rewards = require(Shared.Rewards)
local Worlds = require(Shared.Data.Worlds)

local Net = require(script.Parent.Parent.Net)
local Sessions = require(script.Parent.Parent.Sessions)
local Sync = require(script.Parent.Parent.Sync)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)

local DiveService = {}

type Session = Sessions.Session

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function aliveHumanoid(player: Player): Humanoid?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end
	return nil
end

local function capacity(session: Session): number
	return Economy.stat(session.profile.gear.equip, "pack")
end

local function magnet(session: Session): number
	return Economy.stat(session.profile.gear.equip, "magnet")
end

function DiveService.rollLayout(session: Session)
	local built = WorldBuilder.get(session.world)
	if not built then
		return
	end
	session.layoutId += 1
	session.relics = {}
	local count = #built.points
	local order = table.create(count)
	for i = 1, count do
		order[i] = i
	end
	for i = count, 2, -1 do
		local j = session.rng:NextInteger(1, i)
		order[i], order[j] = order[j], order[i]
	end
	local data = Worlds.get(session.world)
	local list: { any } = {}
	for n = 1, math.min(Config.Dive.ActiveRelics, count) do
		local index = order[n]
		local rarity = Economy.rollRarity(built.depths[index] * 0.95, session.rng:NextNumber())
		local key = data.relics[rarity].key
		session.relics[index] = key
		table.insert(list, { index, key } :: { any })
	end
	local progress = Profile.progress(session.profile, session.world)
	session.chestActive = not progress.cleared and progress.sold >= Economy.goal(session.world)
	session.chestCarried = false
	Net.push(session.player, "layout", { id = session.layoutId, world = session.world, relics = list, chest = session.chestActive })
end

local function startDive(session: Session)
	local profile = session.profile
	session.mode = "Diving"
	session.oxygenMax = Economy.stat(profile.gear.equip, "tank")
	session.oxygen = session.oxygenMax
	session.diveStart = #profile.backpack
	session.surfacedFor = 0
	session.syncTimer = 0
	session.maxDepth = 0
	session.chestCarried = false
	profile.stats.dives += 1
	if profile.tutorial == 1 then
		profile.tutorial = 2
		Sync.profile(session)
	end
	Net.push(session.player, "dive", { state = "start", oxygen = session.oxygen, max = session.oxygenMax, layout = session.layoutId })
end

local function clearWorld(session: Session): { [string]: any }
	local profile = session.profile
	local world = session.world
	local progress = Profile.progress(profile, world)
	progress.cleared = true
	local reward = Economy.clearReward(world)
	profile.coins += reward
	profile.lifetime += reward
	-- The next world becomes available to unlock (for a fee) rather than opening right away.
	local nextWorld = nil
	if world < Config.WorldCount and profile.unlocked <= world then
		nextWorld = world + 1
	end
	return {
		world = world,
		reward = reward,
		nextWorld = nextWorld,
		unlockCost = if nextWorld then Economy.unlockCost(nextWorld) else nil,
		all = world == Config.WorldCount,
	}
end

-- Ends a dive. Treasure stays in the backpack until sold at the sell stand; a rescue (blackout,
-- death, leaving mid-dive) drops half of what was gathered on this dive.
-- reason: "surface" | "blackout" | "died" | "leave"
local function endDive(session: Session, reason: string)
	if session.mode ~= "Diving" and session.mode ~= "Rescue" then
		return
	end
	local profile = session.profile
	local world = session.world
	local backpack = profile.backpack
	local rescued = reason ~= "surface"
	local gathered = math.max(0, #backpack - session.diveStart)
	local lost = 0
	if rescued and gathered > 0 then
		lost = gathered - math.floor(gathered * Config.Dive.BlackoutKeep)
		for _ = 1, lost do
			table.remove(backpack)
		end
	end
	local progress = Profile.progress(profile, world)
	local meters = Economy.displayMeters(world, session.maxDepth)
	local record = nil
	if meters > progress.best then
		progress.best = meters
		if meters >= 10 then
			record = meters
		end
	end
	local carried = session.chestCarried
	local cleared = nil
	if carried and not rescued and not progress.cleared then
		cleared = clearWorld(session)
	end
	if rescued and reason ~= "leave" then
		profile.stats.blackouts += 1
	end
	if profile.tutorial == 2 and #backpack > 0 then
		profile.tutorial = 3
	end

	session.mode = "Dock"
	session.oxygen = session.oxygenMax
	session.chestCarried = false

	Net.push(session.player, "surfaced", {
		gathered = gathered,
		lost = lost,
		cargo = #backpack,
		rescued = rescued,
		chest = carried and not rescued,
		chestLost = carried and rescued,
		record = record,
	})
	if cleared then
		Net.push(session.player, "cleared", cleared)
	end
	Sync.profile(session)
	DiveService.rollLayout(session)
end

-- Sells the whole backpack. Only on the dock, standing at this world's sell stand.
-- `anywhere` bypasses the distance-to-stand check (the AutoSell pass sells the instant you
-- surface, wherever that is).
function DiveService.sell(session: Session, fromPrompt: boolean?, anywhere: boolean?): (boolean, string?)
	local profile = session.profile
	local backpack = profile.backpack
	if session.mode ~= "Dock" then
		return false, "err.diving"
	end
	if #backpack == 0 then
		return false, "nothingToSell"
	end
	local root = rootOf(session.player)
	if not root or not aliveHumanoid(session.player) then
		return false, "err.generic"
	end
	if not anywhere then
		local spot = Layout.origin(session.world) + Layout.dock(session.world).sell
		local offset = root.Position - spot
		local reach = Config.SellRadius + (if fromPrompt then 8 else 0)
		if Vector3.new(offset.X, 0, offset.Z).Magnitude > reach or math.abs(offset.Y) > 10 then
			return false, "sellFar"
		end
	end
	local now = os.clock()
	if now - session.lastSell < 0.8 then
		return false, "err.busy"
	end
	session.lastSell = now
	local total = 0
	local perWorld: { [number]: number } = {}
	for _, key in backpack do
		total += Economy.relicValueByKey(key)
		local relic = Worlds.relics[key]
		if relic then
			perWorld[relic.world] = (perWorld[relic.world] or 0) + 1
		end
	end
	local count = #backpack
	local payout = math.floor(total * Sessions.multiplier(session))
	profile.coins += payout
	profile.lifetime += payout
	table.clear(backpack)
	session.diveStart = 0
	local world = session.world
	local goal = Economy.goal(world)
	local current = Profile.progress(profile, world)
	local wasReady = current.sold >= goal
	for relicWorld, n in perWorld do
		local progress = Profile.progress(profile, relicWorld)
		progress.sold += n
	end
	local chestReady = not wasReady and current.sold >= goal and not current.cleared
	if profile.tutorial == 2 or profile.tutorial == 3 then
		profile.tutorial = 4
	end
	Net.push(session.player, "sold", {
		payout = payout,
		count = count,
		progress = current.sold,
		goal = goal,
		chestReady = chestReady,
	})
	Sync.profile(session)
	if chestReady then
		DiveService.rollLayout(session)
	end
	return true, nil
end

local function blackout(session: Session)
	if session.mode ~= "Diving" then
		return
	end
	session.mode = "Rescue"
	Net.push(session.player, "dive", { state = "blackout" })
	task.delay(1.5, function()
		if Sessions.get(session.player) ~= session then
			return
		end
		local character = session.player.Character
		if character and aliveHumanoid(session.player) then
			character:PivotTo(Layout.spawnCFrame(session.world))
		end
		endDive(session, "blackout")
	end)
end

local function tick(session: Session, dt: number)
	session.profile.stats.playtime += dt
	Rewards.addPlaytime(session.profile, dt, os.time())
	if session.mode == "Travel" or session.mode == "Rescue" then
		return
	end
	local root = rootOf(session.player)
	if not root or not aliveHumanoid(session.player) then
		return
	end
	local position = root.Position
	local depth = Config.SurfaceY - position.Y
	if session.mode == "Dock" then
		if depth >= Config.Dive.SubmergeDepth and Layout.overLagoon(session.world, position) then
			startDive(session)
		elseif #session.profile.backpack > 0 then
			-- Stepping onto the sell pad sells everything.
			local spot = Layout.origin(session.world) + Layout.dock(session.world).sell
			local offset = position - spot
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= Config.SellRadius and math.abs(offset.Y) < 8 then
				DiveService.sell(session)
			end
		end
		return
	end
	-- Diving
	local d = math.max(0, depth)
	session.oxygen -= Economy.oxygenDrain(session.world, d) * dt
	if d > session.maxDepth then
		session.maxDepth = d
	end
	if session.oxygen <= 0 then
		session.oxygen = 0
		blackout(session)
		return
	end
	if depth < Config.Dive.SurfaceDepth then
		session.surfacedFor += dt
		if session.surfacedFor >= Config.Dive.SurfaceHold then
			endDive(session, "surface")
			if session.passes.AutoSell and #session.profile.backpack > 0 then
				DiveService.sell(session, false, true)
			end
			return
		end
	else
		session.surfacedFor = 0
	end
	session.syncTimer += dt
	if session.syncTimer >= 1.5 then
		session.syncTimer = 0
		Net.push(session.player, "oxygen", { value = session.oxygen, max = session.oxygenMax })
	end
end

local function reject(session: Session, point: number, reason: string)
	Net.push(session.player, "reject", { point = point, reason = reason, layout = session.layoutId })
end

local function onCollect(player: Player, layoutId: any, point: any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return
	end
	if type(layoutId) ~= "number" or type(point) ~= "number" or point ~= point then
		return
	end
	point = math.floor(point)
	if layoutId ~= session.layoutId or session.mode == "Rescue" or session.mode == "Travel" then
		reject(session, point, "stale")
		return
	end
	local root = rootOf(player)
	local built = WorldBuilder.get(session.world)
	if not root or not built or not aliveHumanoid(player) then
		reject(session, point, "stale")
		return
	end
	local reach = magnet(session) + Config.Dive.CollectTolerance
	local target = if point == 0 then built.chest else built.points[point]
	if not target then
		reject(session, point, "gone")
		return
	end
	if (root.Position - target).Magnitude > reach + (if point == 0 then 3 else 0) then
		reject(session, point, "far")
		return
	end
	if point == 0 then
		if not session.chestActive or session.chestCarried then
			reject(session, point, "gone")
			return
		end
	else
		if not session.relics[point] then
			reject(session, point, "gone")
			return
		end
		if #session.profile.backpack >= capacity(session) then
			reject(session, point, "full")
			return
		end
	end
	if session.mode == "Dock" then
		local depth = Config.SurfaceY - root.Position.Y
		if depth < 0.5 or not Layout.overLagoon(session.world, root.Position) then
			reject(session, point, "far")
			return
		end
		startDive(session)
	end
	local profile = session.profile
	if point == 0 then
		session.chestCarried = true
		Net.push(player, "collected", { point = 0, chest = true, cargo = #profile.backpack })
		return
	end
	local key = session.relics[point]
	session.relics[point] = nil
	table.insert(profile.backpack, key)
	local discovered = (profile.relics[key] or 0) == 0
	profile.relics[key] = (profile.relics[key] or 0) + 1
	profile.stats.relics += 1
	Sync.stats(session)
	Net.push(player, "collected", {
		point = point,
		key = key,
		cargo = #profile.backpack,
		capacity = capacity(session),
		discovered = discovered,
		total = profile.relics[key],
	})
	-- The spot refills with a fresh relic after a short delay, as long as this is still the same
	-- dive (otherwise the next rollLayout already reseeds every point from scratch).
	local capturedLayout = session.layoutId
	local depth = built.depths[point]
	task.delay(Config.Dive.RelicRespawnMin + session.rng:NextNumber() * (Config.Dive.RelicRespawnMax - Config.Dive.RelicRespawnMin), function()
		if session.layoutId ~= capturedLayout or (session.mode ~= "Diving" and session.mode ~= "Rescue") or session.relics[point] then
			return
		end
		local rarity = Economy.rollRarity(depth * 0.95, session.rng:NextNumber())
		local newKey = Worlds.get(session.world).relics[rarity].key
		session.relics[point] = newKey
		Net.push(player, "relicSpawn", { point = point, key = newKey })
	end)
end

local function onHazard(player: Player, index: any)
	local session = Sessions.get(player)
	if not session or session.mode ~= "Diving" or type(index) ~= "number" then
		return
	end
	local built = WorldBuilder.get(session.world)
	if not built or not built.hazards[math.floor(index)] then
		return
	end
	local now = os.clock()
	if now - session.lastHazard < Config.Dive.HazardImmunity then
		return
	end
	session.lastHazard = now
	session.oxygen = math.max(0, session.oxygen - session.oxygenMax * Config.Dive.HazardPenalty)
	Net.push(player, "oxygen", { value = session.oxygen, max = session.oxygenMax, hit = true })
end

-- Travel ---------------------------------------------------------------------------------------

function DiveService.teleport(session: Session, world: number): (boolean, string?)
	if session.busy then
		return false, "err.busy"
	end
	if world < 1 or world > session.profile.unlocked then
		return false, "err.locked"
	end
	if session.mode ~= "Dock" then
		return false, "err.diving"
	end
	session.busy = true
	session.mode = "Travel"
	Net.push(session.player, "travel", { state = "start", world = world })
	local ok, built = pcall(WorldBuilder.ensure, world)
	if not ok or not built then
		session.mode = "Dock"
		session.busy = false
		Net.push(session.player, "travel", { state = "failed", world = session.world })
		return false, "err.generic"
	end
	session.world = world
	session.profile.world = world
	session.player:SetAttribute("World", world)
	session.player.RespawnLocation = built.spawn
	local character = session.player.Character
	if character then
		character:PivotTo(Layout.spawnCFrame(world))
	end
	task.wait(0.2)
	session.mode = "Dock"
	session.busy = false
	DiveService.rollLayout(session)
	Sync.profile(session)
	Net.push(session.player, "travel", { state = "done", world = world })
	return true, nil
end

function DiveService.onDied(session: Session)
	if session.mode == "Diving" or session.mode == "Rescue" then
		endDive(session, "died")
	end
end

function DiveService.onLeave(session: Session)
	if session.mode == "Diving" or session.mode == "Rescue" then
		endDive(session, if session.mode == "Rescue" then "blackout" else "leave")
	end
end

function DiveService.refreshOxygen(session: Session)
	if session.mode ~= "Diving" then
		session.oxygenMax = Economy.stat(session.profile.gear.equip, "tank")
		session.oxygen = session.oxygenMax
	end
end

function DiveService.init()
	Net.onEvent(Remotes.Collect, onCollect)
	Net.onEvent(Remotes.Hazard, onHazard)
	-- Keeps the Profile panel's playtime reasonably fresh even when nothing else syncs.
	task.spawn(function()
		while true do
			task.wait(30)
			for _, session in Sessions.all() do
				if session.ready then
					Sync.profile(session)
				end
			end
		end
	end)
	local accumulator = 0
	local step = 1 / Config.Dive.ServerHz
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < step then
			return
		end
		local elapsed = math.min(accumulator, 0.5)
		accumulator = 0
		for _, session in Sessions.all() do
			if session.ready then
				local ok, err = pcall(tick :: any, session, elapsed)
				if not ok then
					warn("[DiveService] tick failed: " .. tostring(err))
				end
			end
		end
	end)
end

return DiveService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">GearService</string>
            <string name="Source"><![CDATA[--!strict
-- Diving gear shop: buying and equipping gear pieces, and dressing characters in their gear.
-- Gear of a world can be bought once that world is unlocked; buying auto-equips the piece when
-- it beats the one worn in that slot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Economy = require(Shared.Economy)
local Gear = require(Shared.Data.Gear)
local GearModels = require(Shared.Models.GearModels)

local Net = require(script.Parent.Parent.Net)
local Sessions = require(script.Parent.Parent.Sessions)
local Sync = require(script.Parent.Parent.Sync)
local DiveService = require(script.Parent.DiveService)

local GearService = {}

type Session = Sessions.Session

function GearService.dress(session: Session)
	local character = session.player.Character
	if character then
		local ok, err = pcall(function()
			GearModels.dress(character, session.profile.gear.equip)
		end)
		if not ok then
			warn("[DeepDive] Could not dress gear: " .. tostring(err))
		end
	end
end

local function applied(session: Session, item: Gear.Item)
	if item.slot == "tank" then
		DiveService.refreshOxygen(session)
	end
	GearService.dress(session)
	Sync.profile(session)
end

local function buy(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	local item = if type(payload) == "table" and type(payload.key) == "string" then Gear.get(payload.key) else nil
	if not item then
		return false, "err.generic"
	end
	local profile = session.profile
	if item.world > profile.unlocked then
		return false, "err.locked"
	end
	if profile.gear.owned[item.key] then
		return false, "gearOwned"
	end
	local cost = Economy.gearCost(item.key) :: number
	if profile.coins < cost then
		return false, "notEnough"
	end
	profile.coins -= cost
	profile.gear.owned[item.key] = true
	local equipped = false
	if item.tier > Gear.tier(profile.gear.equip[item.slot]) then
		profile.gear.equip[item.slot] = item.key
		equipped = true
	end
	if profile.tutorial == 4 then
		profile.tutorial = 5
	end
	applied(session, item)
	return true, nil, { key = item.key, equipped = equipped, cost = cost }
end

local function equip(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	local item = if type(payload) == "table" and type(payload.key) == "string" then Gear.get(payload.key) else nil
	if not item or not session.profile.gear.owned[item.key] then
		return false, "err.generic"
	end
	session.profile.gear.equip[item.slot] = item.key
	applied(session, item)
	return true
end

function GearService.init()
	Net.on("BuyGear", buy)
	Net.on("EquipGear", equip)
end

return GearService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- Ranking boards: weekly, monthly and all-time coins earned, each an OrderedDataStore. The top
-- 10 of each (Directors listed apart) are published as JSON in ReplicatedStorage for the dock
-- boards, the podium statues and the player list. Holding a top-3 spot accrues hold time
-- towards the ranking tiers (Config.Tiers). When DataStores are unavailable (Studio without
-- API access) the boards rank the players in this server and hold time is kept in memory.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserService = game:GetService("UserService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Operators = require(Shared.Operators)
local Rankings = require(Shared.Rankings)
local Remotes = require(Shared.Remotes)

local ProfileStore = require(script.Parent.Parent.ProfileStore)
local Sessions = require(script.Parent.Parent.Sessions)

local LeaderboardService = {}

local TOP = 10
local GLOBAL_REFRESH = 60
local LOCAL_REFRESH = 8
local WRITE_INTERVAL = 120
local CREDIT_MIN = 45 -- seconds between hold-time credits (shared across servers)
local CREDIT_MAX = 300 -- never credit more than this at once (e.g. after every server was down)

export type Entry = { u: number, n: string, d: string, v: number, t: number, nt: number?, ns: number? }
type Row = { u: number, v: number }

local storeFailed = false
local ordered: { [string]: OrderedDataStore } = {}
local holdStore: GlobalDataStore? = nil
local clockStore: GlobalDataStore? = nil
local names: { [number]: { n: string, d: string } } = {}
local holds: { [number]: Rankings.Holds } = {}
local lastWrite: { [Player]: number } = {}
local lastValue: { [Player]: string } = {}
local lastLocalCredit = os.clock()
local published: StringValue
local latest: any = { global = false, boards = {}, directors = {} }

local function storesOn(): boolean
	return not storeFailed and not ProfileStore.memoryMode
end

local function storeName(board: string, now: number): string
	if board == "weekly" then
		return "DeepDive_Week_v1_" .. Rankings.weekId(now)
	elseif board == "monthly" then
		return "DeepDive_Month_v1_" .. Rankings.monthId(now)
	end
	return "DeepDive_TopDivers_v1"
end

local function orderedStore(board: string, now: number): OrderedDataStore?
	if not storesOn() then
		return nil
	end
	local name = storeName(board, now)
	local existing = ordered[name]
	if existing then
		return existing
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	if not ok then
		storeFailed = true
		return nil
	end
	ordered[name] = result
	return result
end

local function holdStores(): (GlobalDataStore?, GlobalDataStore?)
	if not storesOn() then
		return nil, nil
	end
	if not holdStore then
		local ok = pcall(function()
			holdStore = DataStoreService:GetDataStore("DeepDive_Holds_v1")
			clockStore = DataStoreService:GetDataStore("DeepDive_HoldClock_v1")
		end)
		if not ok then
			storeFailed = true
			return nil, nil
		end
	end
	return holdStore, clockStore
end

local function cleanHolds(value: any): Rankings.Holds
	if type(value) ~= "table" then
		return { w = 0, m = 0 }
	end
	return { w = math.max(0, tonumber(value.w) or 0), m = math.max(0, tonumber(value.m) or 0) }
end

local function holdsOf(userId: number): Rankings.Holds
	local cached = holds[userId]
	if cached then
		return cached
	end
	local store = holdStores()
	local value: any = nil
	if store then
		pcall(function()
			value = store:GetAsync(tostring(userId))
		end)
	end
	local result = cleanHolds(value)
	holds[userId] = result
	return result
end

local function scores(player: Player): { [string]: number }
	return {
		weekly = tonumber(player:GetAttribute("Weekly")) or 0,
		monthly = tonumber(player:GetAttribute("Monthly")) or 0,
		alltime = tonumber(player:GetAttribute("Lifetime")) or 0,
	}
end

-- Queues this player's scores for the ranking stores (rate limited unless forced).
function LeaderboardService.submit(player: Player, force: boolean?)
	local session = Sessions.get(player)
	if not session then
		return
	end
	local now = os.time()
	local values = scores(player)
	local signature = string.format("%d/%d/%d", values.weekly, values.monthly, values.alltime)
	if not force and (os.clock() - (lastWrite[player] or -math.huge) < WRITE_INTERVAL or lastValue[player] == signature) then
		return
	end
	if not storesOn() then
		return
	end
	lastWrite[player] = os.clock()
	lastValue[player] = signature
	local key = tostring(player.UserId)
	for board, value in values do
		local store = orderedStore(board, now)
		if store then
			task.spawn(function()
				pcall(function()
					store:SetAsync(key, math.floor(value))
				end)
			end)
		end
	end
end

local function fetch(board: string, now: number): ({ Row }, boolean)
	local store = orderedStore(board, now)
	if store then
		local rows: { Row } = {}
		local ok = pcall(function()
			local pages = store:GetSortedAsync(false, TOP + #Operators.list() + 1)
			for _, item in pages:GetCurrentPage() do
				local userId = tonumber(item.key)
				if userId and type(item.value) == "number" then
					table.insert(rows, { u = userId, v = item.value })
				end
			end
		end)
		if ok and #rows > 0 then
			return rows, true
		end
	end
	local rows: { Row } = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Lifetime") ~= nil then
			table.insert(rows, { u = player.UserId, v = math.floor(scores(player)[board]) })
		end
	end
	table.sort(rows, function(a, b)
		return a.v > b.v
	end)
	return rows, false
end

-- Directors who are not in the fetched top rows still get their own score on the board.
local function directorScore(board: string, now: number, userId: number): number?
	local player = Players:GetPlayerByUserId(userId)
	if player and player:GetAttribute("Lifetime") ~= nil then
		return math.floor(scores(player)[board])
	end
	local store = orderedStore(board, now)
	local value: any = nil
	if store then
		pcall(function()
			value = store:GetAsync(tostring(userId))
		end)
	end
	return if type(value) == "number" then value else nil
end

local function resolveNames(ids: { number })
	local missing = {}
	for _, id in ids do
		local player = Players:GetPlayerByUserId(id)
		if player then
			names[id] = { n = player.Name, d = player.DisplayName }
		elseif not names[id] then
			table.insert(missing, id)
		end
	end
	if #missing == 0 then
		return
	end
	pcall(function()
		for _, info in UserService:GetUserInfosByUserIdsAsync(missing) do
			names[info.Id] = { n = info.Username, d = info.DisplayName }
		end
	end)
	for _, id in missing do
		if not names[id] then
			local ok, name = pcall(function()
				return Players:GetNameFromUserIdAsync(id)
			end)
			local text = if ok and type(name) == "string" then name else "Diver"
			names[id] = { n = text, d = text }
		end
	end
end

-- Adds the time since the last credit to the hold time of everyone in a top-3 spot. Across
-- servers one shared clock key decides who credits each window, so time is never counted twice.
local function creditHolds(tops: { [string]: { number } }, global: boolean)
	local delta = 0
	local store, clock = holdStores()
	if global and store and clock then
		local now = os.time()
		pcall(function()
			clock:UpdateAsync("clock", function(old: any)
				local last = if type(old) == "table" then tonumber(old.t) else nil
				if last and now - last < CREDIT_MIN then
					return nil
				end
				delta = if last then math.clamp(now - last, 0, CREDIT_MAX) else 0
				return { t = now }
			end)
		end)
	elseif not global then
		local now = os.clock()
		delta = math.min(now - lastLocalCredit, CREDIT_MAX)
		lastLocalCredit = now
	end
	if delta <= 0 then
		return
	end
	local gains: { [number]: Rankings.Holds } = {}
	for board, ids in tops do
		for _, id in ids do
			local gain = gains[id] or { w = 0, m = 0 }
			if board == "weekly" then
				gain.w += delta
			else
				gain.m += delta
			end
			gains[id] = gain
		end
	end
	for id, gain in gains do
		local current = holdsOf(id)
		current.w += gain.w
		current.m += gain.m
		if global and store then
			task.spawn(function()
				pcall(function()
					store:UpdateAsync(tostring(id), function(old: any)
						local value = cleanHolds(old)
						value.w += gain.w
						value.m += gain.m
						holds[id] = { w = value.w, m = value.m }
						return value
					end)
				end)
			end)
		end
	end
end

local function entry(row: Row, board: string, rank: number): Entry
	local name = names[row.u] or { n = "Diver", d = "Diver" }
	local h = holds[row.u] or { w = 0, m = 0 }
	local e: Entry = { u = row.u, n = name.n, d = name.d, v = row.v, t = Rankings.tier(h) }
	if rank <= 3 and board ~= "alltime" then
		local nextTier, seconds = Rankings.nextTier(holdsOf(row.u), board)
		e.nt = nextTier
		e.ns = if seconds then math.ceil(seconds) else nil
	end
	return e
end

-- Rebuilds every board; returns true when the data came from the global stores.
function LeaderboardService.refresh(): boolean
	local now = os.time()
	local global = true
	local ranked: { [string]: { Row } } = {}
	local directors: { [string]: Row } = {}
	local ids: { number } = {}
	local operators = Operators.list()
	for _, board in Rankings.Boards do
		local rows, fromStore = fetch(board, now)
		global = global and fromStore
		local list: { Row } = {}
		for _, row in rows do
			if Operators.is(row.u) then
				directors[board] = directors[board] or row
			elseif #list < TOP then
				table.insert(list, row)
				table.insert(ids, row.u)
			end
		end
		if not directors[board] and operators[1] then
			local value = directorScore(board, now, operators[1])
			if value then
				directors[board] = { u = operators[1], v = value }
			end
		end
		if directors[board] then
			table.insert(ids, directors[board].u)
		end
		ranked[board] = list
	end

	local tops: { [string]: { number } } = { weekly = {}, monthly = {} }
	for board, list in tops do
		for i = 1, math.min(3, #ranked[board]) do
			table.insert(list, ranked[board][i].u)
		end
	end
	creditHolds(tops, global)
	resolveNames(ids)

	local data: any = { global = global, at = now, boards = {}, directors = {} }
	for _, board in Rankings.Boards do
		local entries = {}
		for rank, row in ranked[board] do
			entries[rank] = entry(row, board, rank)
		end
		data.boards[board] = { entries = entries, reset = Rankings.untilReset(board, now) }
		local director = directors[board]
		if director then
			local name = names[director.u] or { n = "Director", d = "Director" }
			data.directors[board] = { u = director.u, n = name.n, d = name.d, v = director.v }
		end
	end
	latest = data
	published.Value = HttpService:JSONEncode(data)
	for _, player in Players:GetPlayers() do
		local h = holds[player.UserId]
		if h then
			player:SetAttribute("Tier", Rankings.tier(h))
		end
	end
	return global
end

function LeaderboardService.latest(): any
	return latest
end

function LeaderboardService.init()
	local existing = ReplicatedStorage:FindFirstChild(Remotes.Board)
	if existing then
		existing:Destroy()
	end
	published = Instance.new("StringValue")
	published.Name = Remotes.Board
	published.Value = HttpService:JSONEncode(latest)
	published.Parent = ReplicatedStorage

	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			local h = holdsOf(player.UserId)
			if player.Parent then
				player:SetAttribute("Tier", Rankings.tier(h))
			end
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		LeaderboardService.submit(player, true)
		lastWrite[player] = nil
		lastValue[player] = nil
	end)
	task.spawn(function()
		task.wait(4)
		while true do
			for player in Sessions.all() do
				LeaderboardService.submit(player)
			end
			local global = LeaderboardService.refresh()
			task.wait(if global then GLOBAL_REFRESH else LOCAL_REFRESH)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--!strict
-- Egg hatching (server-side rolls), equipping, locking and deleting pets.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Layout = require(Shared.Layout)
local Profile = require(Shared.Profile)

local Net = require(script.Parent.Parent.Net)
local Sessions = require(script.Parent.Parent.Sessions)
local Sync = require(script.Parent.Parent.Sync)

local PetService = {}

type Session = Sessions.Session

local function nearEgg(session: Session, world: number): boolean
	local character = session.player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false
	end
	local dock = Layout.dock(world)
	local eggPosition = Layout.origin(world) + Vector3.new(dock.egg.X, dock.egg.Y + 4, dock.egg.Z)
	return (root.Position - eggPosition).Magnitude < 26
end

local function hatch(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	if type(payload) ~= "table" then
		return false, "err.generic"
	end
	local world = tonumber(payload.world)
	local count = tonumber(payload.count)
	if not world or not count or (count ~= 1 and count ~= 3 and count ~= 5) then
		return false, "err.generic"
	end
	world = math.floor(world)
	local profile = session.profile
	if world < 1 or world > profile.unlocked then
		return false, "err.locked"
	end
	if session.world ~= world or not nearEgg(session, world) then
		return false, "err.generic"
	end
	if Profile.petCount(profile) + count > Config.PetInventoryCap then
		return false, "inventoryFull"
	end
	local cost = Economy.eggCost(world) * count
	if profile.coins < cost then
		return false, "notEnough"
	end
	profile.coins -= cost
	local lucky = session.passes.LuckyEggs == true
	local results = {}
	for _ = 1, count do
		local key = Economy.rollPet(world, lucky, session.rng:NextNumber())
		profile.petSeq += 1
		local id = "P" .. tostring(profile.petSeq)
		local isNew = not profile.index[key]
		profile.pets[id] = { s = key, l = false }
		profile.index[key] = true
		profile.stats.hatched += 1
		table.insert(results, { id = id, key = key, new = isNew })
	end
	-- Auto-equip into free slots so new players see their pet immediately.
	local cap = Sessions.equipCap(session)
	for _, result in results do
		if #profile.equipped < cap then
			table.insert(profile.equipped, result.id)
		end
	end
	if profile.tutorial == 5 then
		profile.tutorial = 6
	end
	Sessions.publishPets(session)
	Sync.profile(session)
	return true, nil, { results = results, cost = cost }
end

local function sortedByBoost(profile: Profile.Data): { string }
	local ids = {}
	for id in profile.pets do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		local pa, pb = profile.pets[a], profile.pets[b]
		local ba, bb = Economy.petPower(pa.s, pa.m), Economy.petPower(pb.s, pb.m)
		if ba ~= bb then
			return ba > bb
		end
		return a < b
	end)
	return ids
end

local function equip(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or type(payload) ~= "table" or type(payload.id) ~= "string" then
		return false, "err.generic"
	end
	local profile = session.profile
	local id = payload.id :: string
	if not profile.pets[id] then
		return false, "err.generic"
	end
	local index = table.find(profile.equipped, id)
	if payload.on == false then
		if index then
			table.remove(profile.equipped, index)
		end
	elseif not index then
		if #profile.equipped >= Sessions.equipCap(session) then
			table.remove(profile.equipped, 1)
		end
		table.insert(profile.equipped, id)
	end
	Sessions.publishPets(session)
	Sync.profile(session)
	return true
end

local function equipBest(player: Player): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session then
		return false, "err.generic"
	end
	local profile = session.profile
	profile.equipped = {}
	for i, id in sortedByBoost(profile) do
		if i > Sessions.equipCap(session) then
			break
		end
		table.insert(profile.equipped, id)
	end
	Sessions.publishPets(session)
	Sync.profile(session)
	return true
end

local function unequipAll(player: Player): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session then
		return false, "err.generic"
	end
	session.profile.equipped = {}
	Sessions.publishPets(session)
	Sync.profile(session)
	return true
end

local function setLock(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or type(payload) ~= "table" or type(payload.id) ~= "string" or type(payload.locked) ~= "boolean" then
		return false, "err.generic"
	end
	local pet = session.profile.pets[payload.id]
	if not pet then
		return false, "err.generic"
	end
	pet.l = payload.locked
	Sync.profile(session)
	return true
end

local function deletePet(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or type(payload) ~= "table" or type(payload.id) ~= "string" then
		return false, "err.generic"
	end
	local profile = session.profile
	local pet = profile.pets[payload.id]
	if not pet or pet.l then
		return false, "err.generic"
	end
	if session.trade then
		return false, "tradeBusy"
	end
	profile.pets[payload.id] = nil
	local index = table.find(profile.equipped, payload.id)
	if index then
		table.remove(profile.equipped, index)
		Sessions.publishPets(session)
	end
	Sync.profile(session)
	return true
end

-- Enchanting: pay coins (or spend a Lucky Enchant) to add a random new mutation to a pet.
local function mutate(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	if type(payload) ~= "table" or type(payload.id) ~= "string" then
		return false, "err.generic"
	end
	local profile = session.profile
	local pet = profile.pets[payload.id]
	if not pet then
		return false, "err.generic"
	end
	if session.trade then
		return false, "tradeBusy"
	end
	local list = pet.m or {}
	if Economy.regularMutations(list) >= #Config.Mutations then
		return false, "mutateMax"
	end
	local key: string?
	local cost = 0
	if payload.lucky == true then
		if profile.enchants < 1 then
			return false, "noLucky"
		end
		key = Economy.rollMutation(list, session.rng:NextNumber(), Config.LuckyMutations) or Economy.rollMutation(list, session.rng:NextNumber())
		profile.enchants -= 1
	else
		cost = Economy.mutateCost(pet.s, pet.m) :: number
		if profile.coins < cost then
			return false, "notEnough"
		end
		profile.coins -= cost
		key = Economy.rollMutation(list, session.rng:NextNumber())
	end
	assert(key, "a mutation is always available below the cap")
	table.insert(list, key)
	pet.m = list
	if table.find(profile.equipped, payload.id) then
		Sessions.publishPets(session)
	end
	Sync.profile(session)
	return true, nil, { mutation = key, cost = cost, count = #list }
end

-- Trims equipped pets after a pass change or load.
function PetService.clampEquipped(session: Session)
	local cap = Sessions.equipCap(session)
	while #session.profile.equipped > cap do
		table.remove(session.profile.equipped)
	end
	Sessions.publishPets(session)
end

function PetService.init()
	Net.on("Hatch", hatch)
	Net.on("Equip", equip)
	Net.on("EquipBest", equipBest)
	Net.on("UnequipAll", unequipAll)
	Net.on("SetLock", setLock)
	Net.on("DeletePet", deletePet)
	Net.on("Mutate", mutate)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">PurchaseService</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes and developer products. Products are granted idempotently: the receipt id is
-- stored in the profile and saved before the purchase is acknowledged.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Profile = require(Shared.Profile)
local Gear = require(Shared.Data.Gear)
local Worlds = require(Shared.Data.Worlds)

local Net = require(script.Parent.Parent.Net)
local ProfileStore = require(script.Parent.Parent.ProfileStore)
local Sessions = require(script.Parent.Parent.Sessions)
local Sync = require(script.Parent.Parent.Sync)
local GearService = require(script.Parent.GearService)
local PetService = require(script.Parent.PetService)

local PurchaseService = {}

local passById: { [number]: string } = {}
local productById: { [number]: any } = {}

-- Replicated cosmetics (VIP crown, swim trail, nameplate border): recomputed on join and again
-- right after any pass purchase, so other clients see the change immediately.
local function applyCosmetics(session: Sessions.Session)
	local player = session.player
	local passes = session.passes
	player:SetAttribute("VIP", passes.VIPAura == true)
	player:SetAttribute("Trail", passes.SwimTrail == true)
	player:SetAttribute("Border", if passes.BorderGold then "Gold" elseif passes.BorderSilver then "Silver" else "")
end

function PurchaseService.loadPasses(session: Sessions.Session)
	for _, pass in Config.Passes do
		if pass.id > 0 then
			local ok, owned = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(session.player.UserId, pass.id)
			end)
			session.passes[pass.key] = ok and owned == true
		else
			session.passes[pass.key] = false
		end
	end
	applyCosmetics(session)
end

-- The pet with the least valuable boost, skipping locked ones (PetReroll's target).
local function weakestUnlockedPet(profile: any): string?
	local worst, worstBoost = nil, math.huge
	for id, pet in profile.pets do
		if not pet.l then
			local boost = Economy.petBoost(pet.s)
			if boost < worstBoost then
				worst, worstBoost = id, boost
			end
		end
	end
	return worst
end

-- A pet that does not yet have every mutation (GuaranteedMutation's target).
local function pickMutationTarget(profile: any): string?
	for id, pet in profile.pets do
		if Economy.regularMutations(pet.m) < #Config.Mutations then
			return id
		end
	end
	return nil
end

-- The rarest mutation not already in `existing` (Config.Mutations is ordered weakest to strongest).
local function rarestMissing(existing: { string }?): string?
	for i = #Config.Mutations, 1, -1 do
		local key = Config.Mutations[i].key
		if not (existing and table.find(existing, key)) then
			return key
		end
	end
	return nil
end

-- A flat, modest coin grant so a special product always delivers value even when its usual
-- target (an eligible pet, backpack room, ...) is not available right now.
local function fallbackCoins(profile: any, amount: number): () -> ()
	profile.coins += amount
	profile.lifetime += amount
	return function()
		profile.coins -= amount
		profile.lifetime -= amount
	end
end

-- Applies one of the five special products (InstantUnlock, TimedBoost, PetReroll,
-- GuaranteedMutation, BackpackFill). Returns nil for every other product. Otherwise returns a
-- revert closure (call it if the save that follows fails) plus a toast key/args to show.
local function applySpecialProduct(session: Sessions.Session, product: any): ((() -> ())?, string?, any?)
	local profile = session.profile
	if product.instantUnlock then
		local nextWorld = profile.unlocked + 1
		local previous = profile.worlds[tostring(profile.unlocked)]
		if nextWorld <= Config.WorldCount and previous and previous.cleared then
			profile.unlocked = nextWorld
			return function()
				profile.unlocked = nextWorld - 1
			end, "grantedUnlock", { n = nextWorld }
		end
		local coins = if profile.unlocked < Config.WorldCount
			then Economy.unlockCost(profile.unlocked + 1)
			else Economy.nice(Economy.unlockCost(Config.WorldCount) * 0.15)
		return fallbackCoins(profile, coins), "grantedCoins", { n = coins }
	elseif product.timedBoost then
		local before = profile.boostUntil
		local extendFrom = math.max(before, os.time())
		profile.boostUntil = extendFrom + Config.TimedBoostMinutes * 60
		return function()
			profile.boostUntil = before
		end, "grantedBoost", { n = Config.TimedBoostMinutes }
	elseif product.petReroll then
		local id = weakestUnlockedPet(profile)
		if id then
			local pet = profile.pets[id]
			local pastPet = Worlds.pets[pet.s]
			local world = if pastPet then pastPet.world else 1
			local newKey = Economy.rollPet(world, false, session.rng:NextNumber())
			local previousSpecies, previousMutations = pet.s, pet.m
			pet.s = newKey
			pet.m = nil
			profile.index[newKey] = true
			return function()
				pet.s = previousSpecies
				pet.m = previousMutations
			end, "grantedReroll", { key = newKey }
		end
		return fallbackCoins(profile, 200), "grantedCoins", { n = 200 }
	elseif product.guaranteedMutation then
		local id = pickMutationTarget(profile)
		local key = id and rarestMissing(profile.pets[id].m)
		if id and key then
			local pet = profile.pets[id]
			local hadList = pet.m ~= nil
			local list: { string } = pet.m or {}
			table.insert(list, key)
			pet.m = list
			return function()
				table.remove(list)
				if not hadList then
					pet.m = nil
				end
			end, "grantedMutation", { mutation = key }
		end
		return fallbackCoins(profile, 300), "grantedCoins", { n = 300 }
	elseif product.backpackFill then
		local capacity = math.floor(Economy.stat(profile.gear.equip, "pack"))
		local room = math.max(0, capacity - #profile.backpack)
		if room > 0 then
			local relic = Worlds.get(session.world).relics[1]
			for _ = 1, room do
				table.insert(profile.backpack, relic.key)
			end
			profile.relics[relic.key] = (profile.relics[relic.key] or 0) + room
			profile.stats.relics += room
			return function()
				for _ = 1, room do
					table.remove(profile.backpack)
				end
				profile.relics[relic.key] -= room
				profile.stats.relics -= room
			end,
				"grantedFill",
				{ n = room }
		end
		return fallbackCoins(profile, 150), "grantedCoins", { n = 150 }
	elseif product.godShark then
		local id = Profile.addPet(profile, "godShark", { "GOD" })
		Sessions.publishPets(session)
		return function()
			profile.pets[id] = nil
		end, "grantedGodShark", nil
	end
	return nil, nil, nil
end

local function processReceipt(receipt: any): Enum.ProductPurchaseDecision
	local product = productById[receipt.ProductId]
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not product or not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local session = Sessions.get(player)
	if not session or not session.ready then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = session.profile
	local receiptId = tostring(receipt.PurchaseId)
	if table.find(profile.receipts, receiptId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local revert, toastKey, toastArgs = applySpecialProduct(session, product)
	local coins, enchants = 0, 0
	if not toastKey then
		-- The original coin / enchant products (CoinsSmall..Large, LuckyEnchant, UnlockBoost).
		if product.unlockBoost then
			coins = if profile.unlocked < Config.WorldCount
				then Economy.unlockCost(profile.unlocked + 1)
				else Economy.nice(Economy.unlockCost(Config.WorldCount) * 0.15)
		elseif product.dives > 0 then
			coins = Economy.productCoins(product.dives, profile.unlocked)
		end
		enchants = product.enchants or 0
		profile.coins += coins
		profile.lifetime += coins
		profile.enchants += enchants
		revert = function()
			profile.coins -= coins
			profile.lifetime -= coins
			profile.enchants -= enchants
		end
	end

	table.insert(profile.receipts, receiptId)
	while #profile.receipts > 50 do
		table.remove(profile.receipts, 1)
	end
	ProfileStore.markDirty(player)
	if not ProfileStore.save(player, false) then
		if revert then
			revert()
		end
		local index = table.find(profile.receipts, receiptId)
		if index then
			table.remove(profile.receipts, index)
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if product.backpackFill or product.petReroll or product.guaranteedMutation then
		Sessions.publishPets(session)
	end
	Sync.profile(session)
	if toastKey then
		Net.push(player, "toast", { key = toastKey, kind = "gold", args = toastArgs })
	else
		Net.push(player, "toast", { key = "thanks", kind = "gold" })
		Net.push(player, "purchase", { coins = coins, enchants = enchants })
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function PurchaseService.init()
	for _, pass in Config.Passes do
		if pass.id > 0 then
			passById[pass.id] = pass.key
		end
	end
	for _, product in Config.Products do
		if product.id > 0 then
			productById[product.id] = product
		end
	end
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
		local key = passById[passId]
		local session = Sessions.get(player)
		if purchased and key and session then
			session.passes[key] = true
			local profile = session.profile
			if key == "PetSlots" then
				PetService.clampEquipped(session)
			elseif key == "StarterPack" and not profile.starterPackGranted then
				profile.starterPackGranted = true
				local reward = Config.StarterPackReward
				profile.coins += reward.coins
				profile.lifetime += reward.coins
				profile.enchants += reward.enchants or 0
				local item = Gear.get(reward.gearKey)
				if item then
					profile.gear.owned[item.key] = true
					if item.tier > Gear.tier(profile.gear.equip[item.slot]) then
						profile.gear.equip[item.slot] = item.key
					end
					GearService.dress(session)
				end
				task.spawn(ProfileStore.save, player, false)
			end
			applyCosmetics(session)
			Sync.profile(session)
			Net.push(player, "toast", { key = "thanks", kind = "gold" })
		end
	end)
end

return PurchaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict
-- Daily login, playtime and group-join reward claims. All timing and membership is checked here;
-- the client only asks.

local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Operators = require(Shared.Operators)
local Rewards = require(Shared.Rewards)

local Net = require(script.Parent.Parent.Net)
local ProfileStore = require(script.Parent.Parent.ProfileStore)
local Sessions = require(script.Parent.Parent.Sessions)
local Sync = require(script.Parent.Parent.Sync)

local RewardService = {}

local function finish(player: Player, session: Sessions.Session, reward: Rewards.Payout)
	Sync.profile(session)
	Net.push(player, "purchase", { coins = reward.coins, enchants = reward.enchants })
	task.spawn(ProfileStore.save, player, false)
end

local function claimDaily(player: Player): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	local ok, err, reward, day = Rewards.claimDaily(session.profile, os.time())
	if not ok or not reward then
		return false, err
	end
	finish(player, session, reward)
	return true, nil, { day = day, coins = reward.coins, enchants = reward.enchants, boostMinutes = reward.boostMinutes }
end

local function claimPlaytime(player: Player, payload: any): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	local tier = if type(payload) == "table" then tonumber(payload.tier) else nil
	if not tier then
		return false, "err.generic"
	end
	local ok, err, reward = Rewards.claimPlaytime(session.profile, math.floor(tier), os.time())
	if not ok or not reward then
		return false, err
	end
	finish(player, session, reward)
	return true, nil, { tier = tier, coins = reward.coins, enchants = reward.enchants, boostMinutes = reward.boostMinutes }
end

-- Player:IsInGroupAsync caches its answer for the whole session, so a join made a moment ago is
-- checked against the live group list instead.
local function inGroup(player: Player, groupId: number): boolean
	local ok, groups = pcall(function()
		return GroupService:GetGroupsAsync(player.UserId)
	end)
	if ok and type(groups) == "table" then
		for _, group in groups do
			if group.Id == groupId then
				return true
			end
		end
		return false
	end
	local cached, member = pcall(function()
		return player:IsInGroupAsync(groupId)
	end)
	return cached and member == true
end

local function claimGroup(player: Player): (boolean, string?, any)
	local session = Sessions.get(player)
	if not session or not session.ready then
		return false, "err.notReady"
	end
	local profile = session.profile
	local groupId = Operators.groupId()
	if groupId <= 0 then
		return false, "err.generic"
	elseif profile.groupRewarded then
		return false, "rewardClaimed"
	elseif not inGroup(player, groupId) then
		return false, "notInGroup"
	end
	profile.groupRewarded = true
	local reward =
		{ coins = Economy.productCoins(Config.GroupRewardDives, profile.unlocked), enchants = Config.GroupRewardEnchants, boostMinutes = 0 }
	Rewards.grant(profile, reward, os.time())
	finish(player, session, reward)
	return true, nil, { coins = reward.coins, enchants = reward.enchants }
end

function RewardService.init()
	Net.on("ClaimDaily", claimDaily)
	Net.on("ClaimPlaytime", claimPlaytime)
	Net.on("ClaimGroup", claimGroup)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">StatueService</string>
            <string name="Source"><![CDATA[--!strict
-- Podium statues behind each dock's ranking board: gold / silver / bronze podiums carry the top
-- 3 of every board (weekly, monthly, all-time) at once, and each client shows only the board it
-- picked on the dock board. The Director stands big behind the egg stand. Avatars are built from
-- each player's own outfit and prebuilt as soon as the rankings name them. Only worlds someone is
-- in get statues. Names and tier progress are podium attributes; clients draw the labels.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Build = require(Shared.Models.Build)
local Layout = require(Shared.Layout)
local Operators = require(Shared.Operators)
local Rankings = require(Shared.Rankings)

local Sessions = require(script.Parent.Parent.Sessions)
local WorldBuilder = require(script.Parent.Parent.World.WorldBuilder)
local LeaderboardService = require(script.Parent.LeaderboardService)

local StatueService = {}

local V = Vector3.new
local cf = CFrame.new

local PODIUMS = {
	-- rank, sideways offset (board space; + is the viewer's left), podium height, colour
	{ rank = 1, x = 0, height = 4.5, color = Color3.fromRGB(255, 205, 64) },
	{ rank = 2, x = 7.5, height = 3.2, color = Color3.fromRGB(205, 216, 228) },
	{ rank = 3, x = -7.5, height = 2.2, color = Color3.fromRGB(214, 140, 84) },
}
local PODIUM_SCALE = 1.25
local DIRECTOR_SCALE = 2.4

type Slot = { podium: BasePart, users: { [string]: number? }, scale: number }
type WorldStatues = { slots: { [number]: Slot }, director: Slot?, at: number }

local templates: { [number]: Model } = {}
local failed: { [number]: boolean } = {}
local building: { [number]: boolean } = {}
local placed: { [number]: WorldStatues } = {}
local cache: Folder

-- Starts building the avatar for `userId` (once); returns it when ready.
local function template(userId: number): Model?
	local existing = templates[userId]
	if existing or failed[userId] then
		return existing
	end
	if not building[userId] then
		building[userId] = true
		task.spawn(function()
			local ok, model = pcall(function()
				return Players:CreateHumanoidModelFromUserIdAsync(userId)
			end)
			if ok and model then
				for _, d in model:GetDescendants() do
					if d:IsA("Script") or d:IsA("LocalScript") then
						d:Destroy()
					end
				end
				local humanoid = model:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				end
				model.Name = "Avatar_" .. userId
				model.Parent = cache
				templates[userId] = model
			else
				failed[userId] = true
			end
			building[userId] = nil
		end)
	end
	return nil
end

local directorNames: { [number]: string } = {}
local function directorName(userId: number): string?
	if directorNames[userId] == nil then
		local ok, name = pcall(function()
			return Players:GetNameFromUserIdAsync(userId)
		end)
		directorNames[userId] = if ok and type(name) == "string" then name else ""
	end
	local name = directorNames[userId]
	return if name ~= "" then name else nil
end

local function groundY(position: Vector3, fallback: number, ignore: Instance): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { ignore }
	local hit = Workspace:Raycast(position + V(0, 40, 0), V(0, -80, 0), params)
	return if hit then hit.Position.Y else fallback
end

-- Removes decoration (rocks, plants, props) standing inside a box around `at` (half-widths along
-- its X and Z axes), so nothing pokes through the podiums.
local function clearDecor(worldFolder: Instance, at: CFrame, halfX: number, halfZ: number)
	local decor = worldFolder:FindFirstChild("Decor")
	if not decor then
		return
	end
	for _, item in decor:GetChildren() do
		local position: Vector3? = nil
		if item:IsA("Model") then
			local box = item:GetBoundingBox()
			position = box.Position
		elseif item:IsA("BasePart") then
			position = item.Position
		end
		if position then
			local localPoint = at:PointToObjectSpace(position)
			if math.abs(localPoint.X) <= halfX and math.abs(localPoint.Z) <= halfZ then
				item:Destroy()
			end
		end
	end
end

local function podium(folder: Folder, at: CFrame, size: number, height: number, color: Color3, name: string): BasePart
	local base = Build.block(folder, V(size, height, size), at * cf(0, height / 2, 0), color)
	base.Name = name
	base.Material = Enum.Material.Marble
	base.CanCollide = true
	base.CanQuery = true
	local trim = Build.block(folder, V(size + 0.6, 0.5, size + 0.6), at * cf(0, height + 0.25, 0), Color3.fromRGB(250, 250, 255))
	trim.CanCollide = true
	return base
end

local function build(world: number): WorldStatues?
	local built = WorldBuilder.get(world)
	if not built then
		return nil
	end
	local info = Layout.info(world)
	local dock = Layout.dock(world)
	local o = info.origin
	local spawnFlat = o + V(dock.spawn.X, info.landY, dock.spawn.Z)
	local folder = Instance.new("Folder")
	folder.Name = "Statues"
	folder.Parent = built.folder

	local boardAt = CFrame.lookAt(o + V(dock.board.X, info.landY, dock.board.Z), spawnFlat)
	-- One straight row left of the board (as you face it from the spawn), a little further back:
	-- every podium shares the row's facing and base height.
	local center = (boardAt * cf(24, 0, 10)).Position
	local baseY = groundY(center, info.landY, built.folder)
	local row = CFrame.lookAt(V(center.X, baseY, center.Z), V(spawnFlat.X, baseY, spawnFlat.Z))
	clearDecor(built.folder, row, 14, 8)
	local slots: { [number]: Slot } = {}
	for _, spec in PODIUMS do
		local part = podium(folder, row * cf(spec.x, 0, 0), 6, spec.height, spec.color, "Podium" .. spec.rank)
		part:SetAttribute("Rank", spec.rank)
		slots[spec.rank] = { podium = part, users = {}, scale = PODIUM_SCALE }
	end

	-- The Director, big, behind the egg stand (on the far side from the spawn).
	local director: Slot? = nil
	if Operators.list()[1] then
		local egg = o + V(dock.egg.X, info.landY, dock.egg.Z)
		local away = V(egg.X - spawnFlat.X, 0, egg.Z - spawnFlat.Z).Unit
		local spot = egg + away * 13
		local y = groundY(spot, info.landY, built.folder)
		local at = CFrame.lookAt(V(spot.X, y, spot.Z), V(spawnFlat.X, y, spawnFlat.Z))
		clearDecor(built.folder, at, 7, 7)
		local part = podium(folder, at, 9, 3, Color3.fromRGB(24, 18, 22), "DirectorPodium")
		local glow = Build.block(folder, V(9.4, 0.3, 9.4), at * cf(0, 0.15, 0), Color3.fromRGB(255, 40, 60))
		glow.Material = Enum.Material.Neon
		part:SetAttribute("Rank", 0)
		director = { podium = part, users = {}, scale = DIRECTOR_SCALE }
	end
	return { slots = slots, director = director, at = -1 }
end

-- Stands `userId`'s avatar on the podium as `name` (or clears it). Only the root is anchored, so
-- the avatar's joints assemble it in place instead of leaving its parts scattered. Returns false
-- while the avatar is still being built.
local function stand(slot: Slot, key: string, userId: number?): boolean
	local name = "Statue_" .. key
	local old = slot.podium:FindFirstChild(name)
	if slot.users[key] == userId and (old or not userId) then
		return true
	end
	if old then
		old:Destroy()
	end
	slot.users[key] = nil
	if not userId then
		return true
	end
	local source = template(userId)
	if not source then
		return failed[userId] == true
	end
	local statue = source:Clone()
	statue.Name = name
	statue:SetAttribute("Board", key)
	local root = statue:FindFirstChild("HumanoidRootPart") :: BasePart?
	for _, d in statue:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = d == root
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	pcall(function()
		statue:ScaleTo(slot.scale)
	end)
	local humanoid = statue:FindFirstChildOfClass("Humanoid")
	local lift = (if humanoid then humanoid.HipHeight else 2) + (if root then root.Size.Y / 2 else 1)
	local top = slot.podium.CFrame * cf(0, slot.podium.Size.Y / 2 + 0.5 + lift, 0)
	if root then
		statue.PrimaryPart = root
	end
	statue:PivotTo(top)
	statue.Parent = slot.podium
	slot.users[key] = userId
	return true
end

-- Board-namespaced labels ("weekly_Display", ...) so each client reads the board it picked.
local function label(part: BasePart, prefix: string, entry: any?)
	part:SetAttribute(prefix .. "UserId", if entry then entry.u else nil)
	part:SetAttribute(prefix .. "Display", if entry then entry.d else nil)
	part:SetAttribute(prefix .. "Username", if entry then entry.n else nil)
	part:SetAttribute(prefix .. "NextTier", if entry then entry.nt else nil)
	part:SetAttribute(prefix .. "NextSeconds", if entry then entry.ns else nil)
end

local function update(world: number, data: any)
	local statues = placed[world]
	if not statues then
		local made = build(world)
		if not made then
			return
		end
		statues = made
		placed[world] = made
	end
	local fresh = statues.at ~= data.at
	local done = true
	for _, board in Rankings.Boards do
		local section = data.boards and data.boards[board]
		local entries = if section and type(section.entries) == "table" then section.entries else {}
		for rank, slot in statues.slots do
			local entry = entries[rank]
			done = stand(slot, board, if entry then entry.u else nil) and done
			if fresh then
				label(slot.podium, board .. "_", entry)
			end
		end
	end
	local director = statues.director
	if director then
		local id = Operators.list()[1]
		stand(director, "director", id)
		if fresh or director.podium:GetAttribute("Username") == nil then
			local entry = data.directors and data.directors.alltime
			local username = if entry then entry.n else directorName(id)
			label(director.podium, "", { u = id, d = if entry then entry.d else username, n = username })
		end
	end
	if fresh and done then
		statues.at = data.at
	end
end

-- Builds every avatar the rankings name (and the Director's) ahead of time.
local function preload(data: any)
	local first = Operators.list()[1]
	if first then
		template(first)
	end
	for _, board in Rankings.Boards do
		local section = data.boards and data.boards[board]
		local entries = if section and type(section.entries) == "table" then section.entries else {}
		for rank = 1, math.min(3, #entries) do
			template(entries[rank].u)
		end
	end
end

function StatueService.init()
	cache = Instance.new("Folder")
	cache.Name = "DeepDiveStatues"
	cache.Parent = ServerStorage
	task.spawn(function()
		while true do
			local data = LeaderboardService.latest()
			preload(data)
			local occupied: { [number]: boolean } = {}
			for _, session in Sessions.all() do
				if session.ready then
					occupied[session.world] = true
				end
			end
			for world in occupied do
				local ok, err = pcall(function()
					update(world, data)
				end)
				if not ok then
					warn("[DeepDive] Statues for world " .. world .. " failed: " .. tostring(err))
				end
			end
			task.wait(0.5)
		end
	end)
end

return StatueService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--!strict
-- Pet trading between two players on the same server.
--   1. A sends a request; B accepts (or both request each other).
--   2. Each side picks up to Config.TradeMaxPets pets. Any change clears both "ready" flags.
--   3. When both are ready a short countdown runs; the swap happens only if nothing changed.
-- The swap re-validates ownership and inventory space, moves the pets (with their mutations)
-- under fresh ids, and saves both profiles immediately.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Profile = require(Shared.Profile)

local Net = require(script.Parent.Parent.Net)
local ProfileStore = require(script.Parent.Parent.ProfileStore)
local Sessions = require(script.Parent.Parent.Sessions)
local Sync = require(script.Parent.Parent.Sync)

local TradeService = {}

type Session = Sessions.Session
export type Trade = {
	a: Session,
	b: Session,
	offers: { [Player]: { string } },
	ready: { [Player]: boolean },
	token: number,
	countdownEnds: number?,
	closed: boolean,
}

-- requests[target][from] = expiry (os.clock)
local requests: { [Player]: { [Player]: number } } = {}
local lastRequest: { [Player]: number } = {}

local function partnerOf(trade: Trade, player: Player): Session
	return if trade.a.player == player then trade.b else trade.a
end

local function petList(profile: Profile.Data, ids: { string }): { any }
	local out = {}
	for _, id in ids do
		local pet = profile.pets[id]
		if pet then
			table.insert(out, { id = id, s = pet.s, m = pet.m })
		end
	end
	return out
end

local function view(trade: Trade, player: Player): any
	local me = if trade.a.player == player then trade.a else trade.b
	local other = partnerOf(trade, player)
	return {
		partner = { userId = other.player.UserId, name = other.player.DisplayName },
		mine = petList(me.profile, trade.offers[player]),
		theirs = petList(other.profile, trade.offers[other.player]),
		myReady = trade.ready[player] == true,
		theirReady = trade.ready[other.player] == true,
		countdown = if trade.countdownEnds then math.max(0, trade.countdownEnds - os.clock()) else nil,
	}
end

local function broadcast(trade: Trade)
	for _, session in { trade.a, trade.b } do
		Net.push(session.player, "trade", view(trade, session.player))
	end
end

local function close(trade: Trade, reason: string, extra: { [Player]: any }?)
	if trade.closed then
		return
	end
	trade.closed = true
	trade.token += 1
	for _, session in { trade.a, trade.b } do
		if session.trade == trade then
			session.trade = nil
		end
		local payload = { reason = reason, partner = partnerOf(trade, session.player).player.DisplayName }
		if extra and extra[session.player] then
			for key, value in extra[session.player] do
				(payload :: any)[key] = value
			end
		end
		Net.push(session.player, "tradeClosed", payload)
	end
end

local function changed(trade: Trade)
	trade.token += 1
	trade.ready = {}
	trade.countdownEnds = nil
end

-- Moves the listed pets from one profile to another under fresh ids.
local function move(from: Session, to: Session, ids: { string })
	for _, id in ids do
		local pet = from.profile.pets[id]
		from.profile.pets[id] = nil
		local index = table.find(from.profile.equipped, id)
		if index then
			table.remove(from.profile.equipped, index)
		end
		to.profile.petSeq += 1
		local newId = "P" .. tostring(to.profile.petSeq)
		to.profile.pets[newId] = { s = pet.s, l = false, m = if pet.m then table.clone(pet.m) else nil }
		to.profile.index[pet.s] = true
	end
end

local function valid(session: Session, ids: { string }): boolean
	for _, id in ids do
		local pet = session.profile.pets[id]
		if not pet or pet.l then
			return false
		end
	end
	return true
end

local function finalize(trade: Trade)
	local a, b = trade.a, trade.b
	local giveA, giveB = trade.offers[a.player], trade.offers[b.player]
	if not valid(a, giveA) or not valid(b, giveB) then
		changed(trade)
		broadcast(trade)
		return
	end
	if
		Profile.petCount(a.profile) - #giveA + #giveB > Config.PetInventoryCap
		or Profile.petCount(b.profile) - #giveB + #giveA > Config.PetInventoryCap
	then
		changed(trade)
		for _, session in { a, b } do
			Net.push(session.player, "toast", { key = "tradeFull", kind = "bad" })
		end
		broadcast(trade)
		return
	end
	if #giveA == 0 and #giveB == 0 then
		close(trade, "cancelled")
		return
	end
	move(a, b, giveA)
	move(b, a, giveB)
	close(trade, "done", { [a.player] = { got = #giveB, gave = #giveA }, [b.player] = { got = #giveA, gave = #giveB } })
	for _, session in { a, b } do
		Sessions.publishPets(session)
		Sync.profile(session)
		task.spawn(ProfileStore.save, session.player, false)
	end
end

local function start(a: Session, b: Session)
	local trade: Trade = {
		a = a,
		b = b,
		offers = { [a.player] = {}, [b.player] = {} },
		ready = {},
		token = 0,
		countdownEnds = nil,
		closed = false,
	}
	a.trade = trade
	b.trade = trade
	broadcast(trade)
end

local function sessionOf(player: Player): Session?
	local session = Sessions.get(player)
	if session and session.ready then
		return session
	end
	return nil
end

local function targetFrom(payload: any): Player?
	local userId = if type(payload) == "table" then tonumber(payload.userId) else nil
	return if userId then Players:GetPlayerByUserId(userId) else nil
end

local function request(player: Player, payload: any): (boolean, string?, any)
	local session = sessionOf(player)
	local target = targetFrom(payload)
	local other = target and sessionOf(target)
	if not session or not target or not other or target == player then
		return false, "err.generic"
	end
	if session.trade or other.trade then
		return false, "tradeBusy"
	end
	-- They already asked us: accepting by asking back.
	local incoming = requests[player]
	if incoming and incoming[target] and incoming[target] > os.clock() then
		incoming[target] = nil
		start(session, other)
		return true, nil, { started = true }
	end
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < 3 then
		return false, "err.busy"
	end
	lastRequest[player] = now
	local pending = requests[target] or {}
	requests[target] = pending
	pending[player] = now + Config.TradeRequestSeconds
	Net.push(target, "tradeRequest", { userId = player.UserId, name = player.DisplayName, seconds = Config.TradeRequestSeconds })
	return true, nil, { started = false }
end

local function respond(player: Player, payload: any): (boolean, string?, any)
	local session = sessionOf(player)
	local from = targetFrom(payload)
	local pending = requests[player]
	if not session or not from or not pending or not pending[from] then
		return false, "tradeExpired"
	end
	local expired = pending[from] < os.clock()
	pending[from] = nil
	if expired then
		return false, "tradeExpired"
	end
	if payload.accept ~= true then
		Net.push(from, "toast", { key = "tradeDeclined", kind = "bad" })
		return true
	end
	local other = sessionOf(from)
	if not other then
		return false, "tradeExpired"
	end
	if session.trade or other.trade then
		return false, "tradeBusy"
	end
	start(other, session)
	return true
end

local function offer(player: Player, payload: any): (boolean, string?, any)
	local session = sessionOf(player)
	local trade: Trade? = session and session.trade
	if not session or not trade or type(payload) ~= "table" or type(payload.ids) ~= "table" then
		return false, "err.generic"
	end
	local ids: { string } = {}
	for _, id in payload.ids do
		if type(id) ~= "string" or table.find(ids, id) then
			return false, "err.generic"
		end
		local pet = session.profile.pets[id]
		if not pet then
			return false, "err.generic"
		end
		if pet.l then
			return false, "tradeLocked"
		end
		table.insert(ids, id)
	end
	if #ids > Config.TradeMaxPets then
		return false, "tradeMax"
	end
	trade.offers[player] = ids
	changed(trade)
	broadcast(trade)
	return true
end

local function ready(player: Player, payload: any): (boolean, string?, any)
	local session = sessionOf(player)
	local trade: Trade? = session and session.trade
	if not session or not trade or type(payload) ~= "table" or type(payload.ready) ~= "boolean" then
		return false, "err.generic"
	end
	trade.ready[player] = payload.ready
	trade.token += 1
	trade.countdownEnds = nil
	local other = partnerOf(trade, player)
	if trade.ready[player] and trade.ready[other.player] then
		local token = trade.token
		trade.countdownEnds = os.clock() + Config.TradeCountdown
		task.delay(Config.TradeCountdown, function()
			if not trade.closed and trade.token == token then
				finalize(trade)
			end
		end)
	end
	broadcast(trade)
	return true
end

local function cancel(player: Player): (boolean, string?, any)
	local session = sessionOf(player)
	local trade: Trade? = session and session.trade
	if trade then
		close(trade, "cancelled")
	end
	return true
end

function TradeService.onLeave(session: Session)
	local trade: Trade? = session.trade
	if trade then
		close(trade, "left")
	end
	requests[session.player] = nil
	lastRequest[session.player] = nil
	for _, pending in requests do
		pending[session.player] = nil
	end
end

function TradeService.init()
	Net.on("TradeRequest", request)
	Net.on("TradeRespond", respond)
	Net.on("TradeOffer", offer)
	Net.on("TradeReady", ready)
	Net.on("TradeCancel", cancel)
end

return TradeService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Sessions</string>
          <string name="Source"><![CDATA[--!strict
-- Runtime state per connected player (the persistent part lives in `profile`).

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Economy = require(Shared.Economy)
local Profile = require(Shared.Profile)

local Sessions = {}

export type Session = {
	player: Player,
	profile: Profile.Data,
	world: number,
	ready: boolean,
	mode: string, -- "Dock" | "Diving" | "Rescue" | "Travel"
	oxygen: number,
	oxygenMax: number,
	layoutId: number,
	relics: { [number]: string },
	chestActive: boolean,
	chestCarried: boolean,
	diveStart: number, -- backpack size when the current dive began
	lastSell: number,
	surfacedFor: number,
	syncTimer: number,
	lastHazard: number,
	maxDepth: number,
	passes: { [string]: boolean },
	rng: Random,
	busy: boolean,
	trade: any?, -- the open trade this player is in (TradeService)
}

local sessions: { [Player]: Session } = {}

function Sessions.create(player: Player, profile: Profile.Data): Session
	local session: Session = {
		player = player,
		profile = profile,
		world = profile.world,
		ready = false,
		mode = "Dock",
		oxygen = 0,
		oxygenMax = 0,
		layoutId = 0,
		relics = {},
		chestActive = false,
		chestCarried = false,
		diveStart = 0,
		lastSell = 0,
		surfacedFor = 0,
		syncTimer = 0,
		lastHazard = 0,
		maxDepth = 0,
		passes = {},
		rng = Random.new(),
		busy = false,
		trade = nil,
	}
	session.oxygenMax = Economy.stat(profile.gear.equip, "tank")
	session.oxygen = session.oxygenMax
	sessions[player] = session
	return session
end

function Sessions.get(player: Player): Session?
	return sessions[player]
end

function Sessions.remove(player: Player)
	sessions[player] = nil
end

function Sessions.all(): { [Player]: Session }
	return sessions
end

function Sessions.equipCap(session: Session): number
	return Config.PetEquipBase + (if session.passes.PetSlots then Config.PetEquipPass else 0)
end

function Sessions.boostSum(session: Session): number
	local sum = 0
	for _, id in session.profile.equipped do
		local pet = session.profile.pets[id]
		if pet then
			sum += Economy.petPower(pet.s, pet.m)
		end
	end
	return sum
end

function Sessions.multiplier(session: Session): number
	local boosted = session.profile.boostUntil > os.time()
	return Economy.coinMultiplier(Sessions.boostSum(session), session.passes.DoubleCoins == true, boosted)
end

-- Equipped pets as JSON ("species" or "species|Gold,Lava" with mutations), replicated so every
-- client can render followers.
function Sessions.publishPets(session: Session)
	local keys = {}
	for _, id in session.profile.equipped do
		local pet = session.profile.pets[id]
		if pet then
			table.insert(keys, if pet.m and #pet.m > 0 then pet.s .. "|" .. table.concat(pet.m, ",") else pet.s)
		end
	end
	session.player:SetAttribute("Pets", HttpService:JSONEncode(keys))
end

return Sessions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Sync</string>
          <string name="Source"><![CDATA[--!strict
-- Pushes profile snapshots to the owning client and keeps leaderstats in step.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Rankings = require(Shared.Rankings)

local Net = require(script.Parent.Net)
local ProfileStore = require(script.Parent.ProfileStore)
local Sessions = require(script.Parent.Sessions)

local Sync = {}

function Sync.view(session: Sessions.Session)
	return {
		profile = session.profile,
		passes = session.passes,
		world = session.world,
		memory = ProfileStore.memoryMode,
	}
end

-- Public stats as player attributes (nameplates, the Tab list and the global board read these)
-- plus classic leaderstats for tools that expect them.
function Sync.stats(session: Sessions.Session)
	local player = session.player
	local profile = session.profile
	player:SetAttribute("Coins", profile.coins)
	player:SetAttribute("Relics", profile.stats.relics)
	player:SetAttribute("Lifetime", profile.lifetime)
	local weekly, monthly = Rankings.roll(profile, os.time())
	player:SetAttribute("Weekly", weekly)
	player:SetAttribute("Monthly", monthly)
	local stats: Instance? = player:FindFirstChild("leaderstats")
	if not stats then
		local folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		local coins = Instance.new("StringValue")
		coins.Name = "Coins"
		coins.Parent = folder
		local relics = Instance.new("IntValue")
		relics.Name = "Relics"
		relics.Parent = folder
		folder.Parent = player
		stats = folder
	end
	assert(stats, "leaderstats")
	local coinsValue = stats:FindFirstChild("Coins") :: StringValue?
	local relicsValue = stats:FindFirstChild("Relics") :: IntValue?
	if coinsValue then
		coinsValue.Value = Format.short(profile.coins)
	end
	if relicsValue then
		relicsValue.Value = profile.stats.relics
	end
end

Sync.leaderstats = Sync.stats

-- Call after any profile change.
function Sync.profile(session: Sessions.Session)
	ProfileStore.markDirty(session.player)
	Sync.stats(session)
	Net.push(session.player, "profile", Sync.view(session))
end

return Sync
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="48">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Decor</string>
            <string name="Source"><![CDATA[--!strict
-- Themed decoration kits placed procedurally on each island and inside its lagoon.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Build = require(Shared.Models.Build)
local Color = require(Shared.Color)
local Layout = require(Shared.Layout)
local RelicModels = require(Shared.Models.RelicModels)
local Worlds = require(Shared.Data.Worlds)

local Decor = {}

local V = Vector3.new
local cf = CFrame.new
local ang = CFrame.Angles
local rad = math.rad

export type Pal = {
	a1: Color3,
	a2: Color3,
	corals: { Color3 },
	rock: Color3,
	land: Color3,
	sand: Color3,
	leaf: Color3,
	wood: Color3,
	bone: Color3,
	glow: boolean,
}

export type Ctx = {
	parent: Instance,
	rng: Random,
	pal: Pal,
	world: number,
	info: Layout.Info,
	lights: number,
	maxLights: number,
}

local MAX_LIGHTS = 26

local function pick<T>(rng: Random, list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

local function vary(rng: Random, color: Color3, amount: number): Color3
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(
		(h + rng:NextNumber(-amount, amount) * 0.1) % 1,
		math.clamp(s + rng:NextNumber(-amount, amount), 0, 1),
		math.clamp(v + rng:NextNumber(-amount, amount), 0, 1)
	)
end

local function addLight(ctx: Ctx, part: BasePart, color: Color3, range: number, brightness: number)
	if ctx.lights >= ctx.maxLights then
		return
	end
	ctx.lights += 1
	Build.light(part, color, range, brightness)
end

local function solid(part: BasePart): BasePart
	part.CanCollide = true
	part.CanQuery = true
	return part
end

local function group(ctx: Ctx, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = ctx.parent
	return model
end

-- Square pyramid out of four wedges (tall faces meet in the middle).
local function pyramid(parent: Instance, base: CFrame, width: number, height: number, color: Color3, material: Enum.Material?)
	for k = 0, 3 do
		local wedge = Build.wedge(parent, V(width, height, width / 2), base * ang(0, k * math.pi / 2, 0) * cf(0, height / 2, -width / 4), color)
		if material then
			wedge.Material = material
		end
	end
end

local function fire(part: BasePart, color: Color3)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
	emitter.Color = ColorSequence.new(color, Color3.fromRGB(255, 80, 40))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0.1) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Rate = 18
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(12, 12)
	emitter.Parent = part
end

local function smoke(part: BasePart, color: Color3, bubbles: boolean)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = if bubbles then "rbxasset://textures/particles/sparkles_main.dds" else "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = if bubbles then 0.6 else 0.1
	emitter.Size = if bubbles
		then NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.6) })
		else NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(2.5, 4)
	emitter.Rate = if bubbles then 10 else 5
	emitter.Speed = NumberRange.new(4, 7)
	emitter.SpreadAngle = Vector2.new(10, 10)
	emitter.Parent = part
end

-- Swaying plants pivot around their base so the client can rock them without sliding.
local function tagSway(model: Model, strength: number, base: CFrame)
	model.WorldPivot = base
	model:SetAttribute("Sway", strength)
end

-- Elements -------------------------------------------------------------------------------------

local E: { [string]: (Ctx, CFrame) -> () } = {}

E.palm = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Palm")
	local height = rng:NextNumber(14, 20)
	local lean = rng:NextNumber(-14, 14)
	local trunk = Color3.fromRGB(150, 108, 68)
	local frame = at * ang(0, rng:NextNumber(0, math.pi * 2), 0)
	local segments = 5
	for i = 1, segments do
		local segH = height / segments
		frame = frame * ang(rad(lean / segments), 0, 0)
		Build.column(m, segH + 0.3, 1.35 - i * 0.12, frame * cf(0, segH / 2, 0), if i % 2 == 0 then trunk else Color.darken(trunk, 0.12))
		frame = frame * cf(0, segH, 0)
	end
	for i = 1, 7 do
		local yaw = i / 7 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local base = frame * ang(0, yaw, 0) * ang(rad(-18), 0, 0)
		local leaf = vary(rng, ctx.pal.leaf, 0.08)
		Build.block(m, V(1.8, 0.2, 4.2), base * cf(0, 0, -2.1), leaf)
		Build.block(m, V(1.4, 0.2, 3.4), base * cf(0, 0, -4) * ang(rad(-40), 0, 0) * cf(0, 0, -1.6), Color.darken(leaf, 0.1))
	end
	for i = 1, 3 do
		Build.ball(m, 0.9, frame * ang(0, i * 2.1, 0) * cf(0.6, -0.7, 0), Color3.fromRGB(110, 70, 40))
	end
end

E.pine = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Pine")
	local scale = rng:NextNumber(0.8, 1.3)
	local green = vary(rng, Color3.fromRGB(46, 110, 78), 0.05)
	Build.column(m, 3 * scale, 1.2 * scale, at * cf(0, 1.5 * scale, 0), Color3.fromRGB(96, 66, 44))
	local y = 2.5 * scale
	for tier = 1, 3 do
		local w = (10 - tier * 2.4) * scale
		local h = (5.5 - tier * 0.6) * scale
		pyramid(m, at * cf(0, y, 0), w, h, green)
		if Worlds.get(ctx.world).kit == "ice" then
			pyramid(m, at * cf(0, y + h * 0.55, 0), w * 0.5, h * 0.45, Color3.fromRGB(244, 250, 255))
		end
		y += h * 0.62
	end
end

E.deadTree = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "DeadTree")
	local color = Color.darken(ctx.pal.rock, 0.3)
	local height = rng:NextNumber(8, 13)
	local frame = at * ang(0, rng:NextNumber(0, 6.28), 0)
	Build.column(m, height, 1.1, frame * cf(0, height / 2, 0), color)
	for i = 1, 4 do
		local y = height * (0.45 + i * 0.12)
		local branch = frame * cf(0, y, 0) * ang(0, i * 1.7, 0) * ang(rad(55), 0, 0)
		Build.column(m, 4 - i * 0.5, 0.45, branch * cf(0, (4 - i * 0.5) / 2, 0), color)
	end
end

E.rock = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Rock")
	local size = rng:NextNumber(2.5, 6)
	local color = vary(rng, ctx.pal.rock, 0.06)
	for i = 1, rng:NextInteger(2, 3) do
		local s = size * rng:NextNumber(0.6, 1)
		local part = Build.ellipsoid(
			m,
			V(s * 1.3, s * 0.8, s),
			at
				* cf(rng:NextNumber(-1, 1) * size * 0.4, s * 0.25, rng:NextNumber(-1, 1) * size * 0.4)
				* ang(0, rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
			color
		)
		part.Material = Enum.Material.Slate
		if i == 1 and size > 4 then
			solid(part)
		end
	end
end

E.umbrella = function(ctx, at)
	local m = group(ctx, "Umbrella")
	Build.column(m, 7, 0.3, at * cf(0, 3.5, 0) * ang(rad(8), 0, 0), Color3.fromRGB(240, 240, 240))
	local top = at * cf(0.4, 7, -0.4)
	for k = 0, 7 do
		local color = if k % 2 == 0 then ctx.pal.a1 else Color3.fromRGB(255, 255, 255)
		Build.wedge(m, V(3.4, 1.2, 4), top * ang(0, k * math.pi / 4, 0) * cf(0, -0.6, -2), color)
	end
	Build.block(m, V(3, 0.1, 5.5), at * cf(3, 0.05, 1) * ang(0, rad(20), 0), ctx.pal.a2)
end

E.torch = function(ctx, at)
	local m = group(ctx, "Torch")
	Build.column(m, 5, 0.35, at * cf(0, 2.5, 0), Color3.fromRGB(120, 80, 50))
	Build.column(m, 0.8, 1.0, at * cf(0, 5.2, 0), Color3.fromRGB(80, 60, 45))
	local flame = Build.ball(m, 0.9, at * cf(0, 5.9, 0), Color3.fromRGB(255, 170, 60))
	flame.Material = Enum.Material.Neon
	fire(flame, Color3.fromRGB(255, 200, 80))
	addLight(ctx, flame, Color3.fromRGB(255, 170, 90), 16, 1.6)
end

E.lantern = function(ctx, at)
	local m = group(ctx, "Lantern")
	local glow = if ctx.pal.glow then ctx.pal.corals[1] else Color3.fromRGB(255, 200, 110)
	Build.column(m, 6, 0.3, at * cf(0, 3, 0), Color3.fromRGB(60, 56, 64))
	Build.block(m, V(1.2, 0.2, 1.2), at * cf(0, 6, 0), Color3.fromRGB(60, 56, 64))
	local core = Build.block(m, V(0.8, 1.1, 0.8), at * cf(0, 5.35, 0), glow)
	core.Material = Enum.Material.Neon
	addLight(ctx, core, glow, 14, 1.4)
end

E.seagrass = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Seagrass")
	for _ = 1, rng:NextInteger(5, 8) do
		local h = rng:NextNumber(2, 5)
		local color = vary(rng, ctx.pal.leaf, 0.1)
		local base = at
			* cf(rng:NextNumber(-1.2, 1.2), 0, rng:NextNumber(-1.2, 1.2))
			* ang(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 6), rng:NextNumber(-0.25, 0.25))
		Build.block(m, V(0.5, h, 0.18), base * cf(0, h / 2, 0), color)
	end
	tagSway(m, 0.12, at)
end

E.kelp = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Kelp")
	local depth = -at.Position.Y
	local height = math.clamp(depth - rng:NextNumber(3, 8), 6, 42)
	local stalk = Color3.fromRGB(120, 110, 40)
	local leaf = vary(rng, Color3.fromRGB(96, 150, 54), 0.08)
	local segments = math.max(2, math.floor(height / 4))
	local frame = at
	for i = 1, segments do
		local segH = height / segments
		frame = frame * ang(rng:NextNumber(-0.06, 0.06), 0, rng:NextNumber(-0.06, 0.06))
		Build.column(m, segH + 0.2, 0.35, frame * cf(0, segH / 2, 0), stalk)
		local side = if i % 2 == 0 then 1 else -1
		Build.ellipsoid(m, V(2.4, 0.18, 0.9), frame * cf(side * 1.2, segH * 0.6, 0) * ang(0, 0, rad(side * 25)), leaf)
		frame = frame * cf(0, segH, 0)
	end
	local bulb = Build.ball(m, 0.9, frame, Color3.fromRGB(150, 140, 60))
	bulb.Name = "Bulb"
	tagSway(m, 0.25, at)
end

E.coral = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Coral")
	local color = vary(rng, pick(rng, ctx.pal.corals), 0.06)
	local tip = Color.lighten(color, 0.35)
	local kind = rng:NextInteger(1, 5)
	local neon = ctx.pal.glow
	local function finish(part: BasePart)
		if neon then
			part.Material = Enum.Material.Neon
		end
	end
	if kind == 1 then
		local size = rng:NextNumber(2.2, 4)
		Build.ball(m, size, at * cf(0, size * 0.35, 0), color)
		for i = 0, 4 do
			finish(Build.ellipsoid(m, V(size * 1.02, 0.14, size * 0.2), at * cf(0, size * 0.35, 0) * ang(rad(i * 36), rad(i * 50), 0), tip))
		end
	elseif kind == 2 then
		local frame = at * ang(0, rng:NextNumber(0, 6), 0)
		Build.column(m, 1.4, 0.6, frame * cf(0, 0.7, 0), color)
		for i = 1, 5 do
			local branch = frame * cf(0, 1.1, 0) * ang(0, i * 1.26, 0) * ang(rad(rng:NextNumber(18, 45)), 0, 0)
			local len = rng:NextNumber(1.6, 3)
			Build.column(m, len, 0.42, branch * cf(0, len / 2, 0), color)
			finish(Build.ball(m, 0.55, branch * cf(0, len, 0), tip))
		end
	elseif kind == 3 then
		local fan =
			Build.ellipsoid(m, V(rng:NextNumber(3, 5), rng:NextNumber(3, 4.5), 0.18), at * cf(0, 2, 0) * ang(0, rng:NextNumber(0, 6), 0), color)
		fan.Transparency = 0.1
		for i = -2, 2 do
			finish(Build.block(m, V(0.12, 3, 0.22), fan.CFrame * ang(0, 0, rad(i * 18)) * cf(0, -0.3, 0), tip))
		end
	elseif kind == 4 then
		for _ = 1, rng:NextInteger(3, 5) do
			local h = rng:NextNumber(1.5, 3.5)
			local offset = cf(rng:NextNumber(-0.9, 0.9), 0, rng:NextNumber(-0.9, 0.9))
			Build.column(m, h, 0.8, at * offset * cf(0, h / 2, 0), color)
			finish(Build.column(m, 0.12, 0.62, at * offset * cf(0, h + 0.02, 0), Color.darken(color, 0.4)))
		end
	else
		Build.column(m, 1, 1.4, at * cf(0, 0.5, 0), color)
		for i = 1, 12 do
			local a = i / 12 * math.pi * 2
			finish(
				Build.ellipsoid(
					m,
					V(0.24, 1.3, 0.24),
					at * cf(math.cos(a) * 0.45, 1.4, math.sin(a) * 0.45) * ang(math.sin(a) * 0.5, 0, -math.cos(a) * 0.5),
					tip
				)
			)
		end
	end
	if neon and rng:NextNumber() < 0.35 then
		local root = m:FindFirstChildWhichIsA("BasePart")
		if root then
			addLight(ctx, root, tip, 10, 1.2)
		end
	end
end

E.anemone = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Anemone")
	local color = vary(rng, pick(rng, ctx.pal.corals), 0.05)
	Build.column(m, 1.2, 1.6, at * cf(0, 0.6, 0), Color.darken(color, 0.2))
	for i = 1, 16 do
		local a = i / 16 * math.pi * 2
		local r = if i % 2 == 0 then 0.6 else 0.3
		Build.ellipsoid(
			m,
			V(0.22, 1.1, 0.22),
			at * cf(math.cos(a) * r, 1.6, math.sin(a) * r) * ang(math.sin(a) * 0.4, 0, -math.cos(a) * 0.4),
			Color.lighten(color, 0.3)
		)
	end
	tagSway(m, 0.08, at)
end

E.shell = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Shell")
	local model = Build.model("S")
	RelicModels.Shapes.shell(model, pick(rng, ctx.pal.corals), Color3.fromRGB(255, 240, 230))
	Build.fit(model, rng:NextNumber(1.6, 2.6))
	model:PivotTo(at * cf(0, 0.4, 0) * ang(rad(-70), rng:NextNumber(0, 6), 0))
	model.Parent = m
end

E.starfish = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Starfish")
	local model = Build.model("S")
	RelicModels.Shapes.starfish(model, pick(rng, ctx.pal.corals), Color3.fromRGB(255, 230, 200))
	Build.fit(model, rng:NextNumber(1.4, 2.2))
	model:PivotTo(at * cf(0, 0.2, 0) * ang(rad(-90), rng:NextNumber(0, 6), 0))
	model.Parent = m
end

E.barrel = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Barrel")
	local tilt = if rng:NextNumber() < 0.4 then ang(rad(90), rng:NextNumber(0, 6), 0) * cf(0, 0, 0) else ang(0, rng:NextNumber(0, 6), 0)
	local frame = at * cf(0, 1.1, 0) * tilt
	local body = Build.column(m, 2.2, 1.8, frame, ctx.pal.wood)
	body.Material = Enum.Material.WoodPlanks
	for _, y in { -0.7, 0.7 } do
		Build.column(m, 0.2, 1.88, frame * cf(0, y, 0), Color3.fromRGB(70, 66, 70))
	end
end

E.crate = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Crate")
	local size = rng:NextNumber(2, 2.8)
	local frame = at * cf(0, size / 2, 0) * ang(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6), rng:NextNumber(-0.2, 0.2))
	local box = Build.block(m, V(size, size, size), frame, ctx.pal.wood)
	box.Material = Enum.Material.WoodPlanks
	for _, y in { -0.35, 0.35 } do
		Build.block(m, V(size + 0.1, 0.25, size + 0.1), frame * cf(0, size * y, 0), Color.darken(ctx.pal.wood, 0.3))
	end
end

E.cannon = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Cannon")
	local frame = at * ang(0, rng:NextNumber(0, 6), 0)
	local barrel = Build.cylinder(m, 4, 1.1, frame * cf(0, 1.2, 0) * ang(0, 0, rad(12)), Color3.fromRGB(58, 58, 64))
	barrel.Material = Enum.Material.Metal
	Build.block(m, V(3, 0.8, 1.6), frame * cf(0, 0.4, 0), ctx.pal.wood)
	for _, z in { -0.9, 0.9 } do
		Build.cylinder(m, 0.3, 1.2, frame * cf(0, 0.6, z) * ang(0, rad(90), 0), Color.darken(ctx.pal.wood, 0.3))
	end
end

E.anchor = function(ctx, at)
	local m = group(ctx, "Anchor")
	local frame = at * ang(rad(70), ctx.rng:NextNumber(0, 6), 0)
	local color = Color3.fromRGB(70, 70, 78)
	Build.column(m, 6, 0.6, frame * cf(0, 3, 0), color)
	Build.block(m, V(3.4, 0.5, 0.5), frame * cf(0, 5.2, 0), color)
	for _, side in { -1, 1 } do
		Build.column(m, 2.4, 0.5, frame * cf(side * 1.1, 0.8, 0) * ang(0, 0, rad(side * 50)), color)
		Build.spike(m, 1.2, 0.6, frame * cf(side * 1.9, 1.7, 0) * ang(rad(90), 0, 0), color)
	end
end

E.hull = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Shipwreck")
	local frame = at * ang(0, rng:NextNumber(0, 6), rad(rng:NextNumber(-14, 14)))
	local wood = ctx.pal.wood
	local dark = Color.darken(wood, 0.3)
	local length = 26
	local keel = Build.block(m, V(1.2, 1.2, length), frame * cf(0, 0.6, 0), dark)
	solid(keel)
	for _, side in { -1, 1 } do
		local bottom = Build.block(m, V(4.5, 0.6, length - 2), frame * cf(side * 2.3, 1.1, 0) * ang(0, 0, rad(side * -18)), wood)
		bottom.Material = Enum.Material.WoodPlanks
		solid(bottom)
		local wallLength = if side == 1 then length - 4 else length * 0.55
		local wall = Build.block(
			m,
			V(0.6, 5, wallLength),
			frame * cf(side * 4.4, 3.6, if side == 1 then 0 else -length * 0.2) * ang(0, 0, rad(side * -8)),
			wood
		)
		wall.Material = Enum.Material.WoodPlanks
		solid(wall)
	end
	for i = -2, 2 do
		for _, side in { -1, 1 } do
			Build.column(m, 6, 0.5, frame * cf(side * 3.4, 3.2, i * 4.5) * ang(0, 0, rad(side * -25)), dark)
		end
	end
	local deck = Build.block(m, V(8, 0.5, 8), frame * cf(0, 5.6, 7) * ang(rad(-6), 0, 0), wood)
	deck.Material = Enum.Material.WoodPlanks
	solid(deck)
	local mast = Build.column(m, 16, 1.1, frame * cf(0, 9, -3) * ang(rad(28), 0, rad(10)), wood)
	solid(mast)
	Build.column(m, 8, 0.5, frame * cf(0, 14, -7.5) * ang(rad(28), 0, rad(10)) * ang(0, 0, rad(90)), wood)
	local sail = Build.block(m, V(7, 5, 0.12), frame * cf(0.5, 12, -6) * ang(rad(28), 0, rad(14)), Color3.fromRGB(230, 222, 200))
	sail.Transparency = 0.15
	for i = 1, 3 do
		E.barrel(ctx, frame * cf(rng:NextNumber(-2, 2), 1.4, -8 + i * 4))
	end
end

E.pillar = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Pillar")
	local kit = Worlds.get(ctx.world).kit
	local stone = if kit == "atlantis" then Color3.fromRGB(236, 242, 248) else Color3.fromRGB(222, 196, 140)
	local material = if kit == "atlantis" then Enum.Material.Marble else Enum.Material.Sandstone
	local broken = rng:NextNumber() < 0.45
	local height = if broken then rng:NextNumber(4, 8) else rng:NextNumber(10, 14)
	local frame = at * ang(rng:NextNumber(-0.05, 0.05), rng:NextNumber(0, 6), rng:NextNumber(-0.05, 0.05))
	local base = Build.block(m, V(3.4, 1, 3.4), frame * cf(0, 0.5, 0), stone)
	base.Material = material
	local shaft = Build.column(m, height, 2.4, frame * cf(0, 1 + height / 2, 0), stone)
	shaft.Material = material
	solid(shaft)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Build.block(m, V(0.25, height, 0.25), frame * cf(math.cos(a) * 1.15, 1 + height / 2, math.sin(a) * 1.15), Color.darken(stone, 0.12))
	end
	if broken then
		local piece = Build.column(m, 5, 2.4, frame * cf(4.5, 1.2, 1) * ang(0, rad(30), rad(90)), stone)
		piece.Material = material
	else
		local capital = Build.block(m, V(3.6, 1, 3.6), frame * cf(0, 1.5 + height, 0), stone)
		capital.Material = material
	end
	if kit == "atlantis" then
		local ring = Build.column(m, 0.4, 2.6, frame * cf(0, 1 + height * 0.6, 0), ctx.pal.a1)
		ring.Material = Enum.Material.Neon
	end
end

E.arch = function(ctx, at)
	local m = group(ctx, "Arch")
	local kit = Worlds.get(ctx.world).kit
	local stone = if kit == "atlantis" then Color3.fromRGB(236, 242, 248) else Color3.fromRGB(222, 196, 140)
	local frame = at * ang(0, ctx.rng:NextNumber(0, 6), 0)
	for _, side in { -1, 1 } do
		local leg = Build.block(m, V(3, 16, 3), frame * cf(side * 7, 8, 0), stone)
		leg.Material = Enum.Material.Sandstone
		solid(leg)
	end
	local top = Build.block(m, V(18, 3, 3.6), frame * cf(0, 17.5, 0), stone)
	top.Material = Enum.Material.Sandstone
	solid(top)
	local gem = Build.ball(m, 2, frame * cf(0, 17.5, -1.9), ctx.pal.a1)
	gem.Material = Enum.Material.Neon
	addLight(ctx, gem, ctx.pal.a1, 24, 2)
end

E.statue = function(ctx, at)
	local m = group(ctx, "Statue")
	local stone = Color3.fromRGB(150, 140, 128)
	local frame = at * ang(rad(ctx.rng:NextNumber(-8, 8)), ctx.rng:NextNumber(0, 6), 0)
	local head = Build.block(m, V(5, 8, 4.5), frame * cf(0, 3.5, 0), stone)
	head.Material = Enum.Material.Slate
	solid(head)
	Build.block(m, V(5.4, 1.2, 1.5), frame * cf(0, 5.5, -2.2), Color.darken(stone, 0.15))
	Build.block(m, V(1.2, 3, 1.6), frame * cf(0, 3.5, -2.6), Color.darken(stone, 0.1))
	for _, side in { -1, 1 } do
		local eye = Build.block(m, V(1.2, 0.7, 0.4), frame * cf(side * 1.3, 4.7, -2.3), ctx.pal.a1)
		eye.Material = Enum.Material.Neon
	end
end

E.rune = function(ctx, at)
	local m = group(ctx, "Rune")
	local frame = at * ang(rad(ctx.rng:NextNumber(-10, 10)), ctx.rng:NextNumber(0, 6), 0)
	local slab = Build.block(m, V(3.5, 5, 0.8), frame * cf(0, 2.5, 0), Color3.fromRGB(90, 96, 110))
	slab.Material = Enum.Material.Slate
	for i = 0, 2 do
		local line = Build.block(m, V(2.2 - i * 0.4, 0.25, 0.1), frame * cf(0, 3.8 - i * 1.1, -0.42), ctx.pal.a1)
		line.Material = Enum.Material.Neon
	end
	local dot = Build.ball(m, 0.6, frame * cf(0, 1.1, -0.42), ctx.pal.a1)
	dot.Material = Enum.Material.Neon
	addLight(ctx, dot, ctx.pal.a1, 10, 1)
end

E.dome = function(ctx, at)
	local m = group(ctx, "Dome")
	local stone = Color3.fromRGB(236, 242, 248)
	local shell = Build.ellipsoid(m, V(16, 10, 16), at * cf(0, 6, 0), stone)
	shell.Material = Enum.Material.Marble
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local pillar = Build.column(m, 7, 1.4, at * cf(math.cos(a) * 7.2, 3.5, math.sin(a) * 7.2), stone)
		pillar.Material = Enum.Material.Marble
		solid(pillar)
	end
	local top = Build.ball(m, 2.2, at * cf(0, 11.4, 0), ctx.pal.a1)
	top.Material = Enum.Material.Neon
	addLight(ctx, top, ctx.pal.a1, 26, 2)
end

E.iceSpike = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "IceSpike")
	local height = rng:NextNumber(4, 11)
	local width = height * 0.32
	local frame = at * ang(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, 6), rng:NextNumber(-0.2, 0.2))
	local a, b = Build.spike(m, height, width, frame * cf(0, height / 2, 0) * ang(rad(90), 0, 0), Color3.fromRGB(200, 236, 255))
	for _, part in { a, b } do
		part.Material = Enum.Material.Ice
		part.Transparency = 0.15
	end
end

E.iceberg = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Iceberg")
	for i = 1, 4 do
		local size = V(rng:NextNumber(6, 12), rng:NextNumber(6, 14), rng:NextNumber(6, 12))
		local part = Build.block(
			m,
			size,
			at
				* cf(rng:NextNumber(-4, 4), size.Y * 0.3 + i, rng:NextNumber(-4, 4))
				* ang(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)),
			Color3.fromRGB(226, 244, 255)
		)
		part.Material = Enum.Material.Glacier
		solid(part)
	end
end

E.crystal = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Crystal")
	local color = vary(rng, if Worlds.get(ctx.world).kit == "ice" then Color3.fromRGB(170, 225, 255) else ctx.pal.a1, 0.06)
	local scale = rng:NextNumber(1, 2.4)
	for i = 1, rng:NextInteger(3, 6) do
		local height = rng:NextNumber(2, 5) * scale
		local w = 0.9 * scale
		local frame = at
			* cf(rng:NextNumber(-1, 1) * scale, 0, rng:NextNumber(-1, 1) * scale)
			* ang(rng:NextNumber(-0.45, 0.45), rng:NextNumber(0, 6), rng:NextNumber(-0.45, 0.45))
		local shaft = Build.block(m, V(w, height, w), frame * cf(0, height / 2, 0), color)
		shaft.Material = if i == 1 then Enum.Material.Neon else Enum.Material.Glass
		shaft.Transparency = if i == 1 then 0 else 0.2
		local a, b = Build.spike(m, w * 1.1, w, frame * cf(0, height + w * 0.55, 0) * ang(rad(90), 0, 0), color)
		a.Material = Enum.Material.Glass
		b.Material = Enum.Material.Glass
	end
	local core = m:FindFirstChildWhichIsA("BasePart")
	if core then
		addLight(ctx, core, color, 12 * scale, 1.3)
	end
end

E.basalt = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Basalt")
	for _ = 1, rng:NextInteger(3, 6) do
		local h = rng:NextNumber(2, 7)
		local col =
			Build.column(m, h, rng:NextNumber(1.6, 2.4), at * cf(rng:NextNumber(-2, 2), h / 2, rng:NextNumber(-2, 2)), Color3.fromRGB(46, 42, 44))
		col.Material = Enum.Material.Basalt
		solid(col)
	end
end

E.lava = function(ctx, at)
	local m = group(ctx, "Lava")
	local r = ctx.rng:NextNumber(3, 6)
	local pool = Build.column(m, 0.3, r * 2, at * cf(0, 0.15, 0), Color3.fromRGB(255, 110, 30))
	pool.Material = Enum.Material.Neon
	local rim = Build.column(m, 0.5, r * 2 + 1.2, at * cf(0, 0.05, 0), Color3.fromRGB(40, 32, 30))
	rim.Material = Enum.Material.Basalt
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new(0.25)
	emitter.Lifetime = NumberRange.new(1, 2)
	emitter.Rate = 6
	emitter.Speed = NumberRange.new(2, 5)
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Parent = pool
	addLight(ctx, pool, Color3.fromRGB(255, 120, 40), 18, 2.2)
end

E.vent = function(ctx, at)
	local m = group(ctx, "Vent")
	local color = Color3.fromRGB(58, 50, 50)
	for i = 0, 2 do
		local c = Build.column(m, 1.6, 3 - i * 0.7, at * cf(0, 0.8 + i * 1.5, 0), color)
		c.Material = Enum.Material.Basalt
	end
	local mouth = Build.column(m, 0.2, 1.2, at * cf(0, 4.4, 0), Color3.fromRGB(255, 120, 50))
	mouth.Material = Enum.Material.Neon
	smoke(mouth, Color3.fromRGB(230, 230, 240), -at.Position.Y > 1)
end

E.tubeWorms = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "TubeWorms")
	for _ = 1, rng:NextInteger(5, 9) do
		local h = rng:NextNumber(1.5, 4)
		local offset = cf(rng:NextNumber(-1.2, 1.2), 0, rng:NextNumber(-1.2, 1.2)) * ang(rng:NextNumber(-0.2, 0.2), 0, rng:NextNumber(-0.2, 0.2))
		Build.column(m, h, 0.35, at * offset * cf(0, h / 2, 0), Color3.fromRGB(235, 232, 225))
		local tip = Build.ball(m, 0.5, at * offset * cf(0, h, 0), Color3.fromRGB(255, 60, 70))
		tip.Material = Enum.Material.Neon
	end
	tagSway(m, 0.06, at)
end

E.glowPlant = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "GlowPlant")
	local color = pick(rng, ctx.pal.corals)
	local h = rng:NextNumber(2, 5)
	local frame = at * ang(rng:NextNumber(-0.25, 0.25), 0, rng:NextNumber(-0.25, 0.25))
	Build.column(m, h, 0.3, frame * cf(0, h / 2, 0), Color.darken(color, 0.5))
	local bulb = Build.ellipsoid(m, V(1.1, 1.4, 1.1), frame * cf(0, h + 0.5, 0), color)
	bulb.Material = Enum.Material.Neon
	for i = 1, 3 do
		Build.ellipsoid(m, V(1.4, 0.15, 0.5), frame * cf(0, h * 0.4, 0) * ang(0, i * 2.1, rad(-25)) * cf(0.6, 0, 0), Color.darken(color, 0.3))
	end
	if rng:NextNumber() < 0.5 then
		addLight(ctx, bulb, color, 10, 1.2)
	end
	tagSway(m, 0.1, at)
end

E.mushroom = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Mushroom")
	local color = pick(rng, ctx.pal.corals)
	local h = rng:NextNumber(3, 7)
	Build.column(m, h, 0.9, at * cf(0, h / 2, 0), Color3.fromRGB(230, 225, 240))
	local cap = Build.ellipsoid(m, V(h * 1.1, h * 0.45, h * 1.1), at * cf(0, h, 0), color)
	cap.Material = Enum.Material.Neon
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		Build.ball(m, 0.6, at * cf(math.cos(a) * h * 0.3, h + h * 0.18, math.sin(a) * h * 0.3), Color3.fromRGB(255, 255, 255))
	end
	addLight(ctx, cap, color, 14, 1.4)
end

E.spire = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Spire")
	local color = Color.darken(ctx.pal.rock, 0.2)
	local glow = pick(rng, ctx.pal.corals)
	local height = rng:NextNumber(6, 16)
	local steps = math.floor(height / 2)
	local frame = at
	for i = 1, steps do
		local w = 3 * (1 - i / (steps + 1)) + 0.4
		local seg = Build.block(m, V(w, 2.2, w), frame * cf(0, 1.1, 0), color)
		seg.Material = Enum.Material.Slate
		if i == 1 then
			solid(seg)
		end
		if i % 3 == 0 then
			local ring = Build.block(m, V(w + 0.3, 0.25, w + 0.3), frame * cf(0, 1.9, 0), glow)
			ring.Material = Enum.Material.Neon
		end
		frame = frame * cf(0, 2, 0) * ang(0, rad(22), rng:NextNumber(-0.06, 0.06))
	end
	local tip = Build.ball(m, 0.9, frame * cf(0, 0.6, 0), glow)
	tip.Material = Enum.Material.Neon
	addLight(ctx, tip, glow, 12, 1.2)
end

E.bones = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Bones")
	for _ = 1, rng:NextInteger(2, 4) do
		local frame = at * cf(rng:NextNumber(-1.5, 1.5), 0.3, rng:NextNumber(-1.5, 1.5)) * ang(0, rng:NextNumber(0, 6), rad(90))
		Build.column(m, 2.4, 0.35, frame, ctx.pal.bone)
		for _, y in { -1.25, 1.25 } do
			Build.ball(m, 0.6, frame * cf(0, y, 0.18), ctx.pal.bone)
			Build.ball(m, 0.6, frame * cf(0, y, -0.18), ctx.pal.bone)
		end
	end
end

E.skull = function(ctx, at)
	local m = group(ctx, "Skull")
	local model = Build.model("S")
	RelicModels.Shapes.skull(model, ctx.pal.bone, Color3.fromRGB(30, 26, 30))
	Build.fit(model, ctx.rng:NextNumber(3, 5))
	model:PivotTo(at * cf(0, 1.4, 0) * ang(0, ctx.rng:NextNumber(0, 6), 0))
	model.Parent = m
end

E.lollipop = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Lollipop")
	local h = rng:NextNumber(6, 11)
	Build.column(m, h, 0.5, at * cf(0, h / 2, 0), Color3.fromRGB(255, 255, 255))
	local frame = at * cf(0, h + 1.6, 0) * ang(0, rng:NextNumber(0, 6), 0)
	local c1, c2 = pick(rng, ctx.pal.corals), Color3.fromRGB(255, 255, 255)
	for i = 0, 3 do
		Build.cylinder(m, 0.6 + i * 0.02, 4 - i * 0.9, frame * ang(0, rad(90), 0), if i % 2 == 0 then c1 else c2)
	end
end

E.gumdrop = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "Gumdrop")
	local size = rng:NextNumber(1.6, 3.2)
	local drop = Build.ball(m, size, at * cf(0, size * 0.25, 0), pick(rng, ctx.pal.corals))
	drop.Material = Enum.Material.Glass
	drop.Transparency = 0.15
end

E.candyCane = function(ctx, at)
	local rng = ctx.rng
	local m = group(ctx, "CandyCane")
	local frame = at * ang(0, rng:NextNumber(0, 6), 0)
	for i = 0, 7 do
		Build.column(m, 1.05, 0.8, frame * cf(0, 0.5 + i, 0), if i % 2 == 0 then Color3.fromRGB(240, 60, 80) else Color3.fromRGB(255, 255, 255))
	end
	for i = 0, 5 do
		local a = i / 5 * math.pi
		Build.ball(
			m,
			0.85,
			frame * cf(-1 + math.cos(a), 8.3 + math.sin(a) * 1, 0),
			if i % 2 == 0 then Color3.fromRGB(240, 60, 80) else Color3.fromRGB(255, 255, 255)
		)
	end
end

E.ribcage = function(ctx, _at)
	local m = group(ctx, "Leviathan")
	local bone = ctx.pal.bone
	local info = ctx.info
	local o = info.origin
	-- A colossal skeleton arching over the lagoon: spine across the back, ribs rising from the water.
	local spineCount = 14
	for i = 0, spineCount do
		local t = i / spineCount
		local a = math.rad(200 + t * 140)
		local r = info.radius + 10
		local p = o + V(math.cos(a) * r, 6 + math.sin(t * math.pi) * 10, math.sin(a) * r)
		solid(Build.ball(m, 5 - math.abs(t - 0.5) * 3, cf(p), bone))
		if i % 2 == 0 and i > 0 and i < spineCount then
			local inward = ((o - p) * V(1, 0, 1)).Unit
			-- Each rib starts pointing inward and up, then bends down toward the water.
			local seg = cf(p) * CFrame.lookAt(Vector3.zero, inward).Rotation * ang(rad(35), 0, 0)
			for _ = 1, 4 do
				seg = seg * cf(0, 0, -3)
				solid(Build.cylinder(m, 6.6, 1.4, seg * ang(0, rad(90), 0), bone))
				seg = seg * cf(0, 0, -3) * ang(rad(-22), 0, 0)
			end
		end
	end
	local skullAt = o + V(math.cos(math.rad(345)) * (info.radius + 18), 8, math.sin(math.rad(345)) * (info.radius + 18))
	local skull = Build.model("GiantSkull")
	RelicModels.Shapes.skull(skull, bone, Color3.fromRGB(255, 60, 90))
	Build.fit(skull, 26)
	skull:PivotTo(CFrame.lookAt(skullAt, o + V(0, 8, 0)))
	skull.Parent = m
	for _, part in skull:GetDescendants() do
		if part:IsA("BasePart") and part.Transparency < 1 then
			part.CanCollide = true
		end
	end
end

