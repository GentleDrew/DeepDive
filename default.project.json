{
  "name": "DeepDive",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 20,
        "CharacterJumpPower": 50,
        "CharacterUseJumpPower": true,
        "CameraMaxZoomDistance": 70,
        "CameraMinZoomDistance": 6,
        "GameSettingsAvatar": "R15",
        "EnableMouseLockOption": true,
        "LoadCharacterAppearance": true,
        "HealthDisplayDistance": 0,
        "NameDisplayDistance": 60,
        "AutoJumpEnabled": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false,
        "ShowDevelopmentGui": true
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 2
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false,
        "Gravity": 196.2,
        "FallenPartsDestroyHeight": -1200
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Brightness": 3,
        "ClockTime": 13.5,
        "GeographicLatitude": 23,
        "Ambient": [0.48, 0.55, 0.6],
        "OutdoorAmbient": [0.62, 0.7, 0.76],
        "ColorShift_Top": [1, 0.96, 0.9],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "ExposureCompensation": 0.1,
        "GlobalShadows": true,
        "ShadowSoftness": 0.25
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.12,
          "Color": [0.78, 0.92, 1],
          "Decay": [0.5, 0.72, 0.84],
          "Glare": 0.25,
          "Haze": 0.8
        }
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "SunAngularSize": 16,
          "MoonAngularSize": 11,
          "StarCount": 3000,
          "CelestialBodiesShown": true
        }
      },
      "DiveBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.6,
          "Size": 28,
          "Threshold": 1.6
        }
      },
      "DiveColor": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.08,
          "Saturation": 0.12,
          "TintColor": [1, 1, 1]
        }
      },
      "DiveSunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.06,
          "Spread": 0.7
        }
      },
      "DiveBlur": {
        "$className": "BlurEffect",
        "$properties": {
          "Size": 0
        }
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true,
        "AmbientReverb": "NoReverb"
      }
    }
  }
}
