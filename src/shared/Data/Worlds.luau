--!strict
-- The 20 worlds. Every world shares one format (island lagoon + blue hole, 5 relics, 1 egg with
-- 5 pets) and only changes theme: names, palette, terrain materials, decor kit, sky and hazards.
-- Colors are hex strings and materials are Enum.Material names so this stays pure data.
--
-- Positional entries:
--   relic = { english, korean, shape, color, accent, style? }
--   pet   = { english, korean, shape, color, accent, style? }
-- style: "neon" (glowing accents), "glass", "ghost", "gold", "rainbow", "cosmic"

export type Named = { en: string, ko: string }
export type Relic = { key: string, world: number, rarity: number, name: Named, shape: string, color: string, accent: string, style: string? }
export type Pet = {
	key: string,
	world: number,
	rarity: number,
	name: Named,
	shape: string,
	color: string,
	accent: string,
	style: string?,
	secret: boolean,
}
export type Sky = {
	time: number,
	bright: number,
	ambient: string,
	outdoor: string,
	density: number,
	haze: number,
	atmo: string,
	decay: string,
	glare: number,
	clouds: number,
	cloudColor: string,
	stars: boolean,
}
export type World = {
	index: number,
	key: string,
	name: Named,
	kit: string,
	meters: number,
	water: string,
	terrain: { [string]: string },
	sky: Sky,
	under: { tint: string, dark: number },
	accent: { string },
	relics: { Relic },
	egg: { name: Named, color: string, accent: string, style: string? },
	pets: { Pet },
	secret: Pet?,
	hazards: { { kind: string, count: number } },
	fish: { string },
	fishGlow: boolean,
}

