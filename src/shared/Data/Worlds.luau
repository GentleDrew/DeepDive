local Worlds = {}
Worlds.list = {} :: { World }
Worlds.byKey = {} :: { [string]: World }
Worlds.relics = {} :: { [string]: Relic }
Worlds.pets = {} :: { [string]: Pet }
Worlds.petOrder = {} :: { string }

local function named(pair: { string }): Named
	return { en = pair[1], ko = pair[2] }
end

for index, raw in RAW do
	local world: World = {
		index = index,
		key = raw.key,
		name = named(raw.name),
		kit = raw.kit,
		meters = raw.meters,
		water = raw.water,
		terrain = raw.terrain,
		sky = {
			time = raw.sky.time,
			bright = raw.sky.bright,
			ambient = raw.sky.ambient,
			outdoor = raw.sky.outdoor,
			density = raw.sky.density,
			haze = raw.sky.haze,
			atmo = raw.sky.atmo,
			decay = raw.sky.decay,
			glare = raw.sky.glare,
			clouds = raw.sky.clouds,
			cloudColor = raw.sky.cloudColor or "#ffffff",
			stars = raw.sky.stars == true,
		},
		under = raw.under,
		accent = raw.accent,
		relics = {},
		egg = { name = { en = raw.egg[1], ko = raw.egg[2] }, color = raw.egg[3], accent = raw.egg[4], style = raw.egg[5] },
		pets = {},
		secret = nil,
		hazards = raw.hazards,
		fish = raw.fish,
		fishGlow = raw.fishGlow == true,
	}
	for rarity, entry in raw.relics do
		local relic: Relic = {
			key = string.format("r%d.%d", index, rarity),
			world = index,
			rarity = rarity,
			name = { en = entry[1], ko = entry[2] },
			shape = entry[3],
			color = entry[4],
			accent = entry[5],
			style = entry[6],
		}
		table.insert(world.relics, relic)
		Worlds.relics[relic.key] = relic
	end
	for rarity, entry in raw.pets do
		local pet: Pet = {
			key = string.format("p%d.%d", index, rarity),
			world = index,
			rarity = rarity,
			name = { en = entry[1], ko = entry[2] },
			shape = entry[3],
			color = entry[4],
			accent = entry[5],
			style = entry[6],
			secret = false,
		}
		table.insert(world.pets, pet)
		Worlds.pets[pet.key] = pet
		table.insert(Worlds.petOrder, pet.key)
	end
	if raw.secret then
		local entry = raw.secret
		local pet: Pet = {
			key = string.format("s%d", index),
			world = index,
			rarity = 6,
			name = { en = entry[1], ko = entry[2] },
			shape = entry[3],
			color = entry[4],
			accent = entry[5],
			style = entry[6],
			secret = true,
		}
		world.secret = pet
		Worlds.pets[pet.key] = pet
		table.insert(Worlds.petOrder, pet.key)
	end
	table.insert(Worlds.list, world)
	Worlds.byKey[world.key] = world
end

function Worlds.get(index: number): World
	return Worlds.list[math.clamp(math.floor(index), 1, #Worlds.list)]
end

return Worlds
